---
/**
 * Book cover with an elegant placeholder fallback - never a broken image.
 */
import { coverUrl } from "../../../functions/_lib/openLibrary.js";

interface Props {
    coverId: number | null;
    title: string;
    authors?: string[];
    size?: "S" | "M" | "L";
    class?: string;
    loading?: "lazy" | "eager";
}

const { coverId, title, authors = [], size = "M", class: className = "", loading = "lazy" } = Astro.props;
const src = coverUrl(coverId, size);
---

{
    src ? (
        <div class:list={["book-cover", className]}>
            <img
                src={src}
                alt={`Book cover: ${title}`}
                loading={loading}
                decoding="async"
                referrerpolicy="no-referrer"
                onerror="this.closest('.book-cover').classList.add('book-cover--missing'); this.remove();"
            />
            <div class="book-cover__placeholder" aria-hidden="true">
                <span class="book-cover__placeholder-title">{title}</span>
                {authors.length > 0 && <span class="book-cover__placeholder-author">{authors[0]}</span>}
            </div>
        </div>
    ) : (
        <div class:list={["book-cover book-cover--missing", className]}>
            <div class="book-cover__placeholder" role="img" aria-label={`No cover available for ${title}`}>
                <span class="book-cover__placeholder-title">{title}</span>
                {authors.length > 0 && <span class="book-cover__placeholder-author">{authors[0]}</span>}
            </div>
        </div>
    )
}

<style>
    .book-cover {
        position: relative;
        aspect-ratio: 2 / 3;
        border-radius: 0.75rem;
        overflow: hidden;
        background: linear-gradient(135deg, #1e293b, #3b1d52);
    }
    .book-cover img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: 1;
    }
    .book-cover__placeholder {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 1rem;
        text-align: center;
    }
    .book-cover--missing img {
        display: none;
    }
    .book-cover__placeholder-title {
        font-weight: 800;
        color: rgba(255, 255, 255, 0.85);
        font-size: 0.95rem;
        line-height: 1.3;
        display: -webkit-box;
        -webkit-line-clamp: 5;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .book-cover__placeholder-author {
        font-size: 0.75rem;
        color: rgba(255, 255, 255, 0.5);
    }
</style>
