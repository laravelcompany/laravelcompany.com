---
import { Image } from "astro:assets";

const testimonials = [
  {
    quote:
      "Their Laravel expertise is unmatched. Our custom CRM was delivered ahead of schedule, fully optimized, and easier to use than we imagined.",
    author: "Daniel Roberts",
    role: "Founder at Summit Logistics",
    avatar: "/testimonial-avatar-1.jpg",
  },
  {
    quote:
      "We received a free consultation and quote within hours. The team guided us through every stage of development, from planning to deployment.",
    author: "Alicia Gomez",
    role: "Operations Manager at Nova Retail",
    avatar: "/testimonial-avatar-2.jpg",
  },
  {
    quote:
      "Their free hosting offer saved us thousands during launch. The Laravel application they built for us scales effortlessly and runs like a dream.",
    author: "Michael Lee",
    role: "CEO at BrightSoft",
    avatar: "/testimonial-avatar-3.jpg",
  },
];
---

<section class="py-20 bg-white relative overflow-hidden">
  <!-- Subtle background pattern with parallax effect -->
  <div class="absolute inset-0 opacity-5 parallax" data-speed="0.15">
    <div
      class="absolute inset-0 bg-repeat"
      style="background-image: url('/grid-pattern.svg');"
    >
    </div>
  </div>

  <div class="container-custom relative">
    <div class="text-center max-w-3xl mx-auto animate-on-scroll">
      <h2 class="text-3xl md:text-4xl font-bold">
        Trusted by businesses that demand quality software
      </h2>
      <p class="mt-4 text-xl text-gray-600">
        Hear from clients who built their platforms with our Laravel development
        & consulting services.
      </p>
    </div>

    <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-8">
      {
        testimonials.map((testimonial, index) => (
          <div
            class="testimonial-card animate-on-scroll group"
            style={`animation-delay: ${index * 0.15}s`}
          >
            <div class="flex items-center mb-6">
              <div>
                <h6 class="font-semibold transition-colors duration-300 group-hover:text-purple-600">
                  {testimonial.author}
                </h6>
                <p class="text-sm text-gray-600">{testimonial.role}</p>
              </div>
            </div>
            <p class="text-gray-700 italic relative">
              <span class="absolute -top-2 -left-1 text-4xl text-purple-600 opacity-20 transition-all duration-300 group-hover:opacity-40 group-hover:scale-110">
                "
              </span>
              {testimonial.quote}
              <span class="absolute -bottom-2 -right-1 text-4xl text-purple-600 opacity-20 transition-all duration-300 group-hover:opacity-40 group-hover:scale-110">
                "
              </span>
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
