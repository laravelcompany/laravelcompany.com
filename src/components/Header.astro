---
import { Image } from 'astro:assets';
import logoSrc from '../assets/logo.svg';

const navItems = [
    { name: 'About Us', href: '/about-us' },
    { name: 'Software', href: '/software' },
];
---

<header class="sticky top-0 z-50 w-full bg-white/80 backdrop-blur-md border-b border-gray-100" role="banner">
    <div class="container-custom flex items-center justify-between h-20">
        <a title="laravel development agency" href="/" class="flex items-center transition-transform duration-300 hover:scale-105 focus:scale-105 focus:outline-none focus:ring-2 focus:ring-payflo-purple focus:ring-offset-2 rounded" aria-label="Payflo home">
            <Image src={logoSrc} alt="laravel development company logo" width={42} class="rounded-full object-cover transition-all duration-300 hover:brightness-110 focus:brightness-110"
            />
        </a>

        <!-- Desktop Nav -->
        <nav class="hidden md:flex items-center space-x-8" role="navigation" aria-label="Main navigation">
            {navItems.map(item => (
                    <a
                            title={item.name}
                            target={item.target ?? '_self'}
                            href={item.href}
                            class="text-gray-700 hover:text-payflo-purple focus:text-payflo-purple transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-payflo-purple focus:ring-offset-2 rounded px-2 py-1"
                    >
                        {item.name}
                    </a>
            ))}
        </nav>

        <div class="flex items-center space-x-4">

            <a href="/contact" class="btn btn-primary focus:outline-none focus:ring-2 focus:ring-payflo-purple focus:ring-offset-2">Book Call</a>

            <!-- Mobile Menu Button -->
            <button
                    id="menu-toggle"
                    class="md:hidden flex flex-col items-center justify-center w-8 h-8 focus:outline-none"
                    aria-label="Toggle navigation menu"
                    aria-expanded="false"
            >
                <span class="hamburger-line"></span>
                <span class="hamburger-line"></span>
                <span class="hamburger-line"></span>
            </button>
        </div>
    </div>

    <!-- Mobile Dropdown Menu - Right below header -->
    <div id="mobile-menu" class="mobile-menu">
        <div class="container-custom py-6">
            <nav class="flex flex-col space-y-4">
                {navItems.map(item => (
                        <a href={item.href} class="mobile-menu-item">
                            {item.name}
                        </a>
                ))}
                <a href="/login" class="mobile-menu-item">
                    Log In
                </a>
                <a href="/contact" class="mobile-menu-cta">
                    Book a Demo
                </a>
            </nav>
        </div>
    </div>
</header>

<style>
    /* Hamburger menu styles */
    .hamburger-line {
        width: 100%;
        height: 2px;
        background-color: #374151;
        margin: 2px 0;
        transition: all 0.3s ease;
        transform-origin: center;
    }

    #menu-toggle.active .hamburger-line:nth-child(1) {
        transform: rotate(45deg) translate(5px, 5px);
    }

    #menu-toggle.active .hamburger-line:nth-child(2) {
        opacity: 0;
    }

    #menu-toggle.active .hamburger-line:nth-child(3) {
        transform: rotate(-45deg) translate(7px, -6px);
    }

    /* Mobile menu styles */
    .mobile-menu {
        display: none;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
        backdrop-filter: blur(10px);
    }

    .mobile-menu.active {
        display: block;
        animation: slideDown 0.3s ease-out;
    }

    .mobile-menu-item {
        display: block;
        color: white;
        font-size: 1.125rem;
        font-weight: 500;
        padding: 0.75rem 1rem;
        border-radius: 0.5rem;
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        text-decoration: none;
        transition: all 0.3s ease;
        backdrop-filter: blur(5px);
    }

    .mobile-menu-item:hover {
        background: rgba(255, 255, 255, 0.2);
        transform: translateX(8px);
    }

    .mobile-menu-cta {
        display: block;
        color: white;
        font-size: 1.125rem;
        font-weight: 600;
        padding: 1rem 1.5rem;
        border-radius: 2rem;
        background: linear-gradient(135deg, #ff6b6b, #ee5a24);
        text-decoration: none;
        text-align: center;
        margin-top: 1rem;
        box-shadow: 0 4px 15px rgba(238, 90, 36, 0.4);
        transition: all 0.3s ease;
    }

    .mobile-menu-cta:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(238, 90, 36, 0.6);
    }

    @keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Hide mobile menu on desktop */
    @media (min-width: 768px) {
        .mobile-menu {
            display: none !important;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const menuToggle = document.getElementById('menu-toggle');
        const mobileMenu = document.getElementById('mobile-menu');

        console.log('Menu elements:', { menuToggle, mobileMenu });

        if (menuToggle && mobileMenu) {
            menuToggle.addEventListener('click', function() {
                console.log('Menu button clicked');

                // Toggle active class on button
                menuToggle.classList.toggle('active');

                // Toggle menu visibility
                if (mobileMenu.classList.contains('active')) {
                    console.log('Hiding menu');
                    mobileMenu.classList.remove('active');
                    menuToggle.setAttribute('aria-expanded', 'false');
                } else {
                    console.log('Showing menu');
                    mobileMenu.classList.add('active');
                    menuToggle.setAttribute('aria-expanded', 'true');
                }
            });

            // Close menu when clicking on links
            const menuLinks = mobileMenu.querySelectorAll('a');
            menuLinks.forEach(link => {
                link.addEventListener('click', function() {
                    console.log('Menu link clicked, closing menu');
                    mobileMenu.classList.remove('active');
                    menuToggle.classList.remove('active');
                    menuToggle.setAttribute('aria-expanded', 'false');
                });
            });

            // Close menu on escape key
            document.addEventListener('keydown', function(event) {
                if (event.key === 'Escape' && mobileMenu.classList.contains('active')) {
                    console.log('Escape pressed, closing menu');
                    mobileMenu.classList.remove('active');
                    menuToggle.classList.remove('active');
                    menuToggle.setAttribute('aria-expanded', 'false');
                }
            });
        }
    });
</script>