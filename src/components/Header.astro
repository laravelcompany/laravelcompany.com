---
import { Image } from "astro:assets";
import logoSrc from "../assets/logo.svg";

interface NavItem {
    name: string;
    href: string;
    target?: string;
}

const navItems: NavItem[] = [
    { name: "About Us", href: "/about-us/" },
    { name: "Software", href: "/software/" },
    { name: "Jobs", href: "/jobs/" },
];
---

<header
    class="fixed top-0 z-50 w-full transition-all duration-300"
    role="banner"
    id="main-header"
>
    <div class="container-custom flex items-center justify-between h-20">
        <a
            title="laravel development agency"
            href="/"
            class="flex items-center transition-transform duration-300 hover:scale-105 focus:scale-105 focus:outline-none focus:ring-2 focus:ring-payflo-purple focus:ring-offset-2 rounded"
            aria-label="Laravel company home"
        >
            <Image
                src={logoSrc}
                alt="laravel development company logo"
                width={42}
                class="rounded-full object-cover transition-all duration-300 hover:brightness-110 focus:brightness-110"
            />
        </a>

        <!-- Desktop Nav -->
        <nav
            class="hidden md:flex items-center space-x-8"
            role="navigation"
            aria-label="Main navigation"
        >
            {
                navItems.map((item) => (
                    <a
                        title={item.name}
                        target={item.target ?? "_self"}
                        href={item.href}
                        class="nav-link"
                    >
                        {item.name}
                    </a>
                ))
            }
        </nav>

        <div class="flex items-center space-x-4">
            <a
                href="/contact/"
                class="btn btn-primary focus:outline-none focus:ring-2 focus:ring-payflo-purple focus:ring-offset-2"
                >Book Call</a
            >

            <!-- Mobile Menu Button -->
            <button
                id="menu-toggle"
                class="md:hidden flex flex-col items-center justify-center w-10 h-10 glass-card p-2 focus:outline-none"
                aria-label="Toggle navigation menu"
                aria-expanded="false"
            >
                <div
                    class="w-6 h-0.5 bg-white mb-1.5 transition-all duration-300 line-1"
                >
                </div>
                <div
                    class="w-6 h-0.5 bg-white mb-1.5 transition-all duration-300 line-2"
                >
                </div>
                <div
                    class="w-6 h-0.5 bg-white transition-all duration-300 line-3"
                >
                </div>
            </button>
        </div>
    </div>

    <!-- Mobile Dropdown Menu - Right below header -->
    <div id="mobile-menu" class="mobile-menu">
        <div class="container-custom py-6">
            <nav class="flex flex-col space-y-4">
                {
                    navItems.map((item) => (
                        <a href={item.href} class="mobile-menu-item">
                            {item.name}
                        </a>
                    ))
                }
                <a href="https://app.laravelmail.com/login" class="mobile-menu-item"> Log In </a>
                <a href="/contact/" class="mobile-menu-cta"> Book a Demo </a>
            </nav>
        </div>
    </div>
</header>

<style>
    /* Hamburger menu styles */
    #menu-toggle.active .line-1 {
        transform: translateY(7px) rotate(45deg);
    }

    #menu-toggle.active .line-2 {
        opacity: 0;
    }

    #menu-toggle.active .line-3 {
        transform: translateY(-7px) rotate(-45deg);
    }

    /* Mobile menu styles */
    .mobile-menu {
        display: none;
        background: rgba(15, 23, 42, 0.95);
        backdrop-blur: 20px;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
    }

    .mobile-menu.active {
        display: block;
        animation: slideDown 0.3s ease-out;
    }

    .mobile-menu-item {
        display: block;
        color: white;
        font-size: 1.125rem;
        font-weight: 600;
        padding: 1rem;
        border-radius: 1rem;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        text-decoration: none;
        transition: all 0.3s ease;
    }

    .mobile-menu-item:hover {
        background: rgba(255, 255, 255, 0.1);
        transform: scale(1.02);
    }

    /* Hide desktop nav on scroll */
    #main-header.scrolled nav[aria-label="Main navigation"] {
        opacity: 0;
        transform: translateY(-10px);
        pointer-events: none;
    }

    nav[aria-label="Main navigation"] {
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .mobile-menu-cta {
        display: block;
        color: white;
        font-size: 1.125rem;
        font-weight: 700;
        padding: 1rem 1.5rem;
        border-radius: 1rem;
        background: var(--gradient-purple-pink);
        text-decoration: none;
        text-align: center;
        margin-top: 1rem;
        box-shadow: 0 4px 15px rgba(124, 58, 237, 0.4);
        transition: all 0.3s ease;
    }

    .mobile-menu-cta:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(124, 58, 237, 0.6);
    }

    @keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Hide mobile menu on desktop */
    @media (min-width: 768px) {
        .mobile-menu {
            display: none !important;
        }
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const header = document.getElementById("main-header");

        window.addEventListener("scroll", () => {
            if (window.scrollY > 20) {
                header?.classList.add("scrolled");
            } else {
                header?.classList.remove("scrolled");
            }
        });

        const menuToggle = document.getElementById("menu-toggle");
        const mobileMenu = document.getElementById("mobile-menu");

        console.log("Menu elements:", { menuToggle, mobileMenu });

        if (menuToggle && mobileMenu) {
            menuToggle.addEventListener("click", function () {
                console.log("Menu button clicked");

                // Toggle active class on button
                menuToggle.classList.toggle("active");

                // Toggle menu visibility
                if (mobileMenu.classList.contains("active")) {
                    console.log("Hiding menu");
                    mobileMenu.classList.remove("active");
                    menuToggle.setAttribute("aria-expanded", "false");
                } else {
                    console.log("Showing menu");
                    mobileMenu.classList.add("active");
                    menuToggle.setAttribute("aria-expanded", "true");
                }
            });

            // Close menu when clicking on links
            const menuLinks = mobileMenu.querySelectorAll("a");
            menuLinks.forEach((link) => {
                link.addEventListener("click", function () {
                    console.log("Menu link clicked, closing menu");
                    mobileMenu.classList.remove("active");
                    menuToggle.classList.remove("active");
                    menuToggle.setAttribute("aria-expanded", "false");
                });
            });

            // Close menu on escape key
            document.addEventListener("keydown", function (event) {
                if (
                    event.key === "Escape" &&
                    mobileMenu.classList.contains("active")
                ) {
                    console.log("Escape pressed, closing menu");
                    mobileMenu.classList.remove("active");
                    menuToggle.classList.remove("active");
                    menuToggle.setAttribute("aria-expanded", "false");
                }
            });
        }
    });
</script>
