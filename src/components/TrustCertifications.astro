---
import { Icon } from "astro-icon/components";
---

<section class="py-20 bg-white/5">
  <div class="container-custom max-w-4xl mx-auto text-center">
    <h2 class="text-3xl md:text-4xl font-black text-white">
      Discuss your security and compliance requirements
    </h2>
    <p class="mt-6 text-lg text-gray-300 leading-relaxed">
      Tell us which standards, assurance documents and procurement checks your
      project requires. Confirm the evidence and scope needed for your organisation
      before choosing a development partner.
    </p>
    <a
      href="/contact/"
      class="mt-8 inline-flex items-center px-6 py-3 bg-white/10 hover:bg-white/20 border border-white/20 rounded-lg text-white font-medium transition-all duration-200"
    >
      <Icon name="ph:envelope-simple-duotone" class="w-5 h-5 mr-2" />
      Discuss Project Requirements
    </a>
  </div>
</section>
