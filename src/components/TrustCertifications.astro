---
import { Icon } from "astro-icon/components";

const certifications = [
  {
    id: "cra",
    name: "CRA Compliant",
    fullName: "Cyber Resilience Act",
    icon: "ph:shield-check-duotone",
    colorFrom: "from-emerald-500",
    colorTo: "to-teal-600",
    borderColor: "border-emerald-500/30",
    textColor: "text-emerald-400",
    shadowColor: "shadow-emerald-500/20",
    tooltip: "Verified secure development lifecycle meeting EU CRA requirements for digital component suppliers.",
    verification: "/compliance#certifications",
  },
  {
    id: "eucc",
    name: "EUCC Certified",
    fullName: "EU Cybersecurity Certification",
    icon: "ph:certificate-duotone",
    colorFrom: "from-blue-500",
    colorTo: "to-indigo-600",
    borderColor: "border-blue-500/30",
    textColor: "text-blue-400",
    shadowColor: "shadow-blue-500/20",
    tooltip: "We undergo annual third-party audits to maintain EUCC certification for ICT products.",
    verification: "/compliance#certifications",
  },
  {
    id: "enisa",
    name: "ENISA Audited",
    fullName: "European Union Agency for Cybersecurity",
    icon: "ph:lock-key-duotone",
    colorFrom: "from-cyan-500",
    colorTo: "to-blue-600",
    borderColor: "border-cyan-500/30",
    textColor: "text-cyan-400",
    shadowColor: "shadow-cyan-500/20",
    tooltip: "Our security practices are regularly audited against ENISA frameworks and guidelines.",
    verification: "/compliance#certifications",
  },
  {
    id: "gdpr",
    name: "GDPR Compliant",
    fullName: "General Data Protection Regulation",
    icon: "ph:user-check-duotone",
    colorFrom: "from-violet-500",
    colorTo: "to-purple-600",
    borderColor: "border-violet-500/30",
    textColor: "text-violet-400",
    shadowColor: "shadow-violet-500/20",
    tooltip: "Full data protection compliance with EU GDPR. DPA available for enterprise clients.",
    verification: "/compliance#certifications",
  },
  {
    id: "ai-act",
    name: "AI Act Ready",
    fullName: "EU Artificial Intelligence Act",
    icon: "ph:brain-duotone",
    colorFrom: "from-rose-500",
    colorTo: "to-pink-600",
    borderColor: "border-rose-500/30",
    textColor: "text-rose-400",
    shadowColor: "shadow-rose-500/20",
    tooltip: "Our AI solutions comply with EU AI Act requirements for high-risk AI systems.",
    verification: "/compliance#certifications",
  },
  {
    id: "iso27001",
    name: "ISO 27001:2022",
    fullName: "Information Security Management",
    icon: "ph:shield-star-duotone",
    colorFrom: "from-amber-500",
    colorTo: "to-orange-600",
    borderColor: "border-amber-500/30",
    textColor: "text-amber-400",
    shadowColor: "shadow-amber-500/20",
    tooltip: "ISMS certified. Annual surveillance audits ensure continued compliance.",
    verification: "/compliance#certifications",
  },
];
---

<section class="py-20 bg-white/5 relative overflow-hidden">
  <!-- Background decoration -->
  <div class="absolute top-0 left-1/4 w-64 h-64 bg-emerald-500/5 blur-[100px] rounded-full -z-10"></div>
  <div class="absolute bottom-0 right-1/4 w-64 h-64 bg-blue-500/5 blur-[100px] rounded-full -z-10"></div>

  <div class="container-custom">
    <!-- Section Header -->
    <div class="text-center max-w-4xl mx-auto mb-16">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-black text-white leading-tight">
        Certified & Compliant –
        <span class="gradient-text bg-gradient-to-r from-emerald-400 via-blue-400 to-violet-400 bg-clip-text text-transparent">
          Enterprise-Grade Security
        </span>
      </h2>
      <p class="mt-6 text-xl text-gray-300 max-w-2xl mx-auto">
        We meet and exceed EU regulatory standards for geolocation & 3D mapping software.
      </p>
    </div>

    <!-- Certification Badges Grid -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 lg:gap-6">
      {certifications.map((cert) => (
        <div class="group relative">
          <!-- Badge Card -->
          <a
            href={cert.verification}
            class={`certification-badge block bg-white/5 border ${cert.borderColor} rounded-xl p-4 md:p-6 text-center transition-all duration-300 hover:bg-white/10 hover:shadow-lg ${cert.shadowColor} hover:-translate-y-1 cursor-pointer`}
            aria-label={`${cert.name}: ${cert.tooltip}`}
            tabindex="0"
          >
            <!-- Icon -->
            <div class={`w-12 h-12 md:w-14 md:h-14 mx-auto mb-3 rounded-xl bg-gradient-to-br ${cert.colorFrom} ${cert.colorTo} flex items-center justify-center shadow-lg`}>
              <Icon name={cert.icon} class="w-6 h-6 md:w-7 md:h-7 text-white" />
            </div>
            
            <!-- Name -->
            <h3 class="text-sm md:text-base font-bold text-white leading-tight">
              {cert.name}
            </h3>
          </a>

          <!-- CSS Tooltip -->
          <div
            class="tooltip absolute z-50 bottom-full left-1/2 -translate-x-1/2 mb-3 w-64 md:w-72 opacity-0 invisible group-hover:opacity-100 group-focus-within:opacity-100 group-focus-within:visible transition-all duration-200"
            role="tooltip"
          >
            <div class="bg-payflo-darker border border-white/20 rounded-lg p-4 shadow-2xl">
              <p class="text-sm text-gray-200 font-medium mb-2">
                {cert.fullName}
              </p>
              <p class="text-xs text-gray-400 mb-3">
                {cert.tooltip}
              </p>
              <a
                href={cert.verification}
                class={`inline-flex items-center text-xs font-semibold ${cert.textColor} hover:underline`}
              >
                View Certificate
                <Icon name="ph:arrow-right" class="w-3 h-3 ml-1" />
              </a>
            </div>
            <!-- Tooltip arrow -->
            <div class="absolute top-full left-1/2 -translate-x-1/2 w-0 h-0 border-l-8 border-r-8 border-t-8 border-l-transparent border-r-transparent border-t-payflo-darker"></div>
          </div>
        </div>
      ))}
    </div>

    <!-- Trust Indicators Bar -->
    <div class="mt-12 flex flex-wrap justify-center items-center gap-6 md:gap-8 text-sm">
      <div class="flex items-center text-gray-400">
        <Icon name="ph:check-circle-duotone" class="w-5 h-5 text-emerald-400 mr-2" />
        <span>Audited Annually</span>
      </div>
      <div class="flex items-center text-gray-400">
        <Icon name="ph:users-three-duotone" class="w-5 h-5 text-blue-400 mr-2" />
        <span>Enterprise DPA Available</span>
      </div>
      <div class="flex items-center text-gray-400">
        <Icon name="ph:file-lock-duotone" class="w-5 h-5 text-violet-400 mr-2" />
        <span>Full Audit Trail</span>
      </div>
    </div>

    <!-- Verification CTA -->
    <div class="mt-10 text-center">
      <p class="text-gray-400 text-sm mb-4">
        Our certifications are available upon request for enterprise clients.
      </p>
      <a
        href="/contact/"
        class="inline-flex items-center px-6 py-3 bg-white/10 hover:bg-white/20 border border-white/20 rounded-lg text-white font-medium transition-all duration-200"
      >
        <Icon name="ph:envelope-simple-duotone" class="w-5 h-5 mr-2" />
        Request Certification Details
      </a>
    </div>
  </div>
</section>

<style>
  .certification-badge {
    min-height: 140px;
  }

  @media (max-width: 768px) {
    .certification-badge {
      min-height: 120px;
    }
  }

  /* Ensure tooltip is positioned correctly on mobile */
  @media (max-width: 640px) {
    .tooltip {
      width: 250px;
      left: 0;
      right: 0;
      margin-left: auto;
      margin-right: auto;
    }
  }

  /* Focus styles for accessibility */
  .certification-badge:focus {
    outline: 2px solid #3b82f6;
    outline-offset: 2px;
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .certification-badge,
    .tooltip {
      transition: none;
    }
  }
</style>
