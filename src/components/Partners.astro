---
const partners = [
  { name: "AppFutura", logo: "/assets/logos/AppFutura-3.svg" },
  { name: "CII", logo: "/assets/logos/CII-1.svg" },
  { name: "CLUTCH", logo: "/assets/logos/CLUTCH-1.svg" },
  { name: "CMO", logo: "/assets/logos/CMO-2.svg" },
  { name: "ISO", logo: "/assets/logos/iso.svg" },
  { name: "NASSCOM", logo: "/assets/logos/nasscom-1.svg" },
  { name: "TIE", logo: "/assets/logos/tie-2.svg" },
  { name: "Top Developers", logo: "/assets/logos/top-developers-1.svg" },
];
---

<section class="py-16 relative overflow-hidden bg-white/5">
  <div class="container-custom">
    <div class="text-center">
      <h3
        class="animate-on-scroll delay-0 text-gray-400 font-medium tracking-wider"
      >
        TRUSTED BY LEADING COMPANIES
      </h3>
    </div>

    <div
      class="mt-12 grid grid-cols-2 md:grid-cols-4 lg:grid-cols-8 gap-8 items-center justify-items-center"
    >
      {
        partners.map((partner, index) => (
          <div class={`group cursor-pointer animate-on-scroll delay-${index}`}>
            <div class="relative p-4 rounded-lg transition-all duration-300 hover:bg-white/5">
              <img
                src={partner.logo}
                alt={partner.name}
                class="h-12 w-auto mx-auto grayscale opacity-60 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-500 transform group-hover:scale-110"
              />
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
