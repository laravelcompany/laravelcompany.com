---
const faqs = [
  {
    question: "How long does it take to build a custom Laravel application?",
    answer:
      "Most Laravel development projects launch within 6-12 weeks, depending on complexity and specific business requirements. Simple web applications and MVPs can be delivered in 4-6 weeks, while enterprise-level solutions with advanced features typically require 3-6 months of development time.",
    keywords:
      "laravel development timeline, custom laravel application, laravel project duration",
    category: "timeline",
  },
  {
    question: "Do you follow Laravel best practices and PSR coding standards?",
    answer:
      "Absolutely! Our certified Laravel development team strictly adheres to PSR standards, Laravel conventions, and industry best practices. We implement clean architecture principles, comprehensive PHPUnit testing, code reviews, and maintain high-quality standards through automated CI/CD pipelines.",
    keywords:
      "laravel best practices, PSR standards, laravel coding standards, clean code",
    category: "quality",
  },
  {
    question:
      "How do you ensure Laravel application security and data protection?",
    answer:
      "We implement Laravel's built-in security features including CSRF protection, SQL injection prevention, XSS protection, and authentication systems. Additionally, we conduct comprehensive security audits, use encrypted data storage, implement rate limiting, and follow OWASP security guidelines for enterprise-grade protection.",
    keywords:
      "laravel security, web application security, data protection, OWASP guidelines",
    category: "security",
  },
  {
    question:
      "Can you integrate Laravel with existing systems and third-party APIs?",
    answer:
      "Yes! Laravel's flexible architecture enables seamless integration with CRMs (Salesforce, HubSpot), ERPs (SAP, Oracle), payment gateways (Stripe, PayPal), and hundreds of third-party APIs. We build custom connectors, webhooks, and ensure reliable data synchronization between systems.",
    keywords:
      "laravel integration, API integration, third-party integration, system integration",
    category: "integration",
  },
  {
    question: "What ongoing Laravel support and maintenance do you provide?",
    answer:
      "We offer comprehensive post-launch Laravel support including 24/7 monitoring, security updates, performance optimization, bug fixes, feature enhancements, and Laravel version upgrades. Our maintenance packages include regular backups, database optimization, and proactive issue resolution.",
    keywords:
      "laravel maintenance, laravel support, ongoing support, laravel updates",
    category: "support",
  },
  {
    question:
      "How do you price Laravel development projects and what's included?",
    answer:
      "Our Laravel development pricing is transparent and project-based, ranging from $10K-$100K+ depending on complexity, features, and scope. We provide detailed estimates including development, testing, deployment, documentation, and initial support. No hidden fees or surprise costs.",
    keywords:
      "laravel development cost, laravel pricing, web development pricing, project estimates",
    category: "pricing",
  },
  {
    question:
      "Do you provide Laravel version upgrades and legacy system modernization?",
    answer:
      "Yes! We specialize in Laravel maintenance packages that include framework upgrades, security patches, performance monitoring, database optimization, and feature additions. We ensure your Laravel application stays current with the latest PHP and Laravel versions for optimal security and performance.",
    keywords:
      "laravel upgrades, laravel maintenance, legacy modernization, framework updates",
    category: "maintenance",
  },
  {
    question: "Can you migrate our existing application to Laravel framework?",
    answer:
      "Absolutely! We excel at migrating applications from various platforms (WordPress, CodeIgniter, Symfony, custom PHP) to Laravel. Our migration process ensures zero downtime, complete data integrity, improved performance, and enhanced security throughout the transition.",
    keywords:
      "laravel migration, platform migration, application migration, framework migration",
    category: "migration",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Laravel Development Company",
  description:
    "Professional Laravel development services for custom web applications, e-commerce platforms, and enterprise solutions",
  url: "https://laravelcompany.com",
  logo: "https://laravelcompany.com/logo.svg",
  contactPoint: {
    "@type": "ContactPoint",
    telephone: "+44 744 821 88 99",
    contactType: "customer service",
    areaServed: "GB",
    availableLanguage: "English",
  },
  sameAs: [
    "https://twitter.com/laravelcompany",
    "https://www.linkedin.com/company/laravel-company-official",
    "https://github.com/laravelcompany",
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
<script
  type="application/ld+json"
  set:html={JSON.stringify(organizationSchema)}
/>

<section
  class="py-24 relative overflow-hidden"
  aria-labelledby="faq-heading"
  itemscope
  itemtype="https://schema.org/FAQPage"
>
  <!-- Background blobs -->
  <div
    class="absolute top-1/4 left-10 w-96 h-96 bg-payflo-purple/10 blur-[130px] rounded-full -z-10"
  >
  </div>
  <div
    class="absolute bottom-1/4 right-10 w-96 h-96 bg-payflo-pink/10 blur-[130px] rounded-full -z-10"
  >
  </div>

  <div
    class="absolute top-20 right-10 opacity-5"
    aria-hidden="true"
    role="presentation"
  >
    <svg class="h-24 w-24 text-red-500" fill="currentColor" viewBox="0 0 24 24">
      <path
        d="M23.642 5.43a.364.364 0 01.014.1v5.149c0 .135-.073.26-.189.326l-4.323 2.49v4.934a.378.378 0 01-.188.326L9.93 23.949a.316.316 0 01-.066.027c-.008.002-.016.008-.024.01a.348.348 0 01-.192 0c-.011-.002-.02-.008-.03-.012-.02-.008-.042-.014-.062-.025L.533 18.755a.376.376 0 01-.189-.326V2.974c0-.033.005-.066.014-.098.003-.012.01-.02.014-.032a.369.369 0 01.023-.058c.004-.013.015-.022.023-.033l.033-.045c.012-.01.025-.018.037-.027.014-.012.027-.024.041-.034L5.527.06a.375.375 0 01.375 0L10.9 2.647c.016.01.03.021.044.033.012.009.022.018.034.027.008.006.019.01.026.018.015.011.024.027.038.041.008.01.018.017.024.027.016.021.028.049.035.075.001.013.007.025.008.038v9.652l3.76-2.164V5.527c0-.033.004-.066.013-.098.003-.01.01-.02.013-.032.007-.02.018-.04.024-.058.007-.013.016-.021.024-.033.007-.013.021-.02.033-.045.012-.01.025-.018.037-.027.014-.011.027-.024.041-.034L19.469.06a.375.375 0 01.375 0l4.998 2.876c.017.01.031.021.045.033.012.009.021.018.033.027.008.006.018.01.025.018.015.011.025.027.039.041.007.01.017.017.024.027.015.021.028.049.034.075.002.013.007.025.009.038z"
      ></path>
    </svg>
  </div>

  <div class="container-custom relative">
    <header class="text-center max-w-5xl mx-auto animate-on-scroll">
      <h2
        id="faq-heading"
        class="text-4xl md:text-5xl lg:text-6xl font-black text-white leading-tight"
        itemprop="name"
      >
        Laravel Development <span class="gradient-text">FAQ</span>
      </h2>
      <p
        class="mt-6 text-xl md:text-2xl text-white/70 font-medium max-w-4xl mx-auto leading-relaxed"
        itemprop="description"
      >
        Everything you need to know about our professional Laravel development
        services, pricing, timelines, and enterprise process.
      </p>

      <div
        class="mt-12 flex flex-wrap justify-center gap-6 lg:gap-10 text-sm lg:text-base font-black uppercase tracking-widest text-white/60"
      >
        <span class="flex items-center gap-3"> 500+ Projects </span>
        <span class="flex items-center gap-3"> 8-Week Delivery </span>
        <span class="flex items-center gap-3"> Certified Team </span>
      </div>
    </header>

    <main class="mt-20 max-w-5xl mx-auto" role="main">
      <div class="space-y-6" itemscope itemtype="https://schema.org/FAQPage">
        {
          faqs.map((faq, index) => (
            <article
              class="animate-on-scroll faq-item"
              style={`animation-delay: ${index * 0.1}s`}
              itemscope
              itemtype="https://schema.org/Question"
              id={`faq-${index + 1}`}
            >
              <details class="group/details w-full">
                <summary class="focus:outline-none focus:bg-white/5 w-full">
                  <h3
                    class="text-xl lg:text-2xl font-black text-white transition-colors duration-300 group-hover:text-payflo-purple pr-6 leading-tight text-left"
                    itemprop="name"
                  >
                    {faq.question}
                  </h3>
                  <div class="flex-shrink-0">
                    <div class="h-10 w-10 lg:h-12 lg:w-12 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center group-hover:bg-white/10 group-open:bg-payflo-purple transition-all duration-300">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-6 w-6 lg:h-7 lg:w-7 text-white group-open:rotate-180 transition-all duration-500"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        aria-hidden="true"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M19 9l-7 7-7-7"
                        />
                      </svg>
                    </div>
                  </div>
                </summary>

                <div
                  class="faq-content"
                  itemscope
                  itemtype="https://schema.org/Answer"
                >
                  <p class="text-lg font-medium" itemprop="text">
                    {faq.answer}
                  </p>
                </div>
              </details>
            </article>
          ))
        }
      </div>
    </main>

    <footer class="mt-20 text-center animate-on-scroll" role="contentinfo">
      <div
        class="glass-card py-16 px-10 border-white/20 max-w-4xl mx-auto relative overflow-hidden"
      >
        <div class="relative">
          <h2 class="text-3xl lg:text-4xl font-black text-white mb-6">
            Ready to Start Your <span class="gradient-text tracking-tighter"
              >Laravel Project</span
            >?
          </h2>
          <p
            class="text-white/70 text-lg lg:text-xl mb-10 max-w-2xl mx-auto leading-relaxed font-medium"
          >
            Our Laravel development experts are ready to discuss your custom web
            application requirements and provide detailed project estimates.
          </p>

          <div
            class="flex flex-col sm:flex-row gap-4 lg:gap-6 justify-center mb-10"
          >
            <a
              title="Schedule a free Laravel development consultation"
              href="/contact"
              class="btn btn-primary"
            >
              Schedule Free Consultation
            </a>
          </div>

          <div class="pt-8 border-t border-white/10">
            <div
              class="flex flex-col lg:flex-row justify-center gap-12 text-white/50 font-black uppercase tracking-widest text-xs"
            >
              <span class="flex items-center gap-3">
                info@laravelcompany.com
              </span>
              <span class="flex items-center gap-3"> Fast Response </span>
              <span class="flex items-center gap-3"> Free Estimation </span>
            </div>
          </div>
        </div>
      </div>
    </footer>

    <aside
      class="mt-16 max-w-4xl mx-auto animate-on-scroll"
      aria-labelledby="related-services"
    >
      <div class="p-8 lg:p-10">
        <h3
          id="related-services"
          class="text-2xl font-black text-white mb-10 text-center uppercase tracking-widest"
        >
          Related Laravel Services
        </h3>
        <div
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 text-center"
        >
          <div
            class="glass-card !p-6 shadow-sm hover:shadow-md transition-shadow duration-300"
          >
            <h4 class="font-black text-white mb-2">Custom Dev</h4>
            <p class="text-xs text-white/50 font-bold uppercase tracking-wider">
              Tailored applications
            </p>
          </div>
          <div
            class="glass-card !p-6 shadow-sm hover:shadow-md transition-shadow duration-300"
          >
            <h4 class="font-black text-white mb-2">E-commerce</h4>
            <p class="text-xs text-white/50 font-bold uppercase tracking-wider">
              Scalable stores
            </p>
          </div>
          <div
            class="glass-card !p-6 shadow-sm hover:shadow-md transition-shadow duration-300"
          >
            <h4 class="font-black text-white mb-2">API Dev</h4>
            <p class="text-xs text-white/50 font-bold uppercase tracking-wider">
              Restful services
            </p>
          </div>
        </div>
      </div>
    </aside>
  </div>
</section>

<style>
  .animate-on-scroll {
    opacity: 0;
    transform: translateY(40px);
    transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .animate-on-scroll.visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  const observerOptions = {
    threshold: 0.1,
    rootMargin: "0px 0px -50px 0px",
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add("visible");
        observer.unobserve(entry.target);
      }
    });
  }, observerOptions);

  document.addEventListener("DOMContentLoaded", () => {
    const animatedElements = document.querySelectorAll(".animate-on-scroll");
    animatedElements.forEach((el) => observer.observe(el));
  });
</script>
