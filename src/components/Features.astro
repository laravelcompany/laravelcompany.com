---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import featureImage1 from '../assets/logo.svg';
import featureImage2 from '../assets/logo.svg';
import featureImage3 from '../assets/logo.svg';

const features = [
{
    title: "Become mission-critical",
    description: "Adding Laravel-powered solutions on top of your existing business processes means your operations run seamlessly inside one robust, scalable platform that grows with your success.",
    icon: "ph:star-duotone",
    image: featureImage1,
    },
{
    title: "Access cutting-edge Laravel tools",
    description: "We don't just build standard applications – we architect excellence. Our Laravel expertise delivers faster development, cleaner code, better security, and more maintainable solutions.",
    icon: "ph:lightning-duotone",
    image: featureImage2,
    },
{
    title: "Ready to scale globally",
    description: "Launch your Laravel application worldwide within weeks, not months. Get rapid market validation and user feedback to accelerate your growth and market penetration.",
    icon: "ph:globe-duotone",
    image: featureImage3,
    },
];

// Alternative feature sets for different business focuses:

const ecommerceFeatures = [
{
    title: "Become their go-to platform",
    description: "Integrating custom e-commerce functionality means customers complete their entire shopping journey within your Laravel-powered ecosystem, increasing retention and lifetime value.",
    icon: "ph:shopping-cart-duotone",
    image: featureImage1,
    },
{
    title: "Leverage modern e-commerce tech",
    description: "Our Laravel e-commerce solutions aren't just online stores – they're conversion machines. Built with performance, security, and scalability at the core.",
    icon: "ph:rocket-duotone",
    image: featureImage2,
    },
{
    title: "Multi-market ready",
    description: "Deploy across multiple markets with localized payment gateways, currencies, and compliance. Launch in new regions within weeks, not quarters.",
    icon: "ph:globe-hemisphere-west-duotone",
    image: featureImage3,
    },
];

const saasFeatures = [
{
    title: "Become indispensable to users",
    description: "Building SaaS features with Laravel means customers accomplish everything within your platform ecosystem – from onboarding to advanced workflows – maximizing stickiness.",
    icon: "ph:users-duotone",
    image: featureImage1,
    },
{
    title: "Access enterprise-grade tools",
    description: "We build SaaS applications that enterprise clients trust. Multi-tenancy, advanced security, API-first architecture, and seamless integrations come standard.",
    icon: "ph:shield-check-duotone",
    image: featureImage2,
    },
{
    title: "Scale to millions of users",
    description: "Launch your SaaS globally with Laravel's proven architecture. Handle massive user bases, process millions of transactions, and maintain 99.9% uptime from day one.",
    icon: "ph:chart-line-up-duotone",
    image: featureImage3,
    },
];

const enterpriseFeatures = [
{
    title: "Become the system of record",
    description: "Custom Laravel applications become the central hub where all your business processes converge – from CRM to inventory management – eliminating data silos.",
    icon: "ph:database-duotone",
    image: featureImage1,
    },
{
    title: "Enterprise-grade architecture",
    description: "We build Laravel solutions that integrate seamlessly with existing enterprise systems. Advanced security, compliance, and performance that IT departments trust.",
    icon: "ph:buildings-duotone",
    image: featureImage2,
    },
{
    title: "Future-proof your operations",
    description: "Deploy Laravel applications that evolve with your business. Modular architecture means adding new features, integrations, and capabilities as you grow.",
    icon: "ph:gear-duotone",
    image: featureImage3,
    },
];
---

<section class="py-24 relative overflow-hidden">
  <!-- Subtle background decoration -->
  <div class="absolute top-0 left-1/4 w-96 h-96 bg-payflo-purple/10 blur-[120px] rounded-full -z-10"></div>
  <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-payflo-pink/10 blur-[120px] rounded-full -z-10"></div>

  <div class="container-custom relative">
    <div class="text-center max-w-4xl mx-auto">
      <h2 title="Laravel Development Agency" class="animate-on-scroll delay-0 text-4xl md:text-5xl lg:text-6xl font-black text-white leading-tight mt-2">
        Laravel Development <span class="gradient-text">Agency</span>
      </h2>
      <p class="animate-on-scroll delay-1 mt-6 text-xl md:text-2xl text-white/70 leading-relaxed font-medium">
        Our approach merges Laravel's elegant simplicity with complete customization freedom.
        We ensure rapid deployment and exceptional user experiences that scale with your growth.
      </p>

      <!-- Optional CTA or trust indicators -->
      <div class="animate-on-scroll delay-2 mt-10 flex flex-wrap justify-center gap-8 text-sm text-white/60 font-bold uppercase tracking-widest">
        <span class="flex items-center gap-2">
          Laravel Certified
        </span>
        <span class="flex items-center gap-2">
          2-3 Week Launch
        </span>
        <span class="flex items-center gap-2">
          Enterprise Security
        </span>
      </div>
    </div>

    <div class="mt-20 grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12">
      {features.map((feature, index) => (
          <div class={`feature-card animate-on-scroll delay-${index + 3} group`}>
            <div class="h-16 w-16 rounded-2xl bg-gradient-to-br from-payflo-purple to-payflo-pink flex items-center justify-center text-white mb-8 transition-all duration-500 group-hover:scale-110 group-hover:rotate-3 shadow-lg shadow-purple-500/20">
              <Icon name={feature.icon} class="h-8 w-8 transition-transform duration-300 group-hover:rotate-12" />
            </div>
            <h3 class="text-2xl font-black text-white mb-4 group-hover:text-payflo-purple transition-colors">
              {feature.title}
            </h3>
            <p class="text-white/70 leading-relaxed mb-8 font-medium">
              {feature.description}
            </p>
            <div class="hover-zoom rounded-lg overflow-hidden">
              <Image
                  src={feature.image}
                  alt={feature.title}
                  class="w-full h-auto rounded-lg transition-all duration-500 filter group-hover:brightness-105"
                  width={350}
                  height={220}
              />
            </div>

            <!-- Optional feature link/CTA -->
            <div class="mt-8 opacity-40 group-hover:opacity-100 transition-opacity duration-300">
              <a href="/laravel-application-development-company" class="text-payflo-purple font-black flex items-center gap-2 text-sm uppercase tracking-widest">
                Learn more
                <Icon name="ph:arrow-right" class="h-4 w-4" />
              </a>
            </div>
          </div>
      ))}
    </div>

    <!-- Optional bottom CTA section -->
    <div class="animate-on-scroll delay-6 mt-20 text-center">
      <div class="inline-flex flex-col sm:flex-row items-center gap-6 glass-card py-6 px-10 border-white/20">
        <span class="text-white font-black text-xl">Ready to build with Laravel?</span>
        <a href="/contact" class="btn btn-primary !py-3 !px-8">
          Start Your Project
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Additional CSS for enhanced animations -->
<style>
  .parallax {
    transform: translateZ(0);
    will-change: transform;
  }

  .hover-zoom img {
    transition: transform 0.5s ease;
  }

  .hover-zoom:hover img {
    transform: scale(1.05);
  }

  @media (prefers-reduced-motion: reduce) {
    .feature-card:hover {
      transform: none;
    }

    .hover-zoom:hover img {
      transform: none;
    }
  }
</style>