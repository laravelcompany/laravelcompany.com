---
import { Icon } from "astro-icon/components";

interface DocLink {
  slug: string;
  title: string;
}

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  icon: string;
  basePath: string; // "/docs/" or "/funny-docs/"
  sectionLabel: string; // "Docs" or "Funny Docs"
  sectionName: string; // "Laravel Documentation" or "Funny Laravel Docs"
  docsList: DocLink[];
  currentSlug: string;
  headings: Heading[];
  tagline?: string;
  downloadHref: string;
  footerHint?: string;
  footerLinkLabel?: string;
}

const {
  title,
  icon,
  basePath,
  sectionLabel,
  sectionName,
  docsList,
  currentSlug,
  headings,
  tagline,
  downloadHref,
  footerHint = "Missing a topic?",
  footerLinkLabel = "Let us know",
} = Astro.props;

const pageHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);

const currentIndex = docsList.findIndex((d) => d.slug === currentSlug);
const prevDoc = currentIndex > 0 ? docsList[currentIndex - 1] : null;
const nextDoc =
  currentIndex >= 0 && currentIndex < docsList.length - 1
    ? docsList[currentIndex + 1]
    : null;
---

<section class="pt-28 pb-10 bg-gradient-to-r from-violet-900 via-purple-900 to-fuchsia-900">
  <div class="container-custom">
    <nav class="flex items-center gap-2 text-sm text-white/50 mb-6">
      <a href="/" class="hover:text-white transition-colors">Home</a>
      <span>/</span>
      <a href={basePath} class="hover:text-white transition-colors">{sectionLabel}</a>
      <span>/</span>
      <span class="text-white">{title}</span>
    </nav>

    <div class="flex items-center gap-4">
      <div class="h-14 w-14 shrink-0 rounded-2xl bg-white/15 border border-white/20 flex items-center justify-center text-white">
        <Icon name={icon} class="h-7 w-7" />
      </div>
      <div>
        <h1 class="text-3xl md:text-4xl font-bold text-white tracking-tight">
          {title}
        </h1>
        <p class="text-white/60 text-sm mt-1">
          {sectionName}
          {tagline && <span class="text-violet-300"> &middot; {tagline}</span>}
        </p>
      </div>
      <a
        href={downloadHref}
        download
        title={`Download ${title} as Markdown`}
        aria-label={`Download ${title} as Markdown`}
        class="ml-auto shrink-0 inline-flex items-center gap-2 px-3.5 py-2.5 rounded-xl bg-white/15 border border-white/20 text-white text-sm font-medium hover:bg-white/25 transition-colors"
      >
        <Icon name="ph:download-duotone" class="h-5 w-5" />
        <span class="hidden sm:inline">Download .md</span>
      </a>
    </div>
  </div>
</section>

<section class="py-10 bg-gray-950 min-h-screen">
  <div class="container-custom">
    {/* Mobile navigation */}
    <div class="lg:hidden mb-8 space-y-3">
      <details class="group rounded-xl border border-gray-800 bg-gray-900/60">
        <summary class="flex items-center justify-between cursor-pointer px-4 py-3 text-sm font-semibold text-white select-none">
          <span class="inline-flex items-center gap-2">
            <Icon name="ph:list-duotone" class="h-4 w-4 text-fuchsia-400" />
            Browse {sectionName.toLowerCase()}
          </span>
          <Icon name="ph:caret-down-duotone" class="h-4 w-4 text-gray-500 group-open:rotate-180 transition-transform" />
        </summary>
        <div class="px-4 pb-4">
          <input
            type="search"
            placeholder="Filter topics..."
            class="docs-filter w-full mb-3 px-3 py-2 text-sm rounded-lg bg-gray-950 border border-gray-800 text-gray-200 placeholder-gray-500 focus:outline-none focus:border-fuchsia-500"
          />
          <ul class="docs-nav-list max-h-72 overflow-y-auto space-y-0.5 pr-1">
            {
              docsList.map((d) => (
                <li data-title={d.title.toLowerCase()}>
                  <a
                    href={`${basePath}${d.slug}/`}
                    class={`block px-3 py-1.5 rounded-md text-sm transition-colors ${
                      d.slug === currentSlug
                        ? "bg-fuchsia-950/60 text-fuchsia-300 font-medium"
                        : "text-gray-400 hover:text-white hover:bg-gray-800/60"
                    }`}
                  >
                    {d.title}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </details>

      {
        pageHeadings.length > 0 && (
          <details class="group rounded-xl border border-gray-800 bg-gray-900/60 xl:hidden">
            <summary class="flex items-center justify-between cursor-pointer px-4 py-3 text-sm font-semibold text-white select-none">
              <span class="inline-flex items-center gap-2">
                <Icon name="ph:list-bullets-duotone" class="h-4 w-4 text-fuchsia-400" />
                On this page
              </span>
              <Icon name="ph:caret-down-duotone" class="h-4 w-4 text-gray-500 group-open:rotate-180 transition-transform" />
            </summary>
            <ul class="px-4 pb-4 space-y-1">
              {
                pageHeadings.map((h) => (
                  <li>
                    <a
                      href={`#${h.slug}`}
                      class={`block text-sm text-gray-400 hover:text-fuchsia-300 transition-colors ${h.depth === 3 ? "pl-4" : ""}`}
                    >
                      {h.text}
                    </a>
                  </li>
                ))
              }
            </ul>
          </details>
        )
      }
    </div>

    <div class="lg:grid lg:grid-cols-[15rem_minmax(0,1fr)] xl:grid-cols-[16rem_minmax(0,1fr)_15rem] lg:gap-10">
      {/* Left sidebar: all topics */}
      <aside class="hidden lg:block">
        <div class="sticky top-24">
          <div class="rounded-xl border border-gray-800 bg-gray-900/60 p-4">
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-semibold uppercase tracking-wider text-gray-500">
                {sectionName}
              </span>
              <span class="text-xs text-gray-600">{docsList.length}</span>
            </div>
            <input
              type="search"
              placeholder="Filter topics..."
              class="docs-filter w-full mb-3 px-3 py-2 text-sm rounded-lg bg-gray-950 border border-gray-800 text-gray-200 placeholder-gray-500 focus:outline-none focus:border-fuchsia-500"
            />
            <ul class="docs-nav-list max-h-[calc(100vh-16rem)] overflow-y-auto space-y-0.5 pr-1">
              {
                docsList.map((d) => (
                  <li data-title={d.title.toLowerCase()}>
                    <a
                      href={`${basePath}${d.slug}/`}
                      aria-current={d.slug === currentSlug ? "page" : undefined}
                      class={`block px-3 py-1.5 rounded-md text-sm border-l-2 transition-colors ${
                        d.slug === currentSlug
                          ? "border-fuchsia-500 bg-fuchsia-950/60 text-fuchsia-300 font-medium"
                          : "border-transparent text-gray-400 hover:text-white hover:bg-gray-800/60"
                      }`}
                    >
                      {d.title}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </aside>

      {/* Article */}
      <div class="min-w-0">
        <article
          class="docs-content prose prose-invert max-w-none
            prose-headings:scroll-mt-28 prose-headings:font-bold prose-headings:tracking-tight
            prose-h2:text-2xl prose-h2:mt-14 prose-h2:pt-8 prose-h2:border-t prose-h2:border-gray-800
            prose-h3:text-xl prose-h3:mt-10
            prose-h4:text-base prose-h4:mt-8
            prose-p:text-gray-300 prose-p:leading-7
            prose-a:text-fuchsia-400 prose-a:no-underline prose-a:font-medium hover:prose-a:text-fuchsia-300 hover:prose-a:underline
            prose-strong:text-white
            prose-code:text-fuchsia-300 prose-code:bg-fuchsia-950/60 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded-md prose-code:text-[0.875em] prose-code:font-medium
            prose-pre:bg-gray-900 prose-pre:border prose-pre:border-gray-800 prose-pre:rounded-xl
            prose-blockquote:border-l-fuchsia-500 prose-blockquote:bg-fuchsia-950/30 prose-blockquote:rounded-r-xl prose-blockquote:py-2 prose-blockquote:not-italic prose-blockquote:text-gray-300
            prose-ul:text-gray-300 prose-ol:text-gray-300 prose-li:marker:text-fuchsia-400
            prose-thead:border-gray-700 prose-tr:border-gray-800
            prose-hr:border-gray-800
            prose-img:rounded-xl"
        >
          <slot />
        </article>

        {/* Prev / next */}
        <nav class="mt-16 pt-8 border-t border-gray-800 grid sm:grid-cols-2 gap-4">
          {
            prevDoc ? (
              <a
                href={`${basePath}${prevDoc.slug}/`}
                class="group flex items-center gap-3 p-4 rounded-xl border border-gray-800 bg-gray-900/60 hover:border-fuchsia-500/60 transition-colors"
              >
                <Icon name="ph:arrow-left-duotone" class="h-5 w-5 shrink-0 text-gray-500 group-hover:text-fuchsia-400 transition-colors" />
                <span class="min-w-0">
                  <span class="block text-xs text-gray-500 mb-0.5">Previous</span>
                  <span class="block text-sm font-medium text-gray-200 group-hover:text-white truncate">
                    {prevDoc.title}
                  </span>
                </span>
              </a>
            ) : (
              <span />
            )
          }
          {
            nextDoc && (
              <a
                href={`${basePath}${nextDoc.slug}/`}
                class="group flex items-center justify-end gap-3 p-4 rounded-xl border border-gray-800 bg-gray-900/60 hover:border-fuchsia-500/60 transition-colors sm:text-right"
              >
                <span class="min-w-0">
                  <span class="block text-xs text-gray-500 mb-0.5">Next</span>
                  <span class="block text-sm font-medium text-gray-200 group-hover:text-white truncate">
                    {nextDoc.title}
                  </span>
                </span>
                <Icon name="ph:arrow-right-duotone" class="h-5 w-5 shrink-0 text-gray-500 group-hover:text-fuchsia-400 transition-colors" />
              </a>
            )
          }
        </nav>

        <div class="mt-8 flex flex-col sm:flex-row justify-between items-center gap-4">
          <a
            href={basePath}
            class="inline-flex items-center px-5 py-2.5 bg-fuchsia-600 text-white text-sm font-medium rounded-lg hover:bg-fuchsia-700 transition-colors"
          >
            <Icon name="ph:arrow-left-duotone" class="h-4 w-4 mr-2" />
            All {sectionName.toLowerCase()}
          </a>
          <div class="flex items-center gap-3">
            <span class="text-gray-500 text-sm">{footerHint}</span>
            <a href="/contact/" class="text-fuchsia-400 hover:text-fuchsia-300 text-sm font-medium">
              {footerLinkLabel}
            </a>
          </div>
        </div>
      </div>

      {/* Right sidebar: on this page */}
      {
        pageHeadings.length > 0 && (
          <aside class="hidden xl:block">
            <div class="sticky top-24">
              <div class="rounded-xl border border-gray-800 bg-gray-900/60 p-4">
                <span class="text-xs font-semibold uppercase tracking-wider text-gray-500">
                  On this page
                </span>
                <ul class="mt-3 max-h-[calc(100vh-14rem)] overflow-y-auto space-y-1.5 pr-1">
                  {
                    pageHeadings.map((h) => (
                      <li>
                        <a
                          href={`#${h.slug}`}
                          class={`block text-[13px] leading-5 text-gray-400 hover:text-fuchsia-300 transition-colors ${h.depth === 3 ? "pl-4" : ""}`}
                        >
                          {h.text}
                        </a>
                      </li>
                    ))
                  }
                </ul>
              </div>
            </div>
          </aside>
        )
      }
    </div>
  </div>
</section>

<style is:global>
  /* Typography plugin backticks off inline code */
  .docs-content :not(pre) > code::before,
  .docs-content :not(pre) > code::after {
    content: none;
  }
  /* Roomy, framed code blocks with copy affordance */
  .docs-content pre {
    position: relative;
    padding: 1rem 1.25rem;
  }
  .docs-content pre code {
    font-size: 0.8125rem;
    line-height: 1.7;
  }
  /* Quote markers off callout-style blockquotes */
  .docs-content blockquote p:first-of-type::before,
  .docs-content blockquote p:last-of-type::after {
    content: none;
  }
  /* Keep long code lines and URLs from breaking the layout */
  .docs-content {
    overflow-wrap: break-word;
  }
  /* Slim scrollbars for the nav panels */
  .docs-nav-list::-webkit-scrollbar {
    width: 6px;
  }
  .docs-nav-list::-webkit-scrollbar-thumb {
    background: rgb(75 85 99);
    border-radius: 9999px;
  }
  /* Copy button injected by the script below */
  .docs-copy-btn {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem 0.625rem;
    font-size: 0.75rem;
    line-height: 1rem;
    color: rgb(156 163 175);
    background: rgb(17 24 39 / 0.9);
    border: 1px solid rgb(55 65 81);
    border-radius: 0.5rem;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
  }
  .docs-copy-btn:hover {
    color: rgb(240 171 252);
    border-color: rgb(162 28 175);
  }
  /* No double top spacing when the article opens with a section heading */
  .docs-content > *:first-child {
    margin-top: 0;
  }
  .docs-content > h2:first-child,
  .docs-content > a[name]:first-child + h2 {
    border-top: none;
    padding-top: 0;
    margin-top: 0;
  }
  /* Alert callouts converted from > [!NOTE] / [!WARNING] / ... markers */
  .docs-content blockquote[data-alert] {
    padding: 0.75rem 1.25rem;
  }
  .docs-content blockquote[data-alert] .docs-alert-label {
    margin-bottom: 0.25rem;
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .docs-content blockquote[data-alert="note"] {
    border-left-color: rgb(217 70 239);
    background: rgb(80 7 36 / 0.25);
  }
  .docs-content blockquote[data-alert="note"] .docs-alert-label {
    color: rgb(240 171 252);
  }
  .docs-content blockquote[data-alert="warning"] {
    border-left-color: rgb(245 158 11);
    background: rgb(69 26 3 / 0.35);
  }
  .docs-content blockquote[data-alert="warning"] .docs-alert-label {
    color: rgb(252 211 77);
  }
  .docs-content blockquote[data-alert="danger"] {
    border-left-color: rgb(239 68 68);
    background: rgb(69 10 10 / 0.35);
  }
  .docs-content blockquote[data-alert="danger"] .docs-alert-label {
    color: rgb(252 165 165);
  }
</style>

<script is:inline>
  document.querySelectorAll(".docs-filter").forEach(function (input) {
    var list = input.parentElement
      ? input.parentElement.querySelector(".docs-nav-list")
      : null;
    if (!list) return;
    input.addEventListener("input", function () {
      var q = input.value.trim().toLowerCase();
      list.querySelectorAll("li[data-title]").forEach(function (li) {
        li.style.display = !q || li.getAttribute("data-title").indexOf(q) !== -1 ? "" : "none";
      });
    });
  });

  document.querySelectorAll(".docs-content pre").forEach(function (pre) {
    var btn = document.createElement("button");
    btn.type = "button";
    btn.className = "docs-copy-btn";
    btn.textContent = "Copy";
    btn.addEventListener("click", function () {
      var code = pre.querySelector("code");
      var text = code ? code.innerText : pre.innerText;
      navigator.clipboard.writeText(text).then(function () {
        btn.textContent = "Copied";
        setTimeout(function () {
          btn.textContent = "Copy";
        }, 1600);
      });
    });
    pre.appendChild(btn);
  });
</script>
