---
---

<section class="hero-section">
  <div class="hero">
    <div class="hero-left">
      <div class="animate-on-scroll delay-0">
        <span class="eyebrow">
          <svg viewBox="0 0 12 12" fill="currentColor"><path d="M6 0l1.5 4.5H12L8.25 7.25 9.75 12 6 9.25 2.25 12l1.5-4.75L0 4.5h4.5L6 0z"/></svg>
          Tailor-made web development
        </span>
      </div>

      <h1 class="animate-on-scroll delay-0">We build <span class="accent-web">web</span><br><span class="accent-apps">applications</span> that grow with you</h1>

      <p class="hero-sub animate-on-scroll delay-1">We're not your do-it-all digital agency, but a partner focused on building web applications with a solid foundation that can grow alongside your needs.</p>

      <div class="hero-actions animate-on-scroll delay-2">
        <a href="/contact/" class="btn-cta">Brief us your project &nbsp;→</a>
      </div>

      <div class="trust-badges animate-on-scroll delay-3">
        <div class="badge">
          <div class="badge-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <div>
            <div class="badge-title">Reliable</div>
            <div class="badge-desc">Secure, tested<br>and dependable</div>
          </div>
        </div>
        <div class="badge">
          <div class="badge-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          </div>
          <div>
            <div class="badge-title">Scalable</div>
            <div class="badge-desc">Built to grow<br>with your business</div>
          </div>
        </div>
        <div class="badge">
          <div class="badge-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
          </div>
          <div>
            <div class="badge-title">Modern</div>
            <div class="badge-desc">Clean code, latest<br>technologies</div>
          </div>
        </div>
        <div class="badge">
          <div class="badge-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
