          <div>
            <div class="badge-title">Collaborative</div>
            <div class="badge-desc">Transparent process,<br>true partnership</div>
          </div>
        </div>
      </div>
    </div>

    <div class="hero-right animate-on-scroll delay-4">
      <div class="hero-card">
        <div class="hero-graphic-wrap">
          <div class="glow-ring glow-ring-1"></div>
          <div class="glow-ring glow-ring-2"></div>

          <div id="hero-three-container" style="position:absolute;inset:0;width:100%;height:100%;"></div>
        </div>

        <div class="feature-strip">
          <div class="feature-item">
            <div class="feature-icon-wrap">
