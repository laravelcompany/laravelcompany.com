---
import { Image } from "astro:assets";
import heroImage from "../assets/logo.svg";
---

<section class="pt-20 pb-16 md:pt-28 md:pb-24 overflow-hidden relative min-h-[80vh] flex items-center">
  <div class="bg-blob blob-1"></div>
  <div class="bg-blob blob-2"></div>

  <div class="container-custom relative">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div>
        <div class="animate-on-scroll delay-0">
          <span class="inline-block px-4 py-2 rounded-full bg-payflo-purple/20 border border-payflo-purple/30 text-payflo-purple text-sm font-bold uppercase tracking-widest mb-6">
            Tailor-made web development
          </span>
        </div>
        <h1 class="animate-on-scroll delay-0 text-5xl md:text-6xl lg:text-7xl font-black leading-tight tracking-tight">
          We build <span class="gradient-text">web applications</span> that grow with you
        </h1>
        <p class="animate-on-scroll delay-1 mt-6 text-xl text-white/70 max-w-lg leading-relaxed">
          We're not your do-it-all digital agency, but a partner focused on building web
          applications with a solid foundation that can grow alongside your needs.
        </p>
        <div class="animate-on-scroll delay-2 mt-8 flex flex-col sm:flex-row gap-4">
          <a href="/contact/" class="btn btn-primary">Brief us your project</a>
        </div>
      </div>

      <div class="animate-on-scroll delay-4">
        <div class="relative hover-zoom">
          <div class="absolute -inset-2 bg-gradient-to-r from-payflo-purple to-payflo-pink rounded-2xl blur-2xl opacity-20 transition-opacity duration-300 hover:opacity-40"></div>
          <div class="relative glass-card border-white/20 p-2 overflow-hidden">
            <Image
              src={heroImage}
              alt="Laravel web development"
              class="w-full h-auto transition-all duration-500 rounded-xl"
              width={700}
              height={500}
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
