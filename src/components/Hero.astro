<style is:global>
  .hero-section {
    --purple:     #6c3fff;
    --purple-lt:  #8b5cf6;
    --pink:       #c026d3;
    --pink-lt:    #e879f9;
    --orange:     #f97316;
    --blue-neon:  #38bdf8;
    --text:       #e2e8f0;
    --text-muted: #94a3b8;
    --border:     rgba(139,92,246,0.18);
    --glow-p:     rgba(108,63,255,0.35);

    background: #0a0818;
    overflow: hidden;
    position: relative;
  }

  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
    padding: 140px 60px 60px;
    position: relative;
    max-width: 1280px;
    margin: 0 auto;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: -80px;
    left: -100px;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(108,63,255,0.18) 0%, transparent 70%);
    pointer-events: none;
  }

  .hero::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(192,38,211,0.12) 0%, transparent 70%);
    pointer-events: none;
  }

  .hero-left {
    position: relative;
    z-index: 2;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    border: 1px solid var(--border);
    background: rgba(108,63,255,0.1);
    padding: 7px 14px;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--purple-lt);
    margin-bottom: 28px;
    text-transform: uppercase;
  }

  .eyebrow svg {
    width: 12px;
    height: 12px;
  }

  .hero-left h1 {
    font-size: clamp(2.4rem, 4.5vw, 3.8rem);
    font-weight: 900;
    line-height: 1.08;
    margin-bottom: 24px;
    color: var(--text);
  }

  .hero-left h1 .accent-web {
    color: var(--purple-lt);
  }

  .hero-left h1 .accent-apps {
    background: linear-gradient(90deg, var(--purple-lt), var(--pink-lt));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-sub {
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.7;
    max-width: 480px;
    margin-bottom: 36px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 48px;
  }

  .btn-cta {
    background: var(--purple);
    color: #fff;
    border: none;
    padding: 12px 24px;
    border-radius: 10px;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    transition: background 0.2s, box-shadow 0.2s;
    box-shadow: 0 0 20px var(--glow-p);
  }

  .btn-cta:hover {
    background: var(--purple-lt);
    box-shadow: 0 0 32px var(--glow-p);
  }

  .trust-badges {
    display: flex;
    gap: 32px;
    flex-wrap: wrap;
  }

  .badge {
    display: flex;
