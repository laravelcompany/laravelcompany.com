---
import { Image } from 'astro:assets';
import heroImage from '../assets/logo.svg';
---

<section class="pt-20 pb-16 md:pt-28 md:pb-24 overflow-hidden relative">
    <!-- Background grid -->
    <div class="absolute inset-0 opacity-5 parallax" data-speed="0.2">
        <div class="absolute inset-0 bg-repeat" style="background-image: url('/grid-pattern.svg');"></div>
    </div>

    <div class="container-custom relative">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            <!-- Left: Messaging -->
            <div>
                <h1 class="animate-on-scroll delay-0 text-4xl md:text-5xl lg:text-6xl font-bold leading-tight">
                    <span class="gradient-text">Laravel™ Company</span><br/> Solutions for You
                </h1>
                <p class="animate-on-scroll delay-1 mt-6 text-xl text-gray-600 max-w-lg">
                    Since 2004, our 100% employee-owned team has delivered ESOP-aligned technical solutions,
                    building <strong>equity platforms, succession systems, and enterprise-grade Laravel™ software</strong>
                    for Fortune 500 leaders.
                </p>
                <div class="animate-on-scroll delay-2 mt-8 flex flex-col sm:flex-row gap-4">
                    <a href="/contact" class="btn btn-primary">Talk to Us</a>
                </div>
                <div class="animate-on-scroll delay-3 mt-8 flex items-center space-x-4">
                    <div class="flex -space-x-2" role="img" aria-label="Client logos">
                        <img
                                src="/testimonial-avatar-3.jpg"
                                alt="BMW software"
                                class="w-10 h-10 rounded-full border-2 border-white bg-white p-1 transition-transform duration-300 hover:scale-110 hover:z-10"
                        />
                        <img
                                src="/testimonial-avatar-2.jpg"
                                alt="Amazon"
                                class="w-10 h-10 rounded-full border-2 border-white bg-white p-1 transition-transform duration-300 hover:scale-110 hover:z-10"
                        />
                        <img
                                src="/testimonial-avatar-1.jpg"
                                alt="Samsung"
                                class="w-10 h-10 rounded-full border-2 border-white bg-white p-1 transition-transform duration-300 hover:scale-110 hover:z-10"
                        />
                    </div>
                    <div class="text-sm text-gray-600">
                        Trusted by global enterprises
                    </div>
                </div>
            </div>

            <!-- Right: Hero Image -->
            <div class="animate-on-scroll delay-4">
                <div class="relative hover-zoom">
                    <div class="absolute -inset-0.5 bg-gradient-to-r from-purple-600 to-blue-500 rounded-xl blur opacity-30 transition-opacity duration-300 hover:opacity-50"></div>
                    <div class="relative bg-white rounded-xl shadow-xl overflow-hidden">
                        <Image
                                src={heroImage}
                                alt="Laravel™ Enterprise Solutions Dashboard"
                                class="w-full h-auto transition-all duration-500"
                                width={700}
                                height={500}
                        />
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
