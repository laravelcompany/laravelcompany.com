---
interface Props {
    title: string;
    highlightText?: string;
    subtitle?: string;
    description?: string;
    breadcrumbs?: { label: string; href?: string }[];
}

const { title, highlightText, subtitle, description, breadcrumbs } = Astro.props;
---

<section class="pt-20 pb-16 md:pt-28 md:pb-24 overflow-hidden relative">
    <!-- Background grid -->
    <div class="absolute inset-0 opacity-5">
        <div
            class="absolute inset-0 bg-repeat"
            style="background-image: url('/grid-pattern.svg');"
        >
        </div>
    </div>

    <div class="container-custom relative">
        {breadcrumbs && (
            <nav class="flex justify-center items-center gap-2 text-sm text-white/50 mb-8 animate-on-scroll">
                {breadcrumbs.map((crumb, index) => (
                    <>
                        <a href={crumb.href || "/"} class="hover:text-white transition-colors">{crumb.label}</a>
                        {index < breadcrumbs.length - 1 && <span>/</span>}
                    </>
                ))}
            </nav>
        )}
        <div class="max-w-4xl">
            <h1
                class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight text-white"
            >
                {
                    highlightText && (
                        <span class="text-payflo-purple">{highlightText}</span>
                    )
                }
                {highlightText && <br />}
                {title}
            </h1>
            {(subtitle || description) && (
                <p class="mt-6 text-xl text-gray-300 max-w-2xl">
                    {subtitle || description}
                </p>
            )}
        </div>
    </div>
</section>
