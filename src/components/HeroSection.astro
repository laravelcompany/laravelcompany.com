---
interface Props {
    title: string;
    highlightText?: string;
    description: string;
}

const { title, highlightText, description } = Astro.props;
---

<section
    class="pt-20 pb-16 md:pt-28 md:pb-24 overflow-hidden relative bg-white dark:bg-gray-900"
>
    <!-- Background grid -->
    <div class="absolute inset-0 opacity-5">
        <div
            class="absolute inset-0 bg-repeat"
            style="background-image: url('/grid-pattern.svg');"
        >
        </div>
    </div>

    <div class="container-custom relative">
        <div class="max-w-4xl">
            <h1
                class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight text-gray-900 dark:text-white"
            >
                {
                    highlightText && (
                        <span class="text-payflo-purple">{highlightText}</span>
                    )
                }
                {highlightText && <br />}
                {title}
            </h1>
            <p class="mt-6 text-xl text-gray-600 dark:text-gray-300 max-w-2xl">
                {description}
            </p>
        </div>
    </div>
</section>
