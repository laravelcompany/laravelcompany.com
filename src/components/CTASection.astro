<section class="py-32 relative overflow-hidden">
  <!-- Background blobs -->
  <div class="bg-blob blob-1 !opacity-20"></div>
  <div class="bg-blob blob-2 !opacity-20"></div>

  <div class="container-custom relative">
    <div class="max-w-4xl mx-auto text-center animate-on-scroll">
      <h2
        class="text-4xl md:text-5xl lg:text-6xl font-black text-white leading-tight"
      >
        Ready to add <span class="gradient-text">magic</span> to your platform?
      </h2>
      <p
        class="mt-8 text-xl md:text-2xl text-white/70 font-medium leading-relaxed"
      >
        Join the growing number of SaaS platforms using Laravel Agency to
        deliver world-class software solutions.
      </p>
      <div class="mt-12 flex flex-col sm:flex-row justify-center gap-6">
        <a href="/contact/" class="btn btn-primary !px-12 !py-5 text-xl">
          Book a Consultation
        </a>
      </div>
    </div>
  </div>
</section>
