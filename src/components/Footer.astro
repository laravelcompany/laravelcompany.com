---
import { Image } from "astro:assets";
import logoSrc from "../assets/logo.svg";
---

<footer class="bg-payflo-darker/60 backdrop-blur-2xl text-white relative overflow-hidden border-t border-white/10">
  <!-- Enhanced decorative background -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <div class="absolute -top-40 -right-40 w-80 h-80 bg-payflo-purple/10 rounded-full blur-3xl animate-pulse"></div>
    <div class="absolute -bottom-40 -left-40 w-80 h-80 bg-blue-500/10 rounded-full blur-3xl animate-pulse delay-1000"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full h-px bg-gradient-to-r from-transparent via-payflo-purple/30 to-transparent"></div>
  </div>

  <div class="container-custom relative z-10">
    <!-- Main Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 py-16 border-b border-white/10">
      
      <!-- Brand Column (spans 4 cols on large) -->
      <div class="lg:col-span-4 space-y-6">
        <a href="/" class="inline-block transition-transform duration-300 hover:scale-105 focus:scale-105 focus:outline-none focus:ring-2 focus:ring-payflo-purple/50 rounded-lg" aria-label="Laravel Company home">
          <Image src={logoSrc} alt="Laravel Company Logo" width={140} height={46} class="transition-opacity hover:opacity-90" />
        </a>
        
        <p class="text-white/60 leading-relaxed max-w-md">
          Delivering <a href="https://laravelcompany.com" class="text-white hover:text-payflo-purple font-semibold transition-colors underline-offset-4 hover:underline">premier software solutions</a> with Laravel-powered automation, ecommerce, and AI platforms.
        </p>

        <!-- Social Links -->
        <div class="flex items-center gap-3">
          <a href="https://www.linkedin.com/company/laravel-company-official/" target="_blank" rel="noopener noreferrer" class="group w-10 h-10 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-white/50 hover:text-white hover:bg-payflo-purple hover:border-payflo-purple transition-all duration-300" aria-label="LinkedIn">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
          </a>
          <a href="https://github.com/laravelcompany" target="_blank" rel="noopener noreferrer" class="group w-10 h-10 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-white/50 hover:text-white hover:bg-payflo-purple hover:border-payflo-purple transition-all duration-300" aria-label="GitHub">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/></svg>
          </a>
          <a href="https://clutch.co/profile/laravel-company" target="_blank" rel="noopener noreferrer" class="group w-10 h-10 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-white/50 hover:text-white hover:bg-payflo-purple hover:border-payflo-purple transition-all duration-300" aria-label="Clutch">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.36z"/></svg>
          </a>
        </div>
      </div>

      <!-- Navigation Columns (8 cols on large, split into 4 groups) -->
      <div class="lg:col-span-8 grid grid-cols-2 md:grid-cols-4 gap-8">
        
        <!-- Company -->
        <div class="space-y-4">
          <h3 class="text-xs font-black uppercase tracking-widest text-payflo-purple/80">Company</h3>
          <ul class="space-y-2.5">
            <li><a href="/about-us/" class="group flex items-center gap-2 text-white/60 hover:text-white transition-colors duration-200"><span class="w-1.5 h-1.5 rounded-full bg-payflo-purple/0 group-hover:bg-payflo-purple transition-colors"></span>About Us</a></li>
            <li><a href="/team/" class="group flex items-center gap-2 text-white/60 hover:text-white transition-colors duration-200"><span class="w-1.5 h-1.5 rounded-full bg-payflo-purple/0 group-hover:bg-payflo-purple transition-colors"></span>Team</a></li>
            <li><a href="/esop/" class="group flex items-center gap-2 text-white/60 hover:text-white transition-colors duration-200"><span class="w-1.5 h-1.5 rounded-full bg-payflo-purple/0 group-hover:bg-payflo-purple transition-colors"></span>ESOP</a></li>
            <li><a href="/jobs/" class="group flex items-center gap-2 text-white/60 hover:text-white transition-colors duration-200"><span class="w-1.5 h-1.5 rounded-full bg-payflo-purple/0 group-hover:bg-payflo-purple transition-colors"></span>Careers</a></li>
            <li><a href="/contact/" class="group flex items-center gap-2 text-white/60 hover:text-white transition-colors duration-200"><span class="w-1.5 h-1.5 rounded-full bg-payflo-purple/0 group-hover:bg-payflo-purple transition-colors"></span>Contact</a></li>
          </ul>
        </div>

        <!-- Services -->
        <div class="space-y-4">
          <h3 class="text-xs font-black uppercase tracking-widest text-payflo-purple/80">Services</h3>
          <ul class="space-y-2.5">
            <li><a href="/software-development-agency-london/" class="group flex items-center gap-2 text-white/60 hover:text-white transition-colors duration-200"><span class="w-1.5 h-1.5 rounded-full bg-payflo-purple/0 group-hover:bg-payflo-purple transition-colors"></span>Bespoke London</a></li>
            <li><a href="/hire-aws-consultant/" class="group flex items-center gap-2 text-white/60 hover:text-white transition-colors duration-200"><span class="w-1.5 h-1.5 rounded-full bg-payflo-purple/0 group-hover:bg-payflo-purple transition-colors"></span>AWS Consulting</a></li>
            <li><a href="/laravel-consulting/" class="group flex items-center gap-2 text-white/60 hover:text-white transition-colors duration-200"><span class="w-1.5 h-1.5 rounded-full bg-payflo-purple/0 group-hover:bg-payflo-purple transition-colors"></span>Laravel Experts</a></li>
            <li><a href="/magento-agency-london/" class="group flex items-center gap-2 text-white/60 hover:text-white transition-colors duration-200"><span class="w-1.5 h-1.5 rounded-full bg-payflo-purple/0 group-hover:bg-payflo-purple transition-colors"></span>Magento Agency</a></li>
            <li><a href="/locations/" class="group flex items-center gap-2 text-white/60 hover:text-white transition-colors duration-200"><span class="w-1.5 h-1.5 rounded-full bg-payflo-purple/0 group-hover:bg-payflo-purple transition-colors"></span>Locations</a></li>
          </ul>
        </div>

        <!-- Products -->
        <div class="space-y-4">
          <h3 class="text-xs font-black uppercase tracking-widest text-payflo-purple/80">Products</h3>
          <ul class="space-y-2.5">
            <li><a href="/software/laravel-seo/" class="group flex items-center gap-2 text-white/60 hover:text-white transition-colors duration-200"><span class="w-1.5 h-1.5 rounded-full bg-payflo-purple/0 group-hover:bg-payflo-purple transition-colors"></span>Laravel SEO</a></li>
            <li><a href="/software/laravel-mail/" class="group flex items-center gap-2 text-white/60 hover:text-white transition-colors duration-200"><span class="w-1.5 h-1.5 rounded-full bg-payflo-purple/0 group-hover:bg-payflo-purple transition-colors"></span>Laravel Mail</a></li>
            <li><a href="/software/laravel-gpt/" class="group flex items-center gap-2 text-white/60 hover:text-white transition-colors duration-200"><span class="w-1.5 h-1.5 rounded-full bg-payflo-purple/0 group-hover:bg-payflo-purple transition-colors"></span>Laravel GPT</a></li>
            <li><a href="/software/laravel-ui/" class="group flex items-center gap-2 text-white/60 hover:text-white transition-colors duration-200"><span class="w-1.5 h-1.5 rounded-full bg-payflo-purple/0 group-hover:bg-payflo-purple transition-colors"></span>Laravel UI</a></li>
          </ul>
        </div>

        <!-- Compliance & Resources -->
        <div class="space-y-4">
          <h3 class="text-xs font-black uppercase tracking-widest text-payflo-purple/80">Trust</h3>
          <ul class="space-y-2.5">
            <li><a href="/nis2-essential-entity-provider/" class="group flex items-center gap-2 text-white/60 hover:text-white transition-colors duration-200"><span class="w-1.5 h-1.5 rounded-full bg-payflo-purple/0 group-hover:bg-payflo-purple transition-colors"></span>NIS2 Compliance</a></li>
            <li><a href="/cra-compliant-software-vendor/" class="group flex items-center gap-2 text-white/60 hover:text-white transition-colors duration-200"><span class="w-1.5 h-1.5 rounded-full bg-payflo-purple/0 group-hover:bg-payflo-purple transition-colors"></span>CRA Certified</a></li>
            <li><a href="/gdpr-europrise-certified/" class="group flex items-center gap-2 text-white/60 hover:text-white transition-colors duration-200"><span class="w-1.5 h-1.5 rounded-full bg-payflo-purple/0 group-hover:bg-payflo-purple transition-colors"></span>GDPR Compliant</a></li>
            <li><a href="/funny-docs/" class="group flex items-center gap-2 text-white/60 hover:text-white transition-colors duration-200"><span class="w-1.5 h-1.5 rounded-full bg-payflo-purple/0 group-hover:bg-payflo-purple transition-colors"></span>😄 Funny Docs</a></li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="py-8 flex flex-col lg:flex-row justify-between items-center gap-6">
      <!-- Copyright -->
      <p class="text-white/50 text-sm text-center lg:text-left">
        © 2026 Laravel Company. Crafted with <span class="text-red-400">❤️</span> in London & EU.
      </p>

      <!-- Legal & Utility Links -->
      <div class="flex flex-wrap justify-center gap-x-8 gap-y-3 text-sm">
        <a href="/privacy-policy/" class="text-white/50 hover:text-white transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-payflo-purple/50 rounded px-1">Privacy Policy</a>
        <a href="/cookie-policy/" class="text-white/50 hover:text-white transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-payflo-purple/50 rounded px-1">Cookie Policy</a>
        <a href="/terms-of-use/" class="text-white/50 hover:text-white transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-payflo-purple/50 rounded px-1">Terms of Service</a>
      </div>

      <!-- Back to Top Button -->
      <button onclick="window.scrollTo({top: 0, behavior: 'smooth'})" 
              class="group flex items-center gap-2 text-white/50 hover:text-white transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-payflo-purple/50 rounded-lg px-3 py-1.5 hover:bg-white/5"
              aria-label="Back to top">
        <svg class="w-4 h-4 transition-transform group-hover:-translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path></svg>
        <span class="text-sm font-medium">Top</span>
      </button>
    </div>

    <!-- Trust Badges -->
    <div class="pt-8 pb-4 flex flex-wrap justify-center gap-6 opacity-60 hover:opacity-100 transition-opacity">
      <span class="text-xs text-white/40 flex items-center gap-2">
        <svg class="w-4 h-4 text-green-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
        ISO 27001 Certified
      </span>
      <span class="text-xs text-white/40 flex items-center gap-2">
        <svg class="w-4 h-4 text-blue-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
        EU Data Sovereign
      </span>
      <span class="text-xs text-white/40 flex items-center gap-2">
        <svg class="w-4 h-4 text-purple-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
        Laravel Partner
      </span>
    </div>
  </div>
</footer>