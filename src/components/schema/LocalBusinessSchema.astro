---
interface Props {
  city: string;
  country: string;
  region?: string;
  coordinates: { lat: number; lng: number };
  telephone?: string;
  serviceAreas: string[];
  priceRange?: string;
  image?: string;
}

const {
  city,
  country,
  region,
  coordinates,
  telephone = '+44 744 821 88 99',
  serviceAreas,
  priceRange = '$$',
  image,
} = Astro.props;
---

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": `https://laravelcompany.com#local-${city.toLowerCase().replace(/\s+/g, '-')}`,
  "name": `Laravel Company - Laravel Development in ${city}`,
  "description": `Top-rated Laravel development company serving ${city}, ${country}. Custom web applications, SaaS platforms, and enterprise solutions.`,
  "url": `https://laravelcompany.com/services/laravel-development-company-in-${city.toLowerCase().replace(/\s+/g, '-')}/`,
  "image": image || "https://laravelcompany.com/logo.svg",
  "telephone": telephone,
  "priceRange": priceRange,
  "address": {
    "@type": "PostalAddress",
    "addressLocality": city,
    "addressRegion": region || country,
    "addressCountry": country
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": coordinates.lat,
    "longitude": coordinates.lng
  },
  "areaServed": serviceAreas.map(area => ({
    "@type": "City",
    "name": area
  })),
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "127"
  },
  "openingHoursSpecification": [
    { "@type": "OpeningHoursSpecification", "dayOfWeek": "Monday", "opens": "09:00", "closes": "18:00" },
    { "@type": "OpeningHoursSpecification", "dayOfWeek": "Tuesday", "opens": "09:00", "closes": "18:00" },
    { "@type": "OpeningHoursSpecification", "dayOfWeek": "Wednesday", "opens": "09:00", "closes": "18:00" },
    { "@type": "OpeningHoursSpecification", "dayOfWeek": "Thursday", "opens": "09:00", "closes": "18:00" },
    { "@type": "OpeningHoursSpecification", "dayOfWeek": "Friday", "opens": "09:00", "closes": "17:00" }
  ],
  "sameAs": [
    "https://twitter.com/laravelcompany",
    "https://github.com/laravelcompany",
    "https://linkedin.com/company/laravelcompany",
    "https://www.facebook.com/laravelcompany/"
  ],
  "foundingDate": "2020"
})} />
