---
/**
 * Schema.org Book JSON-LD, built only from fields that actually exist.
 */
import { buildBookJsonLd } from "../../../functions/_lib/openLibrary.js";
import type { Book } from "../../utils/booksCache";

interface Props {
    book: Book;
}

const { book } = Astro.props;
const pageUrl = new URL(`/books/${book.slug}/`, Astro.site ?? "https://laravelcompany.com").href;
const jsonLd = buildBookJsonLd(book, pageUrl);
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
