---
import { Icon } from 'astro-icon/components';

const highlights = [
  {
    number: "01",
    title: "Speed & Agility",
    description: "Low-code/no-code platforms enable rapid application development in days, not months."
  },
  {
    number: "02", 
    title: "AI-Powered Automation",
    description: "87% of developers using gen AI report greater focus on meaningful work."
  },
  {
    number: "03",
    title: "Embedded Security",
    description: "Security must be woven into every stage of development, not treated as an afterthought."
  },
  {
    number: "04",
    title: "Observability",
    description: "Modern monitoring with AI helps reduce alert noise from 13,000 to under 1,000 per day."
  }
];

const sponsors = [
  "AWS",
  "LogicMonitor", 
  "Quickbase",
  "SmartBear",
  "Sonatype"
];
---

<section class="py-24 relative overflow-hidden bg-gradient-to-b from-payflo-dark/50 to-payflo-dark">
  <div class="absolute inset-0 bg-grid-white/5 -z-10"></div>
  
  <div class="container-custom">
    <!-- Section Header -->
    <div class="text-center max-w-4xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-payflo-purple/20 border border-payflo-purple/30 text-payflo-purple text-sm font-bold uppercase tracking-widest mb-6">
        <Icon name="ph:file-text-duotone" class="h-5 w-5" />
        White Paper
      </div>
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-black text-white leading-tight">
        Embracing Modern Software Development <span class="gradient-text">Practices in the AI Era</span>
      </h2>
      <p class="mt-6 text-xl text-white/70 leading-relaxed">
        Research-backed insights from Harvard Business Review Analytic Services on how enterprises can accelerate software delivery while ensuring quality, security, and governance.
      </p>
    </div>

    <!-- Four Pillars Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
      {highlights.map((item, index) => (
        <div class="group p-8 rounded-2xl bg-white/5 border border-white/10 hover:border-payflo-purple/50 transition-all duration-300 hover:bg-white/10">
          <span class="text-5xl font-black text-payflo-purple/30 group-hover:text-payflo-purple transition-colors">
            {item.number}
          </span>
          <h3 class="mt-4 text-xl font-black text-white">{item.title}</h3>
          <p class="mt-3 text-white/60 leading-relaxed text-sm">
            {item.description}
          </p>
        </div>
      ))}
    </div>

    <!-- Quote & Sponsors -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div class="relative">
        <div class="absolute -inset-4 bg-gradient-to-r from-payflo-purple to-payflo-pink rounded-2xl blur-2xl opacity-20"></div>
        <blockquote class="relative glass-card p-8 border-white/20">
          <Icon name="ph:quotes-duotone" class="h-12 w-12 text-payflo-purple mb-4" />
          <p class="text-xl text-white/80 leading-relaxed italic">
            "Without modern software practices, you simply can't keep up with the velocity and complexity of change while maintaining the quality you need."
          </p>
          <footer class="mt-6 flex items-center gap-4">
            <div class="h-px flex-1 bg-white/20"></div>
            <span class="text-white/60 font-medium">Adam Burden, Global Innovation Lead, Accenture</span>
          </footer>
        </blockquote>
      </div>

      <div>
        <h3 class="text-2xl font-black text-white mb-6">Sponsored by</h3>
        <div class="flex flex-wrap gap-4">
          {sponsors.map((sponsor) => (
            <span class="px-6 py-3 rounded-lg bg-white/5 border border-white/10 text-white/70 font-semibold text-sm">
              {sponsor}
            </span>
          ))}
        </div>
        
        <div class="mt-10">
          <a href="https://hbr.org/hbr-analytic-services" target="_blank" rel="noopener noreferrer" class="btn btn-secondary group">
            <Icon name="ph:arrow-square-out-duotone" class="h-5 w-5" />
            Download Full White Paper
            <Icon name="ph:arrow-right" class="h-4 w-4 group-hover:translate-x-1 transition-transform" />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>