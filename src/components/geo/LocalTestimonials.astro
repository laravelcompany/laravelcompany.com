---
interface Props {
  location?: string;
}

const { location } = Astro.props;

const testimonials = [
  {
    quote: "Their Laravel expertise is unmatched. Our custom CRM was delivered ahead of schedule, fully optimized, and easier to use than we imagined.",
    author: "Daniel Roberts",
    role: "Founder at Summit Logistics",
  },
  {
    quote: "We received a free consultation and quote within hours. The team guided us through every stage of development, from planning to deployment.",
    author: "Alicia Gomez",
    role: "Operations Manager at Nova Retail",
  },
  {
    quote: "Their free hosting offer saved us thousands during launch. The Laravel application they built for us scales effortlessly and runs like a dream.",
    author: "Michael Lee",
    role: "CEO at BrightSoft",
  },
];
---

<section class="py-24 relative overflow-hidden">
  <div class="absolute top-1/2 left-0 w-80 h-80 bg-payflo-purple/10 blur-[100px] rounded-full -z-10"></div>
  <div class="absolute top-0 right-0 w-80 h-80 bg-payflo-pink/10 blur-[100px] rounded-full -z-10"></div>
  <div class="container-custom relative">
    <div class="text-center max-w-3xl mx-auto animate-on-scroll">
      <h2 class="text-4xl md:text-5xl font-black text-white leading-tight">
        Trusted by businesses that demand <span class="gradient-text">quality software</span>
      </h2>
      <p class="mt-6 text-xl text-white/70 font-medium">
        {location
          ? `Hear from clients in ${location} and beyond who built their platforms with our Laravel development services.`
          : 'Hear from clients who built their platforms with our Laravel development services.'}
      </p>
    </div>
    <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-8">
      {testimonials.map((t, i) => (
        <div class="testimonial-card animate-on-scroll group" style={`animation-delay: ${i * 0.15}s`}>
          <div class="flex items-center mb-6">
            <div>
              <h6 class="font-black text-white text-lg transition-colors duration-300 group-hover:text-payflo-purple">{t.author}</h6>
              <p class="text-sm text-white/50 font-bold uppercase tracking-wider">{t.role}</p>
            </div>
          </div>
          <p class="text-white/80 italic relative font-medium leading-relaxed">
            <span class="absolute -top-4 -left-2 text-6xl text-payflo-purple opacity-20 transition-all duration-300 group-hover:opacity-40 group-hover:scale-110 font-serif">"</span>
            {t.quote}
            <span class="absolute -bottom-6 -right-2 text-6xl text-payflo-pink opacity-20 transition-all duration-300 group-hover:opacity-40 group-hover:scale-110 font-serif">"</span>
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
