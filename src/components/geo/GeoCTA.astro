---
import { Icon } from "astro-icon/components";

interface Props {
  location?: string;
  modifier?: string;
}

const { location, modifier } = Astro.props;

const heading = modifier
  ? `Ready for ${modifier} Laravel Development?`
  : location
    ? `Ready to Start Your Laravel Project in ${location}?`
    : 'Ready to Start Your Laravel Project?';

const description = modifier
  ? `Our ${modifier} Laravel development team is ready to discuss your project requirements and provide a detailed proposal.`
  : location
    ? `Our Laravel experts in ${location} are ready to discuss your custom web application requirements and provide detailed project estimates.`
    : 'Our Laravel development experts are ready to discuss your custom web application requirements and provide detailed project estimates.';
---

<section class="py-32 relative overflow-hidden">
  <div class="bg-blob blob-1 !opacity-20"></div>
  <div class="bg-blob blob-2 !opacity-20"></div>
  <div class="container-custom relative">
    <div class="glass-card py-16 px-10 border-white/20 max-w-4xl mx-auto relative overflow-hidden text-center">
      <div class="relative">
        <h2 class="text-3xl lg:text-4xl font-black text-white mb-6">
          {heading.split(/(Laravel|Development)/).map((part, i) =>
            part === 'Laravel' || part === 'Development'
              ? <span class="gradient-text tracking-tighter">{part}</span>
              : <span>{part}</span>
          )}
        </h2>
        <p class="text-white/70 text-lg lg:text-xl mb-10 max-w-2xl mx-auto leading-relaxed font-medium">
          {description}
        </p>
        <div class="flex flex-col sm:flex-row gap-4 lg:gap-6 justify-center mb-10">
          <a href="/contact/" class="btn btn-primary !px-12 !py-5 text-xl">
            Schedule Free Consultation
          </a>
          <a href="tel:+447448218899" class="btn glass-card border-white/20 !px-12 !py-5 text-xl hover:bg-white/10 transition-all font-bold">
            <Icon name="ph:phone-duotone" class="w-5 h-5" /> Call Us
          </a>
        </div>
        <div class="pt-8 border-t border-white/10">
          <div class="flex flex-col lg:flex-row justify-center gap-12 text-white/50 font-black uppercase tracking-widest text-xs">
            <span class="flex items-center gap-3"><Icon name="ph:envelope-simple-duotone" class="w-4 h-4" /> info@laravelcompany.com</span>
            <span class="flex items-center gap-3"><Icon name="ph:lightning-duotone" class="w-4 h-4 text-yellow-400" /> Fast Response</span>
            <span class="flex items-center gap-3"><Icon name="ph:currency-circle-dollar-duotone" class="w-4 h-4 text-green-400" /> Free Estimation</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
