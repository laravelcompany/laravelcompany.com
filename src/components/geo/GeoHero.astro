---
import { Icon } from "astro-icon/components";

interface Props {
  title: string;
  description: string;
  breadcrumbs: { label: string; href?: string }[];
  location?: string;
  areas?: string[];
  rating?: string;
}

const { title, description, breadcrumbs, location, areas, rating = '4.9' } = Astro.props;
---

<section class="pt-20 pb-16 md:pt-28 md:pb-24 overflow-hidden relative">
  <div class="absolute inset-0 opacity-5">
    <div class="absolute inset-0 bg-repeat" style="background-image: url('/grid-pattern.svg');"></div>
  </div>
  <div class="container-custom relative">
    <nav class="flex justify-center items-center gap-2 text-sm text-white/50 mb-8 animate-on-scroll">
      {breadcrumbs.map((crumb, i) => (
        <>
          {crumb.href ? (
            <a href={crumb.href} class="hover:text-white transition-colors">{crumb.label}</a>
          ) : (
            <span class="text-white">{crumb.label}</span>
          )}
          {i < breadcrumbs.length - 1 && <span>/</span>}
        </>
      ))}
    </nav>
    <div class="max-w-4xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-payflo-purple/10 border border-payflo-purple/20 mb-8 animate-on-scroll">
        <Icon name="ph:buildings-duotone" class="w-5 h-5 text-payflo-purple" />
        <span class="text-sm font-bold uppercase tracking-widest text-white/70">
          {location ? `Laravel Agency in ${location}` : 'Laravel Agency'}
        </span>
      </div>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight text-white">
        {title}
      </h1>
      <p class="animate-on-scroll delay-2 mt-6 text-xl text-gray-300 max-w-2xl mx-auto">
        {description}
      </p>
      <div class="animate-on-scroll delay-3 mt-10 flex flex-wrap justify-center gap-6">
        <a href="/contact/" class="btn btn-primary !px-10 !py-5 text-lg shadow-2xl">Get Free Quote</a>
        <a href="/hire-laravel-developer/" class="btn glass-card border-white/20 !px-10 !py-5 text-lg hover:bg-white/10 transition-all font-bold">Hire Developer</a>
      </div>
      <div class="animate-on-scroll delay-4 mt-10 flex flex-wrap justify-center gap-8 text-sm text-white/60 font-bold uppercase tracking-widest">
        <span class="flex items-center gap-2"><Icon name="ph:star-fill" class="w-4 h-4 text-yellow-400" /> {rating}/5 Rating</span>
        <span class="flex items-center gap-2"><Icon name="ph:check-circle-fill" class="w-4 h-4 text-green-400" /> 500+ Projects</span>
        {areas && areas.length > 0 && (
          <span class="flex items-center gap-2"><Icon name="ph:map-pin-fill" class="w-4 h-4 text-payflo-purple" /> {areas.slice(0, 3).join(', ')}</span>
        )}
      </div>
    </div>
  </div>
</section>
