---
const steps = [
  { number: '01', label: 'DISCOVER', title: 'Research & Analysis', description: 'We dig into your domain before touching any code. New project or legacy application, we find the right problem to solve.' },
  { number: '02', label: 'ENGINEER', title: 'Build a Strong Foundation', description: "A Laravel codebase built for the long haul: clear structure, automated tests, and sensible abstractions that don't fight you when requirements change." },
  { number: '03', label: 'EVOLVE', title: 'Flexible Development', description: 'Short cycles. Frequent check-ins. Priorities can shift, so you always get the most valuable thing next.' },
];
const tiles = [
  { name: 'Laravel', detail: 'APPLICATION', glyph: 'L', x: -135, y: -95, angle: -14, cls: 'tile-laravel' },
  { name: 'API', detail: 'CONNECTED', glyph: '{ }', x: 145, y: -100, angle: 12, cls: 'tile-api' },
  { name: 'Database', detail: 'STRUCTURED', glyph: '≡', x: -155, y: 80, angle: -10, cls: 'tile-database' },
  { name: 'Tests', detail: 'CONFIDENT', glyph: '✓', x: 145, y: 110, angle: 15, cls: 'tile-tests' },
];
---
<section id="how-we-work" data-process class="process-section" aria-labelledby="process-heading">
  <div class="process-sticky container-custom">
    <header class="process-header">
      <p class="process-eyebrow"><span></span> FROM FIRST QUESTION TO WHAT'S NEXT</p>
      <h2 id="process-heading">How we <span class="gradient-text">work.</span></h2>
      <p class="process-intro">Good software doesn't happen in one leap.<br />We bring the pieces together.</p>
    </header>
    <div class="process-grid">
      <div class="process-steps">
        {steps.map(step => (
          <article data-process-step class="process-step">
            <span class="step-number">{step.number}</span>
            <div><p class="step-label">{step.label}</p><h3>{step.title}</h3><p class="step-description">{step.description}</p></div>
          </article>
        ))}
      </div>
      <div class="process-visual" aria-hidden="true">
        <div class="scene-grid"></div><div class="scene-orbit orbit-one"></div><div class="scene-orbit orbit-two"></div>
        <div class="app-shell">
          <div class="app-toolbar"><span></span><span></span><span></span><b>your-next-application</b><i>● LIVE</i></div>
          <div class="app-sidebar"><span></span><span></span><span></span><span></span></div>
          <div class="app-title">Built to move forward.</div>
          <div class="app-subtitle">One connected system. Room to grow.</div>
          <div class="app-deploy"><span>↗</span> Deploy & iterate <b>READY</b></div>
        </div>
        {tiles.map(tile => (
          <div data-process-tile class={`process-tile ${tile.cls}`} style={`--dx:${tile.x}px;--dy:${tile.y}px;--angle:${tile.angle}deg`}>
            <span class="tile-icon">{tile.glyph}</span><div><small>{tile.detail}</small><strong>{tile.name}</strong></div><span class="tile-check">✓</span>
          </div>
        ))}
        <div class="scene-caption"><span class="caption-dot"></span><span data-process-stage>Ready for what comes next.</span><span class="caption-index">03 / 03</span></div>
      </div>
    </div>
    <footer class="process-footer"><span class="scroll-cue">SCROLL TO CONNECT THE PIECES <span>↓</span></span><a href="/contact/" class="process-cta">Brief us your project <span>↗</span></a></footer>
    <div class="process-track" aria-hidden="true"><span></span></div>
  </div>
</section>
<script>import '../scripts/process-scroll.js';</script>
<style>
  .process-section{scroll-margin-top:100px;position:relative;overflow:clip;background:#0b0915;color:#fff;padding:100px 0;isolation:isolate}
  .process-section:before{content:'';position:absolute;inset:0;z-index:-1;background:radial-gradient(ellipse at 80% 45%,#7c3aed13,transparent 60%);pointer-events:none}
  .process-header{display:grid;grid-template-columns:1fr 1fr;align-items:end;gap:12px 40px;margin-bottom:45px}
  .process-eyebrow{grid-column:1/-1;color:#b7a8d3;font-size:10px;font-weight:700;letter-spacing:.18em;display:flex;align-items:center;gap:10px}
  .process-eyebrow span{width:6px;height:6px;background:#bb80ff;border-radius:50%}
  h2{font-size:clamp(42px,5.2vw,76px);font-weight:900;letter-spacing:-.045em;line-height:1.04;margin:0}
  .process-intro{font-size:16px;color:#a6a0b6;line-height:1.7;justify-self:end;margin:0}
  .process-grid{display:grid;grid-template-columns:1fr 1.25fr;gap:60px;align-items:center}
  .process-steps{display:grid;gap:10px}
  .process-step{display:flex;gap:18px;padding:19px 0;border-top:1px solid #ffffff18;transition:opacity .35s}
  .step-number{font:12px ui-monospace,monospace;color:#b68ef4;padding-top:4px}
  .step-label{font-size:9px;letter-spacing:.2em;color:#b78fea;font-weight:700;margin:0 0 6px}
  h3{font-size:21px;line-height:1.2;font-weight:700;letter-spacing:-.02em;margin:0 0 9px}
  .step-description{font-size:13px;line-height:1.65;color:#a8a1b8;margin:0;max-width:375px}
  .process-visual{height:420px;position:relative;perspective:1000px}
  .scene-grid{position:absolute;inset:-10px;background-image:linear-gradient(#ffffff04 1px,transparent 1px),linear-gradient(90deg,#ffffff04 1px,transparent 1px);background-size:32px 32px;mask-image:radial-gradient(ellipse,#000,transparent 70%)}
  .scene-orbit{position:absolute;border:1px solid #b388ff16;border-radius:50%;left:50%;top:45%;transform:translate(-50%,-50%) rotate(-20deg);width:470px;height:280px}
  .orbit-two{width:550px;height:360px;transform:translate(-50%,-50%) rotate(22deg)}
  .app-shell{position:absolute;inset:24px 3% 45px;border:1px solid #b885ff45;border-radius:16px;background:linear-gradient(135deg,#211831ec,#13101fee);box-shadow:0 25px 80px #0006;overflow:hidden}
  .app-toolbar{height:35px;display:flex;gap:5px;align-items:center;border-bottom:1px solid #ffffff10;padding:0 12px}
  .app-toolbar>span{width:5px;height:5px;border-radius:50%;background:#78668d}
  .app-toolbar b{font:9px ui-monospace,monospace;color:#a69ab9;margin-left:9px}.app-toolbar i{font:8px ui-monospace,monospace;color:#9cdcbd;margin-left:auto}
  .app-sidebar{position:absolute;left:0;top:35px;bottom:0;width:34px;border-right:1px solid #ffffff10;display:grid;align-content:start;justify-content:center;gap:16px;padding-top:20px}
  .app-sidebar span{width:9px;height:9px;border:1px solid #8c73ac;border-radius:3px}
  .app-title{position:absolute;left:54px;top:57px;font-size:16px;font-weight:700;letter-spacing:-.03em}
  .app-subtitle{position:absolute;left:54px;top:82px;font-size:9px;color:#a59ab4}
  .process-tile{--scatter:0;position:absolute;width:38%;height:74px;display:flex;align-items:center;gap:10px;padding:12px;border:1px solid #a784dd40;border-radius:10px;background:linear-gradient(120deg,#30233e,#1b1627);box-shadow:0 8px 20px #0003;transform:translate(calc(var(--dx)*var(--scatter)),calc(var(--dy)*var(--scatter))) rotate(calc(var(--angle)*var(--scatter)));will-change:auto}
  .tile-laravel{left:14%;top:32%}.tile-api{left:55%;top:32%}.tile-database{left:14%;top:53%}.tile-tests{left:55%;top:53%}
  .tile-icon{white-space:nowrap;font:700 19px ui-monospace,monospace;color:#d5b9ff;background:#a56bec18;border:1px solid #c69aff20;width:34px;height:34px;border-radius:8px;display:grid;place-items:center;flex-shrink:0}
  .tile-api .tile-icon{color:#efa7d0}.tile-tests .tile-icon{color:#9dddbe}.process-tile small{display:block;color:#9989ae;font-size:7px;letter-spacing:.1em}.process-tile strong{display:block;font-size:13px;margin-top:4px;font-weight:600}.tile-check{color:#a1dabc;font-size:9px;margin-left:auto}
  .app-deploy{position:absolute;left:54px;right:20px;bottom:21px;display:flex;align-items:center;gap:8px;font-size:10px;color:#c3b2d9}.app-deploy>span{color:#d79bff}.app-deploy b{margin-left:auto;color:#a6d9bc;font-size:7px;letter-spacing:.1em}
  .scene-caption{position:absolute;bottom:7px;left:5%;right:5%;display:flex;align-items:center;gap:8px;font-size:10px;color:#bdafcd}.caption-dot{width:5px;height:5px;background:#be81ff;border-radius:50%}.caption-index{margin-left:auto;font:9px ui-monospace,monospace;color:#7b6c90}
  .process-footer{display:flex;align-items:center;justify-content:space-between;border-top:1px solid #ffffff13;margin-top:26px;padding-top:20px}.scroll-cue{font-size:8px;letter-spacing:.16em;color:#8d809e;display:none}.scroll-cue>span{color:#c39ae9;margin-left:15px}.process-cta{font-size:13px;color:#ece1fc;text-decoration:none;display:flex;gap:26px;align-items:center}.process-cta:hover{color:#eaa8e3}.process-cta:focus-visible{outline:2px solid #cd95ff;outline-offset:8px}.process-track{display:none}
  @media(min-width:1024px) and (min-height:700px) and (prefers-reduced-motion:no-preference){.process-enhanced{height:260vh;padding:0}.process-enhanced .process-sticky{position:sticky;top:0;min-height:100vh;display:flex;flex-direction:column;justify-content:center;padding-top:45px;padding-bottom:35px}.process-enhanced .process-step{opacity:.8}.process-enhanced .process-step.is-current{opacity:1}.process-enhanced .process-step.is-current .step-number{color:#e8c3ff}.process-enhanced .scroll-cue{display:block}.process-enhanced .process-track{display:block;height:2px;background:#ffffff0b;margin-top:22px;overflow:hidden}.process-track>span{display:block;height:100%;background:linear-gradient(90deg,#9a6af0,#ef9ad0);transform-origin:left;transform:scaleX(var(--process-progress,0))}}
  @media(max-width:1100px){.process-grid{gap:25px}.process-tile{padding:8px;gap:6px}.process-tile strong{font-size:11px}}
  @media(max-width:1023px){.process-section{padding:70px 0}.process-header{margin-bottom:30px}.process-grid{grid-template-columns:1fr}.process-steps{grid-template-columns:repeat(3,1fr);gap:22px}.process-step{gap:10px}h3{font-size:18px}.process-visual{max-width:580px;width:100%;margin:12px auto 0}.scene-orbit{max-width:100%}.orbit-two{max-width:100%}.process-footer{justify-content:flex-end}}
  @media(max-width:639px){.process-header{display:block}.process-eyebrow{font-size:8px;margin-bottom:18px}.process-intro{margin-top:20px;font-size:14px}.process-steps{grid-template-columns:1fr;gap:6px}.process-step{gap:17px;padding:20px 0}.step-description{font-size:14px;max-width:none}h3{font-size:22px}.process-visual{height:310px}.app-shell{inset:10px 0 35px}.app-toolbar b{font-size:7px}.app-title{font-size:13px;left:45px;top:53px}.app-subtitle{left:45px;font-size:7px;top:74px}.process-tile{height:57px;width:39%;padding:6px;gap:5px}.tile-laravel{left:14%;top:33%}.tile-api{left:55%;top:33%}.tile-database{left:14%;top:53%}.tile-tests{left:55%;top:53%}.tile-icon{width:25px;height:25px;font-size:14px}.process-tile strong{font-size:10px}.process-tile small{font-size:5px}.app-deploy{left:45px;bottom:17px;font-size:9px}.scene-caption{font-size:8px;left:2%;right:2%}.caption-index{font-size:7px}.process-footer{margin-top:12px}.scene-orbit{height:200px}.orbit-two{height:250px}}
  @media(prefers-reduced-motion:reduce){.process-step{transition:none}.scroll-cue{display:none}}
</style>
