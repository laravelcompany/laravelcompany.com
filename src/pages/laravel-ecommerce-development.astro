---
import Layout from "../layouts/Layout.astro";
import CTASection from "../components/CTASection.astro";
import { Icon } from "astro-icon/components";

const features = [
  {
    title: "Custom Cart & Checkout",
    desc: "Tailor-made shopping cart, one-page checkout, abandoned cart recovery, and guest checkout.",
    icon: "ph:shopping-cart-duotone"
  },
  {
    title: "Inventory Management",
    desc: "Real-time stock tracking, multi-warehouse support, low-stock alerts, and SKU management.",
    icon: "ph:package-duotone"
  },
  {
    title: "Multi-Vendor Marketplace",
    desc: "Vendor dashboards, commission engine, product approval workflows, and vendor payouts.",
    icon: "ph:storefront-duotone"
  },
  {
    title: "Payment Integrations",
    desc: "Stripe, PayPal, Klarna, bank transfers with subscription billing and invoicing.",
    icon: "ph:credit-card-duotone"
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      "name": "How much does Laravel e-commerce development cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Custom e-commerce stores cost $15,000-$40,000. Multi-vendor marketplaces cost $25,000-$60,000. Enterprise stores with ERP integration reach $50,000-$100,000+."
      }
    },
    {
      "@type": "Question",
      "name": "Do you build multi-vendor e-commerce platforms?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. We build multi-vendor marketplaces with vendor dashboards, commission engines, product approval workflows, and automated payouts via Stripe Connect."
      }
    },
    {
      "@type": "Question",
      "name": "Can you migrate my store to Laravel?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Absolutely. We migrate stores from Shopify, WooCommerce, Magento, and custom platforms to Laravel with full data migration and SEO preservation."
      }
    },
    {
      "@type": "Question",
      "name": "Do you integrate with inventory/ERP systems?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. We integrate with systems like SAP, Oracle, Netsuite, and custom ERPs via REST/SOAP APIs, EDI, or direct database connections."
      }
    }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Laravel E-commerce Development",
  "provider": {
    "@type": "Organization",
    "name": "Laravel Company",
    "url": "https://laravelcompany.com"
  },
  "description": "Custom e-commerce development with Laravel. Multi-vendor, inventory, payments, ERP integration. $15K-$100K.",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "E-commerce Services",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Custom E-commerce" }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Multi-Vendor Marketplace" }}
    ]
  }
};
---

<Layout
  title="Laravel E-commerce Development Company | Custom Cart & Marketplace"
  description="Custom e-commerce development with Laravel. Multi-vendor marketplaces, inventory management, payment gateways, ERP integration. $15K-$100K."
>
  <main id="main-content">
    <!-- Hero -->
    <section class="pt-24 pb-20 md:pt-32 md:pb-28 overflow-hidden relative bg-payflo-dark">
      <div class="absolute inset-0 opacity-10 -z-10">
        <div class="absolute top-0 left-0 w-full h-full bg-[radial-gradient(circle_at_50%_120%,rgba(120,119,198,0.3),rgba(255,255,255,0))]"></div>
      </div>
      <div class="container-custom relative">
        <nav class="flex justify-center items-center gap-2 text-sm text-white/50 mb-8 animate-on-scroll">
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <span>/</span>
          <a href="/laravel-services/" class="hover:text-white transition-colors">Services</a>
          <span>/</span>
          <span class="text-white">E-commerce Development</span>
        </nav>
        <div class="max-w-4xl mx-auto text-center">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-payflo-purple/10 border border-payflo-purple/20 mb-8 animate-on-scroll">
            <Icon name="ph:shopping-cart-duotone" class="w-5 h-5 text-payflo-purple" />
            <span class="text-sm font-bold uppercase tracking-widest text-white/70">E-commerce Experts</span>
          </div>
          <h1 class="text-5xl md:text-7xl lg:text-8xl font-black leading-tight tracking-tight text-white">
            Laravel <span class="gradient-text">E-commerce Development</span>
          </h1>
          <p class="animate-on-scroll delay-2 mt-8 text-xl md:text-2xl text-white/70 leading-relaxed font-medium">
            Custom cart, multi-vendor marketplaces, inventory, and ERP integration. Starting at $15,000.
          </p>
          <div class="animate-on-scroll delay-3 mt-12 flex flex-wrap justify-center gap-6">
            <a href="/contact/" class="btn btn-primary px-10 py-5 text-lg shadow-2xl">Build E-commerce Store</a>
            <a href="/build-marketplace-laravel/" class="btn glass-card border-white/20 px-10 py-5 text-lg hover:bg-white/10 transition-all font-bold">Marketplace →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Core Features -->
    <section class="py-24">
      <div class="container-custom">
        <div class="text-center max-w-3xl mx-auto mb-20 animate-on-scroll">
          <h2 class="text-4xl md:text-5xl font-black mb-6">E-commerce <span class="gradient-text">Core Features</span></h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
          {features.map((f, i) => (
            <div class="animate-on-scroll delay-{i} glass-card p-10 border-white/10 group hover:border-payflo-purple/50 transition-colors">
              <Icon name={f.icon} class="w-12 h-12 text-payflo-purple mb-6 group-hover:scale-110 transition-transform" />
              <h3 class="text-2xl font-black mb-4 text-white">{f.title}</h3>
              <p class="text-gray-400 text-sm leading-relaxed">{f.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Platform Types -->
    <section class="py-24 bg-white/5">
      <div class="container-custom max-w-4xl mx-auto">
        <h2 class="text-4xl font-black text-center mb-16">Store <span class="gradient-text">Types</span></h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10 text-center">
            <h4 class="text-lg font-bold text-white mb-2">B2C Store</h4>
            <p class="text-gray-400 text-xs">Direct-to-consumer online store</p>
          </div>
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10 text-center">
            <h4 class="text-lg font-bold text-white mb-2">B2B Platform</h4>
            <p class="text-gray-400 text-xs">Wholesale, tiered pricing, quotes</p>
          </div>
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10 text-center">
            <h4 class="text-lg font-bold text-white mb-2">Multi-Vendor</h4>
            <p class="text-gray-400 text-xs">Marketplace with vendor dashboards</p>
          </div>
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10 text-center">
            <h4 class="text-lg font-bold text-white mb-2">Subscription</h4>
            <p class="text-gray-400 text-xs">Recurring billing, membership sites</p>
          </div>
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10 text-center">
            <h4 class="text-lg font-bold text-white mb-2">Digital Goods</h4>
            <p class="text-gray-400 text-xs">Downloads, licenses, SaaS codes</p>
          </div>
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10 text-center">
            <h4 class="text-lg font-bold text-white mb-2">Custom ERP</h4>
            <p class="text-gray-400 text-xs">Integrated with inventory/accounting</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Cost Estimate -->
    <section class="py-24">
      <div class="container-custom max-w-4xl mx-auto">
        <h2 class="text-4xl font-black text-center mb-16">Cost <span class="gradient-text">Estimate</span></h2>
        <div class="glass-card p-10 border-white/10">
          <div class="space-y-4">
            <div class="flex justify-between pb-4 border-b border-white/5">
              <span class="text-white/70">Custom Store (6-10 weeks)</span>
              <span class="text-payflo-purple font-bold">$15K-$40K</span>
            </div>
            <div class="flex justify-between pb-4 border-b border-white/5">
              <span class="text-white/70">Multi-Vendor (10-16 weeks)</span>
              <span class="text-payflo-purple font-bold">$25K-$60K</span>
            </div>
            <div class="flex justify-between">
              <span class="text-white/70">Enterprise + ERP (16-24 weeks)</span>
              <span class="text-payflo-pink font-bold">$50K-$100K</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-24 bg-white/5">
      <div class="container-custom max-w-4xl mx-auto">
        <h2 class="text-4xl font-black text-center mb-16">E-commerce <span class="gradient-text">FAQ</span></h2>
        <div class="space-y-6">
          <div class="p-8 glass-card border-white/10">
            <h4 class="text-lg font-bold mb-3 text-white">How much does Laravel e-commerce development cost?</h4>
            <p class="text-gray-400">Custom e-commerce stores cost $15,000-$40,000. Multi-vendor marketplaces cost $25,000-$60,000. Enterprise stores with ERP integration reach $50,000-$100,000+.</p>
          </div>
          <div class="p-8 glass-card border-white/10">
            <h4 class="text-lg font-bold mb-3 text-white">Do you build multi-vendor e-commerce platforms?</h4>
            <p class="text-gray-400">Yes. We build multi-vendor marketplaces with vendor dashboards, commission engines, product approval workflows, and automated payouts via Stripe Connect.</p>
          </div>
          <div class="p-8 glass-card border-white/10">
            <h4 class="text-lg font-bold mb-3 text-white">Can you migrate my store to Laravel?</h4>
            <p class="text-gray-400">Absolutely. We migrate stores from Shopify, WooCommerce, Magento, and custom platforms to Laravel with full data migration and SEO preservation.</p>
          </div>
        </div>
      </div>
    </section>

    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

    <!-- Internal Links -->
    <section class="py-16 border-t border-white/5">
      <div class="container-custom">
        <div class="flex flex-wrap justify-center gap-6 text-sm">
          <a href="/" class="text-payflo-purple hover:underline font-bold">Laravel Development Company →</a>
          <a href="/hire-laravel-developer/" class="text-payflo-purple hover:underline font-bold">Hire E-commerce Dev →</a>
          <a href="/build-marketplace-laravel/" class="text-payflo-purple hover:underline font-bold">Marketplace Build →</a>
          <a href="/migrate-wordpress-to-laravel/" class="text-payflo-purple hover:underline font-bold">Migration Services →</a>
        </div>
      </div>
    </section>

    <CTASection />
  </main>
</Layout>

<style>
  .btn { @apply inline-flex items-center justify-center font-black transition-all duration-300 rounded-2xl; }
  .btn-primary { @apply bg-gradient-to-r from-payflo-purple to-payflo-pink text-white shadow-xl shadow-purple-600/30 hover:shadow-purple-600/50 hover:-translate-y-1; }
  .glass-card { @apply bg-white/5 backdrop-blur-xl border border-white/10 rounded-3xl shadow-2xl; }
  .gradient-text { @apply bg-clip-text text-transparent bg-gradient-to-r from-payflo-purple to-payflo-pink; }
</style>
