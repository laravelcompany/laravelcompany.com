---
import Layout from "../layouts/Layout.astro";
import CTASection from "../components/CTASection.astro";
import { Icon } from "astro-icon/components";

const features = [
  {
    title: "GDPR Compliance",
    desc: "Data residency in EU, GDPR-ready contracts, DPA (Data Processing Agreement) signed.",
    icon: "ph:shield-check-duotone"
  },
  {
    title: "EU Timezone Coverage",
    desc: "Full overlap with UK, Germany, France. 4-6h overlap with US East Coast.",
    icon: "ph:globe-duotone"
  },
  {
    title: "Multi-Language Teams",
    desc: "Developers fluent in English, German, French, and Romanian for local client support.",
    icon: "ph:translate-duotone"
  },
  {
    title: "EU Data Residency",
    desc: "Servers in Frankfurt, Paris, or Dublin. Data never leaves the EU unless requested.",
    icon: "ph:database-duotone"
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      "name": "Why choose a Laravel development company in Europe?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "European companies offer GDPR compliance, EU data residency, timezone alignment with UK/Western Europe, and cultural proximity. Rates are 40-60% lower than US/UK."
      }
    },
    {
      "@type": "Question",
      "name": "Are your European developers GDPR compliant?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. All our European teams are GDPR trained, we sign DPAs, and ensure data residency within the EU. We also handle data subject requests (right to erasure, portability)."
      }
    },
    {
      "@type": "Question",
      "name": "What countries do you cover in Europe?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We have developers in Romania, Germany, France, Netherlands, Poland, and Spain. Our main hub is in Romania with 50+ developers, supported by satellite teams across the EU."
      }
    },
    {
      "@type": "Question",
      "name": "How do you handle data residency requirements?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We deploy to EU-based servers (AWS Frankfurt, Azure Dublin, OVH Paris). Data processing agreements ensure data never leaves the EU unless you explicitly request it."
      }
    }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Laravel Development Company Europe",
  "provider": {
    "@type": "Organization",
    "name": "Laravel Company",
    "url": "https://laravelcompany.com"
  },
  "description": "Laravel development company in Europe. GDPR compliant, EU data residency, timezone alignment. $35-$75/hour.",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "European Services",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "GDPR Compliant Development" }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "EU Data Residency" }}
    ]
  }
};
---

<Layout
  title="Laravel Development Company Europe | GDPR Compliant"
  description="Laravel development company in Europe. GDPR compliant, EU data residency, timezone alignment with UK/Western Europe. $35-$75/hour."
>
  <main id="main-content">
    <!-- Hero -->
    <section class="pt-24 pb-20 md:pt-32 md:pb-28 overflow-hidden relative bg-payflo-dark">
      <div class="absolute inset-0 opacity-10 -z-10">
        <div class="absolute top-0 left-0 w-full h-full bg-[radial-gradient(circle_at_50%_120%,rgba(120,119,198,0.3),rgba(255,255,255,0))]"></div>
      </div>
      <div class="container-custom relative">
        <nav class="flex justify-center items-center gap-2 text-sm text-white/50 mb-8 animate-on-scroll">
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <span>/</span>
          <a href="/laravel-services/" class="hover:text-white transition-colors">Services</a>
          <span>/</span>
          <span class="text-white">Europe Company</span>
        </nav>
        <div class="max-w-4xl mx-auto text-center">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-payflo-purple/10 border border-payflo-purple/20 mb-8 animate-on-scroll">
            <Icon name="ph:globe-duotone" class="w-5 h-5 text-payflo-purple" />
            <span class="text-sm font-bold uppercase tracking-widest text-white/70">Europe Based</span>
          </div>
          <h1 class="text-5xl md:text-7xl lg:text-8xl font-black leading-tight tracking-tight text-white">
            Laravel Development <span class="gradient-text">Company Europe</span>
          </h1>
          <p class="animate-on-scroll delay-2 mt-8 text-xl md:text-2xl text-white/70 leading-relaxed font-medium">
            GDPR compliant, EU data residency, timezone alignment with UK/Western Europe. Starting at $35/hour.
          </p>
          <div class="animate-on-scroll delay-3 mt-12 flex flex-wrap justify-center gap-6">
            <a href="/contact/" class="btn btn-primary px-10 py-5 text-lg shadow-2xl">Hire European Team</a>
            <a href="/laravel-developers-romania/" class="btn glass-card border-white/20 px-10 py-5 text-lg hover:bg-white/10 transition-all font-bold">Romania Team →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Core Features -->
    <section class="py-24">
      <div class="container-custom">
        <div class="text-center max-w-3xl mx-auto mb-20 animate-on-scroll">
          <h2 class="text-4xl md:text-5xl font-black mb-6">European <span class="gradient-text">Advantages</span></h2>
          <p class="text-gray-400 text-lg">GDPR, data residency, timezone alignment, and cultural proximity.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
          {features.map((f, i) => (
            <div class="animate-on-scroll delay-{i} glass-card p-10 border-white/10 group hover:border-payflo-purple/50 transition-colors">
              <Icon name={f.icon} class="w-12 h-12 text-payflo-purple mb-6 group-hover:scale-110 transition-transform" />
              <h3 class="text-2xl font-black mb-4 text-white">{f.title}</h3>
              <p class="text-gray-400 text-sm leading-relaxed">{f.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Countries -->
    <section class="py-24 bg-white/5">
      <div class="container-custom max-w-4xl mx-auto">
        <h2 class="text-4xl font-black text-center mb-16">Coverage <span class="gradient-text">Across Europe</span></h2>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
          {["Romania (Main Hub)", "Germany", "France", "Netherlands", "Poland", "Spain"].map(c => (
            <div class="p-4 rounded-xl bg-white/5 border border-white/10 text-center text-white/70 text-sm font-bold">{c}</div>
          ))}
        </div>
      </div>
    </section>

    <!-- Cost Comparison -->
    <section class="py-24">
      <div class="container-custom max-w-4xl mx-auto">
        <h2 class="text-4xl font-black text-center mb-16">Cost <span class="gradient-text">Comparison</span></h2>
        <div class="glass-card p-10 border-white/10">
          <div class="space-y-4">
            <div class="flex justify-between pb-4 border-b border-white/5">
              <span class="text-white/70">Romania (EU)</span>
              <span class="text-payflo-purple font-bold">$35-$75/hr</span>
            </div>
            <div class="flex justify-between pb-4 border-b border-white/5">
              <span class="text-white/70">Germany/France</span>
              <span class="text-payflo-purple font-bold">$60-$100/hr</span>
            </div>
            <div class="flex justify-between pb-4 border-b border-white/5">
              <span class="text-white/50">UK (Non-EU)</span>
              <span class="text-white/40 line-through">$80-$150/hr</span>
            </div>
            <div class="flex justify-between">
              <span class="text-white/50">USA</span>
              <span class="text-white/40 line-through">$100-$200/hr</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-24 bg-white/5">
      <div class="container-custom max-w-4xl mx-auto">
        <h2 class="text-4xl font-black text-center mb-16">Europe <span class="gradient-text">FAQ</span></h2>
        <div class="space-y-6">
          <div class="p-8 glass-card border-white/10">
            <h4 class="text-lg font-bold mb-3 text-white">Why choose a Laravel development company in Europe?</h4>
            <p class="text-gray-400">European companies offer GDPR compliance, EU data residency, timezone alignment with UK/Western Europe, and cultural proximity. Rates are 40-60% lower than US/UK.</p>
          </div>
          <div class="p-8 glass-card border-white/10">
            <h4 class="text-lg font-bold mb-3 text-white">Are your European developers GDPR compliant?</h4>
            <p class="text-gray-400">Yes. All our European teams are GDPR trained, we sign DPAs, and ensure data residency within the EU. We also handle data subject requests (right to erasure, portability).</p>
          </div>
          <div class="p-8 glass-card border-white/10">
            <h4 class="text-lg font-bold mb-3 text-white">What countries do you cover in Europe?</h4>
            <p class="text-gray-400">We have developers in Romania, Germany, France, Netherlands, Poland, and Spain. Our main hub is in Romania with 50+ developers, supported by satellite teams across the EU.</p>
          </div>
        </div>
      </div>
    </section>

    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

    <!-- Internal Links -->
    <section class="py-16 border-t border-white/5">
      <div class="container-custom">
        <div class="flex flex-wrap justify-center gap-6 text-sm">
          <a href="/" class="text-payflo-purple hover:underline font-bold">Laravel Development Company →</a>
          <a href="/laravel-developers-romania/" class="text-payflo-purple hover:underline font-bold">Romania Developers →</a>
          <a href="/nearshore-laravel-development/" class="text-payflo-purple hover:underline font-bold">Nearshore →</a>
          <a href="/hire-laravel-developer-remote/" class="text-payflo-purple hover:underline font-bold">Remote Hiring →</a>
        </div>
      </div>
    </section>

    <CTASection />
  </main>
</Layout>

<style>
  .btn { @apply inline-flex items-center justify-center font-black transition-all duration-300 rounded-2xl; }
  .btn-primary { @apply bg-gradient-to-r from-payflo-purple to-payflo-pink text-white shadow-xl shadow-purple-600/30 hover:shadow-purple-600/50 hover:-translate-y-1; }
  .glass-card { @apply bg-white/5 backdrop-blur-xl border border-white/10 rounded-3xl shadow-2xl; }
  .gradient-text { @apply bg-clip-text text-transparent bg-gradient-to-r from-payflo-purple to-payflo-pink; }
</style>
