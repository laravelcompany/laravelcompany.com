---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';

export const prerender = true;

interface Product {
  id: number;
  title: string;
  price: string;
  category: string;
  image_urls: string[];
  description: string;
  aff_code: string;
}

interface ApiResponse {
  success: boolean;
  data: Product[];
  pagination: {
    current_page: number;
    per_page: number;
    total: number;
    last_page: number;
  };
}

let products: Product[] = [];
let categories: string[] = [];
let pagination = {
  current_page: 1,
  total: 0,
  last_page: 1
};
let apiError = false;

// Helper to add delay between requests
function delay(ms: number) {
  return new Promise(resolve => setTimeout(resolve, ms));
}

// Fetch products during build
async function fetchAllProducts() {
  const apiUrl = import.meta.env.PUBLIC_API_URL || 'https://app.laravelmail.com/api';
  const allProducts: Product[] = [];
  const delayBetweenRequests = 500;
  const perPage = 10;
  
  try {
    console.log(`📡 Fetching products from: ${apiUrl}/v1/products`);
    
    // Initial fetch to get total count
    const response = await fetch(`${apiUrl}/v1/products?per_page=${perPage}&page=1`, {
        headers: {
            'User-Agent': 'Astro-Build/1.0',
            'Accept': 'application/json'
        }
    });

    if (!response.ok) {
       console.error(`❌ API fetch failed with status ${response.status}`);
       return [];
    }

    const data: ApiResponse = await response.json();
    if (data.success && Array.isArray(data.data)) {
        allProducts.push(...data.data);
    }
    
    const totalPages = data.pagination?.last_page || 1;
    console.log(`✓ Loaded page 1/${totalPages} - ${data.data?.length || 0} products`);

    // Fetch remaining pages if any
    /*
    for (let page = 2; page <= totalPages; page++) {
      try {
        await delay(delayBetweenRequests);
        const nextResponse = await fetch(`${apiUrl}/v1/products?per_page=${perPage}&page=${page}`, {
            headers: {
                'User-Agent': 'Astro-Build/1.0',
                'Accept': 'application/json'
            }
        });

        if (nextResponse.ok) {
            const nextData: ApiResponse = await nextResponse.json();
            if (nextData.success && Array.isArray(nextData.data)) {
                allProducts.push(...nextData.data);
                console.log(`✓ Loaded page ${page}/${totalPages} - ${nextData.data.length} products`);
            }
        }
      } catch (error) {
        console.error(`✗ Page ${page} error:`, error);
      }
    }
    */

    console.log(`\n📊 Shop Build Summary: ${allProducts.length} total products loaded`);
    return allProducts;
  } catch (error) {
    console.error('❌ Failed to fetch products:', error);
    return [];
  }
}

// Load products
if (import.meta.env.SSR) {
  const allProducts = await fetchAllProducts();
  if (allProducts.length > 0) {
    products = allProducts;
    pagination.total = allProducts.length;
    pagination.last_page = Math.ceil(allProducts.length / 250);

    // Extract unique categories
    categories = [...new Set(allProducts.map(p => p.category))].filter(Boolean).sort();
  } else {
    // We only set apiError if the fetch itself failed or returned empty when we expected data.
    // However, if the API is UP but just empty, we should still show the page.
    // For now, let's keep it simple: if 0 products, show the "offline" warning as a hint.
    apiError = true;
  }
}

// Helper functions
function getProductImage(imageUrls: string[]): string {
  return Array.isArray(imageUrls) && imageUrls.length > 0 ? imageUrls[0] : '/logo.svg';
}

function formatPrice(price: string | number): string {
  const num = typeof price === 'string' ? parseFloat(price) : price;
  return new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: 'USD'
  }).format(num);
}

function truncateDescription(desc: string, length: number = 100): string {
  if (!desc) return '';
  return desc.length > length ? desc.substring(0, length) + '...' : desc;
}

function generateSlug(title: string): string {
  return title
    .toLowerCase()
    .replace(/[^\w\s-]/g, '')
    .replace(/\s+/g, '-')
    .replace(/-+/g, '-')
    .trim();
}
---

<Layout title="Shop - Laravel Company Products">
  <main>
    <HeroSection
        title="Premium Products & Tools"
        highlightText="Laravel Shop"
        description="Explore our collection of premium Laravel packages, enterprise solutions, and developer tools designed to accelerate your workflow."
    />

    <section class="py-16 bg-white dark:bg-gray-800">
      <div class="container-custom">
        <div class="text-center mb-16">
          <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-4">Browse Our Products</h2>
          <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
            Find the perfect solution for your next project. We offer a wide range of tools and services.
          </p>
          {apiError && products.length === 0 && (
              <div class="mt-4 inline-block px-4 py-2 bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-800 rounded-lg">
                <p class="text-yellow-800 dark:text-yellow-300 text-sm">⚠️ Unable to connect to the API or no products available.</p>
              </div>
          )}
          {products.length > 0 && (
              <div class="mt-4 inline-block px-4 py-2 bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-lg">
                <p class="text-green-800 dark:text-green-300 text-sm">✓ {products.length} products loaded successfully</p>
              </div>
          )}
        </div>

        <!-- Category Filters -->
        {categories.length > 0 && (
            <div class="flex flex-wrap justify-center gap-3 mb-12 max-h-24 overflow-y-auto">
              <a href="/shop" class="px-4 py-2 rounded-full bg-payflo-purple text-white font-medium text-sm transition-colors whitespace-nowrap">
                All ({products.length})
              </a>
              {categories.map((cat) => {
                const count = products.filter(p => p.category === cat).length;
                return (
                    <button
                       class="px-4 py-2 rounded-full bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 font-medium text-sm hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors whitespace-nowrap">
                      {cat} ({count})
                    </button>
                );
              })}
            </div>
        )}

        <!-- Products Grid -->
        {products.length > 0 ? (
            <div class="space-y-16">
              <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
                {products.slice(0, 250).map((product) => (
                    <div class="feature-card border border-gray-100 dark:border-gray-700 rounded-xl overflow-hidden flex flex-col h-full !p-0">
                      <div class="relative w-full h-48 bg-gray-50 dark:bg-gray-700 overflow-hidden group">
                        <a href={`/shop/${generateSlug(product.title)}`} class="block w-full h-full">
                          <img
                              src={getProductImage(product.image_urls)}
                              alt={product.title}
                              loading="lazy"
                              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300"
                          />
                        </a>
                        <div class="absolute top-2 right-2 bg-payflo-purple text-white px-3 py-1 rounded-full text-xs font-semibold">
                          {product.category}
                        </div>
                      </div>

                      <div class="p-6 flex flex-col flex-grow">
                        <h3 class="text-lg font-bold mb-2 line-clamp-2">
                          <a href={`/shop/${generateSlug(product.title)}`} class="text-gray-900 dark:text-white hover:text-payflo-purple transition-colors">
                            {product.title}
                          </a>
                        </h3>

                        <p class="text-sm text-gray-600 dark:text-gray-400 mb-4 line-clamp-2 flex-grow">
                          {truncateDescription(product.description, 80)}
                        </p>

                        <div class="flex items-center justify-between mt-auto pt-4 border-t border-gray-100 dark:border-gray-700">
                          <span class="text-xl font-bold text-payflo-purple">
                            {formatPrice(product.price)}
                          </span>
                          <a
                              href={`/shop/${generateSlug(product.title)}`}
                              class="btn btn-primary !py-2 !px-4 text-sm"
                          >
                            View Details
                          </a>
                        </div>
                      </div>
                    </div>
                ))}
              </div>

              <!-- Pagination Info -->
              <div class="text-center py-8 border-t border-gray-100 dark:border-gray-700">
                <p class="text-gray-600 dark:text-gray-400 mb-4">
                  Showing 1-{Math.min(250, products.length)} of {products.length} products
                </p>
              </div>
            </div>
        ) : (
            <div class="text-center py-16">
              <p class="text-gray-600 dark:text-gray-300 text-lg">
                No products found at the moment.
              </p>
            </div>
        )}

        <!-- Bottom Section -->
        <div class="border-t border-gray-100 dark:border-gray-700 pt-16 mt-16">
          <div class="grid md:grid-cols-2 gap-12 items-center">
            <div>
              <span class="inline-block px-4 py-1 rounded-full bg-payflo-blue/10 text-payflo-blue font-medium text-sm mb-4">
                Enterprise Solutions
              </span>
              <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-6">
                Elevate Your Business with Our Premium Tools
              </h2>
              <p class="text-gray-600 dark:text-gray-300 mb-6">
                Our shop features the best-in-class tools and services developed by our team. Whether you're looking for automation, SEO tools, or enterprise-grade software, we have you covered.
              </p>
              <div class="space-y-4 mb-8">
                <div class="flex items-start">
                  <svg class="w-5 h-5 text-green-500 mt-1 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <p class="text-gray-600 dark:text-gray-300">Lifetime access to purchased software</p>
                </div>
                <div class="flex items-start">
                  <svg class="w-5 h-5 text-green-500 mt-1 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <p class="text-gray-600 dark:text-gray-300">Priority developer support</p>
                </div>
                <div class="flex items-start">
                  <svg class="w-5 h-5 text-green-500 mt-1 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <p class="text-gray-600 dark:text-gray-300">Regular updates and security patches</p>
                </div>
              </div>
              <div class="flex flex-col sm:flex-row gap-4">
                <a href="/contact" class="btn btn-primary">Custom Solutions</a>
                <a href="/documentation" class="btn btn-secondary">API Docs</a>
              </div>
            </div>

            <!-- Stats/Code Block -->
            <div class="rounded-lg overflow-hidden shadow-xl bg-gray-900 p-6 font-mono text-sm group">
                <div class="flex items-center mb-6">
                  <div class="w-3 h-3 rounded-full bg-red-500 mr-2"></div>
                  <div class="w-3 h-3 rounded-full bg-yellow-500 mr-2"></div>
                  <div class="w-3 h-3 rounded-full bg-green-500"></div>
                </div>
                <pre class="text-purple-400"><code>{`{
  "shop": "LaravelCompany",
  "status": "${products.length > 0 ? 'online' : 'no data'}",
  "total_products": ${products.length},
  "categories": ${categories.length},
  "last_build": "${new Date().toISOString().split('T')[0]}"
}`}</code></pre>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>
