---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Our Network | Laravel Company" description="Laravel Company and its sister companies: Laravel, Magento and Drupal development and support.">
  <main class="py-20 px-6 sm:px-8 lg:px-12 max-w-7xl mx-auto">
    <nav class="flex justify-center items-center gap-2 text-sm text-white/50 mb-8">
      <a href="/" class="hover:text-white transition-colors">Home</a>
      <span>/</span>
      <span class="text-white">Our network</span>
    </nav>
    <div class="max-w-3xl mx-auto text-center mb-14">
      <h1 class="text-4xl md:text-5xl font-black text-white mb-6">Our network</h1>
      <p class="text-lg text-white/70 leading-relaxed">Laravel Company is part of a small group of sister companies, each focused on one platform. If your project involves another stack, these are the teams we would point you to.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
        <div class="glass-card p-8">
          <h2 class="text-2xl font-black text-white mb-3"><a href="https://magentocompany.com/" class="hover:text-payflo-purple transition-colors">Magento Company</a></h2>
          <p class="text-white/70 leading-relaxed mb-5">Magento and Adobe Commerce development for ecommerce teams: custom builds, migrations to Magento 2, performance work and ongoing support.</p>
          <ul class="space-y-2 text-sm"><li><a href="https://magentocompany.com/services/magento-development-company/" class="text-payflo-purple hover:text-payflo-pink transition-colors">Magento development</a></li><li><a href="https://magentocompany.com/services/magento-migration-services/" class="text-payflo-purple hover:text-payflo-pink transition-colors">Magento migration</a></li><li><a href="https://magentocompany.com/services/magento-support-maintenance/" class="text-payflo-purple hover:text-payflo-pink transition-colors">Magento support and maintenance</a></li></ul>
          <p class="mt-6"><a href="https://magentocompany.com/" class="btn btn-primary">Visit Magento Company</a></p>
        </div>
        <div class="glass-card p-8">
          <h2 class="text-2xl font-black text-white mb-3"><a href="https://drupalcompany.com/" class="hover:text-payflo-purple transition-colors">Drupal Company</a></h2>
          <p class="text-white/70 leading-relaxed mb-5">Drupal 10 and 11 development, migration and support: custom builds, Drupal 7 migrations, headless Drupal, security updates and performance.</p>
          <ul class="space-y-2 text-sm"><li><a href="https://drupalcompany.com/services/drupal-development-company/" class="text-payflo-purple hover:text-payflo-pink transition-colors">Drupal development</a></li><li><a href="https://drupalcompany.com/services/drupal-7-to-drupal-10-migration/" class="text-payflo-purple hover:text-payflo-pink transition-colors">Drupal 7 to 10/11 migration</a></li><li><a href="https://drupalcompany.com/services/drupal-support-maintenance/" class="text-payflo-purple hover:text-payflo-pink transition-colors">Drupal support and maintenance</a></li></ul>
          <p class="mt-6"><a href="https://drupalcompany.com/" class="btn btn-primary">Visit Drupal Company</a></p>
        </div>
    </div>
  </main>
</Layout>
