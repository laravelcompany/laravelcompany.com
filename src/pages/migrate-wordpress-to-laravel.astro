---
import Layout from "../layouts/Layout.astro";
import CTASection from "../components/CTASection.astro";
import { Icon } from "astro-icon/components";

const steps = [
  {
    step: "1",
    title: "Discovery & Audit",
    desc: "Analyze WordPress database, plugins, custom post types, and URL structure."
  },
  {
    step: "2",
    title: "Data Migration",
    desc: "Export WP content, users, meta, and media. Transform to Laravel Eloquent models."
  },
  {
    step: "3",
    title: "URL Mapping & Redirects",
    desc: "301 redirects for all old URLs to preserve SEO rankings and backlinks."
  },
  {
    step: "4",
    title: "Feature Parity & Launch",
    desc: "Rebuild plugins functionality, test, and launch with zero downtime."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      "name": "Why migrate from WordPress to Laravel?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "WordPress becomes slow and insecure with many plugins. Laravel offers better performance, security, custom functionality, and scalability for complex web applications."
      }
    },
    {
      "@type": "Question",
      "name": "How long does a WordPress to Laravel migration take?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Simple sites take 4-6 weeks. Complex sites with custom plugins, WooCommerce, or membership systems take 8-16 weeks depending on scope."
      }
    },
    {
      "@type": "Question",
      "name": "Will my SEO rankings be preserved?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. We implement 1:1 URL mapping, 301 redirects for all URLs, preserve meta tags, and maintain sitemap structure to transfer SEO equity."
      }
    },
    {
      "@type": "Question",
      "name": "How much does a WordPress to Laravel migration cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Migration costs range from $8,000 for simple blogs to $30,000+ for complex WooCommerce or membership sites. Fixed-price quotes available after audit."
      }
    }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "WordPress to Laravel Migration",
  "provider": {
    "@type": "Organization",
    "name": "Laravel Company",
    "url": "https://laravelcompany.com"
  },
  "description": "Migrate from WordPress to Laravel with zero downtime, SEO preservation, and performance gains. Data migration, URL mapping, and feature parity.",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Migration Services",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "WordPress Migration" }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "SEO Preservation" }}
    ]
  }
};
---

<Layout
  title="Migrate from WordPress to Laravel | Agency & Migration Service"
  description="Migrate from WordPress to Laravel with zero downtime. SEO preservation, data migration, URL mapping, and 3x performance gains. Get a free audit."
>
  <main id="main-content">
    <!-- Hero -->
    <section class="pt-24 pb-20 md:pt-32 md:pb-28 overflow-hidden relative bg-payflo-dark">
      <div class="absolute inset-0 opacity-10 -z-10">
        <div class="absolute top-0 left-0 w-full h-full bg-[radial-gradient(circle_at_50%_120%,rgba(120,119,198,0.3),rgba(255,255,255,0))]"></div>
      </div>
      <div class="container-custom relative">
        <nav class="flex justify-center items-center gap-2 text-sm text-white/50 mb-8 animate-on-scroll">
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <span>/</span>
          <a href="/laravel-services/" class="hover:text-white transition-colors">Services</a>
          <span>/</span>
          <span class="text-white">WordPress to Laravel</span>
        </nav>
        <div class="max-w-4xl mx-auto text-center">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-payflo-purple/10 border border-payflo-purple/20 mb-8 animate-on-scroll">
            <Icon name="ph:arrow-square-out-duotone" class="w-5 h-5 text-payflo-purple" />
            <span class="text-sm font-bold uppercase tracking-widest text-white/70">Migration Experts</span>
          </div>
          <h1 class="text-5xl md:text-7xl lg:text-8xl font-black leading-tight tracking-tight text-white">
            Migrate from <span class="gradient-text">WordPress to Laravel</span>
          </h1>
          <p class="animate-on-scroll delay-2 mt-8 text-xl md:text-2xl text-white/70 leading-relaxed font-medium">
            Zero downtime migration with SEO preservation, data integrity, and 3x performance gains.
          </p>
          <div class="animate-on-scroll delay-3 mt-12 flex flex-wrap justify-center gap-6">
            <a href="/contact/" class="btn btn-primary px-10 py-5 text-lg shadow-2xl">Get Free Migration Audit</a>
            <a href="/laravel-development-cost/" class="btn glass-card border-white/20 px-10 py-5 text-lg hover:bg-white/10 transition-all font-bold">View Pricing</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Pain Points -->
    <section class="py-24 bg-white/5">
      <div class="container-custom">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
          <div class="animate-on-scroll">
            <h2 class="text-4xl font-black mb-8">Why Leave <span class="gradient-text">WordPress</span>?</h2>
            <div class="space-y-6">
              <div class="flex gap-4">
                <Icon name="ph:warning-octagon-duotone" class="w-8 h-8 text-payflo-pink flex-shrink-0 mt-1" />
                <div>
                  <h4 class="text-lg font-bold text-white mb-1">Plugin Bloat & Security</h4>
                  <p class="text-gray-400 text-sm">37% of WordPress sites are hacked via outdated plugins. Laravel has no plugins, only secure Composer packages.</p>
                </div>
              </div>
              <div class="flex gap-4">
                <Icon name="ph:gauge-duotone" class="w-8 h-8 text-payflo-purple flex-shrink-0 mt-1" />
                <div>
                  <h4 class="text-lg font-bold text-white mb-1">Performance Issues</h4>
                  <p class="text-gray-400 text-sm">WordPress slows down with traffic. Laravel handles 10x more requests per second with proper caching.</p>
                </div>
              </div>
              <div class="flex gap-4">
                <Icon name="ph:lock-key-duotone" class="w-8 h-8 text-payflo-pink flex-shrink-0 mt-1" />
                <div>
                  <h4 class="text-lg font-bold text-white mb-1">Limited Customization</h4>
                  <p class="text-gray-400 text-sm">WordPress forces you into its CMS patterns. Laravel gives you full control over architecture and data models.</p>
                </div>
              </div>
            </div>
          </div>
          <div class="animate-on-scroll delay-2">
            <div class="glass-card p-10 border-payflo-purple/20">
              <h3 class="text-2xl font-black text-white mb-6">Migration Benefits</h3>
              <div class="space-y-4">
                <div class="flex items-center gap-3"><Icon name="ph:rocket-launch-duotone" class="w-6 h-6 text-payflo-purple" /><span class="text-white/70">3x faster page loads</span></div>
                <div class="flex items-center gap-3"><Icon name="ph:shield-check-duotone" class="w-6 h-6 text-payflo-purple" /><span class="text-white/70">Zero plugin vulnerabilities</span></div>
                <div class="flex items-center gap-3"><Icon name="ph:code-block-duotone" class="w-6 h-6 text-payflo-purple" /><span class="text-white/70">Clean, custom codebase</span></div>
                <div class="flex items-center gap-3"><Icon name="ph:chart-line-up-duotone" class="w-6 h-6 text-payflo-purple" /><span class="text-white/70">Scales to millions of users</span></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Migration Process -->
    <section class="py-24">
      <div class="container-custom">
        <div class="text-center max-w-3xl mx-auto mb-20 animate-on-scroll">
          <h2 class="text-4xl md:text-5xl font-black mb-6">Migration <span class="gradient-text">Process</span></h2>
          <p class="text-gray-400 text-lg">Zero-downtime migration in 4 structured phases.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
          {steps.map((s, i) => (
            <div class="animate-on-scroll delay-{i} glass-card p-8 border-white/10 text-center">
              <div class="w-16 h-16 bg-payflo-purple/10 rounded-2xl flex items-center justify-center mx-auto mb-6 border border-payflo-purple/20">
                <span class="text-2xl font-black text-payflo-purple">{s.step}</span>
              </div>
              <h3 class="text-xl font-black mb-4 text-white">{s.title}</h3>
              <p class="text-gray-400 text-sm">{s.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- SEO Preservation -->
    <section class="py-24 bg-white/5">
      <div class="container-custom max-w-4xl mx-auto">
        <h2 class="text-4xl font-black text-center mb-16">SEO <span class="gradient-text">Preservation</span></h2>
        <div class="glass-card p-10 border-white/10">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div>
              <h4 class="text-lg font-bold text-white mb-4">URL Mapping</h4>
              <p class="text-gray-400 text-sm">All old WordPress URLs get 301 redirects to new Laravel routes. We map posts, pages, categories, tags, and custom post types.</p>
            </div>
            <div>
              <h4 class="text-lg font-bold text-white mb-4">Meta & Open Graph</h4>
              <p class="text-gray-400 text-sm">We migrate title tags, meta descriptions, OG images, and structured data to maintain search engine rankings.</p>
            </div>
            <div>
              <h4 class="text-lg font-bold text-white mb-4">Sitemap & Robots</h4>
              <p class="text-gray-400 text-sm">New XML sitemaps generated, old sitemaps redirected, robots.txt configured to match previous indexing rules.</p>
            </div>
            <div>
              <h4 class="text-lg font-bold text-white mb-4">Backlink Equity</h4>
              <p class="text-gray-400 text-sm">All inbound links preserved via redirects. We audit top 100 backlinks to ensure they resolve correctly.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-24">
      <div class="container-custom max-w-4xl mx-auto">
        <h2 class="text-4xl font-black text-center mb-16">Migration <span class="gradient-text">FAQ</span></h2>
        <div class="space-y-6">
          <div class="p-8 glass-card border-white/10">
            <h4 class="text-lg font-bold mb-3 text-white">Why migrate from WordPress to Laravel?</h4>
            <p class="text-gray-400">WordPress becomes slow and insecure with many plugins. Laravel offers better performance, security, custom functionality, and scalability for complex web applications.</p>
          </div>
          <div class="p-8 glass-card border-white/10">
            <h4 class="text-lg font-bold mb-3 text-white">Will my SEO rankings be preserved?</h4>
            <p class="text-gray-400">Yes. We implement 1:1 URL mapping, 301 redirects for all URLs, preserve meta tags, and maintain sitemap structure to transfer SEO equity.</p>
          </div>
        </div>
      </div>
    </section>

    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

    <!-- Internal Links -->
    <section class="py-16 border-t border-white/5">
      <div class="container-custom">
        <div class="flex flex-wrap justify-center gap-6 text-sm">
          <a href="/" class="text-payflo-purple hover:underline font-bold">Laravel Development Company →</a>
          <a href="/hire-laravel-developer/" class="text-payflo-purple hover:underline font-bold">Hire Migration Expert →</a>
          <a href="/laravel-development-services/" class="text-payflo-purple hover:underline font-bold">Development Services →</a>
          <a href="/upgrade-laravel-version/" class="text-payflo-purple hover:underline font-bold">Upgrade Laravel →</a>
        </div>
      </div>
    </section>

    <CTASection />
  </main>
</Layout>

<style>
  .btn { @apply inline-flex items-center justify-center font-black transition-all duration-300 rounded-2xl; }
  .btn-primary { @apply bg-gradient-to-r from-payflo-purple to-payflo-pink text-white shadow-xl shadow-purple-600/30 hover:shadow-purple-600/50 hover:-translate-y-1; }
  .glass-card { @apply bg-white/5 backdrop-blur-xl border border-white/10 rounded-3xl shadow-2xl; }
  .gradient-text { @apply bg-clip-text text-transparent bg-gradient-to-r from-payflo-purple to-payflo-pink; }
</style>
