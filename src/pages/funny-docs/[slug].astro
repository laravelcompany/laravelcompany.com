---
import Layout from "../../layouts/Layout.astro";
import DocsArticle from "../../components/DocsArticle.astro";
import { getCollection } from "astro:content";
import { docTitle } from "../../utils/docTitle.mjs";

export const prerender = true;

export async function getStaticPaths() {
  const funnyDocs = await getCollection("funny-docs");

  return funnyDocs.map((doc) => ({
    params: { slug: doc.id.replace(/\.md$/, "") },
    props: { doc, allDocs: funnyDocs },
  }));
}

const { doc, allDocs } = Astro.props;
const { Content, headings } = await doc.render();

const currentSlug = doc.id.replace(/\.md$/, "");
const title = docTitle(doc.body, currentSlug);

const docsList = allDocs
  .map((d) => ({
    slug: d.id.replace(/\.md$/, ""),
    title: docTitle(d.body, d.id.replace(/\.md$/, "")),
  }))
  .sort((a, b) => a.title.localeCompare(b.title));

const icons: Record<string, string> = {
  "authentication": "ph:key-duotone",
  "authorization": "ph:shield-check-duotone",
  "artisan": "ph:terminal-duotone",
  "blade": "ph:scissors-duotone",
  "billing": "ph:credit-card-duotone",
  "broadcasting": "ph:radio-duotone",
  "boost": "ph:rocket-duotone",
  "ai": "ph:brain-duotone",
  "ai-sdk": "ph:robot-duotone",
  "readme": "ph:book-open-duotone",
};

const icon = icons[currentSlug] || "ph:file-duotone";
---

<Layout title={`${title} - Funny Laravel Docs`}>
  <DocsArticle
    title={title}
    icon={icon}
    basePath="/funny-docs/"
    sectionLabel="Funny Docs"
    sectionName="Funny Laravel docs"
    docsList={docsList}
    currentSlug={currentSlug}
    headings={headings}
    downloadHref={`/funny-docs/${currentSlug}.md`}
    tagline="Warning: May cause actual learning AND laughter!"
    footerHint="Did you enjoy this?"
    footerLinkLabel="Suggest a topic"
  >
    <Content />
  </DocsArticle>
</Layout>
