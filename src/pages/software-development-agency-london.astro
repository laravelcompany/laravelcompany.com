---
import Layout from "../layouts/Layout.astro";
import CTASection from "../components/CTASection.astro";
import { Icon } from "astro-icon/components";
---

<Layout
    title="Software Development Agency London | Custom Web Apps"
    description="Leading bespoke software development agency in London. We specialize in custom web applications, Laravel development, and enterprise solutions."
>
    <main id="main-content">
        <!-- Hero Section -->
        <section class="pt-24 pb-20 md:pt-32 md:pb-28 overflow-hidden relative">
            <div
                class="absolute inset-0 bg-gradient-to-b from-payflo-purple/10 via-transparent to-transparent -z-10"
            >
            </div>
            <div class="container-custom relative">
                <nav class="flex justify-center items-center gap-2 text-sm text-white/50 mb-8 animate-on-scroll">
                    <a href="/" class="hover:text-white transition-colors">Home</a>
                    <span>/</span>
                    <span class="text-white">London Agency</span>
                </nav>
                <div class="max-w-4xl mx-auto text-center">
                    <h1
                        class="text-5xl md:text-7xl lg:text-8xl font-black leading-tight tracking-tight"
                    >
                        London's Premier <span class="gradient-text"
                            >Software Development</span
                        > Agency
                    </h1>
                    <p
                        class="animate-on-scroll delay-1 mt-8 text-xl md:text-2xl text-white/70 leading-relaxed font-medium"
                    >
                        Based in the heart of the capital, we partner with
                        visionary London businesses to engineer bespoke digital
                        platforms that dominate their markets. From Canary Wharf
                        fintech to Soho creatives, we are your local technology
                        powerhouse.
                    </p>
                    <div
                        class="animate-on-scroll delay-2 mt-12 flex flex-wrap justify-center gap-6"
                    >
                        <a
                            href="/contact/"
                            class="btn btn-primary px-10 py-5 text-lg shadow-2xl"
                            >Start Your London Project</a
                        >
                        <a
                            href="#local-expertise"
                            class="btn glass-card border-white/20 px-10 py-5 text-lg hover:bg-white/10 transition-all"
                            >Our Local Expertise</a
                        >
                    </div>
                </div>
            </div>
        </section>

        <!-- Local Presence Section -->
        <section id="local-expertise" class="py-24 bg-white/5 relative">
            <div class="container-custom">
                <div
                    class="grid grid-cols-1 lg:grid-cols-2 gap-20 items-center"
                >
                    <div class="animate-on-scroll">
                        <h2
                            class="text-4xl md:text-5xl font-black mb-8 leading-tight"
                        >
                            Why Partner with a <span class="gradient-text"
                                >London-Based</span
                            > Agency?
                        </h2>
                        <div
                            class="prose prose-invert max-w-none text-gray-400 text-lg"
                        >
                            <p class="mb-6">
                                In a city that never stops, your technology
                                shouldn't either. Choosing a
                                <strong
                                    >software development agency in London</strong
                                > provides more than just proximity—it offers a shared
                                understanding of the city's unique business pace and
                                competitive landscape.
                            </p>
                            <p class="mb-8">
                                We provide the localized, high-touch
                                consultation that remote-only agencies can't
                                match. Whether it's a quick strategy session in
                                person or rapid on-site support, our team is
                                integrated into the London tech ecosystem, from
                                the Silicon Roundabout to the financial
                                district.
                            </p>
                            <div
                                class="grid grid-cols-1 sm:grid-cols-2 gap-6 not-prose"
                            >
                                <div
                                    class="flex items-start gap-4 p-4 rounded-xl bg-white/5 border border-white/10"
                                >
                                    <div
                                        class="w-10 h-10 rounded-lg bg-payflo-purple/20 flex items-center justify-center flex-shrink-0"
                                    >
                                        <Icon
                                            name="ph:users-duotone"
                                            class="w-6 h-6 text-payflo-purple"
                                        />
                                    </div>
                                    <div>
                                        <h4 class="text-white font-bold">
                                            Face-to-Face Strategy
                                        </h4>
                                        <p class="text-sm">
                                            Human-centric collaboration in the
                                            heart of the capital.
                                        </p>
                                    </div>
                                </div>
                                <div
                                    class="flex items-start gap-4 p-4 rounded-xl bg-white/5 border border-white/10"
                                >
                                    <div
                                        class="w-10 h-10 rounded-lg bg-payflo-pink/20 flex items-center justify-center flex-shrink-0"
                                    >
                                        <Icon
                                            name="ph:clock-duotone"
                                            class="w-6 h-6 text-payflo-pink"
                                        />
                                    </div>
                                    <div>
                                        <h4 class="text-white font-bold">
                                            Rapid Response
                                        </h4>
                                        <p class="text-sm">
                                            Same-timezone support and immediate
                                            issue resolution.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="animate-on-scroll delay-2 relative">
                        <div
                            class="glass-card p-2 rounded-3xl overflow-hidden shadow-2xl border-white/20"
                        >
                            <div
                                class="bg-gray-900 rounded-2xl p-10 font-mono text-sm"
                            >
                                <div class="flex gap-2 mb-6">
                                    <div
                                        class="w-3 h-3 rounded-full bg-red-500"
                                    >
                                    </div>
                                    <div
                                        class="w-3 h-3 rounded-full bg-yellow-500"
                                    >
                                    </div>
                                    <div
                                        class="w-3 h-3 rounded-full bg-green-500"
                                    >
                                    </div>
                                </div>
                                <p class="text-payflo-purple">
                                    // London Local Presence
                                </p>
                                <p class="text-white">
                                    const agencyLocation = "Central London, UK";
                                </p>
                                <p class="text-white">
                                    const expertise = ["Fintech", "Media",
                                    "High-Scale SaaS"];
                                </p>
                                <p class="text-gray-500 mt-4">
                                    // Delivering performance at the speed of
                                    London
                                </p>
                                <p class="text-payflo-pink">
                                    {
                                        'buildSystem({ target: "Dominate Market" });'
                                    }
                                </p>
                            </div>
                        </div>
                        <!-- Decorative London Map Element placeholder -->
                        <div
                            class="absolute -bottom-10 -right-10 w-40 h-40 bg-payflo-purple/20 blur-3xl -z-10"
                        >
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Specialized Services Section -->
        <section class="py-24">
            <div class="container-custom">
                <div class="text-center max-w-4xl mx-auto mb-20">
                    <h2 class="text-4xl md:text-6xl font-black mb-6">
                        Built for <span class="gradient-text"
                            >London's Industries</span
                        >
                    </h2>
                    <p class="text-gray-400 text-xl font-medium">
                        We don't build generic software. We build
                        industry-specific engines designed to solve the most
                        complex challenges facing London's most demanding
                        sectors.
                    </p>
                </div>

                <div
                    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10"
                >
                    <!-- Fintech -->
                    <div class="animate-on-scroll feature-card">
                        <div
                            class="w-16 h-16 bg-payflo-purple/20 rounded-2xl flex items-center justify-center mb-8"
                        >
                            <Icon
                                name="ph:bank-duotone"
                                class="w-10 h-10 text-payflo-purple"
                            />
                        </div>
                        <h3 class="text-2xl font-black mb-4">
                            Fintech & Banking
                        </h3>
                        <p class="text-gray-400 leading-relaxed mb-6">
                            In the global financial hub, security and
                            performance are non-negotiable. We build highly
                            secure, compliant financial platforms that handle
                            millions of transactions with zero latency.
                        </p>
                        <ul
                            class="text-sm text-gray-500 space-y-2 font-bold mb-8"
                        >
                            <li>• ISO 27001 Compliant Systems</li>
                            <li>• Real-time Trading Dashboards</li>
                            <li>• Payment Gateway Orchestration</li>
                        </ul>
                    </div>

                    <!-- Creative -->
                    <div
                        class="animate-on-scroll delay-1 feature-card border-payflo-pink/30 bg-payflo-pink/5"
                    >
                        <div
                            class="w-16 h-16 bg-payflo-pink/20 rounded-2xl flex items-center justify-center mb-8"
                        >
                            <Icon
                                name="ph:palette-duotone"
                                class="w-10 h-10 text-payflo-pink"
                            />
                        </div>
                        <h3 class="text-2xl font-black mb-4">
                            Media & Creative Soho
                        </h3>
                        <p class="text-gray-400 leading-relaxed mb-6">
                            Powering London's creative pulse. We engineer media
                            management systems, interactive portfolios, and
                            high-performance streaming platforms for Soho's
                            leading agencies.
                        </p>
                        <ul
                            class="text-sm text-gray-500 space-y-2 font-bold mb-8"
                        >
                            <li>• High-Scale Asset Management</li>
                            <li>• Interactive User Experiences</li>
                            <li>• Collaborative Workflow Tools</li>
                        </ul>
                    </div>

                    <!-- SaaS -->
                    <div class="animate-on-scroll delay-2 feature-card">
                        <div
                            class="w-16 h-16 bg-payflo-purple/20 rounded-2xl flex items-center justify-center mb-8"
                        >
                            <Icon
                                name="ph:rocket-duotone"
                                class="w-10 h-10 text-payflo-purple"
                            />
                        </div>
                        <h3 class="text-2xl font-black mb-4">SaaS Scale-ups</h3>
                        <p class="text-gray-400 leading-relaxed mb-6">
                            From MVP to series D. We provide the technical
                            backbone for London's fastest-growing SaaS
                            companies, focusing on scalability, multi-tenancy,
                            and rapid iteration.
                        </p>
                        <ul
                            class="text-sm text-gray-500 space-y-2 font-bold mb-8"
                        >
                            <li>• Zero-Downtime Deployment</li>
                            <li>• Advanced API First Architecture</li>
                            <li>• Global Infrastructure Scaling</li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>

        <!-- Deep SEO Content -->
        <section class="py-24 bg-payflo-darker/50">
            <div class="container-custom">
                <div
                    class="max-w-4xl mx-auto prose prose-invert prose-red text-lg leading-relaxed"
                >
                    <h2
                        class="text-4xl font-black text-white mb-10 leading-tight"
                    >
                        Mastering Bespoke Software Development in London
                    </h2>
                    <p>
                        As a leading <strong
                            >software development agency London</strong
                        >, we recognize that our clients don't just want
                        code—they want a competitive advantage. The London
                        market is one of the most advanced in the world, and
                        digital products here must be world-class by default.
                    </p>

                    <h3 class="text-3xl font-black text-white mt-16 mb-6">
                        Strategic Digital Engineering
                    </h3>
                    <p>
                        Our approach to <i>bespoke software development</i> involves
                        a deep tactical alignment with your business goals. We don't
                        just start typing; we begin with high-level architecture and
                        strategic workshops. We identify the "bottleneck" in your
                        current business process and engineer it out of existence.
                    </p>

                    <div
                        class="bg-gradient-to-r from-payflo-purple/10 to-transparent border-l-4 border-payflo-purple p-8 my-12 rounded-r-2xl"
                    >
                        <h4 class="text-2xl font-black text-white mb-4">
                            Why London's CTOs Choose Us
                        </h4>
                        <p class="text-gray-300 mb-0">
                            Our reputation as a premier <strong
                                >London software agency</strong
                            > is built on three pillars:
                            <strong>Engineering Excellence</strong>, <strong
                                >Transparent Communication</strong
                            >, and
                            <strong>Market Agility</strong>. We move as fast as
                            the city does, ensuring your product is never late
                            to market.
                        </p>
                    </div>

                    <h3 class="text-3xl font-black text-white mt-16 mb-6">
                        The Full-Stack Excellence
                    </h3>
                    <p>
                        Our technical breadth allows us to handle migrations,
                        integrations, and greenfield projects with equal
                        mastery. As a specialized <i>software agency</i>, we
                        leverage:
                    </p>
                    <ul class="space-y-4 my-10">
                        <li
                            class="flex items-center gap-4 bg-white/5 p-4 rounded-xl"
                        >
                            <span
                                class="w-12 h-12 rounded-lg bg-red-900/10 flex items-center justify-center text-red-400 font-black text-xl"
                                >1</span
                            >
                            <span
                                ><strong>Laravel Mastery:</strong> Deep framework
                                knowledge for robust, secure backend systems.</span
                            >
                        </li>
                        <li
                            class="flex items-center gap-4 bg-white/5 p-4 rounded-xl"
                        >
                            <span
                                class="w-12 h-12 rounded-lg bg-payflo-purple/10 flex items-center justify-center text-payflo-purple font-black text-xl"
                                >2</span
                            >
                            <span
                                ><strong>Reactive Frontends:</strong> React and Vue.js
                                for seamless, app-like web experiences.</span
                            >
                        </li>
                        <li
                            class="flex items-center gap-4 bg-white/5 p-4 rounded-xl"
                        >
                            <span
                                class="w-12 h-12 rounded-lg bg-payflo-pink/10 flex items-center justify-center text-payflo-pink font-black text-xl"
                                >3</span
                            >
                            <span
                                ><strong>Cloud Infrastructure:</strong> AWS and Azure
                                experts for global, resilient hosting.</span
                            >
                        </li>
                    </ul>

                    <h2
                        class="text-4xl font-black text-white mt-24 mb-10 leading-tight"
                    >
                        London Local Service Areas
                    </h2>
                    <p>
                        We provide specialized <strong
                            >software development services</strong
                        > across all London boroughs and major business districts,
                        including:
                    </p>
                    <div
                        class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-8 not-prose"
                    >
                        <div
                            class="p-4 bg-white/5 border border-white/10 rounded-xl text-center font-bold"
                        >
                            The City
                        </div>
                        <div
                            class="p-4 bg-white/5 border border-white/10 rounded-xl text-center font-bold"
                        >
                            Canary Wharf
                        </div>
                        <div
                            class="p-4 bg-white/5 border border-white/10 rounded-xl text-center font-bold"
                        >
                            Shoreditch
                        </div>
                        <div
                            class="p-4 bg-white/5 border border-white/10 rounded-xl text-center font-bold"
                        >
                            Soho
                        </div>
                        <div
                            class="p-4 bg-white/5 border border-white/10 rounded-xl text-center font-bold"
                        >
                            Westminster
                        </div>
                        <div
                            class="p-4 bg-white/5 border border-white/10 rounded-xl text-center font-bold"
                        >
                            King's Cross
                        </div>
                        <div
                            class="p-4 bg-white/5 border border-white/10 rounded-xl text-center font-bold"
                        >
                            Richmond
                        </div>
                        <div
                            class="p-4 bg-white/5 border border-white/10 rounded-xl text-center font-bold"
                        >
                            Islington
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- FAQ Section for London -->
        <section class="py-24 bg-white/5">
            <div class="container-custom">
                <div class="max-w-4xl mx-auto">
                    <h2
                        class="text-4xl md:text-6xl font-black text-center mb-20"
                    >
                        London <span class="gradient-text">FAQ</span>
                    </h2>
                    <div class="space-y-8">
                        <div class="glass-card p-10 border-white/10">
                            <h3 class="text-2xl font-black mb-4 text-white">
                                Where is your London office based?
                            </h3>
                            <p class="text-gray-400 text-lg">
                                We are strategically positioned to serve
                                London's core business districts. While we offer
                                fully remote collaboration, we frequently host
                                strategy workshops in Central London for clients
                                who value face-to-face planning.
                            </p>
                        </div>
                        <div class="glass-card p-10 border-white/10">
                            <h3 class="text-2xl font-black mb-4 text-white">
                                Do you specialize in any specific London
                                industries?
                            </h3>
                            <p class="text-gray-400 text-lg">
                                Yes, being a <strong
                                    >software development company in London</strong
                                >, we have deep roots in the Fintech,
                                E-commerce, and Creative Media sectors. We
                                understand the regulatory and pace-of-life
                                requirements specific to these London markets.
                            </p>
                        </div>
                        <div class="glass-card p-10 border-white/10">
                            <h3 class="text-2xl font-black mb-4 text-white">
                                What is your turnaround for London-based
                                projects?
                            </h3>
                            <p class="text-gray-400 text-lg">
                                We operate on London time. We provide same-day
                                responses and can pivot rapidly. A typical
                                bespoke MVP for a London startup can be
                                delivered in 8-12 weeks, ensuring you hit your
                                investment milestones.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- FAQ Schema -->
        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "FAQPage",
                "mainEntity": [
                    {
                        "@type": "Question",
                        "name": "Where is your London office based?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "We are strategically positioned to serve London's core business districts. While we offer fully remote collaboration, we frequently host strategy workshops in Central London for clients who value face-to-face planning."
                        }
                    },
                    {
                        "@type": "Question",
                        "name": "Do you specialize in any specific London industries?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "Yes, being a software development company in London, we have deep roots in the Fintech, E-commerce, and Creative Media sectors. We understand the regulatory and pace-of-life requirements specific to these London markets."
                        }
                    },
                    {
                        "@type": "Question",
                        "name": "What is your turnaround for London-based projects?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "We operate on London time. We provide same-day responses and can pivot rapidly. A typical bespoke MVP for a London startup can be delivered in 8-12 weeks, ensuring you hit your investment milestones."
                        }
                    }
                ]
            }
        </script>

        <!-- Structured Data for LocalBusiness -->
        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "LocalBusiness",
                "name": "Laravel Company London",
                "image": "https://laravelcompany.com/logo.svg",
                "@id": "https://laravelcompany.com/software-development-agency-london",
                "url": "https://laravelcompany.com",
                "telephone": "+44 744 821 88 99",
                "address": {
                    "@type": "PostalAddress",
                    "streetAddress": "London Business Centre",
                    "addressLocality": "London",
                    "postalCode": "EC1A 1BB",
                    "addressCountry": "GB"
                },
                "geo": {
                    "@type": "GeoCoordinates",
                    "latitude": 51.5074,
                    "longitude": -0.1278
                },
                "servesCuisine": "",
                "openingHoursSpecification": {
                    "@type": "OpeningHoursSpecification",
                    "dayOfWeek": [
                        "Monday",
                        "Tuesday",
                        "Wednesday",
                        "Thursday",
                        "Friday"
                    ],
                    "opens": "09:00",
                    "closes": "18:00"
                },
                "areaServed": {
                    "@type": "AdministrativeArea",
                    "name": "Greater London"
                },
                "priceRange": "$$$"
            }
        </script>

        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "Service",
                "serviceType": "Software Development",
                "provider": {
                    "@type": "LocalBusiness",
                    "name": "Laravel Company London"
                },
                "areaServed": {
                    "@type": "City",
                    "name": "London"
                },
                "hasOfferCatalog": {
                    "@type": "OfferCatalog",
                    "name": "Software Development Services",
                    "itemListElement": [
                        {
                            "@type": "Offer",
                            "itemOffered": {
                                "@type": "Service",
                                "name": "Bespoke Web Application Development"
                            }
                        },
                        {
                            "@type": "Offer",
                            "itemOffered": {
                                "@type": "Service",
                                "name": "Fintech Software Development"
                            }
                        },
                        {
                            "@type": "Offer",
                            "itemOffered": {
                                "@type": "Service",
                                "name": "SaaS Engineering"
                            }
                        }
                    ]
                }
            }
        </script>

        <CTASection />
    </main>
</Layout>

<style>
    .btn {
        @apply inline-flex items-center justify-center font-black transition-all duration-300 rounded-2xl;
    }
    .btn-primary {
        @apply bg-gradient-to-r from-red-600 to-orange-600 text-white shadow-xl shadow-red-600/30 hover:shadow-red-600/50 hover:-translate-y-1;
    }
    .feature-card {
        @apply p-10 bg-white/5 rounded-[2.5rem] border border-white/10 transition-all duration-500 hover:bg-white/10 hover:border-white/20 hover:-translate-y-3 shadow-2xl;
    }
    .animated {
        @apply animate-fade-in-up;
    }
    .glass-card {
        @apply bg-white/5 backdrop-blur-xl border border-white/10 rounded-3xl shadow-2xl;
    }
</style>
