---

<Layout title={pageTitle} description={pageDescription}>
  <!-- Hero Section -->
  <section class="min-h-screen flex items-center justify-center relative pt-20 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-payflo-dark via-purple-900/20 to-payflo-darker"></div>
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>
    
    <div class="container-custom relative z-10">
      <nav class="flex justify-center items-center gap-2 text-sm text-white/50 mb-8 animate-on-scroll">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <span class="text-white">AI Transformation</span>
      </nav>
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-black mb-6 leading-tight">
          <span class="gradient-text">AI-Driven Digital Transformation</span> for Global Industries
        </h1>
        <p class="text-xl md:text-2xl text-white/70 mb-8 max-w-3xl mx-auto">
          Harness AI/ML, data, and modern technologies to solve real-world challenges and unlock new business growth opportunities.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
          <a href="/contact/" class="btn btn-primary text-lg px-8 py-4">
            Schedule a Free Consultation
          </a>
        </div>
        
        <div class="glass-card inline-block">
          <p class="text-payflo-purple font-bold mb-4">Powering Business Success Worldwide Through AI-Led Innovation</p>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-sm">
            <div>
              <p class="text-2xl font-black text-white">13+</p>
              <p class="text-white/50">Years of Expertise</p>
            </div>
            <div>
              <p class="text-2xl font-black text-white">2K+</p>
              <p class="text-white/50">Clients Worldwide</p>
            </div>
            <div>
              <p class="text-2xl font-black text-white">4.8/5</p>
              <p class="text-white/50">Top-Rated on Clutch</p>
            </div>
            <div>
              <p class="text-2xl font-black text-white">100%</p>
              <p class="text-white/50">Global Data Security</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Industries Section -->
  <section id="industries" class="section">
    <div class="container-custom">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-black mb-4">
          Explore Future-Ready, AI-Powered Digital Systems for Global Verticals
        </h2>
        <p class="text-xl text-white/50 mb-4">Optimize Operations & Scale Without Limits</p>
        <a href="/contact/" class="inline-flex items-center text-payflo-purple font-bold hover:text-white transition-colors">
          Talk to Industry Experts <span class="ml-2">→</span>
        </a>
      </div>
      
      <div class="space-y-8">
        {industryGroups.map((group) => (
          <div class="glass-card">
            <h3 class="text-xl font-bold mb-6 text-payflo-purple">{group.title}</h3>
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
              {group.industries.map((industry) => (
                <div class="bg-white/5 rounded-xl p-6 border border-white/10 hover:border-payflo-purple/50 transition-colors">
                  <h4 class="font-bold text-lg mb-3">{industry.name}</h4>
                  <p class="text-white/60 text-sm leading-relaxed">{industry.description}</p>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Case Studies Section -->
  <section id="case-studies" class="section bg-payflo-dark/50">
    <div class="container-custom">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-black mb-4">
          Redefining Industries Through Next-Gen Cognitive Solutions
        </h2>
      </div>
      
      <div class="grid md:grid-cols-3 gap-8">
        {caseStudies.map((study) => (
          <div class="glass-card">
            <div class="text-xs font-bold text-payflo-purple uppercase tracking-wider mb-2">{study.industry}</div>
            <h3 class="text-xl font-bold mb-4">{study.client}</h3>
            <p class="text-white/70 mb-4">{study.result}</p>
            <p class="text-sm text-white/50">{study.technologies}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <section class="section">
    <div class="container-custom">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-black mb-4">
          Words of Trust from Leaders Across Industries
        </h2>
        <p class="text-white/50">See How Laravel Company Built Lasting Partnerships with Pioneers, Disruptors, and Changemakers</p>
      </div>
      
      <div class="testimonial-slider relative">
        <div class="overflow-x-auto pb-4 scrollbar-hide" id="testimonial-track">
          <div class="flex gap-6" id="testimonial-cards">
            {testimonials.map((testimonial) => (
              <div class="testimonial-card min-w-[300px] md:min-w-[400px] flex-shrink-0">
                <p class="text-white/70 mb-6 italic">"{testimonial.quote}"</p>
                <div class="border-t border-white/10 pt-4">
                  <p class="font-bold">{testimonial.name}</p>
                  <p class="text-sm text-white/50">{testimonial.title}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
        
        <button id="testimonial-prev" class="absolute left-0 top-1/2 -translate-y-1/2 -translate-x-4 w-12 h-12 rounded-full glass-card flex items-center justify-center hover:bg-payflo-purple transition-colors" aria-label="Previous testimonial">
          ←
        </button>
        <button id="testimonial-next" class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-4 w-12 h-12 rounded-full glass-card flex items-center justify-center hover:bg-payflo-purple transition-colors" aria-label="Next testimonial">
          →
        </button>
      </div>
    </div>
  </section>

  <!-- Final CTA Section -->
  <section class="section py-24 bg-gradient-to-r from-payflo-purple/20 to-payflo-pink/20">
    <div class="container-custom text-center">
      <h2 class="text-3xl md:text-4xl font-black mb-6">
        Revolutionize Your Business Operations with Intelligent, AI-Powered Solutions Tailored to Your Industry Needs
      </h2>
      <a href="/contact/" class="btn btn-primary text-lg inline-flex items-center">
        Consult Our Experts <span class="ml-2">→</span>
      </a>
    </div>
  </section>
</Layout>

<style>
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  
  .testimonial-slider {
    position: relative;
  }
  
  .testimonial-slider button {
    z-index: 10;
  }
  
  @media (max-width: 768px) {
    .testimonial-slider button {
      display: none;
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const track = document.getElementById('testimonial-track');
    const prevBtn = document.getElementById('testimonial-prev');
    const nextBtn = document.getElementById('testimonial-next');
    
    if (track && prevBtn && nextBtn) {
      let scrollAmount = 0;
      const cardWidth = 420;
      
      prevBtn.addEventListener('click', () => {
        scrollAmount = Math.max(0, scrollAmount - cardWidth);
        track.scrollTo({ left: scrollAmount, behavior: 'smooth' });
      });
      
      nextBtn.addEventListener('click', () => {
        const maxScroll = track.scrollWidth - track.clientWidth;
        scrollAmount = Math.min(maxScroll, scrollAmount + cardWidth);
        track.scrollTo({ left: scrollAmount, behavior: 'smooth' });
      });
    }
  });
</script>
