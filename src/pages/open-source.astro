---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
---

<Layout
	title="Open Source Laravel Packages | Laravel Company"
	description="Explore our collection of free, MIT-licensed open source Laravel packages. SEO tools, email management, GPT integration, UI components, and more."
>
	<!-- Breadcrumb Schema -->
	<script type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@type": "BreadcrumbList",
			"itemListElement": [
				{
					"@type": "ListItem",
					"position": 1,
					"name": "Home",
					"item": "https://laravelcompany.com/"
				},
				{
					"@type": "ListItem",
					"position": 2,
					"name": "Open Source",
					"item": "https://laravelcompany.com/open-source"
				}
			]
		}
	</script>

	<!-- Hero Section -->
	<section class="pt-32 pb-20 relative overflow-hidden">
		<div class="absolute top-20 left-1/4 w-[500px] h-[500px] bg-payflo-purple/20 blur-[150px] rounded-full -z-10"></div>
		<div class="absolute bottom-20 right-1/4 w-[400px] h-[400px] bg-payflo-pink/15 blur-[120px] rounded-full -z-10"></div>
		<div class="absolute top-40 right-1/3 w-[300px] h-[300px] bg-payflo-blue/10 blur-[100px] rounded-full -z-10"></div>
		
		<div class="container-custom relative">
			<nav class="flex justify-center items-center gap-2 text-sm text-white/50 mb-8 animate-on-scroll">
				<a href="/" class="hover:text-white transition-colors">Home</a>
				<span>/</span>
				<span class="text-white">Open Source</span>
			</nav>
			<div class="text-center max-w-4xl mx-auto">
				<div class="animate-on-scroll inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/5 border border-white/10 backdrop-blur-sm mb-8">
					<Icon name="ph:github-logo-duotone" class="w-5 h-5 text-payflo-purple" />
					<span class="text-sm font-semibold text-white/80">MIT Licensed & Free</span>
				</div>
				
				<h1 class="text-4xl md:text-5xl lg:text-6xl font-black text-white leading-tight mb-6">
					Open Source <span class="gradient-text">Laravel Packages</span>
				</h1>
				
				<p class="animate-on-scroll delay-2 text-xl md:text-2xl text-white/70 leading-relaxed font-medium max-w-3xl mx-auto mb-10">
					Building blocks for the Laravel ecosystem. Every package we release is production-ready, 
					well-documented, and backed by the same team that builds enterprise Laravel applications.
				</p>
				
				<div class="animate-on-scroll delay-3 flex flex-wrap justify-center gap-4">
					<a href="https://github.com/laravelcompany" target="_blank" rel="noopener noreferrer" class="btn btn-primary inline-flex items-center gap-2">
						<Icon name="ph:github-logo-duotone" class="w-5 h-5" />
						Visit Our GitHub
						<Icon name="ph:arrow-up-right" class="w-5 h-5" />
					</a>
				</div>
			</div>
		</div>
	</section>

	<!-- Packages Grid -->
	<section class="pb-20 relative overflow-hidden">
		<div class="container-custom">
			<div class="text-center max-w-3xl mx-auto mb-16">
				<h2 class="animate-on-scroll text-3xl md:text-4xl font-black text-white mb-6">
					Our <span class="gradient-text">Packages</span>
				</h2>
				<p class="animate-on-scroll delay-1 text-lg text-white/70">
					Free, MIT-licensed packages used by thousands of developers worldwide. 
					Production-tested and actively maintained.
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
				<!-- Laravel SEO -->
				<div class="animate-on-scroll delay-0 group glass-card p-8 hover:border-payflo-pink/30 transition-all duration-500">
					<div class="h-14 w-14 rounded-2xl bg-gradient-to-br from-pink-600 to-pink-800 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
						<Icon name="ph:magnifying-glass-duotone" class="w-7 h-7 text-white" />
					</div>
					<h3 class="text-2xl font-bold text-white mb-3">Laravel SEO</h3>
					<p class="text-white/60 text-sm leading-relaxed mb-6">
						Automatic meta tags, Open Graph, Twitter Cards, JSON-LD structured data, XML sitemaps, and canonical URLs for any Laravel application.
					</p>
					<div class="flex items-center gap-3 mt-auto">
						<a href="https://github.com/laravelcompany/laravel-seo" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-sm text-white/50 hover:text-white transition-colors">
							<Icon name="ph:github-logo-duotone" class="w-5 h-5" />
							Source
						</a>
						<span class="text-white/20">|</span>
						<a href="/software/laravel-seo/" class="inline-flex items-center gap-2 text-sm text-payflo-pink font-semibold hover:text-payflo-pink/80 transition-colors">
							Learn More
							<Icon name="ph:arrow-right" class="w-4 h-4" />
						</a>
					</div>
				</div>

				<!-- Laravel Mail -->
				<div class="animate-on-scroll delay-100 group glass-card p-8 hover:border-payflo-purple/30 transition-all duration-500">
					<div class="h-14 w-14 rounded-2xl bg-gradient-to-br from-violet-600 to-violet-800 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
						<Icon name="ph:envelope-simple-duotone" class="w-7 h-7 text-white" />
					</div>
					<h3 class="text-2xl font-bold text-white mb-3">Laravel Mail</h3>
					<p class="text-white/60 text-sm leading-relaxed mb-6">
						Advanced email management with drag-and-drop templates, campaign tools, transactional tracking, and delivery analytics.
					</p>
					<div class="flex items-center gap-3 mt-auto">
						<a href="https://github.com/laravelcompany/laravel-mail" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-sm text-white/50 hover:text-white transition-colors">
							<Icon name="ph:github-logo-duotone" class="w-5 h-5" />
							Source
						</a>
						<span class="text-white/20">|</span>
						<a href="/software/laravel-mail/" class="inline-flex items-center gap-2 text-sm text-payflo-purple font-semibold hover:text-payflo-purple/80 transition-colors">
							Learn More
							<Icon name="ph:arrow-right" class="w-4 h-4" />
						</a>
					</div>
				</div>

				<!-- Laravel GPT -->
				<div class="animate-on-scroll delay-200 group glass-card p-8 hover:border-purple-500/30 transition-all duration-500">
					<div class="h-14 w-14 rounded-2xl bg-gradient-to-br from-purple-600 to-purple-800 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
						<Icon name="ph:lightning-duotone" class="w-7 h-7 text-white" />
					</div>
					<h3 class="text-2xl font-bold text-white mb-3">Laravel GPT</h3>
					<p class="text-white/60 text-sm leading-relaxed mb-6">
						OpenAI GPT integration for Laravel. Text generation, chatbots, embeddings, semantic search, with rate limiting and token tracking.
					</p>
					<div class="flex items-center gap-3 mt-auto">
						<a href="https://github.com/laravelcompany/laravel-gpt" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-sm text-white/50 hover:text-white transition-colors">
							<Icon name="ph:github-logo-duotone" class="w-5 h-5" />
							Source
						</a>
						<span class="text-white/20">|</span>
						<a href="/software/laravel-gpt/" class="inline-flex items-center gap-2 text-sm text-purple-400 font-semibold hover:text-purple-400/80 transition-colors">
							Learn More
							<Icon name="ph:arrow-right" class="w-4 h-4" />
						</a>
					</div>
				</div>

				<!-- Laravel UI -->
				<div class="animate-on-scroll delay-300 group glass-card p-8 hover:border-payflo-blue/30 transition-all duration-500">
					<div class="h-14 w-14 rounded-2xl bg-gradient-to-br from-blue-600 to-blue-800 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
						<Icon name="ph:layout-duotone" class="w-7 h-7 text-white" />
					</div>
					<h3 class="text-2xl font-bold text-white mb-3">Laravel UI</h3>
					<p class="text-white/60 text-sm leading-relaxed mb-6">
						Modern UI component library for Laravel Blade. 40+ components built with Alpine.js and Tailwind CSS, dark mode, and WCAG 2.1 AA accessible.
					</p>
					<div class="flex items-center gap-3 mt-auto">
						<a href="https://github.com/laravelcompany/laravel-ui" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-sm text-white/50 hover:text-white transition-colors">
							<Icon name="ph:github-logo-duotone" class="w-5 h-5" />
							Source
						</a>
						<span class="text-white/20">|</span>
						<a href="/software/laravel-ui/" class="inline-flex items-center gap-2 text-sm text-payflo-blue font-semibold hover:text-payflo-blue/80 transition-colors">
							Learn More
							<Icon name="ph:arrow-right" class="w-4 h-4" />
						</a>
					</div>
				</div>

				<!-- Laravel Social -->
				<div class="animate-on-scroll delay-400 group glass-card p-8 hover:border-orange-500/30 transition-all duration-500">
					<div class="h-14 w-14 rounded-2xl bg-gradient-to-br from-orange-600 to-orange-800 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
						<Icon name="ph:share-network-duotone" class="w-7 h-7 text-white" />
					</div>
					<h3 class="text-2xl font-bold text-white mb-3">Laravel Social</h3>
					<p class="text-white/60 text-sm leading-relaxed mb-6">
						AI-powered social media automation. Schedule posts, generate content and images, manage multi-platform campaigns from one dashboard.
					</p>
					<div class="flex items-center gap-3 mt-auto">
						<a href="https://github.com/laravelcompany/laravel-social" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-sm text-white/50 hover:text-white transition-colors">
							<Icon name="ph:github-logo-duotone" class="w-5 h-5" />
							Source
						</a>
						<span class="text-white/20">|</span>
						<a href="/software/laravel-social/" class="inline-flex items-center gap-2 text-sm text-orange-400 font-semibold hover:text-orange-400/80 transition-colors">
							Learn More
							<Icon name="ph:arrow-right" class="w-4 h-4" />
						</a>
					</div>
				</div>

				<!-- Laravel Voip -->
				<div class="animate-on-scroll delay-500 group glass-card p-8 hover:border-payflo-purple/30 transition-all duration-500">
					<div class="h-14 w-14 rounded-2xl bg-gradient-to-br from-emerald-600 to-emerald-800 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
						<Icon name="ph:folder-duotone" class="w-7 h-7 text-white" />
					</div>
					<h3 class="text-2xl font-bold text-white mb-3">Laravel Voip</h3>
					<p class="text-white/60 text-sm leading-relaxed mb-6">
						Associate files with Eloquent models. Upload, transform, optimize, and serve images and documents with an expressive API.
					</p>
					<div class="flex items-center gap-3 mt-auto">
						<a href="https://github.com/laravelcompany/laravel-medialibrary" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-sm text-white/50 hover:text-white transition-colors">
							<Icon name="ph:github-logo-duotone" class="w-5 h-5" />
							Source
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Why Open Source Section -->
	<section class="pb-20 relative overflow-hidden">
		<div class="absolute inset-0 bg-gradient-to-b from-transparent via-payflo-purple/5 to-transparent"></div>
		<div class="container-custom relative">
			<div class="text-center max-w-3xl mx-auto mb-16">
				<h2 class="animate-on-scroll text-3xl md:text-4xl font-black text-white mb-6">
					Why We <span class="gradient-text">Open Source</span>
				</h2>
				<p class="animate-on-scroll delay-1 text-lg text-white/70">
					We believe in giving back to the community that powers our business. Every package is a building block 
					we use in client projects — battle-tested, community-vetted, and freely available.
				</p>
			</div>
			
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
				<div class="animate-on-scroll delay-0 glass-card text-center hover:border-payflo-purple/30">
					<div class="h-16 w-16 rounded-2xl bg-gradient-to-br from-payflo-purple to-payflo-pink flex items-center justify-center mx-auto mb-6">
						<Icon name="ph:shield-check-duotone" class="w-8 h-8 text-white" />
					</div>
					<h3 class="text-xl font-bold text-white mb-3">Production Ready</h3>
					<p class="text-white/60 text-sm">90%+ test coverage, PHPStan level 6, CI/CD via GitHub Actions, and regular security audits.</p>
				</div>
				
				<div class="animate-on-scroll delay-100 glass-card text-center hover:border-payflo-blue/30">
					<div class="h-16 w-16 rounded-2xl bg-gradient-to-br from-payflo-blue to-payflo-purple flex items-center justify-center mx-auto mb-6">
						<Icon name="ph:book-open-text-duotone" class="w-8 h-8 text-white" />
					</div>
					<h3 class="text-xl font-bold text-white mb-3">Well Documented</h3>
					<p class="text-white/60 text-sm">Comprehensive READMEs, API references, migration guides, and live examples for every package.</p>
				</div>
				
				<div class="animate-on-scroll delay-200 glass-card text-center hover:border-payflo-pink/30">
					<div class="h-16 w-16 rounded-2xl bg-gradient-to-br from-payflo-pink to-payflo-blue flex items-center justify-center mx-auto mb-6">
						<Icon name="ph:arrows-clockwise-duotone" class="w-8 h-8 text-white" />
					</div>
					<h3 class="text-xl font-bold text-white mb-3">Actively Maintained</h3>
					<p class="text-white/60 text-sm">Issues responded to within 48 hours. Patch releases within days. Compatible with Laravel 10 & 11.</p>
				</div>
				
				<div class="animate-on-scroll delay-300 glass-card text-center hover:border-emerald-500/30">
					<div class="h-16 w-16 rounded-2xl bg-gradient-to-br from-emerald-500 to-emerald-700 flex items-center justify-center mx-auto mb-6">
						<Icon name="ph:users-duotone" class="w-8 h-8 text-white" />
					</div>
					<h3 class="text-xl font-bold text-white mb-3">Community Driven</h3>
					<p class="text-white/60 text-sm">MIT-licensed. Issues, feature requests, and pull requests welcome from developers of all skill levels.</p>
				</div>
			</div>
		</div>
	</section>

	<!-- CTA Section -->
	<section class="pb-32 relative overflow-hidden">
		<div class="container-custom">
			<div class="max-w-3xl mx-auto text-center glass-card py-16 px-8 md:px-16">
				<h2 class="text-3xl md:text-4xl font-black text-white mb-6">
					Contribute or Get Involved
				</h2>
				<p class="text-lg text-white/70 mb-8 max-w-xl mx-auto">
					All our packages are open for contributions. Submit issues, propose features, or open pull requests — 
					we review everything and welcome developers of all experience levels.
				</p>
				<div class="flex flex-wrap justify-center gap-4">
					<a href="https://github.com/laravelcompany" target="_blank" rel="noopener noreferrer" class="btn btn-primary !px-10 !py-4 text-lg inline-flex items-center gap-2">
						<Icon name="ph:github-logo-duotone" class="w-5 h-5" />
						Explore on GitHub
						<Icon name="ph:arrow-up-right" class="w-5 h-5" />
					</a>
					<a href="/contact/" class="btn btn-secondary !px-10 !py-4 text-lg inline-flex items-center gap-2">
						<Icon name="ph:chat-circle-duotone" class="w-5 h-5" />
						Need a Custom Package?
					</a>
				</div>
			</div>
		</div>
	</section>
</Layout>
