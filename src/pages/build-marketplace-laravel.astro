---
import Layout from "../layouts/Layout.astro";
import CTASection from "../components/CTASection.astro";
import { Icon } from "astro-icon/components";

const features = [
  {
    title: "Multi-Vendor Architecture",
    desc: "Vendor dashboards, product management, order tracking, and commission engines.",
    icon: "ph:storefront-duotone"
  },
  {
    title: "Commission & Payouts",
    desc: "Automated commission calculation, Stripe Connect, PayPal Payouts, and tax handling.",
    icon: "ph:currency-circle-dollar-duotone"
  },
  {
    title: "Review & Rating System",
    desc: "Vendor ratings, product reviews, dispute resolution, and trust scoring.",
    icon: "ph:star-duotone"
  },
  {
    title: "Admin Control Panel",
    desc: "Platform-wide analytics, vendor management, content moderation, and payout controls.",
    icon: "ph:monitor-duotone"
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      "name": "How much does it cost to build a marketplace with Laravel?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A multi-vendor marketplace costs $25,000-$60,000 depending on complexity. Basic platforms with vendor dashboards and payments start at $25K. Advanced platforms with reviews, disputes, and mobile apps reach $60K+."
      }
    },
    {
      "@type": "Question",
      "name": "How long does it take to build a Laravel marketplace?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Basic marketplaces launch in 8-12 weeks. Advanced platforms with mobile apps, complex commission logic, and dispute systems take 16-24 weeks."
      }
    },
    {
      "@type": "Question",
      "name": "Which payment gateway is best for marketplaces?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We recommend Stripe Connect for global marketplaces (handles split payments, onboarding, KYC). PayPal Payouts is great for simpler use cases. We integrate both and handle all compliance."
      }
    },
    {
      "@type": "Question",
      "name": "Can you migrate my existing marketplace to Laravel?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. We migrate marketplaces from WordPress/WooCommerce, Shopify, and custom platforms to Laravel with zero downtime and data integrity."
      }
    }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Laravel Marketplace Development",
  "provider": {
    "@type": "Organization",
    "name": "Laravel Company",
    "url": "https://laravelcompany.com"
  },
  "description": "Build multi-vendor marketplaces with Laravel. Commission engine, vendor dashboards, Stripe Connect, reviews. $25K-$60K.",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Marketplace Services",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Multi-Vendor Platform" }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Commission Engine" }}
    ]
  }
};
---

<Layout
  title="Build Marketplace Laravel Developers | Multi-Vendor Platforms"
  description="Build multi-vendor marketplaces with Laravel. Commission engine, vendor dashboards, Stripe Connect integration, reviews. $25K-$60K. Get a quote."
>
  <main id="main-content">
    <!-- Hero -->
    <section class="pt-24 pb-20 md:pt-32 md:pb-28 overflow-hidden relative bg-payflo-dark">
      <div class="absolute inset-0 opacity-10 -z-10">
        <div class="absolute top-0 left-0 w-full h-full bg-[radial-gradient(circle_at_50%_120%,rgba(120,119,198,0.3),rgba(255,255,255,0))]"></div>
      </div>
      <div class="container-custom relative">
        <nav class="flex justify-center items-center gap-2 text-sm text-white/50 mb-8 animate-on-scroll">
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <span>/</span>
          <a href="/laravel-services/" class="hover:text-white transition-colors">Services</a>
          <span>/</span>
          <span class="text-white">Marketplace Development</span>
        </nav>
        <div class="max-w-4xl mx-auto text-center">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-payflo-purple/10 border border-payflo-purple/20 mb-8 animate-on-scroll">
            <Icon name="ph:storefront-duotone" class="w-5 h-5 text-payflo-purple" />
            <span class="text-sm font-bold uppercase tracking-widest text-white/70">Marketplace Experts</span>
          </div>
          <h1 class="animate-on-scroll delay-1 text-5xl md:text-7xl lg:text-8xl font-black leading-tight tracking-tight text-white">
            Build <span class="gradient-text">Marketplace</span> with Laravel
          </h1>
          <p class="animate-on-scroll delay-2 mt-8 text-xl md:text-2xl text-white/70 leading-relaxed font-medium">
            Multi-vendor platforms with commission engine, vendor dashboards, and Stripe Connect. Starting at $25,000.
          </p>
          <div class="animate-on-scroll delay-3 mt-12 flex flex-wrap justify-center gap-6">
            <a href="/contact/" class="btn btn-primary px-10 py-5 text-lg shadow-2xl">Build Marketplace</a>
            <a href="/laravel-mvp-development/" class="btn glass-card border-white/20 px-10 py-5 text-lg hover:bg-white/10 transition-all font-bold">MVP Package</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Core Features -->
    <section class="py-24">
      <div class="container-custom">
        <div class="text-center max-w-3xl mx-auto mb-20 animate-on-scroll">
          <h2 class="text-4xl md:text-5xl font-black mb-6">Marketplace <span class="gradient-text">Core Features</span></h2>
          <p class="text-gray-400 text-lg">Everything you need to launch a multi-vendor platform.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
          {features.map((f, i) => (
            <div class="animate-on-scroll delay-{i} glass-card p-10 border-white/10 group hover:border-payflo-purple/50 transition-colors">
              <Icon name={f.icon} class="w-12 h-12 text-payflo-purple mb-6 group-hover:scale-110 transition-transform" />
              <h3 class="text-2xl font-black mb-4 text-white">{f.title}</h3>
              <p class="text-gray-400 text-sm leading-relaxed">{f.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Platform Types -->
    <section class="py-24 bg-white/5">
      <div class="container-custom max-w-4xl mx-auto">
        <h2 class="text-4xl font-black text-center mb-16">Marketplace <span class="gradient-text">Types</span></h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10 text-center">
            <h4 class="text-lg font-bold text-white mb-2">Product Marketplace</h4>
            <p class="text-gray-400 text-xs">E-commerce multi-vendor like Amazon</p>
          </div>
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10 text-center">
            <h4 class="text-lg font-bold text-white mb-2">Service Marketplace</h4>
            <p class="text-gray-400 text-xs">TaskRabbit, Upwork-style platforms</p>
          </div>
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10 text-center">
            <h4 class="text-lg font-bold text-white mb-2">Rental Marketplace</h4>
            <p class="text-gray-400 text-xs">Airbnb-style booking platforms</p>
          </div>
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10 text-center">
            <h4 class="text-lg font-bold text-white mb-2">B2B Marketplace</h4>
            <p class="text-gray-400 text-xs">Wholesale, procurement platforms</p>
          </div>
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10 text-center">
            <h4 class="text-lg font-bold text-white mb-2">Food Delivery</h4>
            <p class="text-gray-400 text-xs">Multi-restaurant delivery platforms</p>
          </div>
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10 text-center">
            <h4 class="text-lg font-bold text-white mb-2">Event/Booking</h4>
            <p class="text-gray-400 text-xs">Vendor booking platforms</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Cost Estimate -->
    <section class="py-24">
      <div class="container-custom max-w-4xl mx-auto">
        <h2 class="text-4xl font-black text-center mb-16">Cost <span class="gradient-text">Estimate</span></h2>
        <div class="glass-card p-10 border-white/10">
          <div class="space-y-4">
            <div class="flex justify-between pb-4 border-b border-white/5">
              <span class="text-white/70">Basic Marketplace (8-12 weeks)</span>
              <span class="text-payflo-purple font-bold">$25K-$35K</span>
            </div>
            <div class="flex justify-between pb-4 border-b border-white/5">
              <span class="text-white/70">Advanced Platform (12-16 weeks)</span>
              <span class="text-payflo-purple font-bold">$35K-$50K</span>
            </div>
            <div class="flex justify-between">
              <span class="text-white/70">Enterprise + Mobile (16-24 weeks)</span>
              <span class="text-payflo-pink font-bold">$50K-$100K</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-24 bg-white/5">
      <div class="container-custom max-w-4xl mx-auto">
        <h2 class="text-4xl font-black text-center mb-16">Marketplace <span class="gradient-text">FAQ</span></h2>
        <div class="space-y-6">
          <div class="p-8 glass-card border-white/10">
            <h4 class="text-lg font-bold mb-3 text-white">How much does it cost to build a marketplace with Laravel?</h4>
            <p class="text-gray-400">A multi-vendor marketplace costs $25,000-$60,000 depending on complexity. Basic platforms with vendor dashboards and payments start at $25K. Advanced platforms with reviews, disputes, and mobile apps reach $60K+.</p>
          </div>
          <div class="p-8 glass-card border-white/10">
            <h4 class="text-lg font-bold mb-3 text-white">Which payment gateway is best for marketplaces?</h4>
            <p class="text-gray-400">We recommend Stripe Connect for global marketplaces (handles split payments, onboarding, KYC). PayPal Payouts is great for simpler use cases. We integrate both and handle all compliance.</p>
          </div>
          <div class="p-8 glass-card border-white/10">
            <h4 class="text-lg font-bold mb-3 text-white">Can you migrate my existing marketplace to Laravel?</h4>
            <p class="text-gray-400">Yes. We migrate marketplaces from WordPress/WooCommerce, Shopify, and custom platforms to Laravel with zero downtime and data integrity.</p>
          </div>
        </div>
      </div>
    </section>

    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

    <!-- Internal Links -->
    <section class="py-16 border-t border-white/5">
      <div class="container-custom">
        <div class="flex flex-wrap justify-center gap-6 text-sm">
          <a href="/" class="text-payflo-purple hover:underline font-bold">Laravel Development Company →</a>
          <a href="/hire-laravel-developer/" class="text-payflo-purple hover:underline font-bold">Hire Marketplace Dev →</a>
          <a href="/build-booking-platform-laravel/" class="text-payflo-purple hover:underline font-bold">Booking Platform →</a>
          <a href="/laravel-mvp-development/" class="text-payflo-purple hover:underline font-bold">MVP Package →</a>
        </div>
      </div>
    </section>

    <CTASection />
  </main>
</Layout>

<style>
  .btn { @apply inline-flex items-center justify-center font-black transition-all duration-300 rounded-2xl; }
  .btn-primary { @apply bg-gradient-to-r from-payflo-purple to-payflo-pink text-white shadow-xl shadow-purple-600/30 hover:shadow-purple-600/50 hover:-translate-y-1; }
  .glass-card { @apply bg-white/5 backdrop-blur-xl border border-white/10 rounded-3xl shadow-2xl; }
  .gradient-text { @apply bg-clip-text text-transparent bg-gradient-to-r from-payflo-purple to-payflo-pink; }
</style>
