---
import Layout from "../layouts/Layout.astro";
import CTASection from "../components/CTASection.astro";
import { Icon } from "astro-icon/components";
---

<Layout
    title="Magento Agency London | Expert Magento 2 Developers"
    description="Leading Magento agency in London. Certified Magento 2 developers helping London businesses build high-performance, scalable e-commerce stores with Adobe Commerce."
>
    <main id="main-content">
        <!-- Hero Section -->
        <section class="pt-24 pb-20 md:pt-32 md:pb-28 overflow-hidden relative">
            <div
                class="absolute inset-0 bg-[radial-gradient(circle_at_30%_20%,rgba(215,90,55,0.1),transparent)] -z-10"
            >
            </div>
            <div class="container-custom relative">
                <nav class="flex justify-center items-center gap-2 text-sm text-white/50 mb-8 animate-on-scroll">
                    <a href="/" class="hover:text-white transition-colors">Home</a>
                    <span>/</span>
                    <span class="text-white">Magento Agency</span>
                </nav>
                <div class="max-w-4xl mx-auto text-center">
                    <div
                        class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-orange-600/10 border border-orange-600/20 mb-8 animate-on-scroll"
                    >
                        <Icon
                            name="ph:shopping-cart-duotone"
                            class="w-5 h-5 text-orange-500"
                        />
                        <span
                            class="text-sm font-bold uppercase tracking-widest text-orange-500/80"
                            >Certified Magento 2 Experts</span
                        >
                    </div>
                    <h1
                        class="animate-on-scroll delay-1 text-5xl md:text-7xl lg:text-8xl font-black leading-tight tracking-tight"
                    >
                        London's Leading <span
                            class="gradient-text !from-orange-500 !to-red-600"
                            >Magento Agency</span
                        >
                    </h1>
                    <p
                        class="animate-on-scroll delay-2 mt-8 text-xl md:text-2xl text-white/70 leading-relaxed font-medium"
                    >
                        Helping London's most ambitious brands dominate
                        e-commerce. We engineer high-performance, secure, and
                        infinitely scalable Magento 2 stores tailored for the
                        capital's competitive retail landscape.
                    </p>
                    <div
                        class="animate-on-scroll delay-3 mt-12 flex flex-wrap justify-center gap-6"
                    >
                        <a
                            href="/contact/"
                            class="btn btn-primary bg-gradient-to-r from-orange-600 to-red-600 px-10 py-5 text-lg shadow-2xl"
                            >Scale Your Store Today</a
                        >
                        <a
                            href="#services"
                            class="btn glass-card border-white/20 px-10 py-5 text-lg hover:bg-white/10 transition-all font-bold"
                            >Our Magento Expertise</a
                        >
                    </div>
                </div>
            </div>
        </section>

        <!-- Trusted By / Stats -->
        <section class="py-12 border-y border-white/5 bg-white/2">
            <div class="container-custom">
                <div
                    class="flex flex-wrap justify-center gap-12 md:gap-24 opacity-60 grayscale hover:grayscale-0 transition-all duration-500"
                >
                    <div class="flex flex-col items-center">
                        <span class="text-3xl font-black text-white">100+</span>
                        <span
                            class="text-xs font-bold uppercase tracking-widest text-gray-500"
                            >Magento Projects</span
                        >
                    </div>
                    <div class="flex flex-col items-center">
                        <span class="text-3xl font-black text-white">400%</span>
                        <span
                            class="text-xs font-bold uppercase tracking-widest text-gray-500"
                            >Avg. Revenue Growth</span
                        >
                    </div>
                    <div class="flex flex-col items-center">
                        <span class="text-3xl font-black text-white">99.9%</span
                        >
                        <span
                            class="text-xs font-bold uppercase tracking-widest text-gray-500"
                            >Uptime Record</span
                        >
                    </div>
                </div>
            </div>
        </section>

        <!-- Why Us Section -->
        <section class="py-24">
            <div class="container-custom">
                <div
                    class="grid grid-cols-1 lg:grid-cols-2 gap-20 items-center"
                >
                    <div class="animate-on-scroll shrink-0">
                        <div class="relative group">
                            <div
                                class="absolute -inset-4 bg-orange-600/20 blur-3xl rounded-[3rem] opacity-0 group-hover:opacity-100 transition-opacity"
                            >
                            </div>
                            <div
                                class="relative glass-card p-2 border-white/10"
                            >
                                <div class="bg-gray-900 rounded-2xl p-10">
                                    <h3 class="text-orange-500 font-mono mb-4">
                                        // London Market Mastery
                                    </h3>
                                    <p
                                        class="text-white text-lg font-medium leading-relaxed"
                                    >
                                        "The London e-commerce market is fast,
                                        demanding, and high-volume. A standard
                                        Magento install isn't enough. You need
                                        an agency that understands localized
                                        logistics, multi-currency complexity,
                                        and London's unique consumer behavior."
                                    </p>
                                    <div class="mt-8 flex items-center gap-4">
                                        <div
                                            class="w-12 h-12 rounded-full bg-orange-600/20 flex items-center justify-center"
                                        >
                                            <Icon
                                                name="ph:buildings-duotone"
                                                class="w-6 h-6 text-orange-500"
                                            />
                                        </div>
                                        <div>
                                            <p class="text-white font-bold">
                                                Central London Presence
                                            </p>
                                            <p class="text-sm text-gray-500">
                                                Support built for the capital.
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="animate-on-scroll delay-1">
                        <h2 class="text-4xl md:text-5xl font-black mb-8">
                            Why Partner with our <span
                                class="gradient-text !from-orange-500 !to-red-600"
                                >London Agency</span
                            >?
                        </h2>
                        <div class="space-y-6">
                            <div class="flex gap-6">
                                <div
                                    class="w-12 h-12 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center flex-shrink-0"
                                >
                                    <Icon
                                        name="ph:lightning-duotone"
                                        class="w-6 h-6 text-orange-500"
                                    />
                                </div>
                                <div>
                                    <h4
                                        class="text-xl font-bold text-white mb-2"
                                    >
                                        Extreme Performance Tuning
                                    </h4>
                                    <p class="text-gray-400">
                                        We don't just build stores; we build
                                        conversion machines. Our LCP and Core
                                        Web Vitals optimization ensures your
                                        Magento store is lightning fast on
                                        London's mobile networks.
                                    </p>
                                </div>
                            </div>
                            <div class="flex gap-6">
                                <div
                                    class="w-12 h-12 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center flex-shrink-0"
                                >
                                    <Icon
                                        name="ph:shield-check-duotone"
                                        class="w-6 h-6 text-orange-500"
                                    />
                                </div>
                                <div>
                                    <h4
                                        class="text-xl font-bold text-white mb-2"
                                    >
                                        Security-First Approach
                                    </h4>
                                    <p class="text-gray-400">
                                        Regular security audits and rapid
                                        patching. We keep your Magento 2 store
                                        safe from the latest threats, ensuring
                                        your customers' data is always
                                        protected.
                                    </p>
                                </div>
                            </div>
                            <div class="flex gap-6">
                                <div
                                    class="w-12 h-12 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center flex-shrink-0"
                                >
                                    <Icon
                                        name="ph:handshake-duotone"
                                        class="w-6 h-6 text-orange-500"
                                    />
                                </div>
                                <div>
                                    <h4
                                        class="text-xl font-bold text-white mb-2"
                                    >
                                        Local Strategic Consultation
                                    </h4>
                                    <p class="text-gray-400">
                                        Face-to-face planning in Central London.
                                        We work with your team to align your
                                        technical roadmap with your business's
                                        quarterly goals.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Services Section -->
        <section
            id="services"
            class="py-24 bg-white/2 relative overflow-hidden"
        >
            <div class="container-custom">
                <div class="text-center max-w-3xl mx-auto mb-20">
                    <h2 class="text-4xl md:text-6xl font-black mb-6">
                        Expert <span
                            class="gradient-text !from-orange-500 !to-red-600"
                            >Magento 2</span
                        > Services
                    </h2>
                    <p class="text-gray-400 text-xl">
                        From initial build to deep technical optimization, we
                        cover the entire Magento lifecycle.
                    </p>
                </div>

                <div
                    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8"
                >
                    <div
                        class="animate-on-scroll feature-card hover:border-orange-500/30"
                    >
                        <Icon
                            name="ph:code-duotone"
                            class="w-12 h-12 text-orange-500 mb-6"
                        />
                        <h4 class="text-xl font-bold mb-4">
                            Bespoke Development
                        </h4>
                        <p class="text-sm text-gray-500 leading-relaxed">
                            Custom module development and complex third-party
                            integrations (ERP, CRM, PIM).
                        </p>
                    </div>
                    <div
                        class="animate-on-scroll delay-1 feature-card hover:border-orange-500/30"
                    >
                        <Icon
                            name="ph:rocket-duotone"
                            class="w-12 h-12 text-orange-500 mb-6"
                        />
                        <h4 class="text-xl font-bold mb-4">
                            Magento Migration
                        </h4>
                        <p class="text-sm text-gray-500 leading-relaxed">
                            Zero-downtime migrations from Magento 1, Shopify, or
                            WooCommerce to Magento 2.
                        </p>
                    </div>
                    <div
                        class="animate-on-scroll delay-2 feature-card hover:border-orange-500/30"
                    >
                        <Icon
                            name="ph:gauge-duotone"
                            class="w-12 h-12 text-orange-500 mb-6"
                        />
                        <h4 class="text-xl font-bold mb-4">
                            Speed Optimization
                        </h4>
                        <p class="text-sm text-gray-500 leading-relaxed">
                            Advanced Varnish, Redis, and Image optimization for
                            sub-second page loads.
                        </p>
                    </div>
                    <div
                        class="animate-on-scroll delay-3 feature-card hover:border-orange-500/30"
                    >
                        <Icon
                            name="ph:arrows-clockwise-duotone"
                            class="w-12 h-12 text-orange-500 mb-6"
                        />
                        <h4 class="text-xl font-bold mb-4">24/7 Support</h4>
                        <p class="text-sm text-gray-500 leading-relaxed">
                            Ongoing maintenance, security patches, and proactive
                            monitoring in London time.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Deep SEO Content -->
        <section class="py-24">
            <div class="container-custom">
                <div
                    class="max-w-4xl mx-auto prose prose-invert prose-orange text-lg leading-relaxed"
                >
                    <h2 class="text-4xl font-black text-white mb-10">
                        Bespoke Magento 2 Solutions for London Retailers
                    </h2>
                    <p>
                        Operating a high-traffic e-commerce store in London
                        requires a technical partner who understands the stakes.
                        As a specialized <strong>Magento agency London</strong>,
                        we don't just build sites; we engineer durable growth
                        engines that handle thousands of concurrent users across
                        the globe.
                    </p>

                    <h3 class="text-3xl font-black text-white mt-16 mb-6">
                        Adobe Commerce & Open Source Expertise
                    </h3>
                    <p>
                        Whether you are leveraging **Adobe Commerce Cloud** or
                        the **Magento Open Source** edition, our certified <i
                            >Magento developers in London</i
                        > have the deep core knowledge required to customize the framework
                        without compromising upgradability. We strictly follow Magento
                        coding standards and PSR-12 principles.
                    </p>

                    <div
                        class="bg-gradient-to-r from-orange-600/10 to-transparent border-l-4 border-orange-600 p-8 my-12 rounded-r-2xl"
                    >
                        <h4 class="text-2xl font-black text-white mb-4">
                            The PWA & Headless Future
                        </h4>
                        <p class="text-gray-300">
                            For London's leading fashion and luxury brands,
                            speed is luxury. We specialize in
                            <strong>Headless Magento</strong> architectures using
                            **Vue Storefront** and **Magento PWA Studio**, delivering
                            sub-second experiences that drive mobile conversions higher
                            than ever before.
                        </p>
                    </div>

                    <h3 class="text-3xl font-black text-white mt-16 mb-6">
                        Localized London Logistics
                    </h3>
                    <p>
                        Being a local <i>software development agency</i>, we
                        understand the intricacies of the UK shipping and
                        payment landscape. We've built custom integrations for:
                    </p>
                    <ul
                        class="grid grid-cols-1 sm:grid-cols-2 gap-4 not-prose my-10 font-bold text-sm"
                    >
                        <li
                            class="flex items-center gap-3 p-4 bg-white/5 rounded-xl border border-white/10 italic"
                        >
                            <Icon
                                name="ph:truck-duotone"
                                class="w-5 h-5 text-orange-500"
                            />
                            Royal Mail & DPD Local
                        </li>
                        <li
                            class="flex items-center gap-3 p-4 bg-white/5 rounded-xl border border-white/10 italic"
                        >
                            <Icon
                                name="ph:credit-card-duotone"
                                class="w-5 h-5 text-orange-500"
                            />
                            Worldpay & Barclaycard
                        </li>
                        <li
                            class="flex items-center gap-3 p-4 bg-white/5 rounded-xl border border-white/10 italic"
                        >
                            <Icon
                                name="ph:globe-duotone"
                                class="w-5 h-5 text-orange-500"
                            />
                            Global-e Cross-border
                        </li>
                        <li
                            class="flex items-center gap-3 p-4 bg-white/5 rounded-xl border border-white/10 italic"
                        >
                            <Icon
                                name="ph:package-duotone"
                                class="w-5 h-5 text-orange-500"
                            />
                            Linnworks & Brightpearl
                        </li>
                    </ul>
                </div>
            </div>
        </section>

        <!-- FAQ for Magento -->
        <section class="py-24 bg-white/2">
            <div class="container-custom">
                <div class="max-w-4xl mx-auto">
                    <h2 class="text-4xl font-black text-center mb-16">
                        Magento Agency <span
                            class="gradient-text !from-orange-500 !to-red-600"
                            >FAQ</span
                        >
                    </h2>
                    <div class="space-y-6">
                        <div class="p-8 glass-card border-white/10">
                            <h4 class="text-xl font-bold mb-4 text-white">
                                How do you optimize Magento 2 for speed?
                            </h4>
                            <p class="text-gray-400">
                                We implement a multi-layer caching strategy
                                using Varnish and Redis, optimize database
                                queries, use high-performance NVMe hosting, and
                                ensure all JS/CSS is minified and deferred using
                                modern front-end best practices.
                            </p>
                        </div>
                        <div class="p-8 glass-card border-white/10">
                            <h4 class="text-xl font-bold mb-4 text-white">
                                Are your Magento developers based in London?
                            </h4>
                            <p class="text-gray-400">
                                Our core strategic and project management team
                                is based in Central London, providing you with
                                localized support and face-to-face consultation
                                when needed. Our development team operates on
                                GMT/EST time to ensure maximum coverage.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Structured Data -->
        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "LocalBusiness",
                "name": "Magento Agency London - Laravel Company",
                "image": "https://laravelcompany.com/logo.svg",
                "@id": "https://laravelcompany.com/magento-agency-london",
                "url": "https://laravelcompany.com",
                "telephone": "+44 744 821 88 99",
                "address": {
                    "@type": "PostalAddress",
                    "streetAddress": "EC1A 1BB",
                    "addressLocality": "London",
                    "addressCountry": "GB"
                },
                "areaServed": "London",
                "priceRange": "$$$$"
            }
        </script>
        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "Service",
                "serviceType": "Magento Development",
                "provider": {
                    "@type": "LocalBusiness",
                    "name": "Magento Agency London"
                },
                "description": "Expert Magento 2 development services in London, specializing in scaling high-volume e-commerce stores."
            }
        </script>

        <section class="py-10 px-6 text-center text-white/60 text-sm">
            For Magento builds, migrations and support beyond London, see our sister company <a href="https://magentocompany.com/" class="text-payflo-purple hover:text-payflo-pink">Magento Company</a>.
        </section>

        <CTASection />
    </main>
</Layout>

<style>
    .btn {
        @apply inline-flex items-center justify-center font-black transition-all duration-300 rounded-2xl border-none;
    }
    .btn-primary {
        @apply text-white hover:-translate-y-1;
    }
    .glass-card {
        @apply bg-white/5 backdrop-blur-xl border border-white/10 rounded-3xl shadow-2xl;
    }
    .feature-card {
        @apply p-8 bg-white/5 rounded-3xl border border-white/10 transition-all duration-500;
    }
    .gradient-text {
        @apply bg-clip-text text-transparent bg-gradient-to-r from-orange-500 to-red-600;
    }
</style>
