  "description": "Comprehensive Laravel development services including custom web applications, APIs, AI integration, consulting, maintenance, and industry-specific solutions.",
  "url": "https://laravelcompany.com/services/",
  "numberOfItems": services.length,
  "itemListElement": services.map((s, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "item": {
      "@type": "Service",
      "name": s.title,
      "url": `https://laravelcompany.com${s.slug}`,
      "provider": {
        "@type": "Organization",
        "name": "Laravel Company"
      }
    }
  }))
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": ["Service", "ProfessionalService"],
  "serviceType": "Laravel Development Services",
  "provider": {
    "@type": "Organization",
    "name": "Laravel Company",
    "url": "https://laravelcompany.com",
    "logo": "https://laravelcompany.com/logo.svg",
    "aggregateRating": reviewsAggregate,
    "review": reviewsSchemaJSON
  },
  "description": "Custom Laravel development services including web applications, SaaS platforms, API development, AI integration, consulting, audits, maintenance, and migration. UK-based Laravel development company with 500+ projects delivered.",
  "areaServed": ["GB", "US", "EU", "Worldwide"],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Laravel Development Services",
    "itemListElement": services.map(s => ({
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": s.title
      }
    }))
  }
};

const webpageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Laravel Development Services | Custom Software, APIs, AI & Consulting",
  "description": "Laravel development services including custom web applications, SaaS platforms, API development, AI integrations, consulting, audits, maintenance and enterprise solutions.",
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": [".speakable-heading", ".speakable-text"]
  },
  "about": {
    "@type": "Thing",
    "name": "Laravel Development Services"
  },
  "provider": {
    "@type": "Organization",
    "name": "Laravel Company"
  }
};
---

<Layout
  title="Laravel Development Services | Custom Software, APIs, AI & Consulting"
  description="Laravel development services including custom web applications, SaaS platforms, API development, AI integrations, consulting, audits, maintenance and enterprise solutions. 500+ projects delivered."
>
  <main>
    <!-- Hero -->
    <section class="pt-24 pb-20 md:pt-32 md:pb-28 overflow-hidden relative bg-payflo-dark speakable-text">
      <div class="absolute inset-0 opacity-10 -z-10">
        <div class="absolute top-0 left-0 w-full h-full bg-[radial-gradient(circle_at_50%_120%,rgba(120,119,198,0.3),rgba(255,255,255,0))]"></div>
      </div>
      <div class="container-custom relative">
        <nav class="flex justify-center items-center gap-2 text-sm text-white/50 mb-8 animate-on-scroll">
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <span>/</span>
          <span class="text-white">Services</span>
        </nav>
        <div class="max-w-4xl mx-auto text-center">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-payflo-purple/10 border border-payflo-purple/20 mb-8 animate-on-scroll">
            <Icon name="ph:buildings-duotone" class="w-5 h-5 text-payflo-purple" />
            <span class="text-sm font-bold uppercase tracking-widest text-white/70">Laravel Agency</span>
          </div>
          <h1 class="animate-on-scroll delay-1 text-5xl md:text-7xl lg:text-8xl font-black leading-tight tracking-tight text-white">
            Laravel <span class="gradient-text">Development Services</span>
          </h1>
          <p class="animate-on-scroll delay-2 mt-8 text-lg md:text-xl text-white/70 leading-relaxed font-medium max-w-3xl mx-auto">
            We are a UK-based Laravel development company delivering custom web applications, SaaS platforms, API-first architectures, AI integrations, and enterprise solutions. 500+ projects delivered with a 4.9/5 client rating. Every project is built with security-first practices, scalable architecture, and long-term maintainability in mind.
          </p>
          <div class="animate-on-scroll delay-3 mt-12 flex flex-wrap justify-center gap-6">
            <a href="/contact/" class="btn btn-primary px-10 py-5 text-lg shadow-2xl">Get Free Quote</a>
            <a href="/hire-laravel-developer/" class="btn glass-card border-white/20 px-10 py-5 text-lg hover:bg-white/10 transition-all font-bold">Hire Laravel Developers</a>
          </div>
          <div class="animate-on-scroll delay-4 mt-10 flex flex-wrap justify-center gap-8 text-sm text-white/60 font-bold uppercase tracking-widest">
            <span class="flex items-center gap-2"><Icon name="ph:star-fill" class="w-4 h-4 text-yellow-400" /> 4.9/5 Rating</span>
            <span class="flex items-center gap-2"><Icon name="ph:check-circle-fill" class="w-4 h-4 text-green-400" /> 500+ Projects</span>
            <span class="flex items-center gap-2"><Icon name="ph:map-pin-fill" class="w-4 h-4 text-payflo-purple" /> UK & Global</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Intro Section -->
    <section class="py-24 speakable-heading">
      <div class="container-custom max-w-5xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-16 animate-on-scroll">
          <h2 class="text-4xl md:text-5xl font-black mb-6">Custom Laravel <span class="gradient-text">Development Services</span></h2>
        </div>
        <div class="glass-card p-8 md:p-10 border-white/10 animate-on-scroll">
          <p class="mb-6 text-gray-300">Laravel has become the framework of choice for modern web application development, powering everything from startup MVPs to enterprise-grade systems serving millions of users. As a leading <strong class="text-white">Laravel development company</strong>, we have delivered 500+ projects across industries including healthcare, fintech, e-commerce, logistics, and SaaS — each one built with a focus on security, scalability, and long-term maintainability.</p>
          <p class="mb-6 text-gray-300">What makes Laravel exceptional is its comprehensive ecosystem. Unlike other frameworks that require developers to piece together third-party libraries for basic functionality, Laravel ships with built-in authentication, encryption, queue management, event broadcasting, caching, validation, and testing tools — all maintained by a dedicated core team with a clear release roadmap. For businesses, this means faster development cycles, lower maintenance costs, and reduced technical risk. As an experienced <strong class="text-white">Laravel development agency</strong>, we leverage this ecosystem to deliver production-ready applications in weeks, not months.</p>
          <p class="mb-6 text-gray-300">Our team specialises in building enterprise applications that handle complex business logic, high-throughput transaction processing, and sensitive data requiring robust security controls. We build SaaS platforms with multi-tenant architecture, subscription billing, and usage analytics. We design API-first systems that power mobile applications, third-party integrations, and microservice ecosystems. We integrate artificial intelligence into Laravel applications, connecting OpenAI, Anthropic, and Google Gemini models with your proprietary data through retrieval-augmented generation pipelines. Every solution is built with an architecture-first approach, ensuring your application can grow, evolve, and adapt to changing business requirements without requiring rewrites.</p>
          <p class="text-gray-300">As <strong class="text-white">Laravel developers</strong>, we bring deep expertise across the full Laravel ecosystem — from Horizon and Nova to Reverb and Vapor — combined with years of experience building <strong class="text-white">custom Laravel development</strong> solutions for businesses worldwide. Whether you need <strong class="text-white">Laravel software development</strong> for a new product, <strong class="text-white">Laravel web application development</strong> for an internal business tool, or expert consulting to improve an existing Laravel application, our team delivers the technical excellence and strategic guidance that transforms your vision into a reliable, scalable product.</p>
        </div>
      </div>
    </section>

    <!-- Detailed Service Blocks -->
    <section class="py-24 bg-white/5">
      <div class="container-custom">
        <div class="text-center max-w-3xl mx-auto mb-16 animate-on-scroll">
          <h2 class="text-4xl md:text-5xl font-black mb-6">Our Laravel <span class="gradient-text">Services</span></h2>
          <p class="text-gray-400 text-lg">Comprehensive Laravel development services covering every stage of your project — from strategy and architecture through development, deployment, and ongoing support.</p>
        </div>
        <div class="space-y-8 max-w-6xl mx-auto">
          {services.map((service, i) => (
            <div class="animate-on-scroll glass-card p-8 md:p-10 border-white/10 group hover:border-payflo-purple/50 transition-colors">
              <div class="flex items-start gap-5 mb-5">
                <Icon name={service.icon} class="w-10 h-10 text-payflo-purple mt-1 group-hover:scale-110 transition-transform shrink-0" />
                <h3 class="text-2xl font-black text-white">{service.title}</h3>
              </div>
              <p class="text-gray-400 text-sm leading-relaxed mb-6">{service.desc}</p>
              <a href={service.slug} class="inline-flex items-center gap-2 text-payflo-purple font-bold hover:text-payflo-pink transition-colors text-sm">
                {service.linkText} <Icon name="ph:arrow-right" class="w-4 h-4" />
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- High-Intent SEO Pages -->
    <section class="py-24">
      <div class="container-custom">
        <div class="text-center max-w-3xl mx-auto mb-16 animate-on-scroll">
          <h2 class="text-4xl md:text-5xl font-black mb-6">High-Intent <span class="gradient-text">SEO Pages</span></h2>
          <p class="text-gray-400 text-lg">Landing pages built around buyer-ready search terms with strong commercial intent.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6 max-w-6xl mx-auto">
          <a href="/hire-dedicated-laravel-developers/" class="glass-card p-6 border-white/10 hover:border-payflo-purple/50 transition-colors group">
            <Icon name="ph:user-focus-duotone" class="w-8 h-8 text-payflo-purple mb-4 group-hover:scale-110 transition-transform" />
            <h3 class="text-lg font-bold mb-2 text-white">Hire Dedicated Laravel Developers</h3>
            <p class="text-gray-400 text-xs leading-relaxed">Dedicated resource, shortlist fast, and flexible delivery models.</p>
          </a>
          <a href="/laravel-migration-services/" class="glass-card p-6 border-white/10 hover:border-payflo-purple/50 transition-colors group">
            <Icon name="ph:arrows-clockwise-duotone" class="w-8 h-8 text-payflo-purple mb-4 group-hover:scale-110 transition-transform" />
            <h3 class="text-lg font-bold mb-2 text-white">Laravel Migration Services</h3>
            <p class="text-gray-400 text-xs leading-relaxed">CodeIgniter, WordPress, and legacy PHP migrations.</p>
          </a>
          <a href="/laravel-maintenance-support/" class="glass-card p-6 border-white/10 hover:border-payflo-purple/50 transition-colors group">
            <Icon name="ph:wrench-duotone" class="w-8 h-8 text-payflo-purple mb-4 group-hover:scale-110 transition-transform" />
            <h3 class="text-lg font-bold mb-2 text-white">Laravel Maintenance Support</h3>
            <p class="text-gray-400 text-xs leading-relaxed">Bug fixes, security patching, upgrades, and retainers.</p>
          </a>
          <a href="/laravel-api-integration-services/" class="glass-card p-6 border-white/10 hover:border-payflo-purple/50 transition-colors group">
            <Icon name="ph:plugs-connected-duotone" class="w-8 h-8 text-payflo-purple mb-4 group-hover:scale-110 transition-transform" />
            <h3 class="text-lg font-bold mb-2 text-white">Laravel API Integration Services</h3>
            <p class="text-gray-400 text-xs leading-relaxed">Payment gateways, CRM syncs, ERP connectors, and webhooks.</p>
          </a>
          <a href="/laravel-development-company-usa/" class="glass-card p-6 border-white/10 hover:border-payflo-purple/50 transition-colors group">
            <Icon name="ph:flag-banner-duotone" class="w-8 h-8 text-payflo-purple mb-4 group-hover:scale-110 transition-transform" />
            <h3 class="text-lg font-bold mb-2 text-white">Laravel Development Company USA</h3>
            <p class="text-gray-400 text-xs leading-relaxed">Remote Laravel team for US buyers with timezone overlap.</p>
          </a>
          <a href="/laravel-livewire-development/" class="glass-card p-6 border-white/10 hover:border-payflo-purple/50 transition-colors group">
            <Icon name="ph:layout-duotone" class="w-8 h-8 text-payflo-purple mb-4 group-hover:scale-110 transition-transform" />
            <h3 class="text-lg font-bold mb-2 text-white">Laravel Livewire Development</h3>
            <p class="text-gray-400 text-xs leading-relaxed">Reactive dashboards and forms with less frontend complexity.</p>
          </a>
          <a href="/laravel-aws-deployment-services/" class="glass-card p-6 border-white/10 hover:border-payflo-purple/50 transition-colors group">
            <Icon name="ph:cloud-arrow-up-duotone" class="w-8 h-8 text-payflo-purple mb-4 group-hover:scale-110 transition-transform" />
            <h3 class="text-lg font-bold mb-2 text-white">Laravel AWS Deployment Services</h3>
            <p class="text-gray-400 text-xs leading-relaxed">CI/CD, scaling, backups, and production infrastructure.</p>
          </a>
          <a href="/laravel-custom-module-development/" class="glass-card p-6 border-white/10 hover:border-payflo-purple/50 transition-colors group">
            <Icon name="ph:puzzle-piece-duotone" class="w-8 h-8 text-payflo-purple mb-4 group-hover:scale-110 transition-transform" />
            <h3 class="text-lg font-bold mb-2 text-white">Laravel Custom Module Development</h3>
            <p class="text-gray-400 text-xs leading-relaxed">Add structured features to existing Laravel apps.</p>
          </a>
        </div>
      </div>
    </section>

    <!-- Industries We Serve -->
    <section class="py-24">
      <div class="container-custom max-w-6xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-16 animate-on-scroll">
          <h2 class="text-4xl md:text-5xl font-black mb-6">Industries <span class="gradient-text">We Serve</span></h2>
          <p class="text-gray-400 text-lg">Deep domain expertise across industries. Each sector has unique requirements, compliance considerations, and user expectations — and we bring specialist knowledge to every project.</p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {industries.map((ind, i) => (
            <a
              href={ind.slug}
              class="animate-on-scroll glass-card p-6 border-white/10 hover:border-payflo-purple/50 transition-colors group"
            >
              <Icon name={ind.icon} class="w-8 h-8 text-payflo-purple mb-4 group-hover:scale-110 transition-transform" />
              <h3 class="text-lg font-bold mb-2 text-white">{ind.title}</h3>
              <p class="text-gray-400 text-xs leading-relaxed">{ind.desc}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Development Process -->
    <section class="py-24 bg-white/5">
      <div class="container-custom max-w-6xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-16 animate-on-scroll">
          <h2 class="text-4xl md:text-5xl font-black mb-6">Our Laravel <span class="gradient-text">Development Process</span></h2>
          <p class="text-gray-400 text-lg">A proven, structured approach to delivering high-quality Laravel applications on time and on budget. Every project follows this end-to-end methodology.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {processSteps.map((step, i) => (
            <div class="animate-on-scroll glass-card p-6 border-white/10 hover:border-payflo-purple/50 transition-colors">
              <span class="inline-block text-3xl font-black text-payflo-purple/30 mb-3">{step.step}</span>
              <h3 class="text-xl font-black mb-3 text-white">{step.title}</h3>
              <p class="text-gray-400 text-xs leading-relaxed">{step.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Technology Stack -->
    <section class="py-24">
      <div class="container-custom max-w-6xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-16 animate-on-scroll">
          <h2 class="text-4xl md:text-5xl font-black mb-6">Technologies <span class="gradient-text">We Work With</span></h2>
          <p class="text-gray-400 text-lg">Modern technology stack covering backend, frontend, mobile, AI, infrastructure, and databases. We select the right tools for each project's specific requirements.</p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
          {techCategories.map((cat, i) => (
            <div class="animate-on-scroll glass-card p-8 border-white/10">
              <Icon name={cat.icon} class="w-10 h-10 text-payflo-purple mb-5" />
              <h3 class="text-xl font-black mb-5 text-white">{cat.title}</h3>
              <ul class="space-y-3">
                {cat.items.map(item => (
                  <li class="flex items-start gap-3 text-gray-400 text-sm">
                    <Icon name="ph:check-circle-duotone" class="w-5 h-5 text-payflo-purple mt-0.5 shrink-0" />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Laravel Expertise -->
    <section class="py-24 bg-white/5">
      <div class="container-custom max-w-6xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-16 animate-on-scroll">
          <h2 class="text-4xl md:text-5xl font-black mb-6">Laravel <span class="gradient-text">Expertise</span></h2>
          <p class="text-gray-400 text-lg">Deep mastery of the Laravel ecosystem. We leverage first-party Laravel packages to build robust, maintainable applications faster.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {laravelExpertise.map((exp, i) => (
            <div class="animate-on-scroll glass-card p-6 border-white/10 hover:border-payflo-purple/50 transition-colors">
              <h3 class="text-lg font-black mb-2 text-white">{exp.name}</h3>
              <p class="text-gray-400 text-xs leading-relaxed">{exp.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Why Laravel / Comparison -->
    <section class="py-24">
      <div class="container-custom max-w-6xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-16 animate-on-scroll">
          <h2 class="text-4xl md:text-5xl font-black mb-6">Why Choose <span class="gradient-text">Laravel?</span></h2>
          <p class="text-gray-400 text-lg">Laravel offers unique advantages for business application development compared to other popular frameworks. Here is how it compares across the dimensions that matter most to your project.</p>
        </div>
        <div class="space-y-8">
          {comparisons.map((comp, i) => (
            <div class="animate-on-scroll glass-card p-8 border-white/10">
              <div class="flex items-center gap-3 mb-6">
                <h3 class="text-2xl font-black text-white">Laravel vs</h3>
                <span class="text-2xl font-black text-payflo-pink">{comp.framework}</span>
                <span class="text-sm text-gray-500 font-medium">| {comp.useCase}</span>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="p-4 rounded-xl bg-white/[0.02] border border-white/5">
                  <h4 class="text-sm font-bold text-payflo-purple mb-2">Development Speed</h4>
                  <p class="text-gray-400 text-xs leading-relaxed">{comp.devSpeed}</p>
                </div>
                <div class="p-4 rounded-xl bg-white/[0.02] border border-white/5">
                  <h4 class="text-sm font-bold text-payflo-purple mb-2">Security</h4>
                  <p class="text-gray-400 text-xs leading-relaxed">{comp.security}</p>
                </div>
                <div class="p-4 rounded-xl bg-white/[0.02] border border-white/5">
                  <h4 class="text-sm font-bold text-payflo-purple mb-2">Ecosystem</h4>
                  <p class="text-gray-400 text-xs leading-relaxed">{comp.ecosystem}</p>
                </div>
                <div class="p-4 rounded-xl bg-white/[0.02] border border-white/5">
                  <h4 class="text-sm font-bold text-payflo-purple mb-2">Cost & Maintenance</h4>
                  <p class="text-gray-400 text-xs leading-relaxed">{comp.cost}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Case Studies -->
    <section class="py-24 bg-white/5">
      <div class="container-custom max-w-5xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-16 animate-on-scroll">
          <h2 class="text-4xl md:text-5xl font-black mb-6">Recent Laravel <span class="gradient-text">Projects</span></h2>
          <p class="text-gray-400 text-lg">Real projects demonstrating our Laravel development expertise across SaaS, marketplace, AI, and healthcare domains.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {caseStudies.map((cs, i) => (
            <div class="animate-on-scroll glass-card p-8 border-white/10 hover:border-payflo-purple/50 transition-colors">
              <div class="flex items-center gap-3 mb-4">
                <Icon name={cs.icon} class="w-8 h-8 text-payflo-pink" />
                <div>
                  <h3 class="text-xl font-black text-white">{cs.title}</h3>
                  <p class="text-gray-500 text-xs">{cs.subtitle}</p>
                </div>
              </div>
              <p class="text-gray-400 text-sm leading-relaxed mb-5">{cs.desc}</p>
              <ul class="space-y-2">
                {cs.results.map(r => (
                  <li class="flex items-start gap-3 text-gray-400 text-xs">
                    <Icon name="ph:check-circle-duotone" class="w-4 h-4 text-payflo-purple mt-0.5 shrink-0" />
                    <span>{r}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- E-E-A-T / Why Companies Choose Us -->
    <section class="py-24">
      <div class="container-custom max-w-5xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-16 animate-on-scroll">
          <h2 class="text-4xl md:text-5xl font-black mb-6">Why Companies Choose Our <span class="gradient-text">Laravel Developers</span></h2>
        </div>
        <div class="glass-card p-8 md:p-10 border-white/10 animate-on-scroll">
          <p class="mb-6 text-gray-300">Companies choose to work with our Laravel developers because we bring more than technical skills to every project — we bring strategic thinking, architectural discipline, and a genuine commitment to our clients' success. Our team has been building Laravel applications since the framework's early releases, accumulating years of production experience across hundreds of projects spanning startups, scale-ups, and enterprise organisations.</p>
          <p class="mb-6 text-gray-300">We take an architecture-first approach to every engagement. Before writing a single line of code, we invest in understanding your business domain, technical constraints, integration requirements, and long-term roadmap. This upfront investment means fewer surprises, less rework, and a system designed to grow with your business. Our security mindset means every application is built with defence in depth — encryption, authentication, authorisation, input validation, and audit logging are not afterthoughts but foundational design decisions.</p>
          <p class="mb-6 text-gray-300">Our team actively contributes to the Laravel ecosystem through open-source packages, community knowledge sharing, and ongoing engagement with the Laravel core team. We maintain several open-source Laravel packages and regularly publish technical content to help the broader Laravel community build better applications. This commitment to the ecosystem ensures we stay at the forefront of Laravel best practices and emerging capabilities.</p>
          <p class="mb-6 text-gray-300">We build long-term partnerships, not one-off projects. Many of our clients have worked with us for years, evolving their applications through multiple major releases, feature expansions, and architecture migrations. Our code quality standards — comprehensive test coverage, clean architecture patterns, thorough documentation, and consistent coding conventions — ensure that your application remains maintainable and extensible long after the initial development phase.</p>
          <p class="text-gray-300">Our track record speaks for itself: 500+ projects delivered, 4.9/5 average client rating, and long-term relationships with clients across 20+ countries. When you hire our <strong class="text-white">Laravel experts</strong>, you gain a technical partner who cares as much about your project's success as you do.</p>
        </div>
      </div>
    </section>

    <!-- Location Pages -->
    <section class="py-24 bg-white/5">
      <div class="container-custom">
        <div class="text-center max-w-3xl mx-auto mb-16 animate-on-scroll">
          <h2 class="text-4xl md:text-5xl font-black text-white leading-tight">
            Laravel Development by <span class="gradient-text">Location</span>
          </h2>
          <p class="mt-6 text-xl text-white/70 font-medium">
            Find expert <strong class="text-white">Laravel developers</strong> in your city. Local expertise with global standards.
          </p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
