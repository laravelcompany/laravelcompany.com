---
import Layout from "../layouts/Layout.astro";
import CTASection from "../components/CTASection.astro";
import { Icon } from "astro-icon/components";
---

<Layout
    title="Hire AWS Consultant | Certified Cloud Architecture Experts"
    description="Hire a certified AWS consultant to scale your business with secure, high-performance cloud solutions and expert guidance."
>
    <main id="main-content">
        <!-- Hero Section -->
        <section
            class="pt-24 pb-20 md:pt-32 md:pb-28 overflow-hidden relative bg-payflo-dark"
        >
            <div class="absolute inset-0 opacity-10 -z-10">
                <div
                    class="absolute top-0 left-0 w-full h-full bg-[radial-gradient(circle_at_50%_120%,rgba(120,119,198,0.3),rgba(255,255,255,0))]"
                >
                </div>
            </div>
            <div class="container-custom relative">
                <nav class="flex justify-center items-center gap-2 text-sm text-white/50 mb-8 animate-on-scroll">
                    <a href="/" class="hover:text-white transition-colors">Home</a>
                    <span>/</span>
                    <span class="text-white">AWS Consulting</span>
                </nav>
                <div class="max-w-4xl mx-auto text-center">
                    <div
                        class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/5 border border-white/10 mb-8 animate-on-scroll"
                    >
                        <Icon
                            name="ph:cloud-check-duotone"
                            class="w-5 h-5 text-payflo-purple"
                        />
                        <span
                            class="text-sm font-bold uppercase tracking-widest text-white/70"
                            >Certified AWS Solutions Architects</span
                        >
                    </div>
                    <h1
                        class="text-5xl md:text-7xl lg:text-8xl font-black leading-tight tracking-tight text-white"
                    >
                        Hire a Certified <span class="gradient-text"
                            >AWS Consultant</span
                        >
                    </h1>
                    <p
                        class="animate-on-scroll delay-2 mt-8 text-xl md:text-2xl text-white/70 leading-relaxed font-medium"
                    >
                        Stop guessing and start scaling. Our AWS experts provide
                        the architectural clarity and engineering precision you
                        need to build a future-proof cloud ecosystem.
                    </p>
                    <div
                        class="animate-on-scroll delay-3 mt-12 flex flex-wrap justify-center gap-6"
                    >
                        <a
                            href="/contact/"
                            class="btn btn-primary px-10 py-5 text-lg shadow-2xl"
                            >Hire an Expert Now</a
                        >
                        <a
                            href="#services"
                            class="btn glass-card border-white/20 px-10 py-5 text-lg hover:bg-white/10 transition-all font-bold"
                            >Explore Services</a
                        >
                    </div>
                </div>
            </div>
        </section>

        <!-- Value Proposition -->
        <section class="py-24 border-y border-white/5">
            <div class="container-custom">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-12 text-center">
                    <div class="animate-on-scroll">
                        <div
                            class="w-16 h-16 bg-payflo-purple/10 rounded-2xl flex items-center justify-center mx-auto mb-6 border border-payflo-purple/20"
                        >
                            <Icon
                                name="ph:currency-circle-dollar-duotone"
                                class="w-10 h-10 text-payflo-purple"
                            />
                        </div>
                        <h3 class="text-2xl font-black mb-4">
                            Cost Optimization
                        </h3>
                        <p class="text-gray-400">
                            Reduce your monthly AWS bill by up to 40% through
                            intelligent resource allocation and reserved
                            instance management.
                        </p>
                    </div>
                    <div class="animate-on-scroll delay-1">
                        <div
                            class="w-16 h-16 bg-payflo-pink/10 rounded-2xl flex items-center justify-center mx-auto mb-6 border border-payflo-pink/20"
                        >
                            <Icon
                                name="ph:shield-check-duotone"
                                class="w-10 h-10 text-payflo-pink"
                            />
                        </div>
                        <h3 class="text-2xl font-black mb-4">
                            Bulletproof Security
                        </h3>
                        <p class="text-gray-400">
                            Implement IAM best practices, VPC isolation, and
                            automated threat detection to keep your data secure
                            and compliant.
                        </p>
                    </div>
                    <div class="animate-on-scroll delay-2">
                        <div
                            class="w-16 h-16 bg-payflo-purple/10 rounded-2xl flex items-center justify-center mx-auto mb-6 border border-payflo-purple/20"
                        >
                            <Icon
                                name="ph:chart-line-up-duotone"
                                class="w-10 h-10 text-payflo-purple"
                            />
                        </div>
                        <h3 class="text-2xl font-black mb-4">
                            Hyper-Scalability
                        </h3>
                        <p class="text-gray-400">
                            Leverage serverless and containerized environments
                            to handle traffic spikes with zero performance
                            degradation.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Services Grid -->
        <section id="services" class="py-24 relative overflow-hidden">
            <div class="container-custom">
                <div class="text-center max-w-3xl mx-auto mb-20">
                    <h2 class="text-4xl md:text-5xl font-black mb-6">
                        Our AWS <span class="gradient-text"
                            >Consulting Services</span>
                    </h2>
                    <p class="text-gray-400 text-lg">
                        We provide end-to-end cloud engineering, from initial
                        strategy to 24/7 managed infrastructure.
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div
                        class="animate-on-scroll glass-card p-12 border-white/10 group hover:border-payflo-purple/50 transition-colors"
                    >
                        <Icon
                            name="ph:airplane-tilt-duotone"
                            class="w-12 h-12 text-payflo-purple mb-8 group-hover:scale-110 transition-transform"
                        />
                        <h3 class="text-3xl font-black mb-6">
                            Cloud Migration
                        </h3>
                        <p class="text-gray-400 text-lg mb-8 leading-relaxed">
                            Seamlessly transition your legacy infrastructure to
                            AWS. We handle the entire "Lift and Shift" or
                            "Refactoring" process with zero downtime, ensuring
                            your data integrity is maintained throughout.
                        </p>
                        <ul class="space-y-3 text-sm font-bold text-white/70">
                            <li class="flex items-center gap-2">
                                <Icon
                                    name="ph:check-circle-fill"
                                    class="w-5 h-5 text-payflo-purple"
                                /> Database Migration (RDS)
                            </li>
                            <li class="flex items-center gap-2">
                                <Icon
                                    name="ph:check-circle-fill"
                                    class="w-5 h-5 text-payflo-purple"
                                /> On-Premise to VPC Migration
                            </li>
                            <li class="flex items-center gap-2">
                                <Icon
                                    name="ph:check-circle-fill"
                                    class="w-5 h-5 text-payflo-purple"
                                /> Zero-Downtime Strategy
                            </li>
                        </ul>
                    </div>

                    <div
                        class="animate-on-scroll delay-1 glass-card p-12 border-white/10 group hover:border-payflo-pink/50 transition-colors"
                    >
                        <Icon
                            name="ph:lightning-duotone"
                            class="w-12 h-12 text-payflo-pink mb-8 group-hover:scale-110 transition-transform"
                        />
                        <h3 class="text-3xl font-black mb-6">
                            Serverless Architecture
                        </h3>
                        <p class="text-gray-400 text-lg mb-8 leading-relaxed">
                            Adopt the future of cloud computing. We design
                            event-driven architectures using AWS Lambda,
                            Fargate, and API Gateway to bring your operational
                            costs to near-zero for idle time.
                        </p>
                        <ul class="space-y-3 text-sm font-bold text-white/70">
                            <li class="flex items-center gap-2">
                                <Icon
                                    name="ph:check-circle-fill"
                                    class="w-5 h-5 text-payflo-pink"
                                /> AWS Lambda & Step Functions
                            </li>
                            <li class="flex items-center gap-2">
                                <Icon
                                    name="ph:check-circle-fill"
                                    class="w-5 h-5 text-payflo-pink"
                                /> DynamoDB Schema Design
                            </li>
                            <li class="flex items-center gap-2">
                                <Icon
                                    name="ph:check-circle-fill"
                                    class="w-5 h-5 text-payflo-pink"
                                /> Event-Driven Microservices
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>

        <!-- Deep Technical Content -->
        <section class="py-24 bg-white/5">
            <div class="container-custom">
                <div
                    class="max-w-4xl mx-auto prose prose-invert prose-purple text-lg leading-relaxed"
                >
                    <h2 class="text-4xl font-black text-white mb-10">
                        Why Work With an AWS Specialized Consultant?
                    </h2>
                    <p>
                        Cloud complexity is the silent killer of modern software
                        projects. Without a certified
                        <strong>AWS consultant</strong>, your infrastructure can
                        quickly become a bloated, insecure, and expensive
                        liability.
                    </p>

                    <h3 class="text-3xl font-black text-white mt-16 mb-6">
                        Infrastructure as Code (IaC)
                    </h3>
                    <p>
                        We believe that if it's not in code, it's not in
                        production. Our <i>AWS consulting services</i>
                        specialize in **Terraform** and **AWS CDK**, ensuring your
                        environment is reproducible, version-controlled, and transparent.
                        No "mystery clicks" in the AWS Console—just clean, automated
                        infrastructure.
                    </p>

                    <div
                        class="bg-gradient-to-br from-payflo-purple/20 to-payflo-pink/5 border border-white/10 p-10 my-12 rounded-3xl relative overflow-hidden"
                    >
                        <div
                            class="absolute -right-20 -top-20 w-64 h-64 bg-payflo-purple/10 blur-3xl -z-10"
                        >
                        </div>
                        <h4
                            class="text-2xl font-black text-white mb-6 flex items-center gap-4"
                        >
                            <Icon
                                name="ph:certificate-duotone"
                                class="w-8 h-8 text-payflo-purple"
                            />
                            AWS Certified Expertise
                        </h4>
                        <p class="text-gray-300 mb-8">
                            Our team consists of <strong
                                >AWS Certified Solutions Architects</strong
                            > and
                            <strong>DevOps Engineers</strong>. When you <strong
                                >hire an AWS consultant</strong
                            >
                            from us, you're not getting a generalist; you're getting
                            a specialist who understands the deep internals of the
                            AWS global network.
                        </p>
                        <div class="flex flex-wrap gap-4">
                            <span
                                class="px-4 py-2 bg-white/5 rounded-lg border border-white/10 text-xs font-bold uppercase"
                                >Solutions Architect</span
                            >
                            <span
                                class="px-4 py-2 bg-white/5 rounded-lg border border-white/10 text-xs font-bold uppercase"
                                >DevOps Engineer Professional</span
                            >
                            <span
                                class="px-4 py-2 bg-white/5 rounded-lg border border-white/10 text-xs font-bold uppercase"
                                >Security Specialist</span
                            >
                        </div>
                    </div>

                    <h3 class="text-3xl font-black text-white mt-16 mb-6">
                        Managed DevOps & Monitoring
                    </h3>
                    <p>
                        Going beyond the initial setup, we provide 24/7
                        monitoring and managed DevOps. By implementing **AWS
                        CloudWatch**, **X-Ray**, and **Grafana**, we give you
                        total visibility into your application's health,
                        allowing us to proactively solve problems before your
                        users even see them.
                    </p>
                </div>
            </div>
        </section>

        <!-- Engagement Models -->
        <section class="py-24">
            <div class="container-custom">
                <div class="text-center max-w-3xl mx-auto mb-20">
                    <h2 class="text-4xl md:text-5xl font-black mb-6">
                        Flexible <span class="gradient-text"
                            >Engagement Models</span>
                    </h2>
                    <p class="text-gray-400 text-lg">
                        Whether you need a one-off audit or long-term
                        partnership, we have a model that fits.
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <div
                        class="p-8 rounded-3xl bg-white/5 border border-white/10 flex flex-col items-center text-center"
                    >
                        <h4 class="text-xl font-black text-white mb-4">
                            Cloud Audit
                        </h4>
                        <div
                            class="text-3xl font-black text-payflo-purple mb-6"
                        >
                            1-2 Weeks
                        </div>
                        <p class="text-sm text-gray-400 mb-8">
                            Comprehensive assessment of your current AWS setup,
                            focusing on security, cost, and stability.
                        </p>
                        <a
                            href="/contact/"
                            class="mt-auto font-bold text-payflo-purple hover:underline"
                            >Get Audit Quote →</a
                        >
                    </div>
                    <div
                        class="p-8 rounded-3xl bg-payflo-purple/10 border border-payflo-purple/30 flex flex-col items-center text-center scale-105 shadow-2xl"
                    >
                        <div
                            class="px-3 py-1 bg-payflo-purple text-white text-[10px] font-black uppercase rounded-full mb-4"
                        >
                            Most Popular
                        </div>
                        <h4 class="text-xl font-black text-white mb-4">
                            Project Implementation
                        </h4>
                        <div class="text-3xl font-black text-white mb-6">
                            Custom Scope
                        </div>
                        <p class="text-sm text-gray-400 mb-8">
                            End-to-end migration or architecture build-out
                            tailored to your specific requirements.
                        </p>
                        <a
                            href="/contact/"
                            class="mt-auto btn btn-primary py-3 px-6 text-sm"
                            >Hire for Project</a
                        >
                    </div>
                    <div
                        class="p-8 rounded-3xl bg-white/5 border border-white/10 flex flex-col items-center text-center"
                    >
                        <h4 class="text-xl font-black text-white mb-4">
                            Managed Cloud
                        </h4>
                        <div class="text-3xl font-black text-payflo-pink mb-6">
                            Retainer
                        </div>
                        <p class="text-sm text-gray-400 mb-8">
                            Ongoing 24/7 support, security patches, and scaling
                            management for your infrastructure.
                        </p>
                        <a
                            href="/contact/"
                            class="mt-auto font-bold text-payflo-pink hover:underline"
                            >Learn About Retainers →</a
                        >
                    </div>
                </div>
            </div>
        </section>

        <!-- Structured Data -->
        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "Service",
                "serviceType": "AWS Consulting",
                "provider": {
                    "@type": "Organization",
                    "name": "Laravel Company",
                    "url": "https://laravelcompany.com"
                },
                "description": "Professional AWS consulting and cloud architecture services by certified experts.",
                "hasOfferCatalog": {
                    "@type": "OfferCatalog",
                    "name": "AWS Services",
                    "itemListElement": [
                        {
                            "@type": "Offer",
                            "itemOffered": {
                                "@type": "Service",
                                "name": "AWS Cloud Migration"
                            }
                        },
                        {
                            "@type": "Offer",
                            "itemOffered": {
                                "@type": "Service",
                                "name": "Serverless Architecture Design"
                            }
                        },
                        {
                            "@type": "Offer",
                            "itemOffered": {
                                "@type": "Service",
                                "name": "AWS Cost Optimization Audit"
                            }
                        }
                    ]
                }
            }
        </script>

        <CTASection />
    </main>
</Layout>

<style>
    .btn {
        @apply inline-flex items-center justify-center font-black transition-all duration-300 rounded-2xl;
    }
    .btn-primary {
        @apply bg-gradient-to-r from-payflo-purple to-payflo-pink text-white shadow-xl shadow-purple-600/30 hover:shadow-purple-600/50 hover:-translate-y-1;
    }
    .glass-card {
        @apply bg-white/5 backdrop-blur-xl border border-white/10 rounded-3xl shadow-2xl transition-all duration-500;
    }
    .feature-card {
        @apply p-10 bg-white/5 rounded-3xl border border-white/10 transition-all duration-500 hover:bg-white/10 hover:-translate-y-2;
    }
    .gradient-text {
        @apply bg-clip-text text-transparent bg-gradient-to-r from-payflo-purple to-payflo-pink;
    }
</style>
