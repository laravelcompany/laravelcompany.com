</Layout>

<style>
    .line-clamp-3 {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .filter-pill {
        @apply px-4 py-2 rounded-full bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 font-medium text-sm hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors whitespace-nowrap;
    }

    .filter-pill.active {
        @apply bg-payflo-purple text-white hover:bg-payflo-purple/90;
    }
</style>

<script>
    // Simple client-side filtering and search
    document.addEventListener("DOMContentLoaded", () => {
        const filterButtons = document.querySelectorAll(".filter-pill");
        const jobCards = document.querySelectorAll(".job-card");
        const searchInput = document.getElementById(
            "job-search",
        ) as HTMLInputElement;
        const searchBtn = document.getElementById("search-btn");
        const jobsContainer = document.getElementById("jobs-container");

        // --- Filtering Logic ---
        filterButtons.forEach((button) => {
            button.addEventListener("click", () => {
                const filter = button.getAttribute("data-filter");
                filterButtons.forEach((btn) => btn.classList.remove("active"));
                button.classList.add("active");

                document.querySelectorAll(".job-card").forEach((card) => {
                    const cardType = card.getAttribute("data-type");
                    const htmlCard = card as HTMLElement;
                    if (filter === "all" || cardType === filter) {
                        htmlCard.style.display = "block";
                    } else {
                        htmlCard.style.display = "none";
                    }
                });
            });
        });

        // --- Search Logic ---
        const performSearch = async () => {
            const keyword = searchInput.value.trim();
            if (!keyword) return;

            if (searchBtn)
                searchBtn.innerHTML =
                    '<svg class="w-5 h-5 animate-spin" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>';

            try {
                const response = await fetch(
                    "https://jobs.izdrail.com/api/v1/jobs",
                    {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ keyword }),
                    },
                );

                if (response.ok) {
                    const data = await response.json();
                    const rawJobs =
                        data.jobs || data.results || data.data || [];
                    const processedJobs = rawJobs.map((job: any) => {
                        if (!job.url && job.job_url) job.url = job.job_url;
                        return job;
                    });
                    renderJobs(processedJobs);
                }
            } catch (error) {
                console.error("Search failed:", error);
            } finally {
                if (searchBtn)
                    searchBtn.innerHTML =
                        '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>';
            }
        };

        const renderJobs = (jobs: any[]) => {
            if (!jobsContainer) return;

            if (jobs.length === 0) {
                jobsContainer.innerHTML =
                    '<div class="text-center py-16"><p class="text-gray-600 dark:text-gray-300 text-lg">No jobs found for this keyword.</p></div>';
                return;
            }

            jobsContainer.innerHTML = jobs
                .map(
                    (job) => `
                <div class="job-card feature-card border border-gray-100 dark:border-gray-700 rounded-xl overflow-hidden hover:shadow-xl transition-shadow" data-type="${job.type || "other"}">
                    <div class="p-6">
                        <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4 mb-4">
                            <div class="flex-1">
                                <h3 class="text-xl font-bold mb-2">
                                    <a href="/jobs/${generateSlug(job.title, job.id, job.url || job.job_url)}" class="text-gray-900 dark:text-white hover:text-payflo-purple transition-colors">
                                        ${job.title}
                                    </a>
                                </h3>
                                <div class="flex flex-wrap items-center gap-4 text-sm text-gray-600 dark:text-gray-400">
                                    <div class="flex items-center gap-1">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
                                        <span class="font-medium">${job.company || "Unknown Company"}</span>
                                    </div>
                                    ${
                                        job.location
                                            ? `
                                        <div class="flex items-center gap-1">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                                            <span>${job.location}</span>
                                        </div>
                                    `
                                            : ""
                                    }
                                    <div class="flex items-center gap-1">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                        <span>Recently posted</span>
                                    </div>
                                </div>
                            </div>
                            <div class="flex flex-wrap gap-2">
                                ${job.type ? `<span class="px-3 py-1 bg-payflo-purple/10 text-payflo-purple rounded-full text-xs font-semibold">${job.type}</span>` : ""}
                                ${job.salary ? `<span class="px-3 py-1 bg-green-100 dark:bg-green-900/30 text-green-600 dark:text-green-400 rounded-full text-xs font-semibold">${job.salary}</span>` : ""}
                            </div>
                        </div>
                        <p class="text-gray-600 dark:text-gray-300 mb-4 line-clamp-3">${truncate(job.description, 150)}</p>
                        <div class="flex gap-3">
                            <a href="/jobs/${generateSlug(job.title, job.id, job.url || job.job_url)}" class="btn btn-primary !py-2 !px-4 text-sm">View Details</a>
                            ${job.url ? `<a href="${job.url}" target="_blank" rel="noopener noreferrer" class="btn btn-secondary !py-2 !px-4 text-sm">Apply Now</a>` : ""}
                        </div>
                    </div>
                </div>
            `,
                )
                .join("");
        };

        const hashString = (input: string) => {
            let h = 5381;
            for (let i = 0; i < input.length; i++) {
                h = ((h << 5) + h + input.charCodeAt(i)) >>> 0;
            }
            return h.toString(36);
        };

        // Keep in sync with src/utils/jobSlug.ts
        const generateSlug = (title: string, id: any, url?: string) => {
            let safeId = id;
            if (!safeId || safeId === "undefined" || safeId === "null") {
                safeId = url ? hashString(url) : hashString(title);
            }
            return (
                title
                    .toLowerCase()
                    .replace(/[^\w\s-]/g, "")
                    .replace(/\s+/g, "-")
                    .replace(/-+/g, "-")
                    .trim() +
                "-" +
                safeId
            );
        };

        const stripHtml = (html: string) => {
            if (!html) return "";
            return html
                .replace(/<[^>]*>?/gm, "")
                .replace(/&nbsp;/g, " ")
                .replace(/&rsquo;/g, "'")
                .replace(/&amp;/g, "&")
                .replace(/&quot;/g, '"')
                .replace(/&lt;/g, "<")
                .replace(/&gt;/g, ">");
        };

        const truncate = (str: string, len: number) => {
            if (!str) return "";
            const cleanStr = stripHtml(str);
            return cleanStr.length > len
                ? cleanStr.substring(0, len) + "..."
                : cleanStr;
        };

        if (searchBtn) searchBtn.addEventListener("click", performSearch);
        if (searchInput) {
            searchInput.addEventListener("keypress", (e) => {
                if (e.key === "Enter") performSearch();
            });
        }
    });
</script>
