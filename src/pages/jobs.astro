---
import Layout from "../layouts/Layout.astro";
import HeroSection from "../components/HeroSection.astro";
import { getJobs, type Job } from "../utils/jobsCache";
import { generateJobSlug } from "../utils/jobSlug";
import { Icon } from "astro-icon/components";

export const prerender = true;

let jobs: Job[] = [];
let apiError = false;
const defaultKeyword = "laravel";

// Load jobs using cache utility
if (import.meta.env.SSR) {
    try {
        const rawJobs = await getJobs(defaultKeyword);
        jobs = rawJobs.map((job) => {
            if (!job.url && job.job_url) job.url = job.job_url;
            if (!job.company) job.company = "Laravel Agency Partner";
            return job;
        });
        if (jobs.length === 0) {
            apiError = true;
        }
    } catch (error) {
        console.error("❌ Failed to load jobs:", error);
        apiError = true;
    }
}

// Helper functions
function stripHtml(html: string): string {
    if (!html) return "";
    return html
        .replace(/<[^>]*>?/gm, "")
        .replace(/&nbsp;/g, " ")
        .replace(/&rsquo;/g, "'")
        .replace(/&amp;/g, "&")
        .replace(/&quot;/g, '"')
        .replace(/&lt;/g, "<")
        .replace(/&gt;/g, ">");
}

function truncateDescription(desc: string, length: number = 150): string {
    if (!desc) return "";
    const cleanDesc = stripHtml(desc);
    return cleanDesc.length > length
        ? cleanDesc.substring(0, length) + "..."
        : cleanDesc;
}

function generateSlug(title: string, id: any, url?: string): string {
    return generateJobSlug(title, id, url);
}

function formatDate(dateStr?: string | null): string {
    if (!dateStr) return "Recently posted";
    try {
        const date = new Date(dateStr);
        const now = new Date();
        const diffTime = Math.abs(now.getTime() - date.getTime());
        const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

        if (diffDays === 0) return "Today";
        if (diffDays === 1) return "Yesterday";
        if (diffDays < 7) return `${diffDays} days ago`;
        if (diffDays < 30) return `${Math.floor(diffDays / 7)} weeks ago`;
        return `${Math.floor(diffDays / 30)} months ago`;
    } catch {
        return "Recently posted";
    }
}

// Extract unique job types and locations
const jobTypes = [...new Set(jobs.map((j) => j.type).filter(Boolean))].sort();
const locations = [
    ...new Set(jobs.map((j) => j.location).filter(Boolean)),
].sort();
