---
import Layout from "../../layouts/Layout.astro";
import HeroSection from "../../components/HeroSection.astro";
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import { stripMarkdown } from "../../utils/stripMarkdown.mjs";

export const prerender = true;

const allDocs = await getCollection("docs");
const docs = allDocs.filter((doc) => doc.id.replace(/\.md$/, "") !== "readme");

const icons: Record<string, string> = {
  "installation": "ph:download-duotone",
  "structure": "ph:folder-duotone",
  "frontend": "ph:paint-brush-duotone",
  "database": "ph:database-duotone",
  "eloquent-collections": "ph:stack-duotone",
  "eloquent-serialization": "ph:arrows-left-right-duotone",
  "session": "ph:clock-duotone",
  "redis": "ph:lightning-duotone",
  "cache": "ph:lightning-duotone",
  "csrf": "ph:shield-check-duotone",
  "hashing": "ph:fingerprint-duotone",
  "passwords": "ph:lock-key-duotone",
  "verification": "ph:check-circle-duotone",
  "packages": "ph:package-duotone",
  "providers": "ph:puzzle-piece-duotone",
  "facades": "ph:wall-duotone",
  "lifecycle": "ph:arrows-clockwise-duotone",
  "sail": "ph:boat-duotone",
  "telescope": "ph:binoculars-duotone",
  "reverb": "ph:radio-duotone",
  "mix": "ph:sliders-duotone",
  "mongodb": "ph:leaf-duotone",
  "search": "ph:magnifying-glass-duotone",
  "seeding": "ph:plant-duotone",
  "mocking": "ph:mask-happy-duotone",
  "urls": "ph:link-duotone",
  "views": "ph:eye-duotone",
  "releases": "ph:tag-duotone",
  "ai": "ph:brain-duotone",
  "documentation": "ph:book-open-duotone",
};

const docsList = docs
  .map((doc) => ({
    slug: doc.id.replace(/\.md$/, ""),
    title: doc.body.split("\n")[0].replace(/^#\s*/, ""),
    excerpt: stripMarkdown(doc.body.split("\n").slice(1, 8).join(" ")).substring(0, 150),
    icon: icons[doc.id.replace(/\.md$/, "")] || "ph:file-duotone",
  }))
  .sort((a, b) => a.title.localeCompare(b.title));
---

<Layout title="Laravel Documentation - Laravel Company">
  <HeroSection
    title="Laravel Documentation"
    subtitle="The full Laravel framework documentation, from installation to advanced topics. Pick a topic and start building."
    breadcrumbs={[{ label: "Home", href: "/" }, { label: "Docs" }]}
  />

  <section class="py-20 bg-gray-50">
    <div class="container-custom">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          docsList.map((doc) => (
            <a
              href={`/docs/${doc.slug}/`}
              class="group relative bg-white rounded-2xl p-6 shadow-md hover:shadow-2xl transition-all duration-300 border border-gray-100 hover:border-purple-200 overflow-hidden"
            >
              <div class="absolute top-0 right-0 w-24 h-24 bg-gradient-to-br from-purple-100 to-pink-100 rounded-bl-full -mr-8 -mt-8 opacity-0 group-hover:opacity-100 transition-opacity duration-300" />

              <div class="relative">
                <div class="h-14 w-14 rounded-xl bg-gradient-to-br from-purple-500 to-pink-500 flex items-center justify-center text-white mb-4 group-hover:scale-110 transition-transform duration-300">
                  <Icon name={doc.icon} class="h-7 w-7" />
                </div>

                <h2 class="text-xl font-bold text-gray-800 mb-2 group-hover:text-purple-600 transition-colors">
                  {doc.title}
                </h2>
                <p class="text-gray-600 text-sm line-clamp-2">{doc.excerpt}...</p>

                <div class="mt-4 flex items-center text-purple-600 font-semibold text-sm">
                  <span>Read now</span>
                  <Icon name="ph:arrow-right" class="h-4 w-4 ml-1 group-hover:translate-x-1 transition-transform" />
                </div>
              </div>
            </a>
          ))
        }
      </div>

      {
        docsList.length === 0 && (
          <div class="text-center py-12">
            <p class="text-gray-600 text-lg">
              No documentation available yet. Check back soon.
            </p>
          </div>
        )
      }
    </div>
  </section>
</Layout>
