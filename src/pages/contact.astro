                  </svg>
                </div>
                <div>
                  <h4 class="font-semibold text-white">No Obligations</h4>
                  <p class="text-gray-300 text-sm mt-1">
                    Totally pressure-free. Consider us your new friendly tech advisors!
                  </p>
                </div>
              </div>

              <div class="flex items-start space-x-4">
                <div
                  class="flex-shrink-0 w-10 h-10 bg-purple-900/20 rounded-full flex items-center justify-center mt-1"
                >
                  <svg
                    class="w-5 h-5 text-purple-400"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                </div>
                <div>
                  <h4 class="font-semibold text-white">Actionable Ideas</h4>
                  <p class="text-gray-300 text-sm mt-1">
                    Get practical suggestions you can use right away to grow your business.
                  </p>
                </div>
              </div>

              <!-- Testimonial -->
              <blockquote
                class="border-l-4 border-amber-500 bg-amber-900/10 p-4 rounded-r-lg mt-6"
              >
