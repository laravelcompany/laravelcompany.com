  <script is:inline>
    const showBooking = () => {
      const panel = document.querySelector("#booking-panel");
      const container = document.querySelector("#calendly-container");
      const cta = document.querySelector("#booking-cta");
      if (!panel || !container) return;

      container.classList.remove("hidden");
      container.innerHTML = '<div class="calendly-inline-widget" data-url="https://calendly.com/laravelagency/30min?background_color=0f172a&text_color=ffffff&primary_color=7c3aed&utm_source=website&utm_medium=general_inquiry&utm_campaign=contact_page" style="min-width:320px;height:700px;"></div>';
      cta?.classList.remove("hidden");

      const script = document.createElement("script");
      script.src = "https://assets.calendly.com/assets/external/widget.js";
      script.async = true;
      document.head.appendChild(script);
      panel.dataset.bookingState = "eligible";
    };

    const showRestriction = () => {
      const panel = document.querySelector("#booking-panel");
      const restricted = document.querySelector("#booking-restricted");
      if (!panel || !restricted) return;
      restricted.classList.remove("hidden");
      restricted.classList.add("flex");
      panel.dataset.bookingState = "restricted";
    };

    const resolveBookingEligibility = async () => {
      const panel = document.querySelector("#booking-panel");
      if (!panel || panel.dataset.bookingState) return;

      const controller = new AbortController();
      const timeout = window.setTimeout(() => controller.abort(), 2500);

      try {
        const response = await fetch("/api/booking-eligibility", {
          credentials: "same-origin",
          headers: { Accept: "application/json" },
          signal: controller.signal,
        });
        const result = response.ok ? await response.json() : { eligible: true };
        result.eligible === false ? showRestriction() : showBooking();
      } catch {
        showBooking();
      } finally {
        window.clearTimeout(timeout);
        document.querySelector("#booking-loading")?.remove();
        panel.setAttribute("aria-busy", "false");
      }
    };

    document.addEventListener("astro:page-load", resolveBookingEligibility);
    resolveBookingEligibility();
  </script>

  <!-- Location & Contact Section -->
  <section class="py-20 bg-white/5">
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto animate-on-scroll">
