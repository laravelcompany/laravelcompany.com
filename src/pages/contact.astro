                <p>If you're already a client or have an active business relationship with us, contact us directly:</p>
              </div>
              <div class="mt-7 grid gap-3 sm:grid-cols-2">
                <a href="tel:+447448218899" class="rounded-xl border border-orange-400/30 bg-orange-400/10 px-4 py-3 text-center font-semibold text-orange-200 transition hover:bg-orange-400/20 focus:outline-none focus:ring-2 focus:ring-orange-400">Call +44 744 821 8899</a>
                <a href="mailto:info@laravelcompany.com" class="rounded-xl border border-purple-400/30 bg-purple-400/10 px-4 py-3 text-center font-semibold text-purple-200 transition hover:bg-purple-400/20 focus:outline-none focus:ring-2 focus:ring-purple-400">Email our team</a>
              </div>
            </div>
          </div>
        </div>

        <!-- Information Panel -->
        <div
          class="rounded-2xl overflow-hidden animate-on-scroll shadow-xl bg-white/10 border border-orange-500/20"
        >
          <div class="w-full h-full flex flex-col">
            <!-- Header -->
            <div
