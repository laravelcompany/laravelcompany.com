---
import ClientReviews from "../components/ClientReviews.astro";
import { reviewsAggregate, reviewsSchemaJSON } from "../data/reviews";
import Layout from "../layouts/Layout.astro";
import CTASection from "../components/CTASection.astro";
import { Icon } from "astro-icon/components";

const services = [
  {
    title: "Custom Laravel Web Applications",
    desc: "As a specialist Laravel development agency, we deliver tailored solutions designed to solve real business challenges. From complex web applications to long-term platform support, our team provides end-to-end Laravel expertise.",
    icon: "ph:code-block-duotone",
    features: ["Bespoke architecture", "SOLID principles", "Clean code", "Scalable design"]
  },
  {
    title: "Laravel API Development & Integrations",
    desc: "We create secure, well-documented APIs and integrate Laravel applications with CRMs, payment gateways, ERPs, marketing platforms, and third-party services to ensure seamless data flow across your systems.",
    icon: "ph:plugs-connected-duotone",
    features: ["REST & GraphQL APIs", "CRM integration", "Payment gateways", "Webhook systems"]
  },
  {
    title: "Laravel CRM & Portal Development",
    desc: "From internal management systems to customer and partner portals, we build intuitive, role-based platforms that streamline workflows, reporting, and user access control.",
    icon: "ph:users-three-duotone",
    features: ["Role-based access", "Workflow automation", "Reporting dashboards", "User management"]
  },
  {
    title: "SaaS & Subscription Platforms",
    desc: "We develop scalable SaaS applications using Laravel, including recurring billing, user management, permissions, analytics, and automated processes.",
    icon: "ph:buildings-duotone",
    features: ["Multi-tenancy", "Recurring billing", "Usage analytics", "Automated workflows"]
  },
  {
    title: "Laravel Migration & Modernisation",
    desc: "We migrate legacy PHP systems and outdated platforms to modern Laravel frameworks, improving performance, security, and code maintainability without disrupting your operations.",
    icon: "ph:arrow-circle-up-duotone",
    features: ["Legacy PHP migration", "Zero downtime", "Data integrity", "Performance gains"]
  },
  {
    title: "Laravel Support & Ongoing Maintenance",
    desc: "Our team provides structured Laravel support packages, including monitoring, performance optimisation, updates, security patches, and feature enhancements.",
    icon: "ph:wrench-duotone",
    features: ["24/7 monitoring", "Security patches", "Performance tuning", "Feature enhancements"]
  }
];

const whatWeCanBuild = [
  {
    title: "Laravel Bespoke CRM Systems",
    desc: "Our Laravel web development team can develop CRM systems purpose built for your business needs, ensuring you and your staff have access to everything you need. Develop a streamlined system that connects sales, services, administration and marketing.",
    icon: "ph:chart-line-duotone"
  },
  {
    title: "Laravel Subscription Platforms",
    desc: "Our laravel web development agency team can develop subscription platforms allowing users to sign up and pay monthly for specific services or products. Our platforms integrate with other tools including email marketing, e-commerce platforms and catalogue management software.",
    icon: "ph:credit-card-duotone"
  },
  {
    title: "Laravel Booking Applications",
    desc: "An online automated booking platform allows business to take reservations for classes, appointments, rooms, equipment rental, tickets and more. Integrate your booking system with other tools including your calendar, CRM, email and invoicing system.",
    icon: "ph:calendar-check-duotone"
  },
  {
    title: "Laravel Comparison Websites",
    desc: "Laravel would allow our team to build comparison type websites such as GoCompare or Compare the Market with complex databases, powerful filtering capabilities and a robust monetisation strategy.",
    icon: "ph:funnel-duotone"
  },
  {
    title: "API and App Development",
    desc: "We can develop APIs and admin panel functionality for your mobile app allowing you to easily manage your app. You can also integrate your interface with existing architecture, to expand the services you offer and increase revenue channels.",
    icon: "ph:device-mobile-duotone"
  },
  {
    title: "Online Learning Platforms",
    desc: "We can develop advanced learning management systems for you to deploy and track educational materials, courses and assignments. An LMS with Laravel could include self-registration and login for students and teachers, automated learning journeys, reporting, and collaboration tools.",
    icon: "ph:graduation-cap-duotone"
  }
];

const industries = [
  { title: "Education & eLearning", desc: "Secure, scalable systems for managing student data, learning content, assessments, and online training environments.", icon: "ph:book-open-duotone" },
  { title: "Healthcare & Public Sector", desc: "Compliant, reliable platforms designed to support sensitive data handling, service delivery, reporting, and internal operations.", icon: "ph:heart-duotone" },
  { title: "SaaS & Subscription", desc: "High-performance software platforms with recurring billing, user management, analytics, and automated workflows.", icon: "ph:cloud-duotone" },
  { title: "Manufacturing & Logistics", desc: "Operational platforms for tracking production, inventory, scheduling, supplier integrations, and distribution processes.", icon: "ph:truck-duotone" },
  { title: "Professional Services", desc: "Client-facing systems for managing projects, documents, communications, and service delivery workflows.", icon: "ph:briefcase-duotone" },
  { title: "Membership & Associations", desc: "Secure member portals with subscription management, gated content, event bookings, and community features.", icon: "ph:identification-badge-duotone" }
];

const serviceList = [
  "Bespoke Laravel web application development",
  "Custom-built platforms designed around your workflows",
  "Laravel API development and integrations",
  "Secure and reliable APIs that connect your Laravel application with third-party platforms",
  "Laravel migrations and system rebuilds",
  "Migration of legacy systems and outdated platforms to modern Laravel architectures",
  "Performance optimisation and scalability",
  "Database tuning, queue management, caching strategies, and infrastructure optimisation",
  "Laravel security hardening and technical audits",
  "Proactive security reviews, vulnerability assessments, and best-practice implementation",
  "Laravel support and ongoing maintenance",
  "Flexible support packages with clear SLAs, covering updates, monitoring, and bug fixes"
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      "name": "What services does a Laravel development company provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A full-service Laravel agency provides custom web development, API development, SaaS platform builds, e-commerce solutions, legacy migrations, maintenance & support, performance optimization, and security audits."
      }
    },
    {
      "@type": "Question",
      "name": "Why should I choose Laravel for my web application?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Laravel is a powerful, open-source web application framework designed for building custom, scalable, and high-performance digital platforms. It streamlines repetitive tasks, enables efficient development while maintaining clean code, and allows developers to focus on creativity and innovation. Laravel is well suited to a wide range of applications including order management systems, booking platforms, comparison websites, CRMs, learning management systems, and custom e-commerce portals."
      }
    },
    {
      "@type": "Question",
      "name": "How much does Laravel development cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Custom Laravel projects typically range from $10,000 for MVPs to $100,000+ for enterprise platforms. Hourly rates range from $35-$75/hour depending on developer seniority and location."
      }
    },
    {
      "@type": "Question",
      "name": "Why choose a custom Laravel development company over freelancers?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Agencies provide project management, code quality guarantees, backup developers, established workflows, and long-term support. You get a team, not just one person, reducing project risk significantly."
      }
    },
    {
      "@type": "Question",
      "name": "Can you migrate our existing application to Laravel?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes! We specialise in migrating legacy PHP systems and outdated platforms to modern Laravel frameworks, improving performance, security, and code maintainability without disrupting your operations. We have experience migrating from WordPress, CodeIgniter, Symfony, and custom PHP applications."
      }
    },
    {
      "@type": "Question",
      "name": "Do you follow Laravel best practices and coding standards?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Absolutely. We strictly follow PSR-12 standards, Laravel conventions, SOLID principles, and implement comprehensive PHPUnit testing with CI/CD pipelines for every project."
      }
    }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Laravel Development Services",
  "provider": {
    "@type": "Organization",
    "name": "Laravel Company",
    "url": "https://laravelcompany.com",
    "aggregateRating": reviewsAggregate,
    "review": reviewsSchemaJSON
  },
  "description": "Full-service Laravel development agency offering custom web apps, API development, SaaS platforms, e-commerce, and maintenance services.",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Laravel Services",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Custom Laravel Web Applications" }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Laravel API Development & Integrations" }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Laravel CRM & Portal Development" }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "SaaS & Subscription Platforms" }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Laravel Migration & Modernisation" }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Laravel Support & Ongoing Maintenance" }}
    ]
  }
};
---

<Layout
  title="Laravel Development Services | Custom Web Apps, APIs & SaaS Platforms"
  description="Professional Laravel development services: custom web applications, REST APIs, SaaS platforms, CRM portals, e-commerce solutions, and ongoing maintenance. 500+ projects delivered by a UK-based Laravel agency."
>
  <main id="main-content">
    <!-- Hero -->
    <section class="pt-24 pb-20 md:pt-32 md:pb-28 overflow-hidden relative bg-payflo-dark">
      <div class="absolute inset-0 opacity-10 -z-10">
        <div class="absolute top-0 left-0 w-full h-full bg-[radial-gradient(circle_at_50%_120%,rgba(120,119,198,0.3),rgba(255,255,255,0))]"></div>
      </div>
      <div class="container-custom relative">
        <nav class="flex justify-center items-center gap-2 text-sm text-white/50 mb-8 animate-on-scroll">
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <span>/</span>
          <a href="/laravel-services/" class="hover:text-white transition-colors">Services</a>
          <span>/</span>
          <span class="text-white">Laravel Development Services</span>
        </nav>
        <div class="max-w-4xl mx-auto text-center">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-payflo-purple/10 border border-payflo-purple/20 mb-8 animate-on-scroll">
            <Icon name="ph:buildings-duotone" class="w-5 h-5 text-payflo-purple" />
            <span class="text-sm font-bold uppercase tracking-widest text-white/70">Laravel Development Agency</span>
          </div>
          <h1 class="animate-on-scroll delay-1 text-5xl md:text-7xl lg:text-8xl font-black leading-tight tracking-tight text-white">
            Laravel <span class="gradient-text">Development Services</span>
          </h1>
          <p class="animate-on-scroll delay-2 mt-8 text-xl md:text-2xl text-white/70 leading-relaxed font-medium">
            Laravel Development Company is a UK-based Laravel development agency specialising in bespoke, scalable web applications. Our experienced Laravel developers build custom solutions for growing businesses, from complex APIs to high-performance platforms.
          </p>
          <div class="animate-on-scroll delay-3 mt-12 flex flex-wrap justify-center gap-6">
            <a href="/contact/" class="btn btn-primary px-10 py-5 text-lg shadow-2xl">Get Free Quote</a>
            <a href="/hire-laravel-developer/" class="btn glass-card border-white/20 px-10 py-5 text-lg hover:bg-white/10 transition-all font-bold">Hire Developer</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Why Laravel -->
    <section class="py-24 bg-white/5">
      <div class="container-custom">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
          <div class="animate-on-scroll">
            <h2 class="text-4xl font-black mb-8">Laravel Development Agency <span class="gradient-text">You Can Rely On</span></h2>
            <p class="text-gray-400 text-lg leading-relaxed mb-6">
              As a specialist Laravel development agency, we build secure, scalable and high-performance web applications tailored to your business goals. Our team leverages Laravel's powerful framework to deliver clean architecture, robust integrations and long-term maintainability, whether you need a custom web platform, API development or a complex business system.
            </p>
            <p class="text-gray-400 text-lg leading-relaxed">
              From planning and development through to deployment and ongoing support, we provide a reliable, end-to-end Laravel development service designed to grow with your organisation.
            </p>
          </div>
          <div class="animate-on-scroll delay-2">
            <div class="glass-card p-10 border-white/10">
              <h3 class="text-2xl font-black text-white mb-6">Why We Use Laravel</h3>
              <div class="space-y-4">
                <div class="flex gap-4">
                  <Icon name="ph:lightning-duotone" class="w-6 h-6 text-payflo-purple flex-shrink-0 mt-1" />
                  <p class="text-gray-400 text-sm">Laravel streamlines repetitive tasks, enabling more efficient development while maintaining clean, maintainable code.</p>
                </div>
                <div class="flex gap-4">
                  <Icon name="ph:arrows-out-duotone" class="w-6 h-6 text-payflo-pink flex-shrink-0 mt-1" />
                  <p class="text-gray-400 text-sm">Laravel empowers us to create truly unique digital experiences without the limitations of out-of-the-box technologies.</p>
                </div>
                <div class="flex gap-4">
                  <Icon name="ph:shield-check-duotone" class="w-6 h-6 text-payflo-purple flex-shrink-0 mt-1" />
                  <p class="text-gray-400 text-sm">One of the fastest-growing frameworks with a large active community ensuring excellent security, performance, and long-term support.</p>
                </div>
                <div class="flex gap-4">
                  <Icon name="ph:trend-up-duotone" class="w-6 h-6 text-payflo-pink flex-shrink-0 mt-1" />
                  <p class="text-gray-400 text-sm">Allows developers to focus on creativity, innovation, and delivering high-quality solutions within agreed timeframes and budgets.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Services Grid -->
    <section class="py-24">
      <div class="container-custom">
        <div class="text-center max-w-3xl mx-auto mb-20 animate-on-scroll">
          <h2 class="text-4xl md:text-5xl font-black mb-6">Our <span class="gradient-text">Laravel Development Services</span></h2>
          <p class="text-gray-400 text-lg">As a specialist Laravel development agency, we deliver tailored solutions designed to solve real business challenges. From complex web applications to long-term platform support, our team provides end-to-end Laravel expertise.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {services.map((s, i) => (
            <div class={`animate-on-scroll delay-${i} glass-card p-10 border-white/10 group hover:border-payflo-purple/50 transition-colors`}>
              <Icon name={s.icon} class="w-12 h-12 text-payflo-purple mb-8 group-hover:scale-110 transition-transform" />
              <h3 class="text-2xl font-black mb-4 text-white">{s.title}</h3>
              <p class="text-gray-400 text-sm mb-6 leading-relaxed">{s.desc}</p>
              <ul class="space-y-2">
                {s.features.map(f => (
                  <li class="flex items-center gap-2 text-sm text-white/60">
                    <Icon name="ph:check-circle-fill" class="w-4 h-4 text-payflo-purple" /> {f}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- What We Can Build -->
    <section class="py-24 bg-white/5">
      <div class="container-custom">
        <div class="text-center max-w-3xl mx-auto mb-20 animate-on-scroll">
          <h2 class="text-4xl md:text-5xl font-black mb-6">What Our Laravel Development Agency <span class="gradient-text">Can Build</span></h2>
          <p class="text-gray-400 text-lg">Laravel is a perfect framework for many different types of web applications and platforms.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {whatWeCanBuild.map((item, i) => (
            <div class={`animate-on-scroll delay-${i} glass-card p-10 border-white/10 group hover:border-payflo-purple/50 transition-colors`}>
              <Icon name={item.icon} class="w-12 h-12 text-payflo-pink mb-6 group-hover:scale-110 transition-transform" />
              <h3 class="text-xl font-black mb-3 text-white">{item.title}</h3>
              <p class="text-gray-400 text-sm leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Full Service List -->
    <section class="py-24">
      <div class="container-custom max-w-5xl mx-auto">
        <div class="text-center mb-16 animate-on-scroll">
          <h2 class="text-4xl font-black mb-6">End-to-End <span class="gradient-text">Laravel Services</span></h2>
          <p class="text-gray-400 text-lg">As an experienced Laravel development agency, we provide end-to-end development services designed to support businesses at every stage of their digital journey.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {serviceList.map((service, i) => (
            <div class={`animate-on-scroll delay-${i} flex gap-4 p-6 glass-card border-white/10 hover:border-payflo-purple/30 transition-colors`}>
              <Icon name="ph:check-circle-fill" class="w-5 h-5 text-payflo-purple flex-shrink-0 mt-0.5" />
              <p class="text-white/80 text-sm">{service}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Industries -->
    <section class="py-24 bg-white/5">
      <div class="container-custom">
        <div class="text-center max-w-3xl mx-auto mb-20 animate-on-scroll">
          <h2 class="text-4xl md:text-5xl font-black mb-6">Industries We <span class="gradient-text">Support</span></h2>
          <p class="text-gray-400 text-lg">As an experienced Laravel development agency, we work with organisations across a wide range of sectors, delivering tailored digital platforms that align with industry-specific requirements.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {industries.map((ind, i) => (
            <div class={`animate-on-scroll delay-${i} glass-card p-8 border-white/10 group hover:border-payflo-purple/50 transition-colors`}>
              <Icon name={ind.icon} class="w-10 h-10 text-payflo-purple mb-4 group-hover:scale-110 transition-transform" />
              <h3 class="text-xl font-black mb-3 text-white">{ind.title}</h3>
              <p class="text-gray-400 text-sm leading-relaxed">{ind.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Why Choose Us -->
    <section class="py-24">
      <div class="container-custom">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
          <div class="animate-on-scroll">
            <h2 class="text-4xl font-black mb-8">A Trusted <span class="gradient-text">Laravel Partner</span> for Your Business</h2>
            <div class="space-y-6">
              <div class="flex gap-4">
                <Icon name="ph:certificate-duotone" class="w-8 h-8 text-payflo-purple flex-shrink-0 mt-1" />
                <div>
                  <h4 class="text-lg font-bold text-white mb-1">Certified Team</h4>
                  <p class="text-gray-400 text-sm">Laravel-certified developers with 5+ years average experience on every project.</p>
                </div>
              </div>
              <div class="flex gap-4">
                <Icon name="ph:clock-countdown-duotone" class="w-8 h-8 text-payflo-pink flex-shrink-0 mt-1" />
                <div>
                  <h4 class="text-lg font-bold text-white mb-1">8-Week Average Delivery</h4>
                  <p class="text-gray-400 text-sm">Proven agile workflows deliver MVPs in 4-6 weeks, full platforms in 8-12 weeks.</p>
                </div>
              </div>
              <div class="flex gap-4">
                <Icon name="ph:shield-check-duotone" class="w-8 h-8 text-payflo-purple flex-shrink-0 mt-1" />
                <div>
                  <h4 class="text-lg font-bold text-white mb-1">Enterprise Security</h4>
                  <p class="text-gray-400 text-sm">OWASP compliance, GDPR readiness, penetration testing, and SOC 2 aligned processes.</p>
                </div>
              </div>
              <div class="flex gap-4">
                <Icon name="ph:trend-up-duotone" class="w-8 h-8 text-payflo-pink flex-shrink-0 mt-1" />
                <div>
                  <h4 class="text-lg font-bold text-white mb-1">Scalable Architecture</h4>
                  <p class="text-gray-400 text-sm">Event-driven design, queue workers, caching layers, and auto-scaling infrastructure.</p>
                </div>
              </div>
            </div>
          </div>
          <div class="animate-on-scroll delay-2">
            <div class="glass-card p-10 border-white/10">
              <h3 class="text-2xl font-black text-white mb-6">Manchester-Based Laravel Agency</h3>
              <p class="text-gray-400 text-sm leading-relaxed mb-6">
                Laravel Development Company is a UK-based Laravel development agency based in Manchester, delivering high-quality, scalable web applications for organisations across the UK and beyond. Our in-house team of experienced Laravel developers, project managers, and QA specialists work collaboratively to design, build, and maintain reliable digital systems that support long-term business growth.
              </p>
              <p class="text-gray-400 text-sm leading-relaxed mb-6">
                We work with a wide range of clients, from ambitious SMEs and growing digital brands to enterprise organisations and public sector bodies.
              </p>
              <p class="text-gray-400 text-sm leading-relaxed">
                We offer flexible engagement models including fixed-scope development, agile sprint-based delivery, and ongoing support retainers.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-24 bg-white/5">
      <div class="container-custom max-w-4xl mx-auto">
        <h2 class="text-4xl font-black text-center mb-16">Laravel Development <span class="gradient-text">FAQ</span></h2>
        <div class="space-y-6">
          <div class="p-8 glass-card border-white/10">
            <h4 class="text-lg font-bold mb-3 text-white">What services does a Laravel development company provide?</h4>
            <p class="text-gray-400">A full-service Laravel agency provides custom web development, API development, SaaS platform builds, e-commerce solutions, legacy migrations, maintenance & support, performance optimization, and security audits.</p>
          </div>
          <div class="p-8 glass-card border-white/10">
            <h4 class="text-lg font-bold mb-3 text-white">Why should I choose Laravel for my web application?</h4>
            <p class="text-gray-400">Laravel is a powerful, open-source web application framework designed for building custom, scalable, and high-performance digital platforms. It streamlines repetitive tasks, enables efficient development while maintaining clean code, and allows developers to focus on creativity and innovation. Laravel is well suited to a wide range of applications including order management systems, booking platforms, comparison websites, CRMs, learning management systems, and custom e-commerce portals.</p>
          </div>
          <div class="p-8 glass-card border-white/10">
            <h4 class="text-lg font-bold mb-3 text-white">How much does Laravel development cost?</h4>
            <p class="text-gray-400">Custom Laravel projects typically range from $10,000 for MVPs to $100,000+ for enterprise platforms. Hourly rates range from $35-$75/hour depending on developer seniority and location.</p>
          </div>
          <div class="p-8 glass-card border-white/10">
            <h4 class="text-lg font-bold mb-3 text-white">Why choose a custom Laravel development company over freelancers?</h4>
            <p class="text-gray-400">Agencies provide project management, code quality guarantees, backup developers, established workflows, and long-term support. You get a team, not just one person, reducing project risk significantly.</p>
          </div>
          <div class="p-8 glass-card border-white/10">
            <h4 class="text-lg font-bold mb-3 text-white">Can you migrate our existing application to Laravel?</h4>
            <p class="text-gray-400">Yes! We specialise in migrating legacy PHP systems and outdated platforms to modern Laravel frameworks, improving performance, security, and code maintainability without disrupting your operations. We have experience migrating from WordPress, CodeIgniter, Symfony, and custom PHP applications.</p>
          </div>
          <div class="p-8 glass-card border-white/10">
            <h4 class="text-lg font-bold mb-3 text-white">Do you follow Laravel best practices and coding standards?</h4>
            <p class="text-gray-400">Absolutely. We strictly follow PSR-12 standards, Laravel conventions, SOLID principles, and implement comprehensive PHPUnit testing with CI/CD pipelines for every project.</p>
          </div>
        </div>
      </div>
    </section>

    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

    <ClientReviews />

    <!-- Internal Links -->
    <section class="py-16 border-t border-white/5">
      <div class="container-custom">
        <div class="flex flex-wrap justify-center gap-6 text-sm">
          <a href="/" class="text-payflo-purple hover:underline font-bold">Laravel Development Company →</a>
