---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";

const nis2Requirements = [
  {
    title: "Supply Chain Security",
    description: "Implement appropriate and proportionate technical, operational, and organizational measures to ensure resilience.",
    icon: "ph:link-break-duotone"
  },
  {
    title: "Incident Handling",
    description: "Establish processes for incident detection, response, and reporting within 24-72 hours.",
    icon: "ph:warning-circle-duotone"
  },
  {
    title: "Risk Management",
    description: "Implement comprehensive risk management measures covering cybersecurity and physical security.",
    icon: "ph:shield-check-duotone"
  },
  {
    title: "Business Continuity",
    description: "Maintain disaster recovery plans and backup procedures for critical infrastructure protection.",
    icon: "ph:arrows-clockwise-duotone"
  }
];

const benefits = [
  {
    title: "EUCC Certified Development",
    description: "Our software development lifecycle follows EUCC (EU Common Criteria) certified practices.",
    icon: "ph:certificate-duotone"
  },
  {
    title: "24-Hour Vulnerability Disclosure",
    description: "We maintain a dedicated security team for rapid vulnerability response and disclosure.",
    icon: "ph:bug-beetle-duotone"
  },
  {
    title: "SBOM Generation",
    description: "Full Software Bill of Materials (SBOM) available for all products, ensuring supply chain transparency.",
    icon: "ph:file-text-duotone"
  },
  {
    title: "Audit-Ready Documentation",
    description: "Comprehensive security documentation, penetration test reports, and compliance certifications.",
    icon: "ph:folder-lock-duotone"
  }
];
---

<Layout
  title="NIS2 Essential Entity Provider | Laravel Company"
  description="Certified NIS2 essential entity software provider. Meet your supply chain compliance obligations with our EUCC certified solutions for government."
>
  <section class="pt-20 pb-12 md:pt-28 md:pb-16">
    <div class="container-custom">
      <nav class="flex justify-center items-center gap-2 text-sm text-white/50 mb-8 animate-on-scroll">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <a href="/compliance/" class="hover:text-white transition-colors">Compliance</a>
        <span>/</span>
        <span class="text-white">NIS2</span>
      </nav>

      <div class="max-w-4xl mx-auto animate-on-scroll">
        <h1 class="text-4xl md:text-5xl font-bold leading-tight">
          NIS2 Essential Entity <span class="gradient-text">Provider</span>
        </h1>
        <p class="mt-6 text-xl text-white/70">
          As a certified NIS2 essential entity software provider, we help government bodies and critical infrastructure operators meet their supply chain compliance obligations. Our EUCC certified solutions ensure your procurement meets EU cybersecurity standards.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="/contact/" class="btn btn-primary">
            Request Compliance Documentation
          </a>
          <a href="/compliance/" class="btn bg-white/10 border border-white/20 text-white hover:bg-white/20">
            View All Certifications
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-12 bg-payflo-darker/30">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <div class="flex flex-wrap gap-6 justify-center">
          <div class="glass-card px-6 py-4 flex items-center gap-3">
            <Icon name="ph:seal-check-duotone" class="w-6 h-6 text-green-400" />
            <span class="font-medium text-white">EUCC Certified</span>
          </div>
          <div class="glass-card px-6 py-4 flex items-center gap-3">
            <Icon name="ph:shield-check-duotone" class="w-6 h-6 text-blue-400" />
            <span class="font-medium text-white">NIS2 Aligned</span>
          </div>
          <div class="glass-card px-6 py-4 flex items-center gap-3">
            <Icon name="ph:user-check-duotone" class="w-6 h-6 text-violet-400" />
            <span class="font-medium text-white">GDPR Compliant</span>
          </div>
          <div class="glass-card px-6 py-4 flex items-center gap-3">
            <Icon name="ph:certificate-duotone" class="w-6 h-6 text-amber-400" />
            <span class="font-medium text-white">ISO 27001:2022</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold mb-8 text-center animate-on-scroll">
          NIS2 Supply Chain Requirements We Meet
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {nis2Requirements.map((req, index) => (
            <div class="glass-card p-6 animate-on-scroll" style={`animation-delay: ${index * 0.1}s`}>
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-xl bg-payflo-purple/20 flex items-center justify-center flex-shrink-0">
                  <Icon name={req.icon} class="w-6 h-6 text-payflo-purple" />
                </div>
                <div>
                  <h3 class="text-lg font-semibold text-white mb-2">{req.title}</h3>
                  <p class="text-white/70 text-sm">{req.description}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-payflo-darker/30">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold mb-8 text-center animate-on-scroll">
          Why Choose a NIS2 Essential Entity Provider
        </h2>
        
        <div class="glass-card p-8 border-payflo-purple/30 animate-on-scroll">
          <p class="text-white/70 mb-6">
            Under NIS2 Directive, essential entities must ensure that the ICT products and services they procure meet appropriate cybersecurity standards. Working with a certified NIS2 essential entity provider like Laravel Company ensures:
          </p>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <Icon name="ph:check-circle" class="w-5 h-5 text-green-400 flex-shrink-0 mt-0.5" />
              <span class="text-white/70"><strong class="text-white">Compliance Confidence:</strong> Our EUCC certification demonstrates adherence to EU cybersecurity standards recognized by ENISA.</span>
            </li>
            <li class="flex items-start gap-3">
              <Icon name="ph:check-circle" class="w-5 h-5 text-green-400 flex-shrink-0 mt-0.5" />
              <span class="text-white/70"><strong class="text-white">Supply Chain Transparency:</strong> Full SBOM documentation for every software component ensures visibility into your software supply chain.</span>
            </li>
            <li class="flex items-start gap-3">
              <Icon name="ph:check-circle" class="w-5 h-5 text-green-400 flex-shrink-0 mt-0.5" />
              <span class="text-white/70"><strong class="text-white">Rapid Response:</strong> Our 24-hour vulnerability disclosure process aligns with NIS2 incident reporting requirements.</span>
            </li>
            <li class="flex items-start gap-3">
              <Icon name="ph:check-circle" class="w-5 h-5 text-green-400 flex-shrink-0 mt-0.5" />
              <span class="text-white/70"><strong class="text-white">Audit Readiness:</strong> Annual third-party audits and comprehensive documentation simplify your compliance verification.</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold mb-8 text-center animate-on-scroll">
          Our Commitment to Public Sector Security
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {benefits.map((benefit, index) => (
            <div class="glass-card p-6 animate-on-scroll" style={`animation-delay: ${index * 0.1}s`}>
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-lg bg-payflo-purple/20 flex items-center justify-center flex-shrink-0">
                  <Icon name={benefit.icon} class="w-5 h-5 text-payflo-purple" />
                </div>
                <div>
                  <h3 class="font-semibold text-white mb-2">{benefit.title}</h3>
                  <p class="text-sm text-white/70">{benefit.description}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-gradient-to-r from-payflo-purple to-payflo-blue text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-[url('/grid-pattern.svg')] opacity-10"></div>
    <div class="container-custom relative">
      <div class="max-w-3xl mx-auto text-center animate-on-scroll">
        <h2 class="text-3xl md:text-4xl font-bold">Need a NIS2 Compliant IT Partner?</h2>
        <p class="mt-6 text-xl opacity-90">
          Our team can provide documentation, answer questions about our certifications, or discuss specific requirements for your public sector project.
        </p>
        <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/contact/" class="btn bg-white text-payflo-purple hover:bg-opacity-90">
            Contact Our Compliance Team
          </a>
          <a href="/compliance/" class="btn bg-white/10 border border-white/20 text-white hover:bg-white/20">
            View All Certifications
          </a>
        </div>
      </div>
    </div>
  </section>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": "NIS2 Essential Entity Provider",
      "description": "Certified NIS2 essential entity software provider. Meet your supply chain compliance obligations with our EUCC certified solutions for government.",
      "provider": {
        "@type": "Organization",
        "name": "Laravel Company",
        "url": "https://laravelcompany.com",
        "certification": [
          { "@type": "Certification", "name": "EUCC", "certifyingAuthority": "ENISA" },
          { "@type": "Certification", "name": "NIS2 Aligned", "certifyingAuthority": "EU" }
        ]
      }
    }
  </script>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://laravelcompany.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Compliance",
          "item": "https://laravelcompany.com/compliance/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "NIS2 Essential Entity Provider",
          "item": "https://laravelcompany.com/nis2-essential-entity-provider/"
        }
      ]
    }
  </script>
</Layout>
