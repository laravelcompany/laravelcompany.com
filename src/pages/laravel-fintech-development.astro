---
import Layout from "../layouts/Layout.astro";
import CTASection from "../components/CTASection.astro";
import { Icon } from "astro-icon/components";

const features = [
  {
    title: "PCI-Compliant Payments",
    desc: "Stripe, PayPal, bank transfers with PCI-DSS compliance and secure tokenization.",
    icon: "ph:credit-card-duotone"
  },
  {
    title: "Bank-Grade APIs",
    desc: "Open Banking, Plaid, Stripe Treasury, and custom ledger system integrations.",
    icon: "ph:bank-duotone"
  },
    {
    title: "Ledger & Accounting",
    desc: "Double-entry ledger, transaction tracking, reconciliation, and financial reporting.",
    icon: "ph:bank-duotone"
  },
  {
    title: "Fraud Detection",
    desc: "Real-time transaction monitoring, velocity checks, and ML-based fraud scoring.",
    icon: "ph:shield-check-duotone"
  },
  {
    title: "Real-Time Transactions",
    desc: "WebSocket-powered real-time payment processing, balance updates, and instant notifications.",
    icon: "ph:lightning-duotone"
  },
  {
    title: "Regulatory Reporting",
    desc: "Automated regulatory report generation for FINRA, SEC, FCA, and central bank compliance.",
    icon: "ph:clipboard-text-duotone"
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      "name": "Why use Laravel for fintech development?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Laravel offers robust queue systems for financial transactions, excellent testing tools for regulatory compliance, and packages like Laravel Cashier and custom ledger implementations."
      }
    },
    {
      "@type": "Question",
      "name": "How much does fintech software development cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Fintech platforms cost $40,000-$150,000+ depending on complexity. Payment gateways start at $15,000. Ledger systems cost $25,000-$60,000."
      }
    },
    {
      "@type": "Question",
      "name": "Do you handle PCI compliance?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. We build PCI-DSS compliant payment flows, use tokenization, never store raw card data, and provide compliance documentation for audits."
      }
    },
    {
      "@type": "Question",
      "name": "Can you integrate with banking APIs?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Absolutely. We integrate with Plaid, Stripe Treasury, Open Banking APIs, SWIFT, and major bank APIs for account verification and transfers."
      }
    },
    {
      "@type": "Question",
      "name": "What is your development process for fintech projects?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We follow a six-phase process: Discovery & compliance scoping, architecture & security design, agile development with PCI-DSS controls, third-party security audit, regulatory documentation package, and deployment with ongoing monitoring."
      }
    },
    {
      "@type": "Question",
      "name": "Do you provide ongoing support after launch?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. We offer 24/7 managed support, security monitoring, compliance updates, and feature maintenance. Retainer packages start at $5,000/month and include priority response SLAs."
      }
    },
    {
      "@type": "Question",
      "name": "What fintech regulations do you cover?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We cover PCI-DSS, GDPR, PSD2, SOC 2, ISO 27001, KYC/AML, MiFID II, FCA regulations, and open banking standards. For US clients we also support FINRA and SEC compliance frameworks."
      }
    },
    {
      "@type": "Question",
      "name": "Can you build a cryptocurrency or blockchain fintech platform?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. We build crypto payment gateways, exchange platforms, DeFi dashboards, and wallet integrations using Laravel with Web3.js, ethers.js, and blockchain API providers like Alchemy and Infura."
      }
    }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Laravel FinTech Development",
  "provider": {
    "@type": "Organization",
    "name": "Laravel Company",
    "url": "https://laravelcompany.com"
  },
  "description": "Laravel fintech development: PCI compliance, bank-grade APIs, ledger systems, fraud detection. $40K-$150K.",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "FinTech Services",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Payment Gateway" }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Ledger System" }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Fraud Detection" }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Regulatory Reporting" }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Open Banking API" }}
    ]
  }
};
---

<Layout
  title="Laravel FinTech Development | PCI Compliant Banking Software"
  description="Laravel development for fintech: PCI compliance, bank-grade APIs, ledger systems, fraud detection. $40K-$150K. Get a free consultation."
>
  <main id="main-content">
    <!-- Hero -->
    <section class="pt-24 pb-20 md:pt-32 md:pb-28 overflow-hidden relative bg-payflo-dark">
      <div class="absolute inset-0 opacity-10 -z-10">
        <div class="absolute top-0 left-0 w-full h-full bg-[radial-gradient(circle_at_50%_120%,rgba(120,119,198,0.3),rgba(255,255,255,0))]"></div>
      </div>
      <div class="container-custom relative">
        <nav class="flex justify-center items-center gap-2 text-sm text-white/50 mb-8 animate-on-scroll">
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <span>/</span>
          <a href="/laravel-services/" class="hover:text-white transition-colors">Services</a>
          <span>/</span>
          <span class="text-white">FinTech Development</span>
        </nav>
        <div class="max-w-4xl mx-auto text-center">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-payflo-purple/10 border border-payflo-purple/20 mb-8 animate-on-scroll">
            <Icon name="ph:bank-duotone" class="w-5 h-5 text-payflo-purple" />
            <span class="text-sm font-bold uppercase tracking-widest text-white/70">FinTech Specialists</span>
          </div>
          <h1 class="animate-on-scroll delay-1 text-5xl md:text-7xl lg:text-8xl font-black leading-tight tracking-tight text-white">
            Laravel <span class="gradient-text">FinTech Development</span>
          </h1>
          <p class="animate-on-scroll delay-2 mt-8 text-xl md:text-2xl text-white/70 leading-relaxed font-medium">
            PCI-compliant payment systems, bank-grade APIs, ledger systems, and fraud detection. Starting at $40,000.
          </p>
          <div class="animate-on-scroll delay-3 mt-12 flex flex-wrap justify-center gap-6">
            <a href="/contact/" class="btn btn-primary px-10 py-5 text-lg shadow-2xl">Get FinTech Quote</a>
            <a href="/startup-laravel-agency/" class="btn glass-card border-white/20 px-10 py-5 text-lg hover:bg-white/10 transition-all font-bold">Startup Solutions</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Core Features -->
    <section class="py-24">
      <div class="container-custom">
        <div class="text-center max-w-3xl mx-auto mb-20 animate-on-scroll">
          <h2 class="text-4xl md:text-5xl font-black mb-6">FinTech <span class="gradient-text">Core Features</span></h2>
          <p class="text-gray-400 text-lg">Every fintech platform we build includes these essential capabilities engineered for security, compliance, and performance at scale.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
          {features.map((f, i) => (
            <div class="animate-on-scroll delay-{i} glass-card p-10 border-white/10 group hover:border-payflo-purple/50 transition-colors">
              <Icon name={f.icon} class="w-12 h-12 text-payflo-purple mb-6 group-hover:scale-110 transition-transform" />
              <h3 class="text-2xl font-black mb-4 text-white">{f.title}</h3>
              <p class="text-gray-400 text-sm leading-relaxed">{f.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Development Process -->
    <section class="py-24 bg-white/5">
      <div class="container-custom max-w-5xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-20 animate-on-scroll">
          <h2 class="text-4xl md:text-5xl font-black mb-6">FinTech <span class="gradient-text">Development Process</span></h2>
          <p class="text-gray-400 text-lg">We follow a rigorous six-phase process designed specifically for fintech platforms where security and compliance are non-negotiable.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="animate-on-scroll glass-card p-8 border-white/10">
            <div class="w-14 h-14 rounded-full bg-payflo-purple/20 flex items-center justify-center mb-6 text-2xl font-black text-payflo-purple">1</div>
            <h3 class="text-xl font-black mb-3 text-white">Discovery & Compliance Scoping</h3>
            <p class="text-gray-400 text-sm leading-relaxed">We map every data flow, identify applicable regulations from PCI-DSS to PSD2, define your compliance boundary, and produce a detailed security requirements specification before writing a single line of code.</p>
          </div>
          <div class="animate-on-scroll delay-1 glass-card p-8 border-white/10">
            <div class="w-14 h-14 rounded-full bg-payflo-purple/20 flex items-center justify-center mb-6 text-2xl font-black text-payflo-purple">2</div>
            <h3 class="text-xl font-black mb-3 text-white">Architecture & Security Design</h3>
            <p class="text-gray-400 text-sm leading-relaxed">Our architects build a threat model using STRIDE methodology, design the encryption strategy with AES-256 at rest and TLS 1.3 in transit, and plan the infrastructure with VPC isolation and WAF protection.</p>
          </div>
          <div class="animate-on-scroll delay-2 glass-card p-8 border-white/10">
            <div class="w-14 h-14 rounded-full bg-payflo-purple/20 flex items-center justify-center mb-6 text-2xl font-black text-payflo-purple">3</div>
            <h3 class="text-xl font-black mb-3 text-white">Agile Development with PCI Controls</h3>
            <p class="text-gray-400 text-sm leading-relaxed">Every commit passes static analysis, dependency scanning, and unit tests with 90% coverage minimum. Code reviews include a dedicated compliance check by our security team before any merge to production.</p>
          </div>
          <div class="animate-on-scroll delay-1 glass-card p-8 border-white/10">
            <div class="w-14 h-14 rounded-full bg-payflo-purple/20 flex items-center justify-center mb-6 text-2xl font-black text-payflo-purple">4</div>
            <h3 class="text-xl font-black mb-3 text-white">Third-Party Security Audit</h3>
            <p class="text-gray-400 text-sm leading-relaxed">Before go-live, an independent penetration testing firm validates our implementation. We remediate every finding and provide you with the full audit report for your compliance documentation.</p>
          </div>
          <div class="animate-on-scroll delay-2 glass-card p-8 border-white/10">
            <div class="w-14 h-14 rounded-full bg-payflo-purple/20 flex items-center justify-center mb-6 text-2xl font-black text-payflo-purple">5</div>
            <h3 class="text-xl font-black mb-3 text-white">Regulatory Documentation Package</h3>
            <p class="text-gray-400 text-sm leading-relaxed">We produce SOC 2 reports, PCI attestation of compliance, data processing agreements, privacy impact assessments, and complete compliance evidence bundles required by your regulators.</p>
          </div>
          <div class="animate-on-scroll delay-3 glass-card p-8 border-white/10">
            <div class="w-14 h-14 rounded-full bg-payflo-purple/20 flex items-center justify-center mb-6 text-2xl font-black text-payflo-purple">6</div>
            <h3 class="text-xl font-black mb-3 text-white">Deployment & Ongoing Monitoring</h3>
            <p class="text-gray-400 text-sm leading-relaxed">We implement real-time threat detection with SIEM integration, automated compliance checks, 24/7 incident response, and quarterly infrastructure reviews to maintain your security posture.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Compliance -->
    <section class="py-24 bg-white/5">
      <div class="container-custom max-w-4xl mx-auto">
        <h2 class="text-4xl font-black text-center mb-6">Compliance <span class="gradient-text">Ready</span></h2>
        <p class="text-gray-400 text-lg text-center max-w-3xl mx-auto mb-16 animate-on-scroll">We build fintech platforms that meet the most stringent regulatory frameworks globally, ensuring your product is audit-ready from day one across all jurisdictions you operate in.</p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10 text-center">
            <h4 class="text-lg font-bold text-white mb-2">PCI-DSS</h4>
            <p class="text-gray-400 text-xs">Payment Card Industry compliance</p>
          </div>
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10 text-center">
            <h4 class="text-lg font-bold text-white mb-2">GDPR</h4>
            <p class="text-gray-400 text-xs">EU data protection regulation</p>
          </div>
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10 text-center">
            <h4 class="text-lg font-bold text-white mb-2">SOC 2</h4>
            <p class="text-gray-400 text-xs">Security controls framework</p>
          </div>
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10 text-center">
            <h4 class="text-lg font-bold text-white mb-2">PSD2</h4>
            <p class="text-gray-400 text-xs">EU payment services directive</p>
          </div>
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10 text-center">
            <h4 class="text-lg font-bold text-white mb-2">KYC/AML</h4>
            <p class="text-gray-400 text-xs">Know Your Customer / Anti-Money Laundering</p>
          </div>
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10 text-center">
            <h4 class="text-lg font-bold text-white mb-2">Open Banking</h4>
            <p class="text-gray-400 text-xs">UK/EU open banking APIs</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Why Laravel -->
    <section class="py-24">
      <div class="container-custom max-w-5xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-20 animate-on-scroll">
          <h2 class="text-4xl md:text-5xl font-black mb-6">Why Laravel for <span class="gradient-text">FinTech</span></h2>
          <p class="text-gray-400 text-lg">Laravel has become the framework of choice for fintech applications because it provides the architectural foundations that financial platforms demand.</p>
        </div>
        <div class="space-y-12 max-w-4xl mx-auto">
          <div class="animate-on-scroll glass-card p-8 border-white/10 flex flex-col md:flex-row gap-6 items-start">
            <div class="w-16 h-16 rounded-2xl bg-payflo-purple/20 flex items-center justify-center flex-shrink-0">
              <Icon name="ph:queue-duotone" class="w-8 h-8 text-payflo-purple" />
            </div>
            <div>
              <h3 class="text-2xl font-black mb-3 text-white">Reliable Queue System for Financial Transactions</h3>
              <p class="text-gray-400 leading-relaxed">Laravel's queue system, built on Redis or RabbitMQ, guarantees that payment processing jobs, transaction notifications, and reconciliation tasks execute in order without data loss. Laravel Horizon provides real-time queue monitoring so operators can track every financial job through its lifecycle. Failed jobs automatically retry with exponential backoff, and our custom dead-letter handling ensures no transaction is ever lost.</p>
            </div>
          </div>
          <div class="animate-on-scroll delay-1 glass-card p-8 border-white/10 flex flex-col md:flex-row gap-6 items-start">
            <div class="w-16 h-16 rounded-2xl bg-payflo-purple/20 flex items-center justify-center flex-shrink-0">
              <Icon name="ph:database-duotone" class="w-8 h-8 text-payflo-purple" />
            </div>
            <div>
              <h3 class="text-2xl font-black mb-3 text-white">Atomic Database Transactions for Ledger Integrity</h3>
              <p class="text-gray-400 leading-relaxed">Laravel's Eloquent ORM supports nested database transactions with savepoints, enabling safe double-entry ledger updates where every debit must have a corresponding credit. If one side fails, the entire transaction rolls back atomically. Combined with pessimistic locking and database-level constraints, your financial data maintains integrity even under concurrent load.</p>
            </div>
          </div>
          <div class="animate-on-scroll delay-2 glass-card p-8 border-white/10 flex flex-col md:flex-row gap-6 items-start">
            <div class="w-16 h-16 rounded-2xl bg-payflo-purple/20 flex items-center justify-center flex-shrink-0">
              <Icon name="ph:test-tube-duotone" class="w-8 h-8 text-payflo-purple" />
            </div>
            <div>
              <h3 class="text-2xl font-black mb-3 text-white">Comprehensive Testing for Regulatory Compliance</h3>
              <p class="text-gray-400 leading-relaxed">Laravel's built-in testing tools including PHPUnit, Laravel Dusk for browser testing, and HTTP tests allow us to maintain the regulatory-grade coverage that compliance auditors require. We write feature tests for every financial flow: payment success paths, failure recovery, reconciliation accuracy, and compliance reporting. Our CI pipeline runs 2,000 tests per deployment with code quality gates.</p>
            </div>
          </div>
          <div class="animate-on-scroll delay-3 glass-card p-8 border-white/10 flex flex-col md:flex-row gap-6 items-start">
            <div class="w-16 h-16 rounded-2xl bg-payflo-purple/20 flex items-center justify-center flex-shrink-0">
              <Icon name="ph:plug-duotone" class="w-8 h-8 text-payflo-purple" />
            </div>
            <div>
              <h3 class="text-2xl font-black mb-3 text-white">FinTech Ecosystem & Third-Party Integrations</h3>
              <p class="text-gray-400 leading-relaxed">Laravel Cashier handles subscription billing and invoicing out of the box. Laravel Passport and Sanctum provide OAuth2 and token-based API security for your banking APIs. Spatie packages deliver permissions, media management, and analytics. Combined with direct integrations to Stripe, Plaid, Marqeta, Onfido, and blockchain providers, Laravel delivers a complete fintech development platform. As a <a href="/" class="text-payflo-purple hover:underline font-bold">laravel development company</a> with deep fintech expertise, we have delivered platforms processing millions of dollars in transactions monthly for clients across Europe and North America.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Cost Estimate -->
    <section class="py-24">
      <div class="container-custom max-w-4xl mx-auto">
        <h2 class="text-4xl font-black text-center mb-6">Cost <span class="gradient-text">Estimate</span></h2>
        <p class="text-gray-400 text-lg text-center max-w-3xl mx-auto mb-16 animate-on-scroll">Pricing depends on complexity, regulatory requirements, and integration scope. Every engagement includes a free compliance scoping session to define your exact requirements before any development begins.</p>
        <div class="glass-card p-10 border-white/10">
          <div class="space-y-4">
            <div class="flex justify-between pb-4 border-b border-white/5">
              <span class="text-white/70">Payment Gateway (8-12 weeks)</span>
              <span class="text-payflo-purple font-bold">$15K-$30K</span>
            </div>
            <div class="flex justify-between pb-4 border-b border-white/5">
              <span class="text-white/70">Ledger System (12-16 weeks)</span>
              <span class="text-payflo-purple font-bold">$25K-$60K</span>
            </div>
            <div class="flex justify-between">
              <span class="text-white/70">Full FinTech Platform (16-24 weeks)</span>
              <span class="text-payflo-pink font-bold">$40K-$150K</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Use Cases -->
    <section class="py-24 bg-white/5">
      <div class="container-custom max-w-5xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-20 animate-on-scroll">
          <h2 class="text-4xl md:text-5xl font-black mb-6">FinTech <span class="gradient-text">Use Cases</span></h2>
          <p class="text-gray-400 text-lg">Our Laravel fintech development services power a wide range of financial applications across multiple sectors, from payment processing to digital banking and investment platforms.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="animate-on-scroll glass-card p-8 border-white/10 group hover:border-payflo-purple/50 transition-colors">
            <Icon name="ph:credit-card-duotone" class="w-10 h-10 text-payflo-purple mb-5 group-hover:scale-110 transition-transform" />
            <h3 class="text-xl font-black mb-3 text-white">Payment Gateways</h3>
            <p class="text-gray-400 text-sm leading-relaxed">Complete payment gateways supporting credit cards through Stripe and Braintree, digital wallets like Apple Pay and Google Pay, bank transfers via Plaid and Stripe Treasury, and cryptocurrency payments through Coinbase Commerce and custom Web3 integrations. Every gateway includes PCI-DSS Level 1 compliance, tokenization, 3D Secure authentication, and detailed transaction logging with full audit trails.</p>
          </div>
          <div class="animate-on-scroll delay-1 glass-card p-8 border-white/10 group hover:border-payflo-purple/50 transition-colors">
            <Icon name="ph:hand-coins-duotone" class="w-10 h-10 text-payflo-purple mb-5 group-hover:scale-110 transition-transform" />
            <h3 class="text-xl font-black mb-3 text-white">Lending & Credit Platforms</h3>
            <p class="text-gray-400 text-sm leading-relaxed">Loan origination systems with automated underwriting, credit scoring integration through Experian and Equifax APIs, risk-based pricing engines, loan servicing dashboards, and repayment schedule management with automated collections workflows. We support consumer lending, SME lending, and peer-to-peer lending marketplaces with full regulatory compliance.</p>
          </div>
          <div class="animate-on-scroll delay-2 glass-card p-8 border-white/10 group hover:border-payflo-purple/50 transition-colors">
            <Icon name="ph:chart-line-up-duotone" class="w-10 h-10 text-payflo-purple mb-5 group-hover:scale-110 transition-transform" />
            <h3 class="text-xl font-black mb-3 text-white">Wealth Management & Investment</h3>
            <p class="text-gray-400 text-sm leading-relaxed">Portfolio tracking with real-time market data via Bloomberg and Alpha Vantage APIs, robo-advisor logic with automated rebalancing algorithms, fractional share trading capabilities, tax-loss harvesting engines, and comprehensive investor reporting dashboards with SEC-compliant disclosures and performance analytics.</p>
          </div>
          <div class="animate-on-scroll delay-3 glass-card p-8 border-white/10 group hover:border-payflo-purple/50 transition-colors">
            <Icon name="ph:shield-duotone" class="w-10 h-10 text-payflo-purple mb-5 group-hover:scale-110 transition-transform" />
            <h3 class="text-xl font-black mb-3 text-white">Insurance Technology</h3>
            <p class="text-gray-400 text-sm leading-relaxed">Policy administration systems supporting multiple product lines, claims management workflows with document upload and AI-powered damage assessment, premium calculation engines using actuarial tables, broker management portals with commission tracking, and regulatory filing automation for insurance compliance.</p>
          </div>
          <div class="animate-on-scroll delay-1 glass-card p-8 border-white/10 group hover:border-payflo-purple/50 transition-colors">
            <Icon name="ph:bank-duotone" class="w-10 h-10 text-payflo-purple mb-5 group-hover:scale-110 transition-transform" />
            <h3 class="text-xl font-black mb-3 text-white">Neobanks & Digital Banking</h3>
            <p class="text-gray-400 text-sm leading-relaxed">Core banking modules including account opening with KYC verification through Onfido and Jumio, transaction monitoring with AML screening against global watchlists, virtual and physical card issuance through Marqeta, P2P payment rails, and multi-currency account management with real-time FX conversion at interbank rates.</p>
          </div>
          <div class="animate-on-scroll delay-2 glass-card p-8 border-white/10 group hover:border-payflo-purple/50 transition-colors">
            <Icon name="ph:share-network-duotone" class="w-10 h-10 text-payflo-purple mb-5 group-hover:scale-110 transition-transform" />
            <h3 class="text-xl font-black mb-3 text-white">Blockchain & Crypto Platforms</h3>
            <p class="text-gray-400 text-sm leading-relaxed">Crypto payment gateways, exchange platforms with order book management, DeFi dashboard integrations, NFT marketplace backends, wallet integrations using Web3.js and ethers.js, and blockchain analytics through Chainalysis and Alchemy for compliance with evolving crypto regulations.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Tech Stack -->
    <section class="py-24">
      <div class="container-custom max-w-5xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-20 animate-on-scroll">
          <h2 class="text-4xl md:text-5xl font-black mb-6">Technology <span class="gradient-text">Stack</span></h2>
          <p class="text-gray-400 text-lg">Our fintech technology stack is built for security, scalability, and regulatory compliance from the application layer down to the infrastructure. Every component is selected and configured with financial-grade security requirements in mind, from encrypted data storage to hardened network perimeters.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
