---
import Layout from "../layouts/Layout.astro";
import CTASection from "../components/CTASection.astro";
import { Icon } from "astro-icon/components";

const features = [
  {
    title: "PCI-Compliant Payments",
    desc: "Stripe, PayPal, bank transfers with PCI-DSS compliance and secure tokenization.",
    icon: "ph:credit-card-duotone"
  },
  {
    title: "Bank-Grade APIs",
    desc: "Open Banking, Plaid, Stripe Treasury, and custom ledger system integrations.",
    icon: "ph:bank-duotone"
  },
    {
    title: "Ledger & Accounting",
    desc: "Double-entry ledger, transaction tracking, reconciliation, and financial reporting.",
    icon: "ph:bank-duotone"
  },
  {
    title: "Fraud Detection",
    desc: "Real-time transaction monitoring, velocity checks, and ML-based fraud scoring.",
    icon: "ph:shield-check-duotone"
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      "name": "Why use Laravel for fintech development?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Laravel offers robust queue systems for financial transactions, excellent testing tools for regulatory compliance, and packages like Laravel Cashier and custom ledger implementations."
      }
    },
    {
      "@type": "Question",
      "name": "How much does fintech software development cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Fintech platforms cost $40,000-$150,000+ depending on complexity. Payment gateways start at $15,000. Ledger systems cost $25,000-$60,000."
      }
    },
    {
      "@type": "Question",
      "name": "Do you handle PCI compliance?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. We build PCI-DSS compliant payment flows, use tokenization, never store raw card data, and provide compliance documentation for audits."
      }
    },
    {
      "@type": "Question",
      "name": "Can you integrate with banking APIs?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Absolutely. We integrate with Plaid, Stripe Treasury, Open Banking APIs, SWIFT, and major bank APIs for account verification and transfers."
      }
    }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Laravel FinTech Development",
  "provider": {
    "@type": "Organization",
    "name": "Laravel Company",
    "url": "https://laravelcompany.com"
  },
  "description": "Laravel fintech development: PCI compliance, bank-grade APIs, ledger systems, fraud detection. $40K-$150K.",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "FinTech Services",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Payment Gateway" }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Ledger System" }}
    ]
  }
};
---

<Layout
  title="Laravel FinTech Development | PCI Compliant Banking Software"
  description="Laravel development for fintech: PCI compliance, bank-grade APIs, ledger systems, fraud detection. $40K-$150K. Get a free consultation."
>
  <main id="main-content">
    <!-- Hero -->
    <section class="pt-24 pb-20 md:pt-32 md:pb-28 overflow-hidden relative bg-payflo-dark">
      <div class="absolute inset-0 opacity-10 -z-10">
        <div class="absolute top-0 left-0 w-full h-full bg-[radial-gradient(circle_at_50%_120%,rgba(120,119,198,0.3),rgba(255,255,255,0))]"></div>
      </div>
      <div class="container-custom relative">
        <nav class="flex justify-center items-center gap-2 text-sm text-white/50 mb-8 animate-on-scroll">
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <span>/</span>
          <a href="/laravel-services/" class="hover:text-white transition-colors">Services</a>
          <span>/</span>
          <span class="text-white">FinTech Development</span>
        </nav>
        <div class="max-w-4xl mx-auto text-center">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-payflo-purple/10 border border-payflo-purple/20 mb-8 animate-on-scroll">
            <Icon name="ph:bank-duotone" class="w-5 h-5 text-payflo-purple" />
            <span class="text-sm font-bold uppercase tracking-widest text-white/70">FinTech Specialists</span>
          </div>
          <h1 class="animate-on-scroll delay-1 text-5xl md:text-7xl lg:text-8xl font-black leading-tight tracking-tight text-white">
            Laravel <span class="gradient-text">FinTech Development</span>
          </h1>
          <p class="animate-on-scroll delay-2 mt-8 text-xl md:text-2xl text-white/70 leading-relaxed font-medium">
            PCI-compliant payment systems, bank-grade APIs, ledger systems, and fraud detection. Starting at $40,000.
          </p>
          <div class="animate-on-scroll delay-3 mt-12 flex flex-wrap justify-center gap-6">
            <a href="/contact/" class="btn btn-primary px-10 py-5 text-lg shadow-2xl">Get FinTech Quote</a>
            <a href="/startup-laravel-agency/" class="btn glass-card border-white/20 px-10 py-5 text-lg hover:bg-white/10 transition-all font-bold">Startup Solutions</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Core Features -->
    <section class="py-24">
      <div class="container-custom">
        <div class="text-center max-w-3xl mx-auto mb-20 animate-on-scroll">
          <h2 class="text-4xl md:text-5xl font-black mb-6">FinTech <span class="gradient-text">Core Features</span></h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
          {features.map((f, i) => (
            <div class="animate-on-scroll delay-{i} glass-card p-10 border-white/10 group hover:border-payflo-purple/50 transition-colors">
              <Icon name={f.icon} class="w-12 h-12 text-payflo-purple mb-6 group-hover:scale-110 transition-transform" />
              <h3 class="text-2xl font-black mb-4 text-white">{f.title}</h3>
              <p class="text-gray-400 text-sm leading-relaxed">{f.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Compliance -->
    <section class="py-24 bg-white/5">
      <div class="container-custom max-w-4xl mx-auto">
        <h2 class="text-4xl font-black text-center mb-16">Compliance <span class="gradient-text">Ready</span></h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10 text-center">
            <h4 class="text-lg font-bold text-white mb-2">PCI-DSS</h4>
            <p class="text-gray-400 text-xs">Payment Card Industry compliance</p>
          </div>
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10 text-center">
            <h4 class="text-lg font-bold text-white mb-2">GDPR</h4>
            <p class="text-gray-400 text-xs">EU data protection regulation</p>
          </div>
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10 text-center">
            <h4 class="text-lg font-bold text-white mb-2">SOC 2</h4>
            <p class="text-gray-400 text-xs">Security controls framework</p>
          </div>
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10 text-center">
            <h4 class="text-lg font-bold text-white mb-2">PSD2</h4>
            <p class="text-gray-400 text-xs">EU payment services directive</p>
          </div>
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10 text-center">
            <h4 class="text-lg font-bold text-white mb-2">KYC/AML</h4>
            <p class="text-gray-400 text-xs">Know Your Customer / Anti-Money Laundering</p>
          </div>
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10 text-center">
            <h4 class="text-lg font-bold text-white mb-2">Open Banking</h4>
            <p class="text-gray-400 text-xs">UK/EU open banking APIs</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Cost Estimate -->
    <section class="py-24">
      <div class="container-custom max-w-4xl mx-auto">
        <h2 class="text-4xl font-black text-center mb-16">Cost <span class="gradient-text">Estimate</span></h2>
        <div class="glass-card p-10 border-white/10">
          <div class="space-y-4">
            <div class="flex justify-between pb-4 border-b border-white/5">
              <span class="text-white/70">Payment Gateway (8-12 weeks)</span>
              <span class="text-payflo-purple font-bold">$15K-$30K</span>
            </div>
            <div class="flex justify-between pb-4 border-b border-white/5">
              <span class="text-white/70">Ledger System (12-16 weeks)</span>
              <span class="text-payflo-purple font-bold">$25K-$60K</span>
            </div>
            <div class="flex justify-between">
              <span class="text-white/70">Full FinTech Platform (16-24 weeks)</span>
              <span class="text-payflo-pink font-bold">$40K-$150K</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-24 bg-white/5">
      <div class="container-custom max-w-4xl mx-auto">
        <h2 class="text-4xl font-black text-center mb-16">FinTech <span class="gradient-text">FAQ</span></h2>
        <div class="space-y-6">
          <div class="p-8 glass-card border-white/10">
            <h4 class="text-lg font-bold mb-3 text-white">Why use Laravel for fintech development?</h4>
            <p class="text-gray-400">Laravel offers robust queue systems for financial transactions, excellent testing tools for regulatory compliance, and packages like Laravel Cashier and custom ledger implementations.</p>
          </div>
          <div class="p-8 glass-card border-white/10">
            <h4 class="text-lg font-bold mb-3 text-white">Do you handle PCI compliance?</h4>
            <p class="text-gray-400">Yes. We build PCI-DSS compliant payment flows, use tokenization, never store raw card data, and provide compliance documentation for audits.</p>
          </div>
          <div class="p-8 glass-card border-white/10">
            <h4 class="text-lg font-bold mb-3 text-white">Can you integrate with banking APIs?</h4>
            <p class="text-gray-400">Absolutely. We integrate with Plaid, Stripe Treasury, Open Banking APIs, SWIFT, and major bank APIs for account verification and transfers.</p>
          </div>
        </div>
      </div>
    </section>

    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

    <!-- Internal Links -->
    <section class="py-16 border-t border-white/5">
      <div class="container-custom">
        <div class="flex flex-wrap justify-center gap-6 text-sm">
          <a href="/hire-laravel-developer/" class="text-payflo-purple hover:underline font-bold">Hire FinTech Developer →</a>
          <a href="/laravel-saas-development/" class="text-payflo-purple hover:underline font-bold">SaaS Development →</a>
          <a href="/laravel-api-development/" class="text-payflo-purple hover:underline font-bold">API Development →</a>
        </div>
      </div>
    </section>

    <CTASection />
  </main>
</Layout>

<style>
  .btn { @apply inline-flex items-center justify-center font-black transition-all duration-300 rounded-2xl; }
  .btn-primary { @apply bg-gradient-to-r from-payflo-purple to-payflo-pink text-white shadow-xl shadow-purple-600/30 hover:shadow-purple-600/50 hover:-translate-y-1; }
  .glass-card { @apply bg-white/5 backdrop-blur-xl border border-white/10 rounded-3xl shadow-2xl; }
  .gradient-text { @apply bg-clip-text text-transparent bg-gradient-to-r from-payflo-purple to-payflo-pink; }
</style>
