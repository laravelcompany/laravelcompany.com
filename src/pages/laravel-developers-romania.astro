---
import Layout from "../layouts/Layout.astro";
import CTASection from "../components/CTASection.astro";
import { Icon } from "astro-icon/components";

const stats = [
  { value: "50+", label: "Active Developers" },
  { value: "$35-$75", label: "Hourly Rate" },
  { value: "EU", label: "Timezone" },
  { value: "100%", label: "English Fluent" }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      "name": "Why hire Laravel developers in Romania?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Romania offers top-tier engineering talent at 60-70% lower rates than USA/UK. Developers are EU-based, speak fluent English, and work in European timezones with 4-6 hour overlap with Western Europe."
      }
    },
    {
      "@type": "Question",
      "name": "How much do Romanian Laravel developers cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Hourly rates range from $35/hour for mid-level to $75/hour for senior architects. Dedicated full-time developers cost $4,500-$10,000/month including overhead."
      }
    },
    {
      "@type": "Question",
      "name": "Are Romanian developers fluent in English?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. All our Romanian developers speak fluent English (C1/C2 level). They have experience working with US/UK clients and understand Western business culture."
      }
    },
    {
      "@type": "Question",
      "name": "What is the timezone overlap with Western Europe?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Romania is in Eastern European Time (EET), which is 1 hour ahead of UK and same as Central Europe. Full overlap with UK (8h) and Western Europe (7-8h)."
      }
    }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Laravel Developers Romania",
  "provider": {
    "@type": "Organization",
    "name": "Laravel Company",
    "url": "https://laravelcompany.com"
  },
  "description": "Hire Laravel developers in Romania. $35-$75/hour, EU timezone, fluent English, 50+ available experts.",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Romania Developer Rates",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Mid-Level Developer" }, "price": "35", "priceCurrency": "USD" },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Senior Developer" }, "price": "55", "priceCurrency": "USD" }
    ]
  }
};
---

<Layout
  title="Laravel Developers Romania | Hire EU-Based Experts $35/hr"
  description="Hire Laravel developers in Romania. $35-$75/hour, EU timezone, fluent English, 50+ available experts. 48h deployment."
>
  <main id="main-content">
    <!-- Hero -->
    <section class="pt-24 pb-20 md:pt-32 md:pb-28 overflow-hidden relative bg-payflo-dark">
      <div class="absolute inset-0 opacity-10 -z-10">
        <div class="absolute top-0 left-0 w-full h-full bg-[radial-gradient(circle_at_50%_120%,rgba(120,119,198,0.3),rgba(255,255,255,0))]"></div>
      </div>
      <div class="container-custom relative">
        <nav class="flex justify-center items-center gap-2 text-sm text-white/50 mb-8 animate-on-scroll">
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <span>/</span>
          <a href="/laravel-services/" class="hover:text-white transition-colors">Services</a>
          <span>/</span>
          <span class="text-white">Developers in Romania</span>
        </nav>
        <div class="max-w-4xl mx-auto text-center">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-payflo-purple/10 border border-payflo-purple/20 mb-8 animate-on-scroll">
            <Icon name="ph:map-pin-duotone" class="w-5 h-5 text-payflo-purple" />
            <span class="text-sm font-bold uppercase tracking-widest text-white/70">Romania Based</span>
          </div>
          <h1 class="animate-on-scroll delay-1 text-5xl md:text-7xl lg:text-8xl font-black leading-tight tracking-tight text-white">
            Laravel <span class="gradient-text">Developers Romania</span>
          </h1>
          <p class="animate-on-scroll delay-2 mt-8 text-xl md:text-2xl text-white/70 leading-relaxed font-medium">
            EU-based talent at $35-$75/hour. Fluent English, 4-6h timezone overlap with Western Europe. 50+ developers available.
          </p>
          <div class="animate-on-scroll delay-3 mt-12 flex flex-wrap justify-center gap-6">
            <a href="/contact/" class="btn btn-primary px-10 py-5 text-lg shadow-2xl">Hire Romanian Dev</a>
            <a href="/outsource-laravel-development/" class="btn glass-card border-white/20 px-10 py-5 text-lg hover:bg-white/10 transition-all font-bold">Outsourcing →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Stats -->
    <section class="py-16 border-y border-white/5 bg-white/[0.02]">
      <div class="container-custom">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 max-w-4xl mx-auto">
          {stats.map((s) => (
            <div class="text-center">
              <div class="text-4xl lg:text-5xl font-black text-payflo-purple">{s.value}</div>
              <div class="text-xs text-white/50 font-bold uppercase tracking-widest mt-2">{s.label}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Why Romania -->
    <section class="py-24">
      <div class="container-custom">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
          <div class="animate-on-scroll">
            <h2 class="text-4xl font-black mb-8">Why <span class="gradient-text">Romania</span> for Laravel?</h2>
            <div class="space-y-6">
              <div class="flex gap-4">
                <Icon name="ph:currency-circle-dollar-duotone" class="w-8 h-8 text-payflo-purple flex-shrink-0 mt-1" />
                <div>
                  <h4 class="text-lg font-bold text-white mb-1">60% Cost Savings</h4>
                  <p class="text-gray-400 text-sm">Same quality as US/UK developers at a fraction of the cost.</p>
                </div>
              </div>
              <div class="flex gap-4">
                <Icon name="ph:globe-duotone" class="w-8 h-8 text-payflo-pink flex-shrink-0 mt-1" />
                <div>
                  <h4 class="text-lg font-bold text-white mb-1">EU Timezone</h4>
                  <p class="text-gray-400 text-sm">4-6 hour overlap with UK, full overlap with Western Europe.</p>
                </div>
              </div>
              <div class="flex gap-4">
                <Icon name="ph:chalkboard-teacher-duotone" class="w-8 h-8 text-payflo-purple flex-shrink-0 mt-1" />
                <div>
                  <h4 class="text-lg font-bold text-white mb-1">Top Engineering Education</h4>
                  <p class="text-gray-400 text-sm">Strong CS programs, high coding competition rankings in Europe.</p>
                </div>
              </div>
            </div>
          </div>
          <div class="animate-on-scroll delay-2">
            <div class="glass-card p-10 border-payflo-purple/20">
              <h3 class="text-2xl font-black text-white mb-6">Rate Comparison</h3>
              <div class="space-y-4">
                <div class="flex justify-between pb-4 border-b border-white/5">
                  <span class="text-white/70">Romania (Mid)</span>
                  <span class="text-payflo-purple font-bold">$35-$50/hr</span>
                </div>
                <div class="flex justify-between pb-4 border-b border-white/5">
                  <span class="text-white/70">Romania (Senior)</span>
                  <span class="text-payflo-purple font-bold">$55-$75/hr</span>
                </div>
                <div class="flex justify-between pb-4 border-b border-white/5">
                  <span class="text-white/50">USA (Mid)</span>
                  <span class="text-white/40 line-through">$75-$120/hr</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-white/50">USA (Senior)</span>
                  <span class="text-white/40 line-through">$120-$200/hr</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Developer Profiles -->
    <section class="py-24 bg-white/5">
      <div class="container-custom">
        <div class="text-center max-w-3xl mx-auto mb-20 animate-on-scroll">
          <h2 class="text-4xl md:text-5xl font-black mb-6">Developer <span class="gradient-text">Profiles</span></h2>
          <p class="text-gray-400 text-lg">Every Romanian developer is vetted, fluent in English, and ready to start in 48h.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
          <div class="glass-card p-8 border-white/10 text-center">
            <div class="w-20 h-20 rounded-full bg-payflo-purple/10 border border-payflo-purple/20 flex items-center justify-center mx-auto mb-6">
              <Icon name="ph:user-circle-duotone" class="w-10 h-10 text-payflo-purple" />
            </div>
            <h4 class="text-xl font-black text-white mb-2">Mid-Level</h4>
            <p class="text-payflo-purple font-bold mb-4">$35-$50/hr</p>
            <p class="text-gray-400 text-sm">3-5 years experience, strong Laravel fundamentals, works independently.</p>
          </div>
          <div class="glass-card p-8 border-payflo-purple/30 scale-105 shadow-2xl text-center">
            <div class="w-20 h-20 rounded-full bg-payflo-purple/20 border border-payflo-purple/30 flex items-center justify-center mx-auto mb-6">
              <Icon name="ph:user-focus-duotone" class="w-10 h-10 text-payflo-purple" />
            </div>
            <h4 class="text-xl font-black text-white mb-2">Senior</h4>
            <p class="text-payflo-purple font-bold mb-4">$55-$75/hr</p>
            <p class="text-gray-400 text-sm">5+ years, architecture decisions, team lead, complex problem solving.</p>
          </div>
          <div class="glass-card p-8 border-white/10 text-center">
            <div class="w-20 h-20 rounded-full bg-payflo-purple/10 border border-payflo-purple/20 flex items-center justify-center mx-auto mb-6">
              <Icon name="ph:user-gear-duotone" class="w-10 h-10 text-payflo-purple" />
            </div>
            <h4 class="text-xl font-black text-white mb-2">Architect</h4>
            <p class="text-payflo-purple font-bold mb-4">$75-$100/hr</p>
            <p class="text-gray-400 text-sm">8+ years, system design, scalability, mentorship, CTO-level input.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-24">
      <div class="container-custom max-w-4xl mx-auto">
        <h2 class="text-4xl font-black text-center mb-16">Romania <span class="gradient-text">FAQ</span></h2>
        <div class="space-y-6">
          <div class="p-8 glass-card border-white/10">
            <h4 class="text-lg font-bold mb-3 text-white">Why hire Laravel developers in Romania?</h4>
            <p class="text-gray-400">Romania offers top-tier engineering talent at 60-70% lower rates than USA/UK. Developers are EU-based, speak fluent English, and work in European timezones with 4-6 hour overlap with Western Europe.</p>
          </div>
          <div class="p-8 glass-card border-white/10">
            <h4 class="text-lg font-bold mb-3 text-white">How much do Romanian Laravel developers cost?</h4>
            <p class="text-gray-400">Hourly rates range from $35/hour for mid-level to $75/hour for senior architects. Dedicated full-time developers cost $4,500-$10,000/month including overhead.</p>
          </div>
          <div class="p-8 glass-card border-white/10">
            <h4 class="text-lg font-bold mb-3 text-white">Are Romanian developers fluent in English?</h4>
            <p class="text-gray-400">Yes. All our Romanian developers speak fluent English (C1/C2 level). They have experience working with US/UK clients and understand Western business culture.</p>
          </div>
        </div>
      </div>
    </section>

    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

    <!-- Internal Links -->
    <section class="py-16 border-t border-white/5">
      <div class="container-custom">
        <div class="flex flex-wrap justify-center gap-6 text-sm">
          <a href="/" class="text-payflo-purple hover:underline font-bold">Laravel Development Company →</a>
          <a href="/hire-laravel-developer/" class="text-payflo-purple hover:underline font-bold">Hire Developer →</a>
          <a href="/laravel-development-company-europe/" class="text-payflo-purple hover:underline font-bold">Europe Company →</a>
          <a href="/hire-laravel-developer-remote/" class="text-payflo-purple hover:underline font-bold">Remote Hiring →</a>
          <a href="/nearshore-laravel-development/" class="text-payflo-purple hover:underline font-bold">Nearshore →</a>
        </div>
      </div>
    </section>

    <CTASection />
  </main>
</Layout>

<style>
  .btn { @apply inline-flex items-center justify-center font-black transition-all duration-300 rounded-2xl; }
  .btn-primary { @apply bg-gradient-to-r from-payflo-purple to-payflo-pink text-white shadow-xl shadow-purple-600/30 hover:shadow-purple-600/50 hover:-translate-y-1; }
  .glass-card { @apply bg-white/5 backdrop-blur-xl border border-white/10 rounded-3xl shadow-2xl; }
  .gradient-text { @apply bg-clip-text text-transparent bg-gradient-to-r from-payflo-purple to-payflo-pink; }
</style>
