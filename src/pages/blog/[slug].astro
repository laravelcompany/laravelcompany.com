---
import Layout from "../../layouts/Layout.astro";
import BlogLeadscaptainPopup from "../../components/BlogLeadscaptainPopup.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import logoSrc from "../../assets/logo.svg";
import { marked } from "marked";
import { enrichCodeBlocks } from "../../utils/codeHighlighter";

function isMarkdown(content: string): boolean {
  const trimmed = content.trimStart();
  if (trimmed.startsWith("<")) return false;
  return /(^#{1,6}\s|^\*\*|^\-\s|^\d+\.\s|```|^\[.*\]\(|^>\s|\|.+\|)/m.test(trimmed);
}

marked.setOptions({
  gfm: true,
  breaks: true,
});

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { data } = post;

// Many imported posts embed generator labels in the content itself: a
// leading "Title: ..." line (a duplicate of the post title, which this
// page already renders as the h1) and a bare "Body:" marker line before
// the actual text. Strip both so readers and search engines never see
// them.
function stripContentLabels(content: string): string {
  return content
    .replace(/^\s*Title:[^\n]*(\r?\n)?/, "")
    .replace(/^Body:\s*$/gm, "")
    .trimStart();
}

const cleanContent = stripContentLabels(data.content);
const cleanExcerpt = data.excerpt
  .replace(/^Title:\s*/, "")
  .replace(/\s*Body:\s*/, " ")
  .trim();
const rawContent = isMarkdown(cleanContent)
  ? marked.parse(cleanContent) as string
  : cleanContent;
const renderedContent = await enrichCodeBlocks(rawContent);

// Google truncates meta descriptions around 155-160 characters.
function truncateDescription(text: string, max = 157): string {
  if (text.length <= 160) return text;
  const cut = text.slice(0, max);
  const lastSpace = cut.lastIndexOf(" ");
  return (lastSpace > 80 ? cut.slice(0, lastSpace) : cut).trimEnd() + "…";
}

const description = truncateDescription(cleanExcerpt);
const postUrl = new URL(`/blog/${post.id}/`, Astro.site).href;
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: data.title,
  description,
  datePublished: data.date,
  author: {
    "@type": "Person",
    name: data.author,
    ...(data.authorRole ? { jobTitle: data.authorRole } : {}),
  },
  publisher: {
    "@type": "Organization",
    name: "Laravel Company",
    url: "https://laravelcompany.com",
    logo: {
      "@type": "ImageObject",
      url: "https://laravelcompany.com/logo-square.png",
    },
  },
  mainEntityOfPage: { "@type": "WebPage", "@id": postUrl },
  ...(data.image ? { image: new URL(data.image, Astro.site).href } : {}),
  ...(data.tags?.length ? { keywords: data.tags.join(", ") } : {}),
};
---

<Layout
  title={`${data.title} | Laravel Company Blog`}
  description={description}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <main class="py-20 px-6 sm:px-8 lg:px-12 max-w-7xl mx-auto">
    <nav class="flex justify-center items-center gap-2 text-sm text-white/50 mb-8 animate-on-scroll">
      <a href="/" class="hover:text-white transition-colors">Home</a>
      <span>/</span>
      <a href="/blog/" class="hover:text-white transition-colors">Blog</a>
      <span>/</span>
      <span class="text-white truncate max-w-[200px]">{data.title}</span>
    </nav>

    <article class="blog-post max-w-3xl mx-auto">
      <div class="animate-on-scroll">
        <div class="flex flex-wrap gap-2 mb-4">
          {data.tags?.map((tag) => (
            <span class="text-xs px-2.5 py-1 rounded-full bg-payflo-purple/20 text-payflo-purple font-medium">
              {tag}
            </span>
          ))}
        </div>

        <h1 class="text-3xl md:text-4xl font-bold mb-6">{data.title}</h1>

        <div class="flex items-center gap-4 mb-8 pb-8 border-b border-white/10">
          <div>
            <p class="font-semibold text-white">{data.author}</p>
            <p class="text-sm text-white/50">{data.authorRole} &middot; {data.date}</p>
          </div>
        </div>
      </div>

      {data.image ? (
        <img
          src={data.image}
          alt={data.title}
          class="w-full rounded-xl mb-10 animate-on-scroll"
        />
      ) : (
        <div class="w-full rounded-xl mb-10 animate-on-scroll bg-payflo-darker flex items-center justify-center py-20">
          <Image
            src={logoSrc}
            alt="Laravel Company"
            width={96}
            class="w-24 h-24 opacity-30"
          />
        </div>
      )}

      <div class="prose prose-slate max-w-none animate-on-scroll">
        <Fragment set:html={renderedContent} />
      </div>
    </article>
  </main>
  <BlogLeadscaptainPopup />
</Layout>

<script>
  function copyText(text: string) {
    if (navigator.clipboard?.writeText) {
      return navigator.clipboard.writeText(text);
    }
    const textarea = document.createElement("textarea");
    textarea.value = text;
    textarea.style.position = "fixed";
    textarea.style.opacity = "0";
    document.body.appendChild(textarea);
    textarea.select();
    document.execCommand("copy");
    textarea.remove();
    return Promise.resolve();
  }

  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const button = target.closest(".code-block__copy");
    if (!button) return;

    const block = button.closest(".code-block");
    const codeElement = block?.querySelector("pre code");
    if (!codeElement) return;

    const text = (codeElement.textContent ?? "").replace(/\n$/, "");
    const label = button.querySelector(".code-block__copy-label");
    const iconWrap = button.querySelector(".code-block__copy-icon-wrap");
    const copyIcon = `<svg class="code-block__copy-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="5.5" y="5.5" width="8" height="8" rx="1.5" stroke="currentColor" stroke-width="1.4"/><path d="M10.5 5.5v-2a1 1 0 0 0-1-1h-5a1 1 0 0 0-1 1v5a1 1 0 0 0 1 1h2" stroke="currentColor" stroke-width="1.4"/></svg>`;
    const checkIcon = `<svg class="code-block__copy-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8.5 6.2 11.5 13 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>`;

    copyText(text).then(() => {
      button.classList.add("code-block__copy--done");
      if (label) label.textContent = "Copied!";
      if (iconWrap) iconWrap.innerHTML = checkIcon;
      setTimeout(() => {
        button.classList.remove("code-block__copy--done");
        if (label) label.textContent = "Copy";
        if (iconWrap) iconWrap.innerHTML = copyIcon;
      }, 2000);
    });
  });
</script>

<style is:global>
  .blog-post .prose {
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.8;
  }
  .blog-post .prose h2 {
    color: white;
    font-size: 1.5rem;
    font-weight: 700;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }
  .blog-post .prose h3 {
    color: white;
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .blog-post .prose p {
    margin-bottom: 1.25rem;
  }
  .blog-post .prose ul {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }
  .blog-post .prose li {
    margin-bottom: 0.5rem;
  }
  .blog-post .prose strong {
    color: white;
  }
  .blog-post .prose a {
    color: #7c3aed;
    text-decoration: underline;
    transition: color 0.2s;
  }
  .blog-post .prose a:hover {
    color: #3b82f6;
  }
  .blog-post .prose blockquote {
    border-left: 4px solid #7c3aed;
    padding-left: 1.5rem;
    margin: 1.5rem 0;
    color: rgba(255, 255, 255, 0.7);
    font-style: italic;
  }
  .blog-post .prose img {
    border-radius: 0.75rem;
    margin: 1.5rem 0;
  }
  .blog-post .prose .lead-paragraph {
    font-size: 1.125rem;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.8;
  }
  .blog-post .prose .highlight-box p {
    margin-bottom: 0;
  }
  .blog-post .prose ol {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
    list-style-type: decimal;
  }
  .blog-post .prose ol li {
    margin-bottom: 0.5rem;
  }
  .blog-post .prose pre {
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.75rem;
    padding: 1.25rem;
    overflow-x: auto;
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
    line-height: 1.7;
  }
  .blog-post .prose code {
    font-family: "JetBrains Mono", "Fira Code", monospace;
    font-size: 0.875em;
  }
  .blog-post .prose :not(pre) > code {
    background: rgba(124, 58, 237, 0.2);
    color: #c4b5fd;
    padding: 0.15em 0.4em;
    border-radius: 0.375rem;
    font-size: 0.85em;
  }
  .blog-post .prose pre code {
    background: none;
    color: rgba(255, 255, 255, 0.85);
    padding: 0;
    border-radius: 0;
  }
  .blog-post .prose table {
    width: 100%;
    margin-bottom: 1.5rem;
    border-collapse: collapse;
  }
  .blog-post .prose th,
  .blog-post .prose td {
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 0.625rem 1rem;
    text-align: left;
  }
  .blog-post .prose th {
    background: rgba(255, 255, 255, 0.05);
    color: white;
    font-weight: 600;
  }
  .blog-post .prose hr {
    border: none;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    margin: 2rem 0;
  }
</style>
