---
import Layout from "../layouts/Layout.astro";
import CTASection from "../components/CTASection.astro";
import { Icon } from "astro-icon/components";

const checks = [
  { category: "OWASP Top 10", items: ["SQL Injection", "XSS (Cross-Site Scripting)", "CSRF Protection", "Insecure Deserialization", "Broken Authentication"] },
  { category: "Laravel Specific", items: ["Mass Assignment", "Unvalidated Requests", "Insecure Facades", "Env File Exposure", "Debug Mode in Production"] },
  { category: "Infrastructure", items: ["HTTPS/TLS Configuration", "CORS Policy", "Rate Limiting", "Dependency Scanning", "Server Hardening"] },
  { category: "Compliance", items: ["GDPR Readiness", "PCI-DSS (if payments)", "SOC 2 Controls", "Data Encryption", "Access Logging"] }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      "name": "What does a Laravel security audit include?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Our audit covers OWASP Top 10 vulnerabilities, Laravel-specific issues (mass assignment, CSRF, XSS), dependency scanning, server configuration, and compliance readiness (GDPR, PCI)."
      }
    },
    {
      "@type": "Question",
      "name": "How long does a Laravel security audit take?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Most audits complete in 5-7 business days. We provide a preliminary high-risk report within 48 hours and a full detailed report with remediation steps by day 7."
      }
    },
    {
      "@type": "Question",
      "name": "How much does a Laravel security audit cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Security audits start at $2,500 for small applications. Medium apps cost $5,000-$8,000. Enterprise audits with compliance reporting cost $10,000+."
      }
    },
    {
      "@type": "Question",
      "name": "Do you provide fixes after the audit?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. We offer fixed-price remediation packages. Our developers implement all fixes, retest, and provide a clean security report ready for your stakeholders."
      }
    },
    {
      "@type": "Question",
      "name": "Are you PCI/GDPR compliance ready?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We audit for GDPR (data protection, user consent, right to erasure) and PCI-DSS (if handling payments). Our reports map findings to specific compliance controls."
      }
    }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Laravel Security Audit",
  "provider": {
    "@type": "Organization",
    "name": "Laravel Company",
    "url": "https://laravelcompany.com"
  },
  "description": "Laravel security audit service: OWASP Top 10, SQL injection, XSS, CSRF, mass assignment, PCI/GDPR readiness. $2,500+ with remediation.",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Security Services",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Security Audit" }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Penetration Testing" }}
    ]
  }
};
---

<Layout
  title="Laravel Security Audit Service | OWASP, PCI, GDPR Compliance"
  description="Laravel security audit service: OWASP Top 10, SQL injection, XSS, CSRF, mass assignment, PCI/GDPR compliance. $2,500+. Get audit quote."
>
  <main id="main-content">
    <!-- Hero -->
    <section class="pt-24 pb-20 md:pt-32 md:pb-28 overflow-hidden relative bg-payflo-dark">
      <div class="absolute inset-0 opacity-10 -z-10">
        <div class="absolute top-0 left-0 w-full h-full bg-[radial-gradient(circle_at_50%_120%,rgba(120,119,198,0.3),rgba(255,255,255,0))]"></div>
      </div>
      <div class="container-custom relative">
        <nav class="flex justify-center items-center gap-2 text-sm text-white/50 mb-8 animate-on-scroll">
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <span>/</span>
          <a href="/laravel-services/" class="hover:text-white transition-colors">Services</a>
          <span>/</span>
          <span class="text-white">Security Audit</span>
        </nav>
        <div class="max-w-4xl mx-auto text-center">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-red-500/10 border border-red-500/20 mb-8 animate-on-scroll">
            <Icon name="ph:shield-warning-duotone" class="w-5 h-5 text-red-400" />
            <span class="text-sm font-bold uppercase tracking-widest text-white/70">Security First</span>
          </div>
          <h1 class="animate-on-scroll delay-1 text-5xl md:text-7xl lg:text-8xl font-black leading-tight tracking-tight text-white">
            Laravel <span class="gradient-text">Security Audit</span>
          </h1>
          <p class="animate-on-scroll delay-2 mt-8 text-xl md:text-2xl text-white/70 leading-relaxed font-medium">
            OWASP Top 10, SQL injection, XSS, CSRF, mass assignment. PCI/GDPR compliance ready. Starting at $2,500.
          </p>
          <div class="animate-on-scroll delay-3 mt-12 flex flex-wrap justify-center gap-6">
            <a href="/contact/" class="btn btn-primary px-10 py-5 text-lg shadow-2xl">Get Security Audit Quote</a>
            <a href="/laravel-performance-optimization/" class="btn glass-card border-white/20 px-10 py-5 text-lg hover:bg-white/10 transition-all font-bold">Performance Audit</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Threat Stats -->
    <section class="py-24 bg-white/5">
      <div class="container-custom">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
          <div class="p-8 rounded-2xl bg-red-500/5 border border-red-500/20 text-center">
            <div class="text-5xl font-black text-red-400 mb-2">37%</div>
            <p class="text-white/70 text-sm">of WordPress hacks via plugins. Laravel has no plugins.</p>
          </div>
          <div class="p-8 rounded-2xl bg-red-500/5 border border-red-500/20 text-center">
            <div class="text-5xl font-black text-red-400 mb-2">70%</div>
            <p class="text-white/70 text-sm">of apps have OWASP Top 10 vulnerabilities.</p>
          </div>
          <div class="p-8 rounded-2xl bg-red-500/5 border border-red-500/20 text-center">
            <div class="text-5xl font-black text-red-400 mb-2">$4.45M</div>
            <p class="text-white/70 text-sm">average cost of a data breach in 2024.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Audit Coverage -->
    <section class="py-24">
      <div class="container-custom">
        <div class="text-center max-w-3xl mx-auto mb-20 animate-on-scroll">
          <h2 class="text-4xl md:text-5xl font-black mb-6">Audit <span class="gradient-text">Coverage</span></h2>
          <p class="text-gray-400 text-lg">Comprehensive security review across 4 key areas.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
          {checks.map((c, i) => (
            <div class="animate-on-scroll delay-{i} glass-card p-8 border-white/10">
              <h3 class="text-xl font-black text-white mb-6 flex items-center gap-3">
                <Icon name="ph:shield-check-duotone" class="w-6 h-6 text-payflo-purple" />
                {c.category}
              </h3>
              <ul class="space-y-3">
                {c.items.map(item => (
                  <li class="flex items-center gap-2 text-sm text-white/60">
                    <Icon name="ph:check-circle-fill" class="w-4 h-4 text-payflo-purple" /> {item}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Process -->
    <section class="py-24 bg-white/5">
      <div class="container-custom max-w-4xl mx-auto">
        <h2 class="text-4xl font-black text-center mb-16">Audit <span class="gradient-text">Process</span></h2>
        <div class="space-y-8">
          <div class="flex gap-6 items-start">
            <div class="w-12 h-12 bg-payflo-purple/10 rounded-xl flex items-center justify-center flex-shrink-0 border border-payflo-purple/20">
              <span class="font-black text-payflo-purple">1</span>
            </div>
            <div>
              <h4 class="text-lg font-bold text-white mb-2">Automated Scanning</h4>
              <p class="text-gray-400 text-sm">Run static analysis, dependency scanners, and vulnerability databases against your codebase.</p>
            </div>
          </div>
          <div class="flex gap-6 items-start">
            <div class="w-12 h-12 bg-payflo-purple/10 rounded-xl flex items-center justify-center flex-shrink-0 border border-payflo-purple/20">
              <span class="font-black text-payflo-purple">2</span>
            </div>
            <div>
              <h4 class="text-lg font-bold text-white mb-2">Manual Penetration Testing</h4>
              <p class="text-gray-400 text-sm">Our security experts attempt SQL injection, XSS, CSRF, and privilege escalation attacks.</p>
            </div>
          </div>
          <div class="flex gap-6 items-start">
            <div class="w-12 h-12 bg-payflo-purple/10 rounded-xl flex items-center justify-center flex-shrink-0 border border-payflo-purple/20">
              <span class="font-black text-payflo-purple">3</span>
            </div>
            <div>
              <h4 class="text-lg font-bold text-white mb-2">Report & Remediation</h4>
              <p class="text-gray-400 text-sm">Detailed report with CVSS scores, proof-of-concept, and step-by-step remediation guide.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-24">
      <div class="container-custom max-w-4xl mx-auto">
        <h2 class="text-4xl font-black text-center mb-16">Security <span class="gradient-text">FAQ</span></h2>
        <div class="space-y-6">
          <div class="p-8 glass-card border-white/10">
            <h4 class="text-lg font-bold mb-3 text-white">What does a Laravel security audit include?</h4>
            <p class="text-gray-400">Our audit covers OWASP Top 10 vulnerabilities, Laravel-specific issues (mass assignment, CSRF, XSS), dependency scanning, server configuration, and compliance readiness (GDPR, PCI).</p>
          </div>
          <div class="p-8 glass-card border-white/10">
            <h4 class="text-lg font-bold mb-3 text-white">How long does a Laravel security audit take?</h4>
            <p class="text-gray-400">Most audits complete in 5-7 business days. We provide a preliminary high-risk report within 48 hours and a full detailed report with remediation steps by day 7.</p>
          </div>
          <div class="p-8 glass-card border-white/10">
            <h4 class="text-lg font-bold mb-3 text-white">Do you provide fixes after the audit?</h4>
            <p class="text-gray-400">Yes. We offer fixed-price remediation packages. Our developers implement all fixes, retest, and provide a clean security report ready for your stakeholders.</p>
          </div>
        </div>
      </div>
    </section>

    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

    <!-- Internal Links -->
    <section class="py-16 border-t border-white/5">
      <div class="container-custom">
        <div class="flex flex-wrap justify-center gap-6 text-sm">
          <a href="/hire-laravel-developer/" class="text-payflo-purple hover:underline font-bold">Hire Security Expert →</a>
          <a href="/laravel-performance-optimization/" class="text-payflo-purple hover:underline font-bold">Performance Audit →</a>
          <a href="/upgrade-laravel-version/" class="text-payflo-purple hover:underline font-bold">Upgrade Laravel →</a>
        </div>
      </div>
    </section>

    <CTASection />
  </main>
</Layout>

<style>
  .btn { @apply inline-flex items-center justify-center font-black transition-all duration-300 rounded-2xl; }
  .btn-primary { @apply bg-gradient-to-r from-payflo-purple to-payflo-pink text-white shadow-xl shadow-purple-600/30 hover:shadow-purple-600/50 hover:-translate-y-1; }
  .glass-card { @apply bg-white/5 backdrop-blur-xl border border-white/10 rounded-3xl shadow-2xl; }
  .gradient-text { @apply bg-clip-text text-transparent bg-gradient-to-r from-payflo-purple to-payflo-pink; }
</style>
