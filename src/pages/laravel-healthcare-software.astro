---
import Layout from "../layouts/Layout.astro";
import CTASection from "../components/CTASection.astro";
import { Icon } from "astro-icon/components";

const features = [
  {
    title: "HIPAA-Compliant Systems",
    desc: "End-to-end encryption, audit logs, access controls, and HIPAA compliance documentation.",
    icon: "ph:shield-check-duotone"
  },
  {
    title: "Patient Portals",
    desc: "Appointment booking, medical history, prescription refills, and secure messaging.",
    icon: "ph:user-circle-duotone"
  },
  {
    title: "FHIR Integrations",
    desc: "HL7 FHIR API integration with EHR/EMR systems like Epic, Cerner, and Allscripts.",
    icon: "ph:hospital-duotone"
  },
  {
    title: "Telehealth Platforms",
    desc: "Video consultations, screen sharing, digital prescriptions, and encounter notes.",
    icon: "ph:video-camera-duotone"
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      "name": "How much does healthcare software development cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Healthcare platforms cost $30,000-$100,000+. Patient portals start at $20,000. Telehealth platforms cost $40,000-$80,000. FHIR integrations cost $15,000-$30,000."
      }
    },
    {
      "@type": "Question",
      "name": "Do you build HIPAA-compliant software?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. All healthcare software we build is HIPAA-compliant with end-to-end encryption, audit logs, role-based access control, and BAA (Business Associate Agreement) support."
      }
    },
    {
      "@type": "Question",
      "name": "Can you integrate with EHR/EMR systems?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Absolutely. We integrate with Epic, Cerner, Allscripts, and other EHRs via HL7 FHIR APIs, enabling seamless patient data exchange."
      }
    },
    {
      "@type": "Question",
      "name": "Do you develop telehealth platforms?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. We build telehealth platforms with video consultations (WebRTC), digital prescriptions, encounter notes, and insurance verification."
      }
    }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Laravel Healthcare Software",
  "provider": {
    "@type": "Organization",
    "name": "Laravel Company",
    "url": "https://laravelcompany.com"
  },
  "description": "HIPAA-compliant healthcare software: patient portals, FHIR integrations, telehealth platforms. $30K-$100K.",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Healthcare Services",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Patient Portal" }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "FHIR Integration" }}
    ]
  }
};
---

<Layout
  title="Laravel Healthcare Software Development | HIPAA Compliant"
  description="HIPAA-compliant healthcare software: patient portals, FHIR integrations, telehealth platforms. $30K-$100K. Get a free consultation."
>
  <main id="main-content">
    <!-- Hero -->
    <section class="pt-24 pb-20 md:pt-32 md:pb-28 overflow-hidden relative bg-payflo-dark">
      <div class="absolute inset-0 opacity-10 -z-10">
        <div class="absolute top-0 left-0 w-full h-full bg-[radial-gradient(circle_at_50%_120%,rgba(120,119,198,0.3),rgba(255,255,255,0))]"></div>
      </div>
      <div class="container-custom relative">
        <nav class="flex justify-center items-center gap-2 text-sm text-white/50 mb-8 animate-on-scroll">
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <span>/</span>
          <a href="/laravel-services/" class="hover:text-white transition-colors">Services</a>
          <span>/</span>
          <span class="text-white">Healthcare Software</span>
        </nav>
        <div class="max-w-4xl mx-auto text-center">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-payflo-pink/10 border border-payflo-pink/20 mb-8 animate-on-scroll">
            <Icon name="ph:heartbeat-duotone" class="w-5 h-5 text-payflo-pink" />
            <span class="text-sm font-bold uppercase tracking-widest text-white/70">Healthcare Specialists</span>
          </div>
          <h1 class="animate-on-scroll delay-1 text-5xl md:text-7xl lg:text-8xl font-black leading-tight tracking-tight text-white">
            Laravel <span class="gradient-text">Healthcare Software</span>
          </h1>
          <p class="animate-on-scroll delay-2 mt-8 text-xl md:text-2xl text-white/70 leading-relaxed font-medium">
            HIPAA-compliant patient portals, FHIR integrations, telehealth platforms. Starting at $30,000.
          </p>
          <div class="animate-on-scroll delay-3 mt-12 flex flex-wrap justify-center gap-6">
            <a href="/contact/" class="btn btn-primary px-10 py-5 text-lg shadow-2xl">Build Healthcare Software</a>
            <a href="/laravel-security-audit/" class="btn glass-card border-white/20 px-10 py-5 text-lg hover:bg-white/10 transition-all font-bold">Security Audit</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Core Features -->
    <section class="py-24">
      <div class="container-custom">
        <div class="text-center max-w-3xl mx-auto mb-20 animate-on-scroll">
          <h2 class="text-4xl md:text-5xl font-black mb-6">Healthcare <span class="gradient-text">Core Features</span></h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
          {features.map((f, i) => (
            <div class="animate-on-scroll delay-{i} glass-card p-10 border-white/10 group hover:border-payflo-purple/50 transition-colors">
              <Icon name={f.icon} class="w-12 h-12 text-payflo-purple mb-6 group-hover:scale-110 transition-transform" />
              <h3 class="text-2xl font-black mb-4 text-white">{f.title}</h3>
              <p class="text-gray-400 text-sm leading-relaxed">{f.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Compliance -->
    <section class="py-24 bg-white/5">
      <div class="container-custom max-w-4xl mx-auto">
        <h2 class="text-4xl font-black text-center mb-16">Compliance <span class="gradient-text">Ready</span></h2>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10 text-center">
            <h4 class="text-lg font-bold text-white mb-2">HIPAA</h4>
            <p class="text-gray-400 text-xs">US healthcare privacy law</p>
          </div>
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10 text-center">
            <h4 class="text-lg font-bold text-white mb-2">GDPR</h4>
            <p class="text-gray-400 text-xs">EU data protection</p>
          </div>
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10 text-center">
            <h4 class="text-lg font-bold text-white mb-2">FHIR</h4>
            <p class="text-gray-400 text-xs">Health data interoperability</p>
          </div>
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10 text-center">
            <h4 class="text-lg font-bold text-white mb-2">SOC 2</h4>
            <p class="text-gray-400 text-xs">Security controls</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Cost Estimate -->
    <section class="py-24">
      <div class="container-custom max-w-4xl mx-auto">
        <h2 class="text-4xl font-black text-center mb-16">Cost <span class="gradient-text">Estimate</span></h2>
        <div class="glass-card p-10 border-white/10">
          <div class="space-y-4">
            <div class="flex justify-between pb-4 border-b border-white/5">
              <span class="text-white/70">Patient Portal (8-12 weeks)</span>
              <span class="text-payflo-purple font-bold">$20K-$40K</span>
            </div>
            <div class="flex justify-between pb-4 border-b border-white/5">
              <span class="text-white/70">Telehealth Platform (12-16 weeks)</span>
              <span class="text-payflo-purple font-bold">$40K-$80K</span>
            </div>
            <div class="flex justify-between">
              <span class="text-white/70">Full Healthcare System (16-24 weeks)</span>
              <span class="text-payflo-pink font-bold">$60K-$150K</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-24 bg-white/5">
      <div class="container-custom max-w-4xl mx-auto">
        <h2 class="text-4xl font-black text-center mb-16">Healthcare <span class="gradient-text">FAQ</span></h2>
        <div class="space-y-6">
          <div class="p-8 glass-card border-white/10">
            <h4 class="text-lg font-bold mb-3 text-white">How much does healthcare software development cost?</h4>
            <p class="text-gray-400">Healthcare platforms cost $30,000-$100,000+. Patient portals start at $20,000. Telehealth platforms cost $40,000-$80,000. FHIR integrations cost $15,000-$30,000.</p>
          </div>
          <div class="p-8 glass-card border-white/10">
            <h4 class="text-lg font-bold mb-3 text-white">Do you build HIPAA-compliant software?</h4>
            <p class="text-gray-400">Yes. All healthcare software we build is HIPAA-compliant with end-to-end encryption, audit logs, role-based access control, and BAA (Business Associate Agreement) support.</p>
          </div>
          <div class="p-8 glass-card border-white/10">
            <h4 class="text-lg font-bold mb-3 text-white">Can you integrate with EHR/EMR systems?</h4>
            <p class="text-gray-400">Absolutely. We integrate with Epic, Cerner, Allscripts, and other EHRs via HL7 FHIR APIs, enabling seamless patient data exchange.</p>
          </div>
        </div>
      </div>
    </section>

    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

    <!-- Internal Links -->
    <section class="py-16 border-t border-white/5">
      <div class="container-custom">
        <div class="flex flex-wrap justify-center gap-6 text-sm">
          <a href="/hire-laravel-developer/" class="text-payflo-purple hover:underline font-bold">Hire Healthcare Dev →</a>
          <a href="/laravel-security-audit/" class="text-payflo-purple hover:underline font-bold">Security Audit →</a>
          <a href="/laravel-api-development/" class="text-payflo-purple hover:underline font-bold">API Development →</a>
        </div>
      </div>
    </section>

    <CTASection />
  </main>
</Layout>

<style>
  .btn { @apply inline-flex items-center justify-center font-black transition-all duration-300 rounded-2xl; }
  .btn-primary { @apply bg-gradient-to-r from-payflo-purple to-payflo-pink text-white shadow-xl shadow-purple-600/30 hover:shadow-purple-600/50 hover:-translate-y-1; }
  .glass-card { @apply bg-white/5 backdrop-blur-xl border border-white/10 rounded-3xl shadow-2xl; }
  .gradient-text { @apply bg-clip-text text-transparent bg-gradient-to-r from-payflo-purple to-payflo-pink; }
</style>
