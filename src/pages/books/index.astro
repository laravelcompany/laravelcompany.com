---
import Layout from "../../layouts/Layout.astro";
import HeroSection from "../../components/HeroSection.astro";
import BookCard from "../../components/books/BookCard.astro";
import { getBooks } from "../../utils/booksCache";
import { BOOK_CATEGORIES, BOOKS_PAGE_SIZE } from "../../data/books-curated";

export const prerender = true;

const books = await getBooks();
const libraryUnavailable = books.length === 0;

const featured = BOOK_CATEGORIES.map((category) => ({
    ...category,
    books: books.filter((b) => b.categories.includes(category.id)).slice(0, 4),
})).filter((category) => category.books.length > 0);

const firstPage = books.slice(0, BOOKS_PAGE_SIZE);
const totalPages = Math.max(1, Math.ceil(books.length / BOOKS_PAGE_SIZE));

// Lets the search script link live results back to curated static pages.
const slugMap = Object.fromEntries(books.map((b) => [b.workKey, b.slug]));
---

<Layout
    title="Books for Developers Who Actually Build Things | Laravel Company"
    description="A curated developer reading library: software engineering, Laravel, PHP, architecture, APIs, databases, DevOps, AI and technical leadership."
>
    <HeroSection
        title="Books for Developers Who Actually Build Things"
        highlightText="The Library"
        subtitle="Our curated reading shelf for software engineering: Laravel, PHP, architecture, APIs, databases, DevOps, AI, system design, business and technical leadership. Not a bookstore - a reading list from people who ship."
        breadcrumbs={[{ label: "Home", href: "/" }, { label: "Books" }]}
    />

    <main class="container-custom pb-20 md:pb-32">
        {/* Search */}
        <section aria-labelledby="books-search-heading" class="max-w-3xl mx-auto -mt-8 mb-16">
            <h2 id="books-search-heading" class="sr-only">Search the library</h2>
            <form id="book-search" action="/books/" method="get" role="search" class="glass-card !p-3 flex gap-3">
                <label for="book-search-input" class="sr-only">Search books by title, author or topic</label>
                <input
                    id="book-search-input"
                    name="q"
                    type="search"
                    placeholder="Search title, author or topic - try &quot;domain-driven design&quot;"
                    autocomplete="off"
                    class="flex-1 bg-transparent border-0 text-white placeholder-white/40 px-4 py-3 focus:outline-none"
                />
                <button type="submit" class="btn btn-primary !py-3 !px-6">Search</button>
            </form>
            <p id="book-search-status" role="status" aria-live="polite" class="mt-3 text-sm text-white/50"></p>
        </section>

        {/* Live search results (progressive enhancement) */}
        <section id="book-search-results-section" aria-labelledby="book-search-results-heading" class="hidden mb-16">
            <h2 id="book-search-results-heading" class="text-2xl font-bold text-white mb-6"></h2>
            <div id="book-search-results" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6"></div>
            <nav id="book-search-pagination" aria-label="Search results pagination" class="mt-10 flex justify-center items-center gap-2 flex-wrap"></nav>
            <p class="mt-6 text-center">
                <button id="book-search-clear" type="button" class="btn btn-secondary !py-2 !px-5 text-sm">
                    Back to the curated shelves
                </button>
            </p>
        </section>

        <div id="books-curated-content">
            {
                libraryUnavailable ? (
                    <section class="glass-card max-w-2xl mx-auto text-center">
                        <h2 class="text-2xl font-bold text-white mb-3">We couldn't reach the library right now</h2>
                        <p class="text-white/70">
                            The books are hiding from us. Try again in a moment - the shelves usually restock
                            themselves.
                        </p>
                    </section>
                ) : (
                    <>
                        {/* Featured shelves */}
                        {featured.map((category) => (
                            <section aria-labelledby={`books-cat-${category.id}`} class="mb-16">
                                <div class="flex items-baseline justify-between gap-4 mb-2">
                                    <h2 id={`books-cat-${category.id}`} class="text-2xl md:text-3xl font-bold text-white">
                                        {category.title}
                                    </h2>
                                </div>
                                <p class="text-white/50 mb-6">{category.tagline}</p>
                                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                                    {category.books.map((book) => (
                                        <BookCard book={book} />
                                    ))}
                                </div>
                            </section>
                        ))}

                        {/* Full catalogue */}
                        <section aria-labelledby="books-all-heading">
                            <h2 id="books-all-heading" class="text-2xl md:text-3xl font-bold text-white mb-2">
                                Browse the full shelf
                            </h2>
                            <p class="text-white/50 mb-6">
                                Every book here gets its own page on Laravel Company. Metadata by the
                                <a href="https://openlibrary.org" target="_blank" rel="noopener noreferrer" class="text-payflo-purple hover:text-white transition-colors"> Open Library</a>.
                            </p>
                            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                                {firstPage.map((book) => (
                                    <BookCard book={book} />
                                ))}
                            </div>
                            {totalPages > 1 && (
                                <nav aria-label="Catalogue pagination" class="mt-10 flex justify-center items-center gap-2 flex-wrap">
                                    <span class="px-4 py-2 rounded-lg bg-payflo-purple text-white font-bold" aria-current="page">1</span>
                                    {Array.from({ length: totalPages - 1 }, (_, i) => i + 2).map((n) => (
                                        <a
                                            href={`/books/page/${n}/`}
                                            class="px-4 py-2 rounded-lg bg-white/5 border border-white/10 text-white/70 hover:text-white hover:border-payflo-purple/50 transition-colors"
                                            aria-label={`Go to page ${n}`}
                                        >
                                            {n}
                                        </a>
                                    ))}
                                    <a href="/books/page/2/" class="px-4 py-2 rounded-lg bg-white/5 border border-white/10 text-white/70 hover:text-white hover:border-payflo-purple/50 transition-colors" aria-label="Go to next page">
                                        Next →
                                    </a>
                                </nav>
                            )}
                        </section>
                    </>
                )
            }
        </div>
    </main>

    <script define:vars={{ slugMap }}>
        window.__BOOK_SLUGS__ = slugMap;
    </script>
    <script>
        const form = document.getElementById("book-search") as HTMLFormElement | null;
        const input = document.getElementById("book-search-input") as HTMLInputElement | null;
        const status = document.getElementById("book-search-status");
        const resultsSection = document.getElementById("book-search-results-section");
        const resultsHeading = document.getElementById("book-search-results-heading");
        const resultsGrid = document.getElementById("book-search-results");
        const paginationNav = document.getElementById("book-search-pagination");
        const clearButton = document.getElementById("book-search-clear");
        const curated = document.getElementById("books-curated-content");
        const slugMap: Record<string, string> = (window as any).__BOOK_SLUGS__ || {};

        interface SearchBook {
            workKey: string;
            title: string;
            authors: string[];
            firstPublishYear: number | null;
            coverUrl: string;
            slug: string;
            openLibraryUrl: string;
        }

        function slugifyTitle(title: string): string {
            return title
                .toLowerCase()
                .normalize("NFD")
                .replace(/[̀-ͯ]/g, "")
                .replace(/[^\w\s-]/g, "")
                .replace(/\s+/g, "-")
                .replace(/-+/g, "-")
                .replace(/^-+|-+$/g, "")
                .trim() || "book";
        }

        function localUrlFor(book: SearchBook): string {
            const curatedSlug = slugMap[book.workKey];
            const slug = curatedSlug || book.slug || `${slugifyTitle(book.title)}-${book.workKey.toLowerCase()}`;
            return `/books/${slug}/`;
        }

        function renderCard(book: SearchBook): HTMLElement {
            const link = document.createElement("a");
            link.href = localUrlFor(book);
            link.className = "group glass-card !p-4 flex flex-col gap-4 hover:border-payflo-purple/50 transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-payflo-purple/50";

            const cover = document.createElement("div");
            cover.className = "relative overflow-hidden rounded-xl";
            cover.style.aspectRatio = "2 / 3";
            cover.style.background = "linear-gradient(135deg, #1e293b, #3b1d52)";
            const placeholder = document.createElement("div");
            placeholder.className = "absolute inset-0 flex flex-col items-center justify-center gap-2 p-4 text-center";
            const pt = document.createElement("span");
            pt.className = "font-extrabold text-white/85 text-sm leading-snug";
            pt.textContent = book.title;
            placeholder.appendChild(pt);
            cover.appendChild(placeholder);
            if (book.coverUrl) {
                const img = document.createElement("img");
                img.src = book.coverUrl;
                img.alt = `Book cover: ${book.title}`;
                img.loading = "lazy";
                img.referrerPolicy = "no-referrer";
                img.className = "absolute inset-0 w-full h-full object-cover";
                img.onerror = () => img.remove();
                cover.appendChild(img);
            }

            const body = document.createElement("div");
            body.className = "flex flex-col gap-1";
            const h3 = document.createElement("h3");
            h3.className = "font-bold text-white leading-snug group-hover:text-payflo-purple transition-colors line-clamp-2";
            h3.textContent = book.title;
            body.appendChild(h3);
            if (book.authors?.length) {
                const p = document.createElement("p");
                p.className = "text-sm text-white/60 line-clamp-1";
                p.textContent = book.authors.join(", ");
                body.appendChild(p);
            }
            if (book.firstPublishYear) {
                const y = document.createElement("p");
                y.className = "text-xs text-white/40 mt-1";
                y.textContent = String(book.firstPublishYear);
                body.appendChild(y);
            }

            link.appendChild(cover);
            link.appendChild(body);
            return link;
        }

        function pageHref(q: string, page: number): string {
            return `/books/?q=${encodeURIComponent(q)}&page=${page}`;
        }

        function renderPagination(q: string, page: number, totalPages: number) {
            if (!paginationNav) return;
            paginationNav.textContent = "";
            if (totalPages <= 1) return;
            const addLink = (label: string, target: number, current = false) => {
                if (current) {
                    const span = document.createElement("span");
                    span.className = "px-4 py-2 rounded-lg bg-payflo-purple text-white font-bold";
                    span.setAttribute("aria-current", "page");
                    span.textContent = label;
                    paginationNav.appendChild(span);
                    return;
                }
                const a = document.createElement("a");
                a.href = pageHref(q, target);
                a.dataset.page = String(target);
                a.className = "px-4 py-2 rounded-lg bg-white/5 border border-white/10 text-white/70 hover:text-white hover:border-payflo-purple/50 transition-colors";
                a.setAttribute("aria-label", `Go to page ${target}`);
                a.textContent = label;
                paginationNav.appendChild(a);
            };
            if (page > 1) addLink("← Prev", page - 1);
            const start = Math.max(1, Math.min(page - 2, totalPages - 4));
            for (let n = start; n <= Math.min(totalPages, start + 4); n++) addLink(String(n), n, n === page);
            if (page < totalPages) addLink("Next →", page + 1);
        }

        async function runSearch(q: string, page: number, push = true) {
            if (!resultsSection || !resultsGrid || !resultsHeading || !status || !curated) return;
            if (push) history.pushState({ q, page }, "", pageHref(q, page));

            status.textContent = "Searching the library…";
            resultsHeading.textContent = `Results for “${q}”`;
            resultsGrid.textContent = "";
            curated.classList.add("hidden");
            resultsSection.classList.remove("hidden");

            try {
                const response = await fetch(`/api/books/search?q=${encodeURIComponent(q)}&page=${page}&limit=12`);
                const data = await response.json();
                if (!response.ok) throw new Error(data?.error || "search failed");

                status.textContent = data.total > 0 ? `${data.total.toLocaleString()} books found` : "No books found for that search.";
                if (data.total === 0) {
                    const empty = document.createElement("p");
                    empty.className = "text-white/60 col-span-full";
                    empty.textContent = "Nothing on the shelf matches that. Try a different title, author or topic.";
                    resultsGrid.appendChild(empty);
                }
                for (const book of data.books as SearchBook[]) resultsGrid.appendChild(renderCard(book));
                renderPagination(q, data.page, data.totalPages);

                (window as any).gtag?.("event", "book_search", { search_term: q, page: data.page });
            } catch {
                status.textContent = "";
                resultsGrid.textContent = "";
                const err = document.createElement("p");
                err.className = "text-white/70 col-span-full glass-card !p-6";
                err.textContent = "We couldn't reach the library right now. The books are hiding from us. Try again in a moment.";
                resultsGrid.appendChild(err);
            }
        }

        function clearSearch(push = true) {
            if (!resultsSection || !curated || !status || !input) return;
            resultsSection.classList.add("hidden");
            curated.classList.remove("hidden");
            status.textContent = "";
            input.value = "";
            if (push) history.pushState({}, "", "/books/");
        }

        form?.addEventListener("submit", (event) => {
            event.preventDefault();
            const q = (input?.value || "").trim();
            if (q) runSearch(q, 1);
        });
        paginationNav?.addEventListener("click", (event) => {
            const link = (event.target as HTMLElement).closest("a[data-page]") as HTMLAnchorElement | null;
            if (!link) return;
            event.preventDefault();
            const q = new URLSearchParams(window.location.search).get("q") || "";
            runSearch(q, parseInt(link.dataset.page || "1", 10));
        });
        clearButton?.addEventListener("click", () => clearSearch());
        window.addEventListener("popstate", () => {
            const params = new URLSearchParams(window.location.search);
            const q = (params.get("q") || "").trim();
            const page = parseInt(params.get("page") || "1", 10) || 1;
            if (q) {
                if (input) input.value = q;
                runSearch(q, page, false);
            } else {
                clearSearch(false);
            }
        });

        // Deep links: /books?q=laravel&page=2
        const params = new URLSearchParams(window.location.search);
        const initialQ = (params.get("q") || "").trim();
        if (initialQ) {
            if (input) input.value = initialQ;
            runSearch(initialQ, parseInt(params.get("page") || "1", 10) || 1, false);
        }
    </script>
</Layout>
