---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

function normalizeBook(raw: any) {
  const isNested = raw.product !== undefined;

  return {
    id: raw.id || raw.metadata?.id || raw.product?.product_id || '',
    title: isNested ? raw.product.title : raw.title,
    date: isNested ? raw.metadata?.date || raw.product?.date || new Date().toISOString().split("T")[0] : raw.date,
    author: isNested ? raw.metadata?.author : raw.author,
    authorRole: isNested ? raw.metadata?.authorRole : raw.authorRole,
    authorAvatar: isNested ? raw.metadata?.authorAvatar : raw.authorAvatar,
    excerpt: isNested ? raw.excerpt : raw.excerpt,
    content: isNested ? raw.content : raw.content,
    image: isNested ? raw.metadata?.image : raw.image,
    tags: isNested ? raw.metadata?.tags : raw.tags,
    buyLink: raw.buyLink,
  };
}

const allBooks = await getCollection("books");
const normalizedBooks = allBooks.map((book) => normalizeBook(book.data));
const sortedBooks = normalizedBooks.sort((a, b) => {
  const dateA = new Date(a.date);
  const dateB = new Date(b.date);
  return dateB.getTime() - dateA.getTime();
});

const paginatedBooks = paginate(sortedBooks, { pageSize: 10 });

function getPageNumbers(current: number, last: number): (number | "...")[] {
  if (last <= 7) return Array.from({ length: last }, (_, i) => i + 1);

  const pages: (number | "...")[] = [1];
  const delta = 1;
  const rangeStart = Math.max(2, current - delta);
  const rangeEnd = Math.min(last - 1, current + delta);

  if (rangeStart > 2) pages.push("...");
  for (let i = rangeStart; i <= rangeEnd; i++) pages.push(i);
  if (rangeEnd < last - 1) pages.push("...");

  pages.push(last);
  return pages;
}

const page = Astro.props.page;
const pageNumbers = getPageNumbers(page.currentPage, page.lastPage);
---

<Layout
  title="Books | Laravel Company"
  description="A curated selection of Laravel and programming books"
>
  <main class="py-20 px-6 sm:px-8 lg:px-12 max-w-7xl mx-auto">
    <nav class="flex justify-center items-center gap-2 text-sm text-white/50 mb-8 animate-on-scroll">
      <a href="/" class="hover:text-white transition-colors">Home</a>
      <span>/</span>
      <span class="text-white">Books</span>
    </nav>

    <div class="max-w-5xl mx-auto">
      <h1 class="text-4xl font-bold mb-4 text-center animate-on-scroll">Books</h1>
      <p class="text-xl text-white/70 mb-12 text-center animate-on-scroll max-w-2xl mx-auto">
        A curated selection of Laravel and programming books.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {paginatedBooks.map((book, index) => {
          const raw = book.data;
          const truncatedExcerpt =
            raw.excerpt.length > 150
              ? raw.excerpt.slice(0, 150) + "..."
              : raw.excerpt;

          return (
            <a
              href={`/books/${raw.id}/`}
              class="group glass-card overflow-hidden animate-on-scroll hover:border-payflo-purple/50 transition-all duration-300"
              style={`animation-delay: ${index * 0.05}s`}
            >
              <div class="aspect-video overflow-hidden bg-payflo-darker">
                {raw.image ? (
                  <img
                    src={raw.image}
                    alt={raw.title}
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center">
                    <img
                      src="/placeholder-book.svg"
                      alt="Book cover"
                      class="w-24 h-24 opacity-30"
                      loading="lazy"
                    />
                  </div>
                )}
              </div>
              <div class="p-6">
                <div class="flex flex-wrap gap-2 mb-3">
                  {raw.tags?.slice(0, 2).map((tag) => (
                    <span class="text-xs px-2.5 py-1 rounded-full bg-payflo-purple/20 text-payflo-purple font-medium">
                      {tag}
                    </span>
                  ))}
                </div>
                <h2 class="text-lg font-semibold text-white mb-2 group-hover:text-payflo-purple transition-colors">
                  {raw.title}
                </h2>
                <p class="text-sm text-white/60 mb-4 line-clamp-3">
                  {truncatedExcerpt}
                </p>
                <div class="flex items-center gap-3 text-xs text-white/40">
                  <span>{raw.date}</span>
                  <span class="w-1 h-1 rounded-full bg-white/20"></span>
                  <span>{raw.author}</span>
                </div>
              </div>
            </a>
          );
        })}
      </div>

      {page.lastPage > 1 && (
        <nav class="flex justify-center items-center gap-2 mt-12 animate-on-scroll" aria-label="Books pagination">
          {page.currentPage > 1 && (
            <a
              href={page.currentPage === 2 ? "/books/" : `/books/${page.currentPage - 1}/`}
              class="px-4 py-2 rounded-lg bg-white/10 text-white hover:bg-white/20 transition-colors text-sm"
            >
              <span class="flex items-center gap-1">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M10 12L6 8l4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                Previous
              </span>
            </a>
          )}

          <div class="flex items-center gap-1">
            {pageNumbers.map((p) => {
              if (p === "...") {
                return <span class="w-9 h-9 flex items-center justify-center text-sm text-white/40 select-none">...</span>;
              }
              return p === page.currentPage ? (
                <span class="w-9 h-9 rounded-lg bg-payflo-purple text-white flex items-center justify-center text-sm font-semibold">{p}</span>
              ) : (
                <a
                  href={p === 1 ? "/books/" : `/books/${p}/`}
                  class="w-9 h-9 rounded-lg bg-white/10 text-white/70 hover:bg-white/20 hover:text-white transition-colors flex items-center justify-center text-sm"
                >{p}</a>
              );
            })}
          </div>

          {page.currentPage < page.lastPage && (
            <a
              href={`/books/${page.currentPage + 1}/`}
              class="px-4 py-2 rounded-lg bg-white/10 text-white hover:bg-white/20 transition-colors text-sm"
            >
              <span class="flex items-center gap-1">
                Next
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </a>
          )}
        </nav>
      )}
    </div>
  </main>
</Layout>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>