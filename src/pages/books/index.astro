---
import Layout from "../../layouts/Layout.astro";
import HeroSection from "../../components/HeroSection.astro";
import BookCard from "../../components/books/BookCard.astro";
import AffiliateDisclosure from "../../components/books/AffiliateDisclosure.astro";
import { books, shelves } from "../../utils/ebayBooks";

export const prerender = true;

const all = shelves();
---

<Layout
    title="Books for Developers: Laravel, PHP, Architecture and More | Laravel Company"
    description="Developer books on eBay UK: Laravel, PHP, clean code, architecture, JavaScript, system design, DevOps, databases, machine learning and engineering management."
>
    <HeroSection
        title="Books for Developers Who Actually Build Things"
        highlightText="The Library"
        subtitle="Real listings from eBay UK for Laravel, PHP, architecture, databases, DevOps, AI and engineering leadership. Compare condition and price, then buy on eBay."
        breadcrumbs={[{ label: "Home", href: "/" }, { label: "Books" }]}
    />

    <main class="container-custom pb-20 md:pb-32">
        <AffiliateDisclosure />

        <section aria-labelledby="books-search-heading" class="max-w-3xl mx-auto mb-12">
            <h2 id="books-search-heading" class="sr-only">Filter books</h2>
            <label for="book-filter" class="sr-only">Filter books by title</label>
            <input
                id="book-filter"
                type="search"
                placeholder="Filter by title, e.g. &quot;domain-driven&quot;"
                autocomplete="off"
                class="w-full glass-card !p-4 bg-transparent text-white placeholder-white/40 focus:outline-none"
            />
            <p id="book-filter-status" role="status" aria-live="polite" class="mt-3 text-sm text-white/50"></p>
        </section>

        {
            all.length === 0 ? (
                <section class="glass-card max-w-2xl mx-auto text-center">
                    <h2 class="text-2xl font-bold text-white mb-3">No listings right now</h2>
                    <p class="text-white/70">The book feed refreshes every few hours. Check back soon.</p>
                </section>
            ) : (
                <>
                    <nav aria-label="Book categories" class="flex flex-wrap gap-3 mb-12">
                        {all.map((s) => (
                            <a href={`/books/${s.slug}/`} class="px-4 py-2 rounded-lg bg-white/5 border border-white/10 text-white/70 hover:text-white hover:border-payflo-purple/50 transition-colors">
                                {s.name} <span class="text-white/40 text-xs">({s.items.length})</span>
                            </a>
                        ))}
                    </nav>
                    <div id="shelves">
                        {all.map((s) => (
                            <section aria-labelledby={`shelf-${s.slug}`} class="shelf mb-16">
                                <div class="flex items-baseline justify-between gap-4 mb-6">
                                    <h2 id={`shelf-${s.slug}`} class="text-2xl md:text-3xl font-bold text-white">{s.name}</h2>
                                    <a href={`/books/${s.slug}/`} class="text-payflo-purple hover:text-white transition-colors text-sm">All {s.items.length} listings →</a>
                                </div>
                                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                                    {s.items.slice(0, 4).map((b) => <BookCard book={b} />)}
                                </div>
                            </section>
                        ))}
                    </div>
                    <section id="filter-results" class="hidden">
                        <div id="filter-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                            {books.map((b) => <BookCard book={b} />)}
                        </div>
                    </section>
                </>
            )
        }
    </main>

    <script>
        const input = document.getElementById("book-filter") as HTMLInputElement | null;
        const status = document.getElementById("book-filter-status");
        const shelvesEl = document.getElementById("shelves");
        const results = document.getElementById("filter-results");
        const grid = document.getElementById("filter-grid");
        input?.addEventListener("input", () => {
            const q = input.value.trim().toLowerCase();
            if (!shelvesEl || !results || !grid || !status) return;
            if (!q) {
                shelvesEl.classList.remove("hidden");
                results.classList.add("hidden");
                status.textContent = "";
                return;
            }
            let n = 0;
            grid.querySelectorAll<HTMLElement>(".book-card").forEach((c) => {
                const ok = (c.dataset.title || "").includes(q);
                c.classList.toggle("hidden", !ok);
                if (ok) n++;
            });
            shelvesEl.classList.add("hidden");
            results.classList.remove("hidden");
            status.textContent = n ? `${n} listings match` : "No listings match that title.";
        });
    </script>
</Layout>
