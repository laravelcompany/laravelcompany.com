---
import Layout from "../../layouts/Layout.astro";
import BookCover from "../../components/books/BookCover.astro";
import BookCard from "../../components/books/BookCard.astro";
import BookSchema from "../../components/schema/BookSchema.astro";
import { getBooks, type Book } from "../../utils/booksCache";
import { BOOK_CATEGORIES } from "../../data/books-curated";
import { bookMetaDescription } from "../../../functions/_lib/openLibrary.js";

export const prerender = true;

export async function getStaticPaths() {
    const books = await getBooks();
    return books.map((book) => {
        // Related: same primary category, excluding self, up to 4.
        const primaryCategory = book.categories[0];
        const related = books
            .filter((b) => b.workKey !== book.workKey && b.categories.includes(primaryCategory))
            .slice(0, 4);
        return { params: { slug: book.slug }, props: { book, related } };
    });
}

interface Props {
    book: Book;
    related: Book[];
}

const { book, related } = Astro.props;
const description = bookMetaDescription(book);
const category = BOOK_CATEGORIES.find((c) => c.id === book.categories[0]);
const bookUrl = new URL(`/books/${book.slug}/`, Astro.site ?? "https://laravelcompany.com").href;
---

<Layout title={`${book.title} | Laravel Company Books`} description={description}>
    <BookSchema book={book} />

    <main class="container-custom pt-28 md:pt-36 pb-20 md:pb-32">
        <nav class="flex items-center gap-2 text-sm text-white/50 mb-10" aria-label="Breadcrumbs">
            <a href="/" class="hover:text-white transition-colors">Home</a>
            <span>/</span>
            <a href="/books/" class="hover:text-white transition-colors">Books</a>
            <span>/</span>
            <span class="text-white" aria-current="page">{book.title}</span>
        </nav>

        <article class="glass-card">
            <div class="grid grid-cols-1 md:grid-cols-[220px_1fr] gap-8">
                <div>
                    <BookCover coverId={book.coverId} title={book.title} authors={book.authors} size="L" loading="eager" />
                </div>
                <div>
                    {category && (
                        <p class="text-xs font-extrabold uppercase tracking-[0.2em] text-payflo-purple/70 mb-3">
                            {category.title}
                        </p>
                    )}
                    <h1 class="text-3xl md:text-4xl font-bold text-white leading-tight">{book.title}</h1>
                    {book.authors.length > 0 && (
                        <p class="mt-3 text-lg text-white/70">by {book.authors.join(", ")}</p>
                    )}
                    <p class="mt-2 text-sm text-white/40">
                        {book.firstPublishYear && <span>First published {book.firstPublishYear}</span>}
                        {book.firstPublishYear && book.editionCount ? <span aria-hidden="true"> · </span> : null}
                        {book.editionCount && <span>{book.editionCount} {book.editionCount === 1 ? "edition" : "editions"}</span>}
                    </p>

                    {book.description && (
                        <section aria-labelledby="about-book" class="mt-6">
                            <h2 id="about-book" class="text-xl font-bold text-white mb-2">About this book</h2>
                            <p class="text-white/75 leading-relaxed">{book.description.slice(0, 1200)}</p>
                        </section>
                    )}

                    <dl class="mt-8 grid gap-3">
                        {book.publishers.length > 0 && (
                            <div class="flex gap-3 text-sm">
                                <dt class="min-w-32 font-bold text-white/45">Publisher</dt>
                                <dd class="text-white/80">{book.publishers.join(", ")}</dd>
                            </div>
                        )}
                        {book.languages.length > 0 && (
                            <div class="flex gap-3 text-sm">
                                <dt class="min-w-32 font-bold text-white/45">Languages</dt>
                                <dd class="text-white/80">{book.languages.join(", ").toUpperCase()}</dd>
                            </div>
                        )}
                        {book.isbns.length > 0 && (
                            <div class="flex gap-3 text-sm">
                                <dt class="min-w-32 font-bold text-white/45">ISBN</dt>
                                <dd class="text-white/80">{book.isbns.join(", ")}</dd>
                            </div>
                        )}
                        {book.subjects.length > 0 && (
                            <div class="flex gap-3 text-sm">
                                <dt class="min-w-32 font-bold text-white/45">Topics</dt>
                                <dd>
                                    {book.subjects.map((subject) => (
                                        <span class="inline-block bg-payflo-purple/15 border border-payflo-purple/35 text-payflo-purple rounded-full px-3 py-0.5 text-xs mr-1 mb-1">
                                            {subject}
                                        </span>
                                    ))}
                                </dd>
                            </div>
                        )}
                    </dl>

                    <div class="mt-8 flex flex-wrap gap-3">
                        <a href="/books/" class="btn btn-secondary !py-2.5 !px-5 text-sm">← Back to the library</a>
                        <a
                            href={book.openLibraryUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="btn btn-secondary !py-2.5 !px-5 text-sm book-open-library-link"
                            data-book={book.title}
                        >
                            View on Open Library ↗
                        </a>
                    </div>
                </div>
            </div>
        </article>

        {related.length > 0 && (
            <section aria-labelledby="related-books" class="mt-16">
                <h2 id="related-books" class="text-2xl font-bold text-white mb-6">Related books</h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                    {related.map((b) => <BookCard book={b} />)}
                </div>
            </section>
        )}
    </main>

    <script define:vars={{ bookTitle: book.title, bookUrl }}>
        window.gtag?.("event", "book_view", { book_title: bookTitle, page_location: bookUrl });
        document.querySelectorAll(".book-open-library-link").forEach((link) => {
            link.addEventListener("click", () => {
                window.gtag?.("event", "open_library_click", { book_title: bookTitle });
            });
        });
    </script>
</Layout>
