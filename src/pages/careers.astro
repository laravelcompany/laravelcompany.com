---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';

// Fetch job listings from external API
async function fetchJobListings(keyword = 'developer') {
    try {
        const response = await fetch('https://jobs.izdrail.com/api/v1/jobs', {
            method: 'POST',
            headers: {
                'accept': 'application/json',
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ keyword })
        });

        if (!response.ok) {
            throw new Error(`HTTP error! status: ${response.status}`);
        }

        const result = await response.json();
        return result.data || [];
    } catch (error) {
        console.error('Error fetching job listings:', error);
        return [];
    }
}

// Helper functions
function getJobDate(job: any) {
    return job.date_posted || new Date().toISOString();
}

function getCompanyLogo(job: any) {
    return job.logo_photo_url || '/logo.svg';
}

function sanitizeHTML(html: string): string {
    if (!html) return '';
    let text = html;
    
    // Replace block elements with line breaks
    text = text.replace(/<\/p>/g, '\n\n');
    text = text.replace(/<\/div>/g, '\n');
    text = text.replace(/<br\s*\/?>/g, '\n');
    text = text.replace(/<\/li>/g, '\n');
    
    // Remove all remaining HTML tags
    text = text.replace(/<[^>]*>/g, '');
    
    // Decode HTML entities
    text = text.replace(/&rsquo;/g, "'")
        .replace(/&lsquo;/g, "'")
        .replace(/&rdquo;/g, '"')
        .replace(/&ldquo;/g, '"')
        .replace(/&nbsp;/g, ' ')
        .replace(/&lt;/g, '<')
        .replace(/&gt;/g, '>')
        .replace(/&quot;/g, '"')
        .replace(/&#039;/g, "'")
        .replace(/&pound;/g, '£')
        .replace(/&euro;/g, '€')
        .replace(/&amp;/g, '&');
    
    // Clean up extra line breaks
    text = text.replace(/\n\n+/g, '\n\n').trim();
    
    return text;
}

function getJobDescription(job: any) {
    if (job.description) {
        const description = sanitizeHTML(job.description);
        return description.length > 300 ? description.substring(0, 300) + '...' : description;
    }
    return 'No description available.';
}

function getSalaryRange(job: any) {
    if (job.min_amount && job.max_amount && job.currency) {
        return `${job.currency} ${job.min_amount.toLocaleString()} - ${job.max_amount.toLocaleString()}`;
    } else if (job.min_amount && job.currency) {
        return `${job.currency} ${job.min_amount.toLocaleString()}+`;
    }
    return null;
}

function getJobType(job: any) {
    return job.job_type || 'Full-time';
}

function isRemoteJob(job: any) {
    return job.is_remote || job.location?.toLowerCase().includes('remote');
}

function calculateReadingTime(job: any): number {
    const wordsPerMinute = 200;
    if (!job.description) return 1;
    const content = job.description.replace(/<[^>]*>/g, '').trim();
    const words = content.split(/\s+/).filter(word => word.length > 0).length;
    return Math.ceil(words / wordsPerMinute) || 1;
}

// Fetch jobs
const jobListings = await fetchJobListings('developer');
const sortedJobs = jobListings.sort((a, b) =>
    new Date(getJobDate(b)).getTime() - new Date(getJobDate(a)).getTime()
);

const featuredJob = sortedJobs[0];
const otherJobs = sortedJobs.slice(1);

const allLocations = Array.from(
    new Set(jobListings.map(job => job.location).filter(l => l && l.trim() !== ''))
).sort();

const allCompanies = Array.from(
    new Set(jobListings.map(job => job.company).filter(c => c && c.trim() !== ''))
).sort();
---

<Layout title="Jobs - Find Your Next Opportunity" description="Discover exciting job opportunities from top companies. Find remote work, full-time positions, and career opportunities that match your skills.">
    <!-- Hero Section -->
    <section class="relative py-20 md:py-32 bg-transparent overflow-hidden">
        <div class="absolute inset-0 bg-[url('/grid-pattern.svg')] opacity-5" aria-hidden="true"></div>
        <div class="container-custom relative">
            <div class="max-w-4xl mx-auto text-center">
                <h1 class="text-4xl md:text-6xl font-bold leading-tight mb-8 animate-on-scroll">
                    Find Your Next <span class="gradient-text">Opportunity</span>
                </h1>
                <p class="text-xl text-gray-400 max-w-2xl mx-auto animate-on-scroll delay-1">
                    Discover exciting career opportunities from top companies around the world. Start your journey today.
                </p>

                <!-- Search Form -->
                <form class="mt-10 flex flex-col sm:flex-row gap-4 max-w-lg mx-auto animate-on-scroll delay-2" id="job-search-form">
                    <input
                        type="text"
                        id="keyword-search"
                        name="keyword"
                        placeholder="Search for jobs (e.g. developer, marketing)"
                        class="flex-1 px-6 py-4 rounded-xl border border-white/20 bg-white/5 text-white placeholder-gray-400 focus:ring-2 focus:ring-brand-primary focus:border-brand-primary focus:outline-none text-lg"
                    />
                    <button
                        type="submit"
                        class="px-8 py-4 bg-brand-primary text-white font-semibold rounded-xl hover:bg-brand-primary/90 focus:bg-brand-primary/90 transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-brand-primary focus:ring-offset-2"
                    >
                        Search Jobs
                    </button>
                </form>
            </div>
        </div>
    </section>

    <!-- Featured Job -->
    {featuredJob && (
        <section class="py-16 bg-[#1e293b]/40 backdrop-blur-md border-y border-white/10">
            <div class="container-custom">
                <div class="mb-12">
                    <h2 class="text-2xl font-bold mb-4 animate-on-scroll">Featured Opportunity</h2>
                </div>

                <article class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center animate-on-scroll delay-1">
                    <div class="rounded-2xl overflow-hidden shadow-lg bg-[#1e293b]/30 flex items-center justify-center min-h-[300px] p-8">
                        <img
                            src={getCompanyLogo(featuredJob)}
                            alt={`${featuredJob.company} logo`}
                            class="max-w-[200px] max-h-[100px] object-contain transition-all duration-500 hover:scale-110"
                        />
                    </div>

                    <div>
                        <div class="flex flex-wrap items-center gap-3 mb-4">
                            <span class="bg-brand-primary/10 text-brand-primary px-3 py-1 rounded-full text-sm font-medium">
                                {getJobType(featuredJob)}
                            </span>
                            {isRemoteJob(featuredJob) && (
                                <span class="bg-green-100 text-green-700 px-3 py-1 rounded-full text-sm font-medium">
                                    Remote
                                </span>
                            )}
                            {getSalaryRange(featuredJob) && (
                                <span class="bg-blue-100 text-blue-700 px-3 py-1 rounded-full text-sm font-medium">
                                    {getSalaryRange(featuredJob)}
                                </span>
                            )}
                        </div>

                        <h3 class="text-3xl md:text-4xl font-bold mb-2 leading-tight text-white">
                            {featuredJob.title}
                        </h3>

                        <p class="text-lg text-brand-primary font-semibold mb-4">
                            {featuredJob.company}
                        </p>

           

                        <div class="flex flex-wrap items-center gap-6 mb-8 text-sm">
                            <div class="flex items-center text-gray-400">
                                <span class="mr-2">📍</span>
                                <span>{featuredJob.location}</span>
                            </div>
                            <div class="flex items-center text-gray-400">
                                <span class="mr-2">📅</span>
                                <time datetime={getJobDate(featuredJob)}>
                                    {new Date(getJobDate(featuredJob)).toLocaleDateString('en-US', {
                                        year: 'numeric',
                                        month: 'long',
                                        day: 'numeric'
                                    })}
                                </time>
                            </div>
                            <div class="flex items-center text-gray-400">
                                <span class="mr-2">⏱️</span>
                                <span>{calculateReadingTime(featuredJob)} min read</span>
                            </div>
                        </div>

                        <div class="flex flex-col sm:flex-row gap-4">
                            <a
                                href={featuredJob.job_url}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="btn btn-primary inline-flex items-center justify-center group focus:outline-none focus:ring-2 focus:ring-brand-primary focus:ring-offset-2"
                            >
                                Apply Now
                                <span class="ml-2 group-hover:translate-x-1 transition-transform duration-200">→</span>
                            </a>
                            {featuredJob.job_url_direct && (
                                <a
                                    href={featuredJob.job_url_direct}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="btn bg-[#1e293b]/30 text-gray-300 hover:bg-gray-600/20 focus:bg-gray-600/20 inline-flex items-center justify-center"
                                >
                                    Direct Apply
                                </a>
                            )}
                        </div>
                    </div>
                </article>
            </div>
        </section>
    )}

    <!-- Filters Section -->
    {(allLocations.length > 0 || allCompanies.length > 0) && (
        <section class="py-8 bg-[#0a0e27]/60 border-b border-white/10">
            <div class="container-custom">
                <div class="flex flex-wrap items-center gap-4 mb-4">
                    <span class="text-sm font-medium text-gray-300">Filter by location:</span>
                    <div class="flex flex-wrap gap-2" role="group" aria-label="Filter jobs by location">
                        <button
                            class="filter-location px-3 py-1 bg-[#1e293b]/40 backdrop-blur-md text-gray-300 rounded-full text-sm border border-white/10 hover:bg-brand-primary hover:text-white focus:bg-brand-primary focus:text-white transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-brand-primary"
                            data-location="all"
                            aria-pressed="true"
                        >
                            All Locations
                        </button>
                        {allLocations.slice(0, 10).map((location: string) => (
                            <button
                                class="filter-location px-3 py-1 bg-[#1e293b]/40 backdrop-blur-md text-gray-300 rounded-full text-sm border border-white/10 hover:bg-brand-primary hover:text-white focus:bg-brand-primary focus:text-white transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-brand-primary"
                                data-location={location}
                                aria-pressed="false"
                            >
                                {location}
                            </button>
                        ))}
                    </div>
                </div>

                <div class="flex flex-wrap items-center gap-4">
                    <span class="text-sm font-medium text-gray-300">Filter by type:</span>
                    <div class="flex flex-wrap gap-2" role="group" aria-label="Filter jobs by type">
                        <button
                            class="filter-type px-3 py-1 bg-[#1e293b]/40 backdrop-blur-md text-gray-300 rounded-full text-sm border border-white/10 hover:bg-brand-primary hover:text-white focus:bg-brand-primary focus:text-white transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-brand-primary"
                            data-type="all"
                            aria-pressed="true"
                        >
                            All Types
                        </button>
                        <button
                            class="filter-type px-3 py-1 bg-[#1e293b]/40 backdrop-blur-md text-gray-300 rounded-full text-sm border border-white/10 hover:bg-brand-primary hover:text-white focus:bg-brand-primary focus:text-white transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-brand-primary"
                            data-type="remote"
                            aria-pressed="false"
                        >
                            Remote Only
                        </button>
                        <button
                            class="filter-type px-3 py-1 bg-[#1e293b]/40 backdrop-blur-md text-gray-300 rounded-full text-sm border border-white/10 hover:bg-brand-primary hover:text-white focus:bg-brand-primary focus:text-white transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-brand-primary"
                            data-type="salary"
                            aria-pressed="false"
                        >
                            With Salary
                        </button>
                    </div>
                </div>
            </div>
        </section>
    )}

    <!-- Jobs Grid -->
    <section class="py-20">
        <div class="container-custom">
            <div class="mb-12">
                <h2 class="text-2xl font-bold mb-4 animate-on-scroll">Latest Job Opportunities</h2>
                <p class="text-gray-400">{jobListings.length} positions available</p>
            </div>

            {otherJobs.length > 0 ? (
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="jobs-grid">
                    {otherJobs.map((job, index) => (
                        <article
                            class={`job-card group animate-on-scroll delay-${Math.min(index + 1, 5)}`}
                            data-location={job.location}
                            data-company={job.company}
                            data-is-remote={isRemoteJob(job)}
                            data-has-salary={getSalaryRange(job) ? 'true' : 'false'}
                        >
                            <div class="h-full block bg-[#1e293b]/40 backdrop-blur-md rounded-xl overflow-hidden shadow-sm hover:shadow-lg focus-within:shadow-lg transition-all duration-300 hover:-translate-y-1 border border-white/10 flex flex-col">
                                <!-- Company Logo -->
                                <div class="aspect-video overflow-hidden bg-[#1e293b]/20 flex items-center justify-center p-6">
                                    <img
                                        src={getCompanyLogo(job)}
                                        alt={`${job.company} logo`}
                                        class="max-w-full max-h-full object-contain transform group-hover:scale-105 transition-transform duration-300"
                                        loading="lazy"
                                    />
                                </div>

                                <div class="p-6 flex flex-col flex-grow">
                                    <!-- Job Type and Remote Badge -->
                                    <div class="flex flex-wrap gap-2 mb-4">
                                        <span class="bg-brand-primary/10 text-brand-primary px-2 py-1 rounded text-xs font-medium">
                                            {getJobType(job)}
                                        </span>
                                        {isRemoteJob(job) && (
                                            <span class="bg-green-100 text-green-700 px-2 py-1 rounded text-xs font-medium">
                                                Remote
                                            </span>
                                        )}
                                        {getSalaryRange(job) && (
                                            <span class="bg-blue-100 text-blue-700 px-2 py-1 rounded text-xs font-medium">
                                                {getSalaryRange(job)}
                                            </span>
                                        )}
                                    </div>

                                    <h3 class="font-semibold text-lg mb-2 group-hover:text-brand-primary transition-colors duration-200 line-clamp-2 text-white">
                                        {job.title}
                                    </h3>

                                    <p class="text-brand-primary font-medium mb-3 text-sm">
                                        {job.company}
                                    </p>

                  

                                    <div class="flex flex-wrap items-center gap-4 text-xs text-gray-400 mb-4">
                                        <div class="flex items-center">
                                            <span class="mr-1">📍</span>
                                            <span>{job.location}</span>
                                        </div>
                                        <div class="flex items-center">
                                            <span class="mr-1">📅</span>
                                            <time datetime={getJobDate(job)}>
                                                {new Date(getJobDate(job)).toLocaleDateString('en-US', {
                                                    year: 'numeric',
                                                    month: 'short',
                                                    day: 'numeric'
                                                })}
                                            </time>
                                        </div>
                                    </div>

                                    <div class="flex flex-col sm:flex-row gap-2 mt-auto">
                                        <a
                                            href={job.job_url}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="flex-1 text-center px-4 py-2 bg-brand-primary text-white text-sm font-medium rounded-lg hover:bg-brand-primary/90 focus:bg-brand-primary/90 transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-brand-primary"
                                        >
                                            Apply Now
                                        </a>
                                        {job.job_url_direct && (
                                            <a
                                                href={job.job_url_direct}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class="flex-1 text-center px-4 py-2 bg-[#1e293b]/30 text-gray-300 text-sm font-medium rounded-lg hover:bg-gray-600/20 focus:bg-gray-600/20 transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-gray-300"
                                            >
                                                Direct Apply
                                            </a>
                                        )}
                                    </div>
                                </div>
                            </div>
                        </article>
                    ))}
                </div>
            ) : (
                <div class="text-center py-16">
                    <div class="max-w-md mx-auto">
                        <div class="text-6xl mb-4">💼</div>
                        <h3 class="text-lg font-semibold text-white mb-2">No jobs available</h3>
                        <p class="text-gray-400">Try searching with different keywords or check back later for new opportunities.</p>
                    </div>
                </div>
            )}

            <!-- No results message for filtering -->
            <div id="no-results" class="hidden text-center py-16">
                <div class="max-w-md mx-auto">
                    <div class="text-6xl mb-4">🔍</div>
                    <h3 class="text-lg font-semibold text-white mb-2">No jobs found</h3>
                    <p class="text-gray-400">Try adjusting your filters or search with different keywords.</p>
                </div>
            </div>
        </div>
    </section>
</Layout>

<script>
    document.addEventListener('astro:page-load', () => {
        // Location filtering
        const locationFilters = document.querySelectorAll('.filter-location');
        const typeFilters = document.querySelectorAll('.filter-type');
        const jobCards = document.querySelectorAll('.job-card');
        const noResults = document.getElementById('no-results');

        function filterJobs() {
            const selectedLocation = document.querySelector('.filter-location[aria-pressed="true"]')?.getAttribute('data-location');
            const selectedType = document.querySelector('.filter-type[aria-pressed="true"]')?.getAttribute('data-type');

            let visibleCount = 0;

            jobCards.forEach(card => {
                const cardLocation = card.getAttribute('data-location');
                const cardIsRemote = card.getAttribute('data-is-remote') === 'true';
                const cardHasSalary = card.getAttribute('data-has-salary') === 'true';

                let showCard = true;

                if (selectedLocation && selectedLocation !== 'all' && cardLocation !== selectedLocation) {
                    showCard = false;
                }

                if (selectedType && selectedType !== 'all') {
                    if (selectedType === 'remote' && !cardIsRemote) {
                        showCard = false;
                    } else if (selectedType === 'salary' && !cardHasSalary) {
                        showCard = false;
                    }
                }

                if (showCard) {
                    card.style.display = 'block';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });

            if (noResults) {
                noResults.classList.toggle('hidden', visibleCount > 0);
            }
        }

        locationFilters.forEach(filter => {
            filter.addEventListener('click', () => {
                locationFilters.forEach(f => {
                    f.classList.remove('bg-brand-primary', 'text-white');
                    f.setAttribute('aria-pressed', 'false');
                });
                filter.classList.add('bg-brand-primary', 'text-white');
                filter.setAttribute('aria-pressed', 'true');
                filterJobs();
            });
        });

        typeFilters.forEach(filter => {
            filter.addEventListener('click', () => {
                typeFilters.forEach(f => {
                    f.classList.remove('bg-brand-primary', 'text-white');
                    f.setAttribute('aria-pressed', 'false');
                });
                filter.classList.add('bg-brand-primary', 'text-white');
                filter.setAttribute('aria-pressed', 'true');
                filterJobs();
            });
        });

        // Search functionality
        const searchForm = document.getElementById('job-search-form');
        if (searchForm) {
            searchForm.addEventListener('submit', (e) => {
                e.preventDefault();
                const keyword = new FormData(searchForm).get('keyword')?.toString() || '';
                const url = new URL(window.location.href);
                url.searchParams.set('search', keyword);
                window.location.href = url.toString();
            });
        }
    });
</script>

<style>
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .line-clamp-3 {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>