---
import Layout from "../layouts/Layout.astro";
import CTASection from "../components/CTASection.astro";
import { Icon } from "astro-icon/components";

const features = [
  {
    title: "Route Optimization",
    desc: "AI-powered route planning, multi-stop optimization, and fuel cost reduction algorithms.",
    icon: "ph:map-trifold-duotone"
  },
  {
    title: "Real-Time Tracking",
    desc: "GPS tracking, geofencing, ETAs, and customer notifications via SMS/email.",
    icon: "ph:map-pin-duotone"
  },
  {
    title: "Fleet Management",
    desc: "Vehicle onboarding, maintenance schedules, fuel tracking, and driver performance.",
    icon: "ph:truck-duotone"
  },
  {
    title: "Warehouse & Inventory",
    desc: "Pick/pack workflows, barcode scanning, stock levels, and multi-warehouse support.",
    icon: "ph:package-duotone"
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      "name": "How much does logistics platform development cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Logistics platforms cost $30,000-$80,000. Route optimization modules start at $15,000. Full fleet management systems cost $50,000-$120,000+."
      }
    },
    {
      "@type": "Question",
      "name": "Do you integrate with GPS/fleet tracking hardware?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. We integrate with Samsara, Geotab, Fleetio, and custom GPS hardware via REST APIs, MQTT, or webhooks for real-time vehicle tracking."
      }
    },
    {
      "@type": "Question",
      "name": "Can you build delivery management platforms?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Absolutely. We build platforms like Onfleet, Bringg, or custom delivery systems with driver apps, customer tracking, and dispatcher dashboards."
      }
    },
    {
      "@type": "Question",
      "name": "Do you provide mobile apps for drivers?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. We build cross-platform driver apps with Flutter or React Native, featuring navigation, proof of delivery, electronic signatures, and offline mode."
      }
    }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Laravel Logistics Platform",
  "provider": {
    "@type": "Organization",
    "name": "Laravel Company",
    "url": "https://laravelcompany.com"
  },
  "description": "Logistics platform development: route optimization, real-time tracking, fleet management. $30K-$120K.",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Logistics Services",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Route Optimization" }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Fleet Management" }}
    ]
  }
};
---

<Layout
  title="Laravel Logistics Platform Development | Route Optimization & Tracking"
  description="Logistics platform development with Laravel. Route optimization, real-time GPS tracking, fleet management. $30K-$120K. Get a quote."
>
  <main id="main-content">
    <!-- Hero -->
    <section class="pt-24 pb-20 md:pt-32 md:pb-28 overflow-hidden relative bg-payflo-dark">
      <div class="absolute inset-0 opacity-10 -z-10">
        <div class="absolute top-0 left-0 w-full h-full bg-[radial-gradient(circle_at_50%_120%,rgba(120,119,198,0.3),rgba(255,255,255,0))]"></div>
      </div>
      <div class="container-custom relative">
        <nav class="flex justify-center items-center gap-2 text-sm text-white/50 mb-8 animate-on-scroll">
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <span>/</span>
          <a href="/laravel-services/" class="hover:text-white transition-colors">Services</a>
          <span>/</span>
          <span class="text-white">Logistics Platform</span>
        </nav>
        <div class="max-w-4xl mx-auto text-center">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-payflo-purple/10 border border-payflo-purple/20 mb-8 animate-on-scroll">
            <Icon name="ph:truck-duotone" class="w-5 h-5 text-payflo-purple" />
            <span class="text-sm font-bold uppercase tracking-widest text-white/70">Logistics Specialists</span>
          </div>
          <h1 class="animate-on-scroll delay-1 text-5xl md:text-7xl lg:text-8xl font-black leading-tight tracking-tight text-white">
            Laravel <span class="gradient-text">Logistics Platform</span>
          </h1>
          <p class="animate-on-scroll delay-2 mt-8 text-xl md:text-2xl text-white/70 leading-relaxed font-medium">
            Route optimization, real-time GPS tracking, fleet management. Starting at $30,000.
          </p>
          <div class="animate-on-scroll delay-3 mt-12 flex flex-wrap justify-center gap-6">
            <a href="/contact/" class="btn btn-primary px-10 py-5 text-lg shadow-2xl">Build Logistics Platform</a>
            <a href="/build-booking-platform-laravel/" class="btn glass-card border-white/20 px-10 py-5 text-lg hover:bg-white/10 transition-all font-bold">Booking System →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Core Features -->
    <section class="py-24">
      <div class="container-custom">
        <div class="text-center max-w-3xl mx-auto mb-20 animate-on-scroll">
          <h2 class="text-4xl md:text-5xl font-black mb-6">Logistics <span class="gradient-text">Core Features</span></h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
          {features.map((f, i) => (
            <div class="animate-on-scroll delay-{i} glass-card p-10 border-white/10 group hover:border-payflo-purple/50 transition-colors">
              <Icon name={f.icon} class="w-12 h-12 text-payflo-purple mb-6 group-hover:scale-110 transition-transform" />
              <h3 class="text-2xl font-black mb-4 text-white">{f.title}</h3>
              <p class="text-gray-400 text-sm leading-relaxed">{f.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Platform Types -->
    <section class="py-24 bg-white/5">
      <div class="container-custom max-w-4xl mx-auto">
        <h2 class="text-4xl font-black text-center mb-16">Platform <span class="gradient-text">Types</span></h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10 text-center">
            <h4 class="text-lg font-bold text-white mb-2">Delivery Management</h4>
            <p class="text-gray-400 text-xs">Last-mile, same-day, scheduled</p>
          </div>
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10 text-center">
            <h4 class="text-lg font-bold text-white mb-2">Fleet Management</h4>
            <p class="text-gray-400 text-xs">Vehicles, drivers, maintenance</p>
          </div>
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10 text-center">
            <h4 class="text-lg font-bold text-white mb-2">Warehouse Ops</h4>
            <p class="text-gray-400 text-xs">Inventory, pick/pack, shipping</p>
          </div>
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10 text-center">
            <h4 class="text-lg font-bold text-white mb-2">Freight Brokerage</h4>
            <p class="text-gray-400 text-xs">Load matching, carrier mgmt</p>
          </div>
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10 text-center">
            <h4 class="text-lg font-bold text-white mb-2">Cold Chain</h4>
            <p class="text-gray-400 text-xs">Temperature monitoring, alerts</p>
          </div>
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10 text-center">
            <h4 class="text-lg font-bold text-white mb-2">3PL Platform</h4>
            <p class="text-gray-400 text-xs">Third-party logistics</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Cost Estimate -->
    <section class="py-24">
      <div class="container-custom max-w-4xl mx-auto">
        <h2 class="text-4xl font-black text-center mb-16">Cost <span class="gradient-text">Estimate</span></h2>
        <div class="glass-card p-10 border-white/10">
          <div class="space-y-4">
            <div class="flex justify-between pb-4 border-b border-white/5">
              <span class="text-white/70">Route Optimization (8-12 weeks)</span>
              <span class="text-payflo-purple font-bold">$15K-$30K</span>
            </div>
            <div class="flex justify-between pb-4 border-b border-white/5">
              <span class="text-white/70">Fleet Management (12-16 weeks)</span>
              <span class="text-payflo-purple font-bold">$30K-$60K</span>
            </div>
            <div class="flex justify-between">
              <span class="text-white/70">Full Logistics Platform (16-24 weeks)</span>
              <span class="text-payflo-pink font-bold">$50K-$120K</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-24 bg-white/5">
      <div class="container-custom max-w-4xl mx-auto">
        <h2 class="text-4xl font-black text-center mb-16">Logistics <span class="gradient-text">FAQ</span></h2>
        <div class="space-y-6">
          <div class="p-8 glass-card border-white/10">
            <h4 class="text-lg font-bold mb-3 text-white">How much does logistics platform development cost?</h4>
            <p class="text-gray-400">Logistics platforms cost $30,000-$80,000. Route optimization modules start at $15,000. Full fleet management systems cost $50,000-$120,000+.</p>
          </div>
          <div class="p-8 glass-card border-white/10">
            <h4 class="text-lg font-bold mb-3 text-white">Do you integrate with GPS/fleet tracking hardware?</h4>
            <p class="text-gray-400">Yes. We integrate with Samsara, Geotab, Fleetio, and custom GPS hardware via REST APIs, MQTT, or webhooks for real-time vehicle tracking.</p>
          </div>
          <div class="p-8 glass-card border-white/10">
            <h4 class="text-lg font-bold mb-3 text-white">Can you build delivery management platforms?</h4>
            <p class="text-gray-400">Absolutely. We build platforms like Onfleet, Bringg, or custom delivery systems with driver apps, customer tracking, and dispatcher dashboards.</p>
          </div>
        </div>
      </div>
    </section>

    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

    <!-- Internal Links -->
    <section class="py-16 border-t border-white/5">
      <div class="container-custom">
        <div class="flex flex-wrap justify-center gap-6 text-sm">
          <a href="/hire-laravel-developer/" class="text-payflo-purple hover:underline font-bold">Hire Logistics Dev →</a>
          <a href="/build-booking-platform-laravel/" class="text-payflo-purple hover:underline font-bold">Booking Platform →</a>
          <a href="/laravel-api-development/" class="text-payflo-purple hover:underline font-bold">API Development →</a>
        </div>
      </div>
    </section>

    <CTASection />
  </main>
</Layout>

<style>
  .btn { @apply inline-flex items-center justify-center font-black transition-all duration-300 rounded-2xl; }
  .btn-primary { @apply bg-gradient-to-r from-payflo-purple to-payflo-pink text-white shadow-xl shadow-purple-600/30 hover:shadow-purple-600/50 hover:-translate-y-1; }
  .glass-card { @apply bg-white/5 backdrop-blur-xl border border-white/10 rounded-3xl shadow-2xl; }
  .gradient-text { @apply bg-clip-text text-transparent bg-gradient-to-r from-payflo-purple to-payflo-pink; }
</style>
