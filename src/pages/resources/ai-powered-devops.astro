---
import Layout from "../../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import content from "../../data/whitepaper-content.json";

const reportSchema = {
  "@context": "https://schema.org",
  "@type": "Report",
  name: content.hero.title,
  headline: content.hero.title,
  description: content.meta.description,
  publisher: {
    "@type": "Organization",
    name: "Forrester Consulting",
    url: "https://forrester.com/consulting",
  },
  sponsor: {
    "@type": "Organization",
    name: "AWS Marketplace",
    url: "https://aws.amazon.com/marketplace",
  },
  datePublished: "2026-01",
  author: {
    "@type": "Organization",
    name: "Forrester Consulting",
  },
  about: {
    "@type": "Thing",
    name: "AI-Powered DevOps",
    description: "Leveraging AI to accelerate product growth, optimize workflows, and reduce overall technical debt.",
  },
};
---

<Layout title={content.meta.title} description={content.meta.description}>
  <script type="application/ld+json" set:html={JSON.stringify(reportSchema)} />

  <!-- Hero -->
  <section class="pt-20 pb-16 md:pt-28 md:pb-24 overflow-hidden relative min-h-[80vh] flex items-center">
    <div class="bg-blob blob-1"></div>
    <div class="bg-blob blob-2"></div>

    <div class="container-custom relative">
      <div class="max-w-4xl mx-auto text-center">
        <div class="animate-on-scroll delay-0 inline-flex items-center gap-2 px-4 py-2 rounded-full bg-payflo-purple/20 border border-payflo-purple/30 text-payflo-purple text-xs font-bold uppercase tracking-widest mb-6">
          <Icon name="ph:file-text-duotone" class="h-4 w-4" />
          <span>Trusted Laravel Development Partner</span>
        </div>

        <p class="animate-on-scroll delay-0 text-xs font-semibold tracking-[0.25em] text-white/40 uppercase mb-4">
          {content.hero.tagline}
        </p>

        <h1 class="animate-on-scroll delay-1 text-4xl md:text-5xl lg:text-7xl font-black leading-tight tracking-tight">
          {content.hero.title}
        </h1>

        <p class="animate-on-scroll delay-2 mt-6 text-lg md:text-xl text-white/70 max-w-3xl mx-auto leading-relaxed">
          {content.hero.subhead}
        </p>

        <div class="animate-on-scroll delay-3 mt-10 flex flex-col sm:flex-row justify-center gap-4">
          <a href="#executive-summary" class="btn btn-primary">Read the Report</a>
          <a href={content.cta.buttonUrl} class="btn btn-secondary group">
            <Icon name="ph:chat-circle-duotone" class="h-5 w-5" />
            {content.cta.buttonText}
            <Icon name="ph:arrow-right" class="h-4 w-4 group-hover:translate-x-1 transition-transform" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- About Forrester + Badge row -->
  <section class="py-8 md:py-12 border-y border-white/5">
    <div class="container-custom">
      <div class="grid grid-cols-1 md:grid-cols-5 gap-8 items-center">
        <div class="md:col-span-3">
          <h2 class="text-lg font-black text-white mb-3">{content.aboutForrester.heading}</h2>
          <p class="text-white/60 leading-relaxed text-sm">{content.aboutForrester.body}</p>
        </div>
        <div class="md:col-span-2 flex flex-wrap gap-3 justify-start md:justify-end">
          <span class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-white/5 border border-white/10 text-white/70 text-sm font-semibold">
            <Icon name="ph:check-circle-duotone" class="h-4 w-4 text-green-400" />
            ISO 27001 Certified
          </span>
          <span class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-white/5 border border-white/10 text-white/70 text-sm font-semibold">
            <Icon name="ph:check-circle-duotone" class="h-4 w-4 text-purple-400" />
            Laravel Partner
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- Table of Contents -->
  <section class="py-16 md:py-20">
    <div class="container-custom">
      <h2 class="animate-on-scroll delay-0 text-2xl md:text-3xl font-black text-white mb-10 text-center">
        Table of Contents
      </h2>
      <nav class="animate-on-scroll delay-1 max-w-2xl mx-auto" aria-label="Table of Contents">
        <ul class="space-y-3">
          {content.tableOfContents.map((item) => (
            <li>
              <a
                href={`#${item.id}`}
                class="flex items-center gap-3 px-6 py-4 rounded-xl bg-white/5 border border-white/10 hover:border-payflo-purple/50 hover:bg-white/10 transition-all duration-300 text-white/70 hover:text-white group"
              >
                <Icon name="ph:arrow-bend-right-down-duotone" class="h-4 w-4 text-payflo-purple opacity-0 group-hover:opacity-100 transition-opacity flex-shrink-0" />
                <span class="font-semibold text-sm">{item.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </section>

  <!-- Executive Summary -->
  <section id="executive-summary" class="py-16 md:py-20 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-payflo-purple/5 to-transparent pointer-events-none"></div>
    <div class="container-custom relative">
      <div class="max-w-4xl mx-auto">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-payflo-purple/20 border border-payflo-purple/30 text-payflo-purple text-xs font-bold uppercase tracking-widest mb-6">
          <span>01</span>
        </div>
        <h2 class="animate-on-scroll delay-0 text-3xl md:text-4xl font-black text-white mb-8">
          {content.executiveSummary.heading}
        </h2>
        <div class="space-y-5">
          {content.executiveSummary.paragraphs.map((p) => (
            <p class="animate-on-scroll text-white/70 leading-relaxed text-base md:text-lg">{p}</p>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Key Findings -->
  <section id="key-findings" class="py-16 md:py-20 relative overflow-hidden">
    <div class="bg-blob blob-1 !opacity-10"></div>
    <div class="container-custom relative">
      <div class="max-w-4xl mx-auto text-center mb-12">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-payflo-purple/20 border border-payflo-purple/30 text-payflo-purple text-xs font-bold uppercase tracking-widest mb-6">
          <span>02</span>
        </div>
        <h2 class="animate-on-scroll delay-0 text-3xl md:text-4xl font-black text-white">
          Key Findings
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {content.keyFindings.map((finding, i) => (
          <div class="animate-on-scroll glass-card p-6 md:p-8">
            <Icon name={finding.icon} class="h-8 w-8 text-payflo-purple mb-4" />
            <h3 class="text-base font-black text-white mb-3 leading-snug">{finding.title}</h3>
            <p class="text-white/60 text-sm leading-relaxed">{finding.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Main Sections -->
  {
    content.sections.map((section, sIdx) => (
      <section id={section.id} class="py-16 md:py-20 relative overflow-hidden">
        {sIdx % 2 === 1 && <div class="absolute inset-0 bg-gradient-to-b from-payflo-purple/[0.03] to-transparent pointer-events-none"></div>}

        <div class="container-custom relative">
          <div class="max-w-4xl mx-auto">
            <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-payflo-purple/20 border border-payflo-purple/30 text-payflo-purple text-xs font-bold uppercase tracking-widest mb-6">
              <span>0{sIdx + 3}</span>
            </div>

            <h2 class="animate-on-scroll delay-0 text-3xl md:text-4xl font-black text-white mb-6">
              {section.heading}
            </h2>

            {section.intro && (
              <p class="animate-on-scroll text-lg md:text-xl text-white/80 font-semibold leading-relaxed mb-8">
                {section.intro}
              </p>
            )}

            <div class="space-y-5">
              {section.paragraphs.map((p) => (
                <p class="animate-on-scroll text-white/70 leading-relaxed">{p}</p>
              ))}
            </div>

            <!-- Figures (Tables) -->
            {section.figures && section.figures.length > 0 && (
              <div class="mt-10 space-y-8">
                {section.figures.map((fig) => (
                  <figure class="animate-on-scroll overflow-x-auto">
                    <figcaption class="text-sm font-bold text-white/80 mb-4">{fig.title}</figcaption>
                    <div class="glass-card !p-0 overflow-hidden border-white/10">
                      <table class="w-full text-left">
                        <thead>
                          <tr class="border-b border-white/10 bg-white/5">
                            {fig.headers.map((header) => (
                              <th class="px-5 py-4 text-xs font-extrabold uppercase tracking-widest text-payflo-purple">{header}</th>
                            ))}
                          </tr>
                        </thead>
                        <tbody>
                          {fig.rows.map((row, rIdx) => (
                            <tr class="border-b border-white/5 last:border-0 hover:bg-white/[0.02] transition-colors">
                              {row.map((cell, cIdx) => (
                                <td class={`px-5 py-3.5 text-sm ${cIdx === 0 ? 'text-white font-semibold' : 'text-white/60'}`}>
                                  {cell}
                                </td>
                              ))}
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  </figure>
                ))}
              </div>
            )}

            <!-- Recommendations (for the recommendations section) -->
            {section.recommendations && section.recommendations.length > 0 && (
              <div class="mt-10 space-y-5">
                {section.recommendations.map((rec) => (
                  <div class="animate-on-scroll glass-card p-6 md:p-8 border-l-4 border-l-payflo-purple">
                    <h3 class="text-lg font-black text-white mb-2">{rec.title}</h3>
                    <p class="text-white/60 text-sm leading-relaxed">{rec.body}</p>
                  </div>
                ))}
              </div>
            )}

            <!-- Subsections (for appendix) -->
            {section.subsections && section.subsections.length > 0 && (
              <div class="mt-10 space-y-8">
                {section.subsections.map((sub) => (
                  <div class="animate-on-scroll">
                    <h3 class="text-xl font-black text-white mb-3">{sub.title}</h3>
                    <p class="text-white/70 leading-relaxed">{sub.body}</p>
                  </div>
                ))}
              </div>
            )}

            {section.conclusion && (
              <p class="animate-on-scroll mt-8 p-6 rounded-xl bg-gradient-to-r from-payflo-purple/10 to-transparent border-l-4 border-payflo-purple text-white/80 font-medium leading-relaxed">
                {section.conclusion}
              </p>
            )}
          </div>
        </div>
      </section>
    ))
  }

  <!-- How This Applies To Laravel -->
  <section id="laravel-block" class="py-16 md:py-20 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-payflo-purple/10 to-transparent pointer-events-none"></div>
    <div class="bg-blob blob-2 !opacity-10"></div>

    <div class="container-custom relative">
      <div class="max-w-4xl mx-auto">
        <div class="animate-on-scroll glass-card p-8 md:p-12 border-payflo-purple/30 relative overflow-hidden">
          <div class="absolute top-0 right-0 w-64 h-64 bg-payflo-purple/10 rounded-full blur-3xl pointer-events-none"></div>

          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-payflo-purple/20 border border-payflo-purple/30 text-payflo-purple text-xs font-bold uppercase tracking-widest mb-6 relative">
            <Icon name="ph:lightbulb-duotone" class="h-4 w-4" />
            <span>Laravel Perspective</span>
          </div>

          <h2 class="text-3xl md:text-4xl font-black text-white mb-6 relative">
            {content.laravelBlock.heading}
          </h2>

          <p class="text-white/70 leading-relaxed text-lg relative">
            {content.laravelBlock.body}
          </p>

          <div class="mt-8 relative">
            <a href={content.cta.buttonUrl} class="btn btn-primary group inline-flex items-center gap-2">
              <Icon name="ph:chat-circle-duotone" class="h-5 w-5" />
              {content.cta.buttonText}
              <Icon name="ph:arrow-right" class="h-4 w-4 group-hover:translate-x-1 transition-transform" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-24 md:py-32 relative overflow-hidden">
    <div class="bg-blob blob-1"></div>
    <div class="bg-blob blob-2"></div>

    <div class="container-custom relative">
      <div class="max-w-4xl mx-auto text-center animate-on-scroll">
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-black text-white leading-tight">
          {content.cta.heading}
        </h2>
        <p class="mt-6 text-lg md:text-xl text-white/70 leading-relaxed max-w-2xl mx-auto">
          {content.cta.subhead}
        </p>
        <div class="mt-10 flex flex-col sm:flex-row justify-center gap-4">
          <a href={content.cta.buttonUrl} class="btn btn-primary !px-12 !py-5 text-lg group inline-flex items-center gap-2">
            <Icon name="ph:chat-circle-duotone" class="h-5 w-5" />
            {content.cta.buttonText}
            <Icon name="ph:arrow-right" class="h-4 w-4 group-hover:translate-x-1 transition-transform" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Project Team & Disclaimer -->
  <section class="py-10 border-t border-white/5">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto space-y-4">
        <p class="text-white/40 text-sm leading-relaxed">{content.projectTeam}</p>
        <p class="text-white/30 text-xs leading-relaxed">{content.disclaimer}</p>
      </div>
    </div>
  </section>
</Layout>
