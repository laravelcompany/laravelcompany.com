---
import Layout from "../layouts/Layout.astro";
import CTASection from "../components/CTASection.astro";
import { Icon } from "astro-icon/components";

const pageTitle = "Laravel Company Website GitHub | Open Source Laravel Tools & Packages";
const pageDescription = "Explore the Laravel Company website GitHub organization — open source Laravel packages for SEO, Mail, GPT, UI and more. MIT-licensed, production-ready tools used by thousands of developers worldwide.";
---

<Layout title={pageTitle} description={pageDescription}>
  <main id="main-content">
    <!-- Hero -->
    <section class="pt-24 pb-20 md:pt-32 md:pb-28 overflow-hidden relative bg-payflo-dark">
      <div class="absolute inset-0 opacity-10 -z-10">
        <div class="absolute top-0 left-0 w-full h-full bg-[radial-gradient(circle_at_50%_120%,rgba(120,119,198,0.3),rgba(255,255,255,0))]"></div>
      </div>
      <div class="container-custom relative">
        <nav class="flex justify-center items-center gap-2 text-sm text-white/50 mb-8 animate-on-scroll">
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <span>/</span>
          <span class="text-white">Laravel Company Website GitHub</span>
        </nav>
        <div class="max-w-4xl mx-auto text-center">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-payflo-purple/10 border border-payflo-purple/20 mb-8 animate-on-scroll">
            <Icon name="ph:github-logo-duotone" class="w-5 h-5 text-payflo-purple" />
            <span class="text-sm font-bold uppercase tracking-widest text-white/70">Laravel Company GitHub</span>
          </div>
          <h1 class="animate-on-scroll delay-1 text-5xl md:text-7xl lg:text-8xl font-black leading-tight tracking-tight text-white">
            Laravel Company <span class="gradient-text">Website GitHub</span>
          </h1>
          <p class="animate-on-scroll delay-2 mt-8 text-xl md:text-2xl text-white/70 leading-relaxed font-medium">
            Our <a href="https://github.com/laravelcompany" class="text-payflo-purple hover:underline font-bold">Laravel Company website GitHub</a> organization hosts open source Laravel packages used by thousands of developers — MIT-licensed, well-tested, and production-ready.
          </p>
          <div class="animate-on-scroll delay-3 mt-12 flex flex-wrap justify-center gap-6">
            <a href="https://github.com/laravelcompany" target="_blank" rel="noopener noreferrer" class="btn btn-primary px-10 py-5 text-lg shadow-2xl">Visit Our GitHub</a>
            <a href="/contact/" class="btn glass-card border-white/20 px-10 py-5 text-lg hover:bg-white/10 transition-all font-bold">Get in Touch</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Introduction -->
    <section class="py-24">
      <div class="container-custom max-w-4xl mx-auto">
        <div class="animate-on-scroll glass-card p-10 border-white/10">
          <p class="text-gray-300 text-lg leading-relaxed mb-6">The <a href="https://github.com/laravelcompany" class="text-payflo-purple hover:underline font-bold">Laravel Company website GitHub</a> organization is the home of our open source Laravel ecosystem. We believe in giving back to the community that powers our business — every tool, package, and library we release is crafted with the same engineering standards we apply to our client work. Our GitHub repositories are publicly accessible, MIT-licensed, and actively maintained by the same senior Laravel developers who build enterprise applications for Fortune 500 companies and high-growth startups.</p>
          <p class="text-gray-400 leading-relaxed mb-6">When you explore the <a href="https://github.com/laravelcompany" class="text-payflo-purple hover:underline font-bold">Laravel Company website GitHub</a> organization, you will find a growing collection of specialized packages designed to solve real-world development problems. From SEO optimization and email management to GPT integration and UI component libraries, each repository represents months of refinement and hundreds of production deployments. Our open source philosophy is simple: build tools we would want to use ourselves, document them thoroughly, and release them under permissive licenses that give developers complete freedom.</p>
          <p class="text-gray-400 leading-relaxed">As a leading <a href="/" class="text-payflo-purple hover:underline font-bold">Laravel development company</a>, our GitHub presence reflects our commitment to transparency, quality, and community engagement. Every star, fork, and contribution on our repositories is a testament to the trust developers place in our work. Whether you are evaluating our engineering capabilities for a potential partnership or simply looking for reliable Laravel packages, our GitHub organization offers a transparent window into how we build software.</p>
        </div>
      </div>
    </section>

    <!-- Open Source Packages -->
    <section class="py-24 bg-white/5">
      <div class="container-custom max-w-5xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-20 animate-on-scroll">
          <h2 class="text-4xl md:text-5xl font-black mb-6">Our Open Source <span class="gradient-text">Laravel Packages</span></h2>
          <p class="text-gray-400 text-lg">Every repository in the <a href="https://github.com/laravelcompany" class="text-payflo-purple hover:underline font-bold">Laravel Company website GitHub</a> organization is built with production quality in mind. Here is what we currently maintain.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
          <div class="animate-on-scroll glass-card p-8 border-white/10 group hover:border-payflo-purple/50 transition-colors">
            <Icon name="ph:magnifying-glass-duotone" class="w-10 h-10 text-payflo-purple mb-5 group-hover:scale-110 transition-transform" />
            <h3 class="text-xl font-black mb-3 text-white">Laravel SEO</h3>
            <p class="text-gray-400 text-sm leading-relaxed">A comprehensive SEO package for Laravel applications that automatically generates meta tags, Open Graph data, Twitter Cards, JSON-LD structured data, XML sitemaps, and canonical URLs. It integrates seamlessly with any Laravel application and supports dynamic content, multi-language sites, and custom SEO strategies. The <a href="https://github.com/laravelcompany" class="text-payflo-purple hover:underline font-bold">Laravel Company website GitHub</a> repository for Laravel SEO includes extensive documentation, unit tests with 95%+ coverage, and ready-to-use Blade components. Thousands of production sites rely on this package for their SEO needs.</p>
          </div>
          <div class="animate-on-scroll delay-1 glass-card p-8 border-white/10 group hover:border-payflo-purple/50 transition-colors">
            <Icon name="ph:envelope-duotone" class="w-10 h-10 text-payflo-purple mb-5 group-hover:scale-110 transition-transform" />
            <h3 class="text-xl font-black mb-3 text-white">Laravel Mail</h3>
            <p class="text-gray-400 text-sm leading-relaxed">An advanced email management package offering drag-and-drop email template building, campaign management, transactional email tracking, and delivery analytics. It integrates with Mailgun, Postmark, SES, and SendGrid, and includes a built-in email testing suite that lets you preview emails before sending. The <a href="https://github.com/laravelcompany" class="text-payflo-purple hover:underline font-bold">Laravel Company website GitHub</a> repository features a full REST API, webhook handling for bounce and complaint tracking, and a responsive email editor. This package is ideal for SaaS platforms, e-commerce stores, and any application that needs reliable email delivery at scale.</p>
          </div>
          <div class="animate-on-scroll delay-2 glass-card p-8 border-white/10 group hover:border-payflo-purple/50 transition-colors">
            <Icon name="ph:magic-wand-duotone" class="w-10 h-10 text-payflo-purple mb-5 group-hover:scale-110 transition-transform" />
            <h3 class="text-xl font-black mb-3 text-white">Laravel GPT</h3>
            <p class="text-gray-400 text-sm leading-relaxed">A Laravel package that brings OpenAI GPT capabilities directly into your application. It provides a clean, fluent API for text generation, content summarization, chatbot conversations, embedding creation, and semantic search. The <a href="https://github.com/laravelcompany" class="text-payflo-purple hover:underline font-bold">Laravel Company website GitHub</a> repository includes rate limiting, token usage tracking, prompt templating, and built-in caching to minimize API costs. Whether you need AI-powered content generation, intelligent chatbots, or automated document analysis, this package provides a Laravel-native interface to the world's most advanced language models.</p>
          </div>
          <div class="animate-on-scroll delay-3 glass-card p-8 border-white/10 group hover:border-payflo-purple/50 transition-colors">
            <Icon name="ph:layout-duotone" class="w-10 h-10 text-payflo-purple mb-5 group-hover:scale-110 transition-transform" />
            <h3 class="text-xl font-black mb-3 text-white">Laravel UI</h3>
            <p class="text-gray-400 text-sm leading-relaxed">A modern UI component library built specifically for Laravel applications using Blade, Alpine.js, and Tailwind CSS. It includes over 40 customizable components: buttons, forms, modals, tables, navigation menus, dropdowns, alerts, and more. The <a href="https://github.com/laravelcompany" class="text-payflo-purple hover:underline font-bold">Laravel Company website GitHub</a> repository features dark mode support, responsive design out of the box, accessibility compliance (WCAG 2.1 AA), and full TypeScript definitions. Every component is documented with live examples, making it easy for Laravel developers to build beautiful interfaces without reaching for a JavaScript framework.</p>
          </div>
        </div>
        <div class="animate-on-scroll mt-12 max-w-3xl mx-auto text-center glass-card p-10 border-payflo-purple/30">
          <p class="text-gray-300 text-lg leading-relaxed">All packages on the <a href="https://github.com/laravelcompany" class="text-payflo-purple hover:underline font-bold">Laravel Company website GitHub</a> organization follow strict coding standards, include comprehensive test suites, and are compatible with Laravel 10 and 11. We publish detailed changelogs, migration guides, and semantic versioning to ensure smooth upgrades. Our goal is to provide the Laravel community with tools that reduce development time without sacrificing quality. Explore our repositories, open issues, submit pull requests — the <a href="https://github.com/laravelcompany" class="text-payflo-purple hover:underline font-bold">Laravel Company website GitHub</a> is built for and by the Laravel community.</p>
        </div>
      </div>
    </section>

    <!-- Engineering Standards -->
    <section class="py-24">
      <div class="container-custom max-w-5xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-20 animate-on-scroll">
          <h2 class="text-4xl md:text-5xl font-black mb-6">Engineering <span class="gradient-text">Standards on GitHub</span></h2>
          <p class="text-gray-400 text-lg">What you will find when you browse the <a href="https://github.com/laravelcompany" class="text-payflo-purple hover:underline font-bold">Laravel Company website GitHub</a> organization goes beyond just code — it is a reflection of our engineering culture and commitment to excellence.</p>
        </div>
        <div class="space-y-8 max-w-4xl mx-auto">
          <div class="animate-on-scroll glass-card p-8 border-white/10 flex flex-col md:flex-row gap-6 items-start">
            <div class="w-16 h-16 rounded-2xl bg-payflo-purple/20 flex items-center justify-center flex-shrink-0">
              <Icon name="ph:flask-duotone" class="w-8 h-8 text-payflo-purple" />
            </div>
            <div>
              <h3 class="text-2xl font-black mb-3 text-white">Comprehensive Test Coverage</h3>
              <p class="text-gray-400 leading-relaxed">Every repository in the <a href="https://github.com/laravelcompany" class="text-payflo-purple hover:underline font-bold">Laravel Company website GitHub</a> organization maintains 90%+ test coverage using PHPUnit, Pest, and Laravel's built-in testing utilities. We run continuous integration on every pull request with GitHub Actions, enforcing code style via Pint, static analysis via PHPStan at level 6, and security checks via Dependabot. This means when you install a package from our GitHub, you are getting code that has been rigorously tested across multiple PHP versions and Laravel versions. Our CI pipelines are public — you can verify the quality yourself.</p>
            </div>
          </div>
          <div class="animate-on-scroll delay-1 glass-card p-8 border-white/10 flex flex-col md:flex-row gap-6 items-start">
            <div class="w-16 h-16 rounded-2xl bg-payflo-purple/20 flex items-center justify-center flex-shrink-0">
              <Icon name="ph:book-open-text-duotone" class="w-8 h-8 text-payflo-purple" />
            </div>
            <div>
              <h3 class="text-2xl font-black mb-3 text-white">Detailed Documentation</h3>
              <p class="text-gray-400 leading-relaxed">We maintain extensive documentation for every package on the <a href="https://github.com/laravelcompany" class="text-payflo-purple hover:underline font-bold">Laravel Company website GitHub</a> organization. Each repository includes a comprehensive README with installation instructions, configuration options, usage examples, and API references. We provide migration guides between major versions, changelogs following the Keep a Changelog convention, and dedicated documentation sites for our flagship packages. Our documentation is updated with every release and community contributions to improve it are always welcome.</p>
            </div>
          </div>
          <div class="animate-on-scroll delay-2 glass-card p-8 border-white/10 flex flex-col md:flex-row gap-6 items-start">
            <div class="w-16 h-16 rounded-2xl bg-payflo-purple/20 flex items-center justify-center flex-shrink-0">
              <Icon name="ph:arrows-clockwise-duotone" class="w-8 h-8 text-payflo-purple" />
            </div>
            <div>
              <h3 class="text-2xl font-black mb-3 text-white">Active Maintenance & Community</h3>
              <p class="text-gray-400 leading-relaxed">The <a href="https://github.com/laravelcompany" class="text-payflo-purple hover:underline font-bold">Laravel Company website GitHub</a> organization is actively maintained. We respond to issues within 48 hours, review pull requests within one week, and ship patch releases for bug fixes within days. Our community guidelines ensure a welcoming environment for contributors of all skill levels. Whether you are reporting a bug, suggesting a feature, or submitting your first pull request, we are committed to making the experience positive and productive. The GitHub repositories are also where we publish our roadmap, RFCs for major features, and release candidates for community testing before stable releases.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Why It Matters -->
    <section class="py-24 bg-white/5">
      <div class="container-custom max-w-4xl mx-auto">
        <div class="animate-on-scroll glass-card p-10 border-white/10">
          <h2 class="text-3xl font-black mb-8 text-center">Why Our GitHub Presence <span class="gradient-text">Matters for Clients</span></h2>
          <p class="text-gray-400 leading-relaxed mb-6">When you are evaluating a <a href="/" class="text-payflo-purple hover:underline font-bold">Laravel development company</a> for your next project, their GitHub presence tells you everything you need to know about their engineering culture. The <a href="https://github.com/laravelcompany" class="text-payflo-purple hover:underline font-bold">Laravel Company website GitHub</a> organization is not just a collection of open source packages — it is a demonstration of how we approach software development. Every repository shows our commitment to clean code, thorough testing, clear documentation, and respectful collaboration.</p>
          <p class="text-gray-400 leading-relaxed mb-6">Clients who review our GitHub before engaging our services gain confidence in our technical capabilities. They can see our coding style, our testing practices, our documentation quality, and how we handle community interactions. This transparency is rare in the agency world, and it is one of the reasons why the <a href="https://github.com/laravelcompany" class="text-payflo-purple hover:underline font-bold">Laravel Company website GitHub</a> organization has become a trusted resource for developers and businesses alike. When you hire us, you are not just getting a development team — you are getting an organization that lives and breathes open source best practices.</p>
          <p class="text-gray-400 leading-relaxed">Beyond the technical signal, our GitHub presence directly benefits our clients. The packages we maintain — Laravel SEO, Laravel Mail, Laravel GPT, Laravel UI, and more — are the same tools we use in client projects. This means your project benefits from battle-tested, community-vetted components that have been refined through thousands of production deployments. The <a href="https://github.com/laravelcompany" class="text-payflo-purple hover:underline font-bold">Laravel Company website GitHub</a> organization ensures that our expertise is constantly evolving through community feedback, issue reports, and feature requests from developers around the world. Our clients get the cumulative benefit of all that collective intelligence.</p>
        </div>
      </div>
    </section>

    <!-- How to Explore -->
    <section class="py-24">
      <div class="container-custom max-w-4xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-16 animate-on-scroll">
          <h2 class="text-4xl md:text-5xl font-black mb-6">Explore Our <span class="gradient-text">GitHub Organization</span></h2>
          <p class="text-gray-400 text-lg">Ready to dive in? The <a href="https://github.com/laravelcompany" class="text-payflo-purple hover:underline font-bold">Laravel Company website GitHub</a> organization is open to everyone. Here is how to get started.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-4xl mx-auto">
          <div class="animate-on-scroll glass-card p-8 border-white/10 text-center group hover:border-payflo-purple/50 transition-colors">
            <div class="w-16 h-16 rounded-full bg-payflo-purple/20 flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform">
              <Icon name="ph:github-logo-duotone" class="w-8 h-8 text-payflo-purple" />
            </div>
            <h3 class="text-xl font-black mb-3 text-white">Browse Repositories</h3>
            <p class="text-gray-400 text-sm leading-relaxed">Visit <a href="https://github.com/laravelcompany" class="text-payflo-purple hover:underline font-bold">github.com/laravelcompany</a> to explore all our open source packages. Star the repositories you find useful and watch them for updates.</p>
          </div>
          <div class="animate-on-scroll delay-1 glass-card p-8 border-white/10 text-center group hover:border-payflo-purple/50 transition-colors">
            <div class="w-16 h-16 rounded-full bg-payflo-purple/20 flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform">
              <Icon name="ph:git-pull-request-duotone" class="w-8 h-8 text-payflo-purple" />
            </div>
            <h3 class="text-xl font-black mb-3 text-white">Contribute</h3>
            <p class="text-gray-400 text-sm leading-relaxed">Submit issues, propose features, or open pull requests. The <a href="https://github.com/laravelcompany" class="text-payflo-purple hover:underline font-bold">Laravel Company website GitHub</a> community welcomes contributions of all sizes.</p>
          </div>
          <div class="animate-on-scroll delay-2 glass-card p-8 border-white/10 text-center group hover:border-payflo-purple/50 transition-colors">
            <div class="w-16 h-16 rounded-full bg-payflo-purple/20 flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform">
              <Icon name="ph:chat-circle-duotone" class="w-8 h-8 text-payflo-purple" />
            </div>
            <h3 class="text-xl font-black mb-3 text-white">Get Support</h3>
            <p class="text-gray-400 text-sm leading-relaxed">Have questions about a package or interested in custom development? <a href="/contact/" class="text-payflo-purple hover:underline font-bold">Contact us</a> or open a discussion on GitHub.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-24 bg-white/5">
      <div class="container-custom max-w-4xl mx-auto">
        <h2 class="text-4xl font-black text-center mb-16">GitHub <span class="gradient-text">FAQ</span></h2>
        <div class="space-y-6">
          <div class="p-8 glass-card border-white/10">
            <h4 class="text-lg font-bold mb-3 text-white">Where can I find the Laravel Company website GitHub organization?</h4>
            <p class="text-gray-400">You can find all our open source repositories at <a href="https://github.com/laravelcompany" class="text-payflo-purple hover:underline font-bold">github.com/laravelcompany</a>. The <a href="https://github.com/laravelcompany" class="text-payflo-purple hover:underline font-bold">Laravel Company website GitHub</a> organization hosts packages for SEO, Mail, GPT, UI, and more.</p>
          </div>
          <div class="p-8 glass-card border-white/10">
            <h4 class="text-lg font-bold mb-3 text-white">Are the Laravel Company GitHub packages free to use?</h4>
            <p class="text-gray-400">Yes. All packages in the <a href="https://github.com/laravelcompany" class="text-payflo-purple hover:underline font-bold">Laravel Company website GitHub</a> organization are MIT-licensed and completely free to use in personal and commercial projects.</p>
          </div>
          <div class="p-8 glass-card border-white/10">
            <h4 class="text-lg font-bold mb-3 text-white">How are Laravel Company GitHub packages different from other Laravel packages?</h4>
            <p class="text-gray-400">Our packages are built by the same team that runs a professional <a href="/" class="text-payflo-purple hover:underline font-bold">Laravel development company</a>. Every repository on the <a href="https://github.com/laravelcompany" class="text-payflo-purple hover:underline font-bold">Laravel Company website GitHub</a> follows strict coding standards, includes 90%+ test coverage, and is actively maintained with regular updates and security patches.</p>
          </div>
          <div class="p-8 glass-card border-white/10">
            <h4 class="text-lg font-bold mb-3 text-white">Can I contribute to Laravel Company GitHub repositories?</h4>
            <p class="text-gray-400">Absolutely. The <a href="https://github.com/laravelcompany" class="text-payflo-purple hover:underline font-bold">Laravel Company website GitHub</a> organization welcomes contributions. You can submit issues, propose features, or open pull requests. We review all contributions and provide constructive feedback.</p>
          </div>
          <div class="p-8 glass-card border-white/10">
            <h4 class="text-lg font-bold mb-3 text-white">Do Laravel Company GitHub packages support the latest Laravel version?</h4>
            <p class="text-gray-400">Yes. We maintain compatibility with Laravel 10 and 11, and we update our packages promptly when new Laravel versions are released. Follow the <a href="https://github.com/laravelcompany" class="text-payflo-purple hover:underline font-bold">Laravel Company website GitHub</a> organization to receive release notifications.</p>
          </div>
          <div class="p-8 glass-card border-white/10">
            <h4 class="text-lg font-bold mb-3 text-white">Can I hire Laravel Company for a project after seeing your GitHub?</h4>
            <p class="text-gray-400">Yes. If you like what you see on our GitHub and need custom Laravel development, <a href="/contact/" class="text-payflo-purple hover:underline font-bold">contact us</a>. As a full-service <a href="/" class="text-payflo-purple hover:underline font-bold">Laravel development company</a>, we build custom applications, SaaS platforms, e-commerce solutions, and more.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Internal Links -->
    <section class="py-16 border-t border-white/5">
      <div class="container-custom">
        <div class="flex flex-wrap justify-center gap-6 text-sm mb-8">
          <a href="/" class="text-payflo-purple hover:underline font-bold">Laravel Development Company →</a>
          <a href="/laravel-development-services/" class="text-payflo-purple hover:underline font-bold">Laravel Development Services →</a>
          <a href="/laravel-saas-development/" class="text-payflo-purple hover:underline font-bold">SaaS Development →</a>
          <a href="/hire-laravel-developer/" class="text-payflo-purple hover:underline font-bold">Hire Laravel Developer →</a>
          <a href="/laravel-development-cost/" class="text-payflo-purple hover:underline font-bold">Development Cost →</a>
        </div>
        <div class="text-center text-sm text-white/30">
          <span>Explore our packages: <a href="/software/laravel-seo/" class="text-payflo-purple hover:underline">Laravel SEO</a> · <a href="/software/laravel-mail/" class="text-payflo-purple hover:underline">Laravel Mail</a> · <a href="/software/laravel-gpt/" class="text-payflo-purple hover:underline">Laravel GPT</a> · <a href="/software/laravel-ui/" class="text-payflo-purple hover:underline">Laravel UI</a></span>
        </div>
      </div>
    </section>

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Where can I find the Laravel Company website GitHub organization?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Find all open source Laravel packages at github.com/laravelcompany, including Laravel SEO, Laravel Mail, Laravel GPT, and Laravel UI."
            }
          },
          {
            "@type": "Question",
            "name": "Are Laravel Company GitHub packages free to use?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes, all packages are MIT-licensed and free to use in personal and commercial projects."
            }
          },
          {
            "@type": "Question",
            "name": "Can I contribute to Laravel Company GitHub repositories?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Absolutely. The Laravel Company website GitHub organization welcomes contributions via issues, feature proposals, and pull requests."
            }
          }
        ]
      }
    </script>

    <CTASection />
  </main>
</Layout>

<style>
  .btn { @apply inline-flex items-center justify-center font-black transition-all duration-300 rounded-2xl; }
  .btn-primary { @apply bg-gradient-to-r from-payflo-purple to-payflo-pink text-white shadow-xl shadow-purple-600/30 hover:shadow-purple-600/50 hover:-translate-y-1; }
  .glass-card { @apply bg-white/5 backdrop-blur-xl border border-white/10 rounded-3xl shadow-2xl; }
  .gradient-text { @apply bg-clip-text text-transparent bg-gradient-to-r from-payflo-purple to-payflo-pink; }
</style>
