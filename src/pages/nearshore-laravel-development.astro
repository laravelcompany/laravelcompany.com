---
import Layout from "../layouts/Layout.astro";
import CTASection from "../components/CTASection.astro";
import { Icon } from "astro-icon/components";

const models = [
  {
    region: "Eastern Europe → Western Europe/UK",
    overlap: "4-6 hours",
    rate: "$35-$75/hr",
    benefit: "EU timezone, cultural proximity, GDPR"
  },
  {
    region: "Latin America → USA",
    overlap: "3-5 hours",
    rate: "$30-$80/hr",
    benefit: "Same-day overlap, bilingual, US business culture"
  },
  {
    region: "Southeast Asia → Australia",
    overlap: "2-4 hours",
    rate: "$20-$60/hr",
    benefit: "Cost-effective, strong English, APAC expertise"
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      "name": "What is nearshore Laravel development?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Nearshore means hiring from nearby countries with 0-5 hour timezone difference. For US: Latin America. For UK/Western Europe: Eastern Europe. For Australia: Southeast Asia."
      }
    },
    {
      "@type": "Question",
      "name": "Why choose nearshore over offshore?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Nearshore offers 3-6 hour timezone overlap (vs 8-12h for offshore), cultural proximity, easier communication, and 40-60% cost savings vs in-house hiring."
      }
    },
    {
      "@type": "Question",
      "name": "How much does nearshore Laravel development cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Nearshore rates: Eastern Europe $35-$75/hr, Latin America $30-$80/hr, Southeast Asia $20-$60/hr. Dedicated teams cost $3,000-$8,000/month depending on region."
      }
    },
    {
      "@type": "Question",
      "name": "Which nearshore region is best for my company?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "US companies: Latin America (same-day overlap). UK/Western Europe: Eastern Europe (EU timezone, GDPR). Australia: Southeast Asia (APAC expertise, 2-4h overlap)."
      }
    }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Nearshore Laravel Development",
  "provider": {
    "@type": "Organization",
    "name": "Laravel Company",
    "url": "https://laravelcompany.com"
  },
  "description": "Nearshore Laravel development: Eastern Europe for EU, Latin America for USA. 3-6h timezone overlap, 40-60% cost savings.",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Nearshore Services",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Eastern Europe Nearshore" }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Latin America Nearshore" }}
    ]
  }
};
---

<Layout
  title="Nearshore Laravel Development | EU & LATAM Teams"
  description="Nearshore Laravel development: Eastern Europe for EU, Latin America for USA. 3-6h timezone overlap, 40-60% cost savings. $20-$80/hr."
>
  <main id="main-content">
    <!-- Hero -->
    <section class="pt-24 pb-20 md:pt-32 md:pb-28 overflow-hidden relative bg-payflo-dark">
      <div class="absolute inset-0 opacity-10 -z-10">
        <div class="absolute top-0 left-0 w-full h-full bg-[radial-gradient(circle_at_50%_120%,rgba(120,119,198,0.3),rgba(255,255,255,0))]"></div>
      </div>
      <div class="container-custom relative">
        <nav class="flex justify-center items-center gap-2 text-sm text-white/50 mb-8 animate-on-scroll">
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <span>/</span>
          <a href="/laravel-services/" class="hover:text-white transition-colors">Services</a>
          <span>/</span>
          <span class="text-white">Nearshore Development</span>
        </nav>
        <div class="max-w-4xl mx-auto text-center">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-payflo-purple/10 border border-payflo-purple/20 mb-8 animate-on-scroll">
            <Icon name="ph:airplane-tilt-duotone" class="w-5 h-5 text-payflo-purple" />
            <span class="text-sm font-bold uppercase tracking-widest text-white/70">Nearshore</span>
          </div>
          <h1 class="text-5xl md:text-7xl lg:text-8xl font-black leading-tight tracking-tight text-white">
            Nearshore <span class="gradient-text">Laravel Development</span>
          </h1>
          <p class="animate-on-scroll delay-2 mt-8 text-xl md:text-2xl text-white/70 leading-relaxed font-medium">
            Eastern Europe for EU, Latin America for USA. 3-6h timezone overlap, 40-60% cost savings.
          </p>
          <div class="animate-on-scroll delay-3 mt-12 flex flex-wrap justify-center gap-6">
            <a href="/contact/" class="btn btn-primary px-10 py-5 text-lg shadow-2xl">Start Nearshore</a>
            <a href="/outsource-laravel-development/" class="btn glass-card border-white/20 px-10 py-5 text-lg hover:bg-white/10 transition-all font-bold">Outsourcing →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Nearshore Models -->
    <section class="py-24">
      <div class="container-custom">
        <div class="text-center max-w-3xl mx-auto mb-20 animate-on-scroll">
          <h2 class="text-4xl md:text-5xl font-black mb-6">Nearshore <span class="gradient-text">Models</span></h2>
          <p class="text-gray-400 text-lg">Choose the region that aligns with your timezone and business culture.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
          {models.map((m, i) => (
            <div class="animate-on-scroll delay-{i} glass-card p-8 border-white/10 hover:border-payflo-purple/30 transition-colors">
              <h3 class="text-xl font-black text-white mb-4">{m.region}</h3>
              <div class="space-y-3">
                <div class="flex justify-between">
                  <span class="text-white/50 text-sm">Timezone Overlap</span>
                  <span class="text-payflo-purple font-bold text-sm">{m.overlap}</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-white/50 text-sm">Rate</span>
                  <span class="text-payflo-purple font-bold text-sm">{m.rate}</span>
                </div>
                <p class="text-gray-400 text-xs mt-2">{m.benefit}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Nearshore vs Offshore -->
    <section class="py-24 bg-white/5">
      <div class="container-custom max-w-4xl mx-auto">
        <h2 class="text-4xl font-black text-center mb-16">Nearshore vs <span class="gradient-text">Offshore</span></h2>
        <div class="overflow-x-auto">
          <table class="w-full border-collapse">
            <thead>
              <tr class="border-b border-white/10">
                <th class="py-4 px-6 text-left text-white/80">Factor</th>
                <th class="py-4 px-6 text-center text-payflo-purple">Nearshore</th>
                <th class="py-4 px-6 text-center text-white/60">Offshore (Asia)</th>
              </tr>
            </thead>
            <tbody>
              <tr class="border-b border-white/5">
                <td class="py-4 px-6 text-white/70">Timezone Overlap</td>
                <td class="py-4 px-6 text-center text-white">3-6 hours</td>
                <td class="py-4 px-6 text-center text-white/40">0-4 hours</td>
              </tr>
              <tr class="border-b border-white/5">
                <td class="py-4 px-6 text-white/70">Cultural Proximity</td>
                <td class="py-4 px-6 text-center"><Icon name="ph:check-circle-fill" class="w-5 h-5 text-payflo-purple mx-auto" /></td>
                <td class="py-4 px-6 text-center"><Icon name="ph:x-circle-duotone" class="w-5 h-5 text-white/30 mx-auto" /></td>
              </tr>
              <tr class="border-b border-white/5">
                <td class="py-4 px-6 text-white/70">Communication</td>
                <td class="py-4 px-6 text-center text-white">Fluent English</td>
                <td class="py-4 px-6 text-center text-white/40">Variable</td>
              </tr>
              <tr>
                <td class="py-4 px-6 text-white/70">Cost Savings</td>
                <td class="py-4 px-6 text-center text-payflo-purple font-bold">40-60%</td>
                <td class="py-4 px-6 text-center text-white/50">60-80%</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Benefits -->
    <section class="py-24">
      <div class="container-custom max-w-4xl mx-auto">
        <h2 class="text-4xl font-black text-center mb-16">Nearshore <span class="gradient-text">Benefits</span></h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="p-8 rounded-2xl bg-white/5 border border-white/10">
            <h4 class="text-lg font-bold text-white mb-2">Real-Time Collaboration</h4>
            <p class="text-gray-400 text-sm">3-6h overlap means you can have meetings, pair programming, and instant feedback within your workday.</p>
          </div>
          <div class="p-8 rounded-2xl bg-white/5 border border-white/10">
            <h4 class="text-lg font-bold text-white mb-2">Cultural Alignment</h4>
            <p class="text-gray-400 text-sm">Similar business culture, work ethics, and communication style reduce misunderstandings and rework.</p>
          </div>
          <div class="p-8 rounded-2xl bg-white/5 border border-white/10">
            <h4 class="text-lg font-bold text-white mb-2">Cost Efficiency</h4>
            <p class="text-gray-400 text-sm">40-60% cheaper than in-house US/UK hiring, with better communication than offshore alternatives.</p>
          </div>
          <div class="p-8 rounded-2xl bg-white/5 border border-white/10">
            <h4 class="text-lg font-bold text-white mb-2">GDPR (EU Only)</h4>
            <p class="text-gray-400 text-sm">Eastern European nearshore ensures EU data residency, GDPR compliance, and DPA agreements.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-24 bg-white/5">
      <div class="container-custom max-w-4xl mx-auto">
        <h2 class="text-4xl font-black text-center mb-16">Nearshore <span class="gradient-text">FAQ</span></h2>
        <div class="space-y-6">
          <div class="p-8 glass-card border-white/10">
            <h4 class="text-lg font-bold mb-3 text-white">What is nearshore Laravel development?</h4>
            <p class="text-gray-400">Nearshore means hiring from nearby countries with 0-5 hour timezone difference. For US: Latin America. For UK/Western Europe: Eastern Europe. For Australia: Southeast Asia.</p>
          </div>
          <div class="p-8 glass-card border-white/10">
            <h4 class="text-lg font-bold mb-3 text-white">Why choose nearshore over offshore?</h4>
            <p class="text-gray-400">Nearshore offers 3-6 hour timezone overlap (vs 8-12h for offshore), cultural proximity, easier communication, and 40-60% cost savings vs in-house hiring.</p>
          </div>
          <div class="p-8 glass-card border-white/10">
            <h4 class="text-lg font-bold mb-3 text-white">Which nearshore region is best for my company?</h4>
            <p class="text-gray-400">US companies: Latin America (same-day overlap). UK/Western Europe: Eastern Europe (EU timezone, GDPR). Australia: Southeast Asia (APAC expertise, 2-4h overlap).</p>
          </div>
        </div>
      </div>
    </section>

    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

    <!-- Internal Links -->
    <section class="py-16 border-t border-white/5">
      <div class="container-custom">
        <div class="flex flex-wrap justify-center gap-6 text-sm">
          <a href="/" class="text-payflo-purple hover:underline font-bold">Laravel Development Company →</a>
          <a href="/laravel-developers-romania/" class="text-payflo-purple hover:underline font-bold">Romania Team →</a>
          <a href="/hire-laravel-developer-remote/" class="text-payflo-purple hover:underline font-bold">Remote Hiring →</a>
          <a href="/outsource-laravel-development/" class="text-payflo-purple hover:underline font-bold">Outsourcing →</a>
        </div>
      </div>
    </section>

    <CTASection />
  </main>
</Layout>

<style>
  .btn { @apply inline-flex items-center justify-center font-black transition-all duration-300 rounded-2xl; }
  .btn-primary { @apply bg-gradient-to-r from-payflo-purple to-payflo-pink text-white shadow-xl shadow-purple-600/30 hover:shadow-purple-600/50 hover:-translate-y-1; }
  .glass-card { @apply bg-white/5 backdrop-blur-xl border border-white/10 rounded-3xl shadow-2xl; }
  .gradient-text { @apply bg-clip-text text-transparent bg-gradient-to-r from-payflo-purple to-payflo-pink; }
</style>
