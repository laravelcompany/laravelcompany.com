---
import Layout from "../layouts/Layout.astro";
import CTASection from "../components/CTASection.astro";
import { Icon } from "astro-icon/components";
---

<Layout
  title="Laravel Services | Laravel Development Company"
  description="Explore our Laravel services: hire developers, custom development, SaaS, API, migration, performance, security, and more. Find the right service for your project."
>
  <main id="main-content">
    <!-- Hero -->
    <section class="pt-24 pb-20 md:pt-32 md:pb-28 overflow-hidden relative bg-payflo-dark">
      <div class="absolute inset-0 opacity-10 -z-10">
        <div class="absolute top-0 left-0 w-full h-full bg-[radial-gradient(circle_at_50%_120%,rgba(120,119,198,0.3),rgba(255,255,255,0))]"></div>
      </div>
      <div class="container-custom relative">
        <nav class="flex justify-center items-center gap-2 text-sm text-white/50 mb-8 animate-on-scroll">
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <span>/</span>
          <span class="text-white">Laravel Services</span>
        </nav>
        <div class="max-w-4xl mx-auto text-center">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-payflo-purple/10 border border-payflo-purple/20 mb-8 animate-on-scroll">
            <Icon name="ph:buildings-duotone" class="w-5 h-5 text-payflo-purple" />
            <span class="text-sm font-bold uppercase tracking-widest text-white/70">All Services</span>
          </div>
          <h1 class="text-5xl md:text-7xl lg:text-8xl font-black leading-tight tracking-tight text-white">
            Laravel <span class="gradient-text">Services</span>
          </h1>
          <p class="animate-on-scroll delay-2 mt-8 text-xl md:text-2xl text-white/70 leading-relaxed font-medium">
            Explore our full range of Laravel services. From hiring developers to building SaaS platforms, we've got you covered.
          </p>
          <div class="animate-on-scroll delay-3 mt-12 flex flex-wrap justify-center gap-6">
            <a href="/hire-laravel-developer/" class="btn btn-primary px-10 py-5 text-lg shadow-2xl">Hire Developer</a>
            <a href="/laravel-development-cost/" class="btn glass-card border-white/20 px-10 py-5 text-lg hover:bg-white/10 transition-all font-bold">View Pricing</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Core Services -->
    <section class="py-24">
      <div class="container-custom">
        <div class="text-center max-w-3xl mx-auto mb-20 animate-on-scroll">
          <h2 class="text-4xl md:text-5xl font-black mb-6">Core <span class="gradient-text">Money Pages</span></h2>
          <p class="text-gray-400 text-lg">Our primary conversion pages. Start here to hire or get a quote.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
          <a href="/hire-laravel-developer/" class="glass-card p-10 border-white/10 hover:border-payflo-purple/50 transition-colors group">
            <Icon name="ph:user-focus-duotone" class="w-12 h-12 text-payflo-purple mb-6 group-hover:scale-110 transition-transform" />
            <h3 class="text-2xl font-black mb-4 text-white">Hire Laravel Developer</h3>
            <p class="text-gray-400 text-sm">Dedicated, hourly, or team augmentation. Starting at $35/hour.</p>
          </a>
          <a href="/laravel-development-services/" class="glass-card p-10 border-white/10 hover:border-payflo-purple/50 transition-colors group">
            <Icon name="ph:code-block-duotone" class="w-12 h-12 text-payflo-purple mb-6 group-hover:scale-110 transition-transform" />
            <h3 class="text-2xl font-black mb-4 text-white">Laravel Development Services</h3>
            <p class="text-gray-400 text-sm">Custom web apps, APIs, SaaS, e-commerce, migration, support.</p>
          </a>
          <a href="/laravel-development-cost/" class="glass-card p-10 border-white/10 hover:border-payflo-purple/50 transition-colors group">
            <Icon name="ph:currency-circle-dollar-duotone" class="w-12 h-12 text-payflo-purple mb-6 group-hover:scale-110 transition-transform" />
            <h3 class="text-2xl font-black mb-4 text-white">Laravel Development Cost</h3>
            <p class="text-gray-400 text-sm">Hourly rates, dedicated pricing, project estimates. Transparent pricing.</p>
          </a>
          <a href="/outsource-laravel-development/" class="glass-card p-10 border-white/10 hover:border-payflo-purple/50 transition-colors group">
            <Icon name="ph:globe-duotone" class="w-12 h-12 text-payflo-purple mb-6 group-hover:scale-110 transition-transform" />
            <h3 class="text-2xl font-black mb-4 text-white">Outsource Laravel Development</h3>
            <p class="text-gray-400 text-sm">Staff augmentation, dedicated teams, nearshore outsourcing.</p>
          </a>
        </div>
      </div>
    </section>

    <!-- Service Categories -->
    <section class="py-24 bg-white/5">
      <div class="container-custom">
        <div class="text-center max-w-3xl mx-auto mb-20 animate-on-scroll">
          <h2 class="text-4xl md:text-5xl font-black mb-6">Service <span class="gradient-text">Categories</span></h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto">
          <a href="/laravel-saas-development/" class="glass-card p-8 border-white/10 hover:border-payflo-purple/30 transition-colors group">
            <Icon name="ph:buildings-duotone" class="w-10 h-10 text-payflo-purple mb-4 group-hover:scale-110 transition-transform" />
            <h4 class="text-xl font-black text-white mb-2">SaaS Development</h4>
            <p class="text-gray-400 text-sm">Multi-tenant SaaS platforms with billing.</p>
          </a>
          <a href="/laravel-api-development/" class="glass-card p-8 border-white/10 hover:border-payflo-purple/30 transition-colors group">
            <Icon name="ph:plugs-connected-duotone" class="w-10 h-10 text-payflo-purple mb-4 group-hover:scale-110 transition-transform" />
            <h4 class="text-xl font-black text-white mb-2">API Development</h4>
            <p class="text-gray-400 text-sm">REST APIs, JSON:API, Sanctum/Passport.</p>
          </a>
          <a href="/migrate-wordpress-to-laravel/" class="glass-card p-8 border-white/10 hover:border-payflo-purple/30 transition-colors group">
            <Icon name="ph:arrow-square-out-duotone" class="w-10 h-10 text-payflo-purple mb-4 group-hover:scale-110 transition-transform" />
            <h4 class="text-xl font-black text-white mb-2">WordPress Migration</h4>
            <p class="text-gray-400 text-sm">Zero-downtime migration with SEO preservation.</p>
          </a>
          <a href="/laravel-performance-optimization/" class="glass-card p-8 border-white/10 hover:border-payflo-purple/30 transition-colors group">
            <Icon name="ph:gauge-duotone" class="w-10 h-10 text-payflo-pink mb-4 group-hover:scale-110 transition-transform" />
            <h4 class="text-xl font-black text-white mb-2">Performance Optimization</h4>
            <p class="text-gray-400 text-sm">Caching, queues, indexing, OpCache tuning.</p>
          </a>
          <a href="/laravel-security-audit/" class="glass-card p-8 border-white/10 hover:border-payflo-purple/30 transition-colors group">
            <Icon name="ph:shield-check-duotone" class="w-10 h-10 text-payflo-purple mb-4 group-hover:scale-110 transition-transform" />
            <h4 class="text-xl font-black text-white mb-2">Security Audit</h4>
            <p class="text-gray-400 text-sm">OWASP, SQL injection, XSS, PCI/GDPR.</p>
          </a>
          <a href="/upgrade-laravel-version/" class="glass-card p-8 border-white/10 hover:border-payflo-purple/30 transition-colors group">
            <Icon name="ph:arrow-circle-up-duotone" class="w-10 h-10 text-payflo-purple mb-4 group-hover:scale-110 transition-transform" />
            <h4 class="text-xl font-black text-white mb-2">Version Upgrade</h4>
            <p class="text-gray-400 text-sm">LTS planning, breaking changes, legacy refactoring.</p>
          </a>
        </div>
      </div>
    </section>

    <!-- Lead Magnet Pages -->
    <section class="py-24">
      <div class="container-custom">
        <div class="text-center max-w-3xl mx-auto mb-20 animate-on-scroll">
          <h2 class="text-4xl md:text-5xl font-black mb-6">Startup & <span class="gradient-text">MVP Solutions</span></h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 max-w-6xl mx-auto">
          <a href="/laravel-mvp-development/" class="glass-card p-8 border-white/10 hover:border-payflo-purple/30 transition-colors group">
            <Icon name="ph:rocket-launch-duotone" class="w-10 h-10 text-payflo-purple mb-4 group-hover:scale-110 transition-transform" />
            <h4 class="text-xl font-black text-white mb-2">MVP Development</h4>
            <p class="text-gray-400 text-sm">Fixed-price $15K-$40K, 4-12 weeks.</p>
          </a>
          <a href="/build-marketplace-laravel/" class="glass-card p-8 border-white/10 hover:border-payflo-purple/30 transition-colors group">
            <Icon name="ph:storefront-duotone" class="w-10 h-10 text-payflo-purple mb-4 group-hover:scale-110 transition-transform" />
            <h4 class="text-xl font-black text-white mb-2">Marketplace Build</h4>
            <p class="text-gray-400 text-sm">Multi-vendor platforms, commission engine.</p>
          </a>
          <a href="/build-booking-platform-laravel/" class="glass-card p-8 border-white/10 hover:border-payflo-purple/30 transition-colors group">
            <Icon name="ph:calendar-check-duotone" class="w-10 h-10 text-payflo-purple mb-4 group-hover:scale-110 transition-transform" />
            <h4 class="text-xl font-black text-white mb-2">Booking Platform</h4>
            <p class="text-gray-400 text-sm">Calendar, payments, provider portals.</p>
          </a>
          <a href="/startup-laravel-agency/" class="glass-card p-8 border-white/10 hover:border-payflo-purple/30 transition-colors group">
            <Icon name="ph:trend-up-duotone" class="w-10 h-10 text-payflo-purple mb-4 group-hover:scale-110 transition-transform" />
            <h4 class="text-xl font-black text-white mb-2">Startup Agency</h4>
            <p class="text-gray-400 text-sm">Equity/deferred payment, fractional CTO.</p>
          </a>
        </div>
      </div>
    </section>

    <!-- Niche Pages -->
    <section class="py-24 bg-white/5">
      <div class="container-custom">
        <div class="text-center max-w-3xl mx-auto mb-20 animate-on-scroll">
          <h2 class="text-4xl md:text-5xl font-black mb-6">Industry <span class="gradient-text">Niche Pages</span></h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
          <a href="/laravel-fintech-development/" class="glass-card p-8 border-white/10 hover:border-payflo-purple/30 transition-colors group">
            <Icon name="ph:currency-circle-dollar-duotone" class="w-10 h-10 text-payflo-purple mb-4 group-hover:scale-110 transition-transform" />
            <h4 class="text-xl font-black text-white mb-2">FinTech Development</h4>
            <p class="text-gray-400 text-sm">PCI compliance, bank-grade APIs, ledger systems.</p>
          </a>
          <a href="/laravel-ecommerce-development/" class="glass-card p-8 border-white/10 hover:border-payflo-purple/30 transition-colors group">
            <Icon name="ph:shopping-cart-duotone" class="w-10 h-10 text-payflo-purple mb-4 group-hover:scale-110 transition-transform" />
            <h4 class="text-xl font-black text-white mb-2">E-commerce Development</h4>
            <p class="text-gray-400 text-sm">Custom cart, inventory, multi-vendor.</p>
          </a>
          <a href="/laravel-crm-development/" class="glass-card p-8 border-white/10 hover:border-payflo-purple/30 transition-colors group">
            <Icon name="ph:user-gear-duotone" class="w-10 h-10 text-payflo-purple mb-4 group-hover:scale-110 transition-transform" />
            <h4 class="text-xl font-black text-white mb-2">CRM Development</h4>
            <p class="text-gray-400 text-sm">Sales pipeline, custom fields, reporting.</p>
          </a>
          <a href="/laravel-healthcare-software/" class="glass-card p-8 border-white/10 hover:border-payflo-purple/30 transition-colors group">
            <Icon name="ph:heartbeat-duotone" class="w-10 h-10 text-payflo-pink mb-4 group-hover:scale-110 transition-transform" />
            <h4 class="text-xl font-black text-white mb-2">Healthcare Software</h4>
            <p class="text-gray-400 text-sm">HIPAA, patient portals, FHIR integrations.</p>
          </a>
          <a href="/laravel-logistics-platform/" class="glass-card p-8 border-white/10 hover:border-payflo-purple/30 transition-colors group">
            <Icon name="ph:truck-duotone" class="w-10 h-10 text-payflo-purple mb-4 group-hover:scale-110 transition-transform" />
            <h4 class="text-xl font-black text-white mb-2">Logistics Platform</h4>
            <p class="text-gray-400 text-sm">Route optimization, real-time tracking.</p>
          </a>
        </div>
      </div>
    </section>

    <!-- Location Pages -->
    <section class="py-24">
      <div class="container-custom">
        <div class="text-center max-w-3xl mx-auto mb-20 animate-on-scroll">
          <h2 class="text-4xl md:text-5xl font-black mb-6">Location-Based <span class="gradient-text">Services</span></h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 max-w-5xl mx-auto">
          <a href="/laravel-developers-romania/" class="glass-card p-8 border-white/10 hover:border-payflo-purple/30 transition-colors group">
            <Icon name="ph:map-pin-duotone" class="w-10 h-10 text-payflo-purple mb-4 group-hover:scale-110 transition-transform" />
            <h4 class="text-xl font-black text-white mb-2">Developers in Romania</h4>
            <p class="text-gray-400 text-sm">EU timezone, top talent, 60% cost savings.</p>
          </a>
          <a href="/laravel-development-company-europe/" class="glass-card p-8 border-white/10 hover:border-payflo-purple/30 transition-colors group">
            <Icon name="ph:globe-duotone" class="w-10 h-10 text-payflo-purple mb-4 group-hover:scale-110 transition-transform" />
            <h4 class="text-xl font-black text-white mb-2">Company in Europe</h4>
            <p class="text-gray-400 text-sm">GDPR, data residency, EU-based team.</p>
          </a>
          <a href="/hire-laravel-developer-remote/" class="glass-card p-8 border-white/10 hover:border-payflo-purple/30 transition-colors group">
            <Icon name="ph:wifi-high-duotone" class="w-10 h-10 text-payflo-purple mb-4 group-hover:scale-110 transition-transform" />
            <h4 class="text-xl font-black text-white mb-2">Hire Remote Developer</h4>
            <p class="text-gray-400 text-sm">Global talent, async workflows, communication.</p>
          </a>
          <a href="/nearshore-laravel-development/" class="glass-card p-8 border-white/10 hover:border-payflo-purple/30 transition-colors group">
            <Icon name="ph:airplane-tilt-duotone" class="w-10 h-10 text-payflo-purple mb-4 group-hover:scale-110 transition-transform" />
            <h4 class="text-xl font-black text-white mb-2">Nearshore Development</h4>
            <p class="text-gray-400 text-sm">US/UK → Eastern Europe/LATAM, timezone alignment.</p>
          </a>
        </div>
      </div>
    </section>

    <!-- Comparison Pages -->
    <section class="py-24 bg-white/5">
      <div class="container-custom">
        <div class="text-center max-w-3xl mx-auto mb-20 animate-on-scroll">
          <h2 class="text-4xl md:text-5xl font-black mb-6">Comparison <span class="gradient-text">Pages</span></h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-4xl mx-auto">
          <a href="/laravel-vs-nodejs-for-saas/" class="glass-card p-8 border-white/10 hover:border-payflo-purple/30 transition-colors group">
            <Icon name="ph:code-block-duotone" class="w-10 h-10 text-payflo-purple mb-4 group-hover:scale-110 transition-transform" />
            <h4 class="text-xl font-black text-white mb-2">Laravel vs Node.js</h4>
            <p class="text-gray-400 text-sm">For SaaS: which is better?</p>
          </a>
          <a href="/laravel-vs-django-web-app/" class="glass-card p-8 border-white/10 hover:border-payflo-purple/30 transition-colors group">
            <Icon name="ph:code-block-duotone" class="w-10 h-10 text-payflo-purple mb-4 group-hover:scale-110 transition-transform" />
            <h4 class="text-xl font-black text-white mb-2">Laravel vs Django</h4>
            <p class="text-gray-400 text-sm">For web apps: feature/performance breakdown.</p>
          </a>
          <a href="/best-laravel-development-companies/" class="glass-card p-8 border-white/10 hover:border-payflo-purple/30 transition-colors group">
            <Icon name="ph:buildings-duotone" class="w-10 h-10 text-payflo-purple mb-4 group-hover:scale-110 transition-transform" />
            <h4 class="text-xl font-black text-white mb-2">Top Rated Companies</h4>
            <p class="text-gray-400 text-sm">Curated list of top Laravel agencies.</p>
          </a>
        </div>
      </div>
    </section>

    <CTASection />
  </main>
</Layout>

<style>
  .btn { @apply inline-flex items-center justify-center font-black transition-all duration-300 rounded-2xl; }
  .btn-primary { @apply bg-gradient-to-r from-payflo-purple to-payflo-pink text-white shadow-xl shadow-purple-600/30 hover:shadow-purple-600/50 hover:-translate-y-1; }
  .glass-card { @apply bg-white/5 backdrop-blur-xl border border-white/10 rounded-3xl shadow-2xl; }
  .gradient-text { @apply bg-clip-text text-transparent bg-gradient-to-r from-payflo-purple to-payflo-pink; }
</style>
