    bio: "Member of Laravel Company Organization",
    avatar: "https://avatars.githubusercontent.com/u/90279111?s=96&v=4",
    github: "Bogdanboti",
  },
  {
    name: "Stefan Bogdan",
    role: "Founder",
    bio: "Member of Laravel Company Organization",
    avatar: "https://avatars.githubusercontent.com/u/2276408?s=96&v=4",
    github: "izdrail",
  },
  {
    name: "Jon Basildon",
    role: "Developer",
    bio: "Member of Laravel Company Organization",
    avatar: "https://avatars.githubusercontent.com/u/145971646?s=96&v=4",
    github: "jonbasildon",
  },
  {
    name: "andreim",
    role: "Marketing",
    bio: "Member of Laravel Company Organization",
    avatar: "https://avatars.githubusercontent.com/u/13685130?s=96&v=4",
    github: "marmureanuweb",
  },
  {
    name: "Marian P",
    role: "Developer",
    bio: "Member of Laravel Company Organization",
    avatar: "https://avatars.githubusercontent.com/u/8106610?s=96&v=4",
    github: "popiciulo",
  },
  {
    name: "Syed Hammad Ahmed",
    role: "Developer",
    bio: "Member of Laravel Company Organization",
    avatar: "https://avatars.githubusercontent.com/u/8712631?s=96&v=4",
    github: "shammadahmed",
  },
];

const values = [
  {
    title: "Innovation Through Automation",
    description:
      "We leverage cutting-edge automation technologies to build software solutions that work smarter, not harder, saving time and resources.",
    icon: "ph:robot-duotone",
  },
  {
    title: "Laravel Expertise",
    description:
      "Deep specialization in Laravel framework enables us to deliver robust, scalable, and maintainable web applications quickly and efficiently.",
    icon: "ph:code-duotone",
  },
  {
    title: "Client-Focused Solutions",
    description:
      "Every project is tailored to meet specific business needs, ensuring our software solutions directly contribute to your success and growth.",
    icon: "ph:users-duotone",
  },
  {
    title: "Quality & Reliability",
    description:
      "We maintain the highest standards in code quality, security, and performance to deliver software solutions you can depend on.",
    icon: "ph:shield-check-duotone",
  },
];

const esopInfo = {
  title: "Employee Stock Ownership Plan",
  description: "We believe in sharing success with our team. Our ESOP represents our commitment to long-term growth and talent retention.",
  points: [
    "Attract and retain top tech talent with competitive ownership benefits",
    "Align employee interests with company growth and long-term success",
    "Broad-based approach - open to all team members",
    "Transparent financial reporting and regular valuations",
  ],
};

const timeline = [
  {
    year: "2019",
    title: "Company Founded",
    description:
      "Laravel Company established with a vision to provide modern software development services with automation at the core.",
  },
  {
    year: "2020",
    title: "Laravel Ecommerce Launch",
    description:
      "Released our flagship Laravel Ecommerce platform, helping businesses build powerful online stores with advanced features.",
  },
  {
    year: "2022",
    title: "Laravel Mail Integration",
    description:
      "Developed Laravel Mail solution for seamless email automation and marketing campaigns integrated with web applications.",
  },
  {
    year: "2024",
    title: "Laravel GPT Revolution",
    description:
      "Pioneered Laravel GPT integration, bringing AI-powered features and automation to web applications and business processes.",
  },
];
---

<Layout
  title="About Laravel Company | Our Team & Mission"
  description="Meet Laravel Company: our mission, team and approach to building software with Laravel Ecommerce, Laravel Mail and Laravel GPT."
>
  <section class="pt-20 pb-16 md:pt-28 md:pb-24">
    <div class="container-custom">
      <nav class="flex justify-center items-center gap-2 text-sm text-white/50 mb-8 animate-on-scroll">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <span class="text-white">About Us</span>
      </nav>
      <div class="text-center max-w-3xl mx-auto animate-on-scroll">
        <h1 class="text-4xl md:text-5xl font-bold leading-tight">
          About <span class="gradient-text">Laravel Company</span>
        </h1>
        <p class="mt-6 text-xl text-white/70">
          We help businesses transform through modern software development
          services, automation solutions, and cutting-edge Laravel applications.
        </p>
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto animate-on-scroll">
        <h2 class="text-3xl md:text-4xl font-bold">Our Values</h2>
        <p class="mt-4 text-xl text-white/70">
          The principles that drive our software development approach.
        </p>
      </div>

      <div class="mt-16 grid grid-cols-1 md:grid-cols-2 gap-8">
        {
          values.map((value, index) => (
            <div
              class="glass-card animate-on-scroll"
              style={`animation-delay: ${index * 0.1}s`}
            >
              <h3 class="text-xl font-semibold text-white">{value.title}</h3>
              <p class="mt-3 text-white/70">{value.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto animate-on-scroll">
        <h2 class="text-3xl md:text-4xl font-bold">Our ESOP</h2>
        <p class="mt-4 text-xl text-white/70">
          {esopInfo.description}
        </p>
      </div>

      <div class="mt-12 max-w-4xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {esopInfo.points.map((point, index) => (
            <div class="glass-card p-6 animate-on-scroll" style={`animation-delay: ${index * 0.1}s`}>
              <div class="flex items-start gap-3">
                <div class="w-6 h-6 rounded-full bg-payflo-purple/20 flex items-center justify-center flex-shrink-0 mt-0.5">
                  <Icon name="ph:check" class="w-4 h-4 text-payflo-purple" />
                </div>
                <span class="text-white/80">{point}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>



  <section class="py-20">
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto animate-on-scroll">
        <h2 class="text-3xl md:text-4xl font-bold">Our Journey</h2>
      </div>

      <div class="mt-12 max-w-4xl mx-auto">
        <div class="relative">
          {
            timeline.map((event, index) => (
              <div
                class="relative pl-8 pb-12 animate-on-scroll"
                style={`animation-delay: ${index * 0.15}s`}
              >
                <div class="absolute left-0 top-0 h-full w-px bg-gradient-to-b from-payflo-purple to-payflo-blue" />
                <div class="absolute left-[-4px] top-2 h-2 w-2 rounded-full bg-payflo-purple" />
                <div class="text-sm font-semibold text-payflo-purple">
                  {event.year}
                </div>
                <h3 class="mt-2 text-xl font-semibold text-white">
                  {event.title}
                </h3>
                <p class="mt-2 text-white/70">{event.description}</p>
              </div>
            ))
          }
        </div>
        <div class="mt-12 text-center">
          <p class="text-xl font-medium text-white/80">
            From custom software development to innovative Laravel solutions,
            we're building the automated future of web applications with Laravel
            Ecommerce, Laravel Mail, and Laravel GPT.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section
    class="py-20 bg-gradient-to-r from-payflo-purple to-payflo-blue text-white relative overflow-hidden"
  >
    <div class="absolute inset-0 bg-[url('/grid-pattern.svg')] opacity-10">
    </div>
    <div class="container-custom relative">
      <div class="max-w-3xl mx-auto text-center animate-on-scroll">
        <span
          class="inline-block px-4 py-1 bg-white/10 rounded-full text-sm font-medium mb-6"
        >
          Ready to Build?
        </span>
        <h2 class="text-3xl md:text-4xl font-bold">Start Your Project Today</h2>
        <p class="mt-6 text-xl opacity-90">
          Let's discuss how our <b>software development services</b> and Laravel solutions
          can transform your business with automation and innovation.
        </p>
        <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/contact/"
            class="btn bg-white text-payflo-purple hover:bg-opacity-90"
          >
            Get Started
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
