---
import Layout from "../layouts/Layout.astro";
import CTASection from "../components/CTASection.astro";
import { Icon } from "astro-icon/components";

const benefits = [
  {
    title: "Global Talent Pool",
    desc: "Access top Laravel developers from 30+ countries, not limited by geography.",
    icon: "ph:globe-duotone"
  },
  {
    title: "Async Workflows",
    desc: "Documentation-first culture, async communication, and recorded standups for any timezone.",
    icon: "ph:clock-countdown-duotone"
  },
  {
    title: "Cost Flexibility",
    desc: "Choose from $25/hr (Latin America/EE) to $100/hr (US/UK) based on your budget.",
    icon: "ph:currency-circle-dollar-duotone"
  },
  {
    title: "Instant Scaling",
    desc: "Add or remove developers in 24h. No office space, no payroll, no hassle.",
    icon: "ph:user-switch-duotone"
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      "name": "How do you manage remote Laravel developers?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We use async workflows with daily standups via Slack/Discord, Jira/Trello for task tracking, and weekly video demos. All code is reviewed, tested, and documented regardless of timezone."
      }
    },
    {
      "@type": "Question",
      "name": "Which timezone is best for remote hiring?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "For US companies: Latin America (same-day overlap). For UK/Western Europe: Eastern Europe (4-6h overlap). For APAC: Southeast Asia (same-day overlap). We match talent to your timezone."
      }
    },
    {
      "@type": "Question",
      "name": "How much do remote Laravel developers cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Remote hiring ranges from $25/hr (Latin America/Eastern Europe) to $100/hr (US/UK). Dedicated full-time remote developers cost $3,000-$8,000/month depending on location and seniority."
      }
    },
    {
      "@type": "Question",
      "name": "Can remote developers integrate with our in-house team?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Absolutely. We use your tools (Slack, Jira, GitLab), follow your workflows, and join your daily standups. We adapt to your culture, not the other way around."
      }
    }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Hire Laravel Developer Remote",
  "provider": {
    "@type": "Organization",
    "name": "Laravel Company",
    "url": "https://laravelcompany.com"
  },
  "description": "Hire remote Laravel developers globally. $25-$100/hour, async workflows, instant scaling. 24h deployment.",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Remote Hiring",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Remote Hourly Developer" }, "price": "25", "priceCurrency": "USD" },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Dedicated Remote Team" }, "price": "3000", "priceCurrency": "USD" }
    ]
  }
};
---

<Layout
  title="Hire Laravel Developer Remote | Global Talent $25/hr"
  description="Hire remote Laravel developers globally. $25-$100/hour, async workflows, instant scaling. 24h deployment, 50+ developers available."
>
  <main id="main-content">
    <!-- Hero -->
    <section class="pt-24 pb-20 md:pt-32 md:pb-28 overflow-hidden relative bg-payflo-dark">
      <div class="absolute inset-0 opacity-10 -z-10">
        <div class="absolute top-0 left-0 w-full h-full bg-[radial-gradient(circle_at_50%_120%,rgba(120,119,198,0.3),rgba(255,255,255,0))]"></div>
      </div>
      <div class="container-custom relative">
        <nav class="flex justify-center items-center gap-2 text-sm text-white/50 mb-8 animate-on-scroll">
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <span>/</span>
          <a href="/laravel-services/" class="hover:text-white transition-colors">Services</a>
          <span>/</span>
          <span class="text-white">Hire Remote Developer</span>
        </nav>
        <div class="max-w-4xl mx-auto text-center">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-payflo-purple/10 border border-payflo-purple/20 mb-8 animate-on-scroll">
            <Icon name="ph:wifi-high-duotone" class="w-5 h-5 text-payflo-purple" />
            <span class="text-sm font-bold uppercase tracking-widest text-white/70">Remote Hiring</span>
          </div>
          <h1 class="text-5xl md:text-7xl lg:text-8xl font-black leading-tight tracking-tight text-white">
            Hire <span class="gradient-text">Remote Laravel Developer</span>
          </h1>
          <p class="animate-on-scroll delay-2 mt-8 text-xl md:text-2xl text-white/70 leading-relaxed font-medium">
            Global talent pool, $25-$100/hour, async workflows, instant scaling. Deploy in 24 hours.
          </p>
          <div class="animate-on-scroll delay-3 mt-12 flex flex-wrap justify-center gap-6">
            <a href="/contact/" class="btn btn-primary px-10 py-5 text-lg shadow-2xl">Hire Remote Dev</a>
            <a href="/hire-laravel-developer/" class="btn glass-card border-white/20 px-10 py-5 text-lg hover:bg-white/10 transition-all font-bold">All Hiring Models →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Benefits -->
    <section class="py-24">
      <div class="container-custom">
        <div class="text-center max-w-3xl mx-auto mb-20 animate-on-scroll">
          <h2 class="text-4xl md:text-5xl font-black mb-6">Remote <span class="gradient-text">Benefits</span></h2>
          <p class="text-gray-400 text-lg">Global talent, flexible costs, and instant scaling without borders.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
          {benefits.map((b, i) => (
            <div class="animate-on-scroll delay-{i} glass-card p-10 border-white/10 group hover:border-payflo-purple/50 transition-colors">
              <Icon name={b.icon} class="w-12 h-12 text-payflo-purple mb-6 group-hover:scale-110 transition-transform" />
              <h3 class="text-2xl font-black mb-4 text-white">{b.title}</h3>
              <p class="text-gray-400 text-sm leading-relaxed">{b.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Remote Regions -->
    <section class="py-24 bg-white/5">
      <div class="container-custom max-w-4xl mx-auto">
        <h2 class="text-4xl font-black text-center mb-16">Remote <span class="gradient-text">Regions</span></h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10 text-center">
            <h4 class="text-lg font-bold text-white mb-2">Eastern Europe</h4>
            <p class="text-payflo-purple font-bold text-sm">$25-$75/hr</p>
            <p class="text-gray-400 text-xs mt-2">Romania, Poland, Ukraine</p>
          </div>
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10 text-center">
            <h4 class="text-lg font-bold text-white mb-2">Latin America</h4>
            <p class="text-payflo-purple font-bold text-sm">$30-$80/hr</p>
            <p class="text-gray-400 text-xs mt-2">Brazil, Mexico, Argentina</p>
          </div>
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10 text-center">
            <h4 class="text-lg font-bold text-white mb-2">South/Southeast Asia</h4>
            <p class="text-payflo-purple font-bold text-sm">$20-$60/hr</p>
            <p class="text-gray-400 text-xs mt-2">India, Philippines, Vietnam</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Async Workflow -->
    <section class="py-24">
      <div class="container-custom max-w-4xl mx-auto">
        <h2 class="text-4xl font-black text-center mb-16">Async <span class="gradient-text">Workflow</span></h2>
        <div class="space-y-8">
          <div class="flex gap-6 items-start">
            <div class="w-12 h-12 bg-payflo-purple/10 rounded-xl flex items-center justify-center flex-shrink-0 border border-payflo-purple/20">
              <span class="font-black text-payflo-purple">1</span>
            </div>
            <div>
              <h4 class="text-lg font-bold text-white mb-2">Daily Standups (Async)</h4>
              <p class="text-gray-400 text-sm">Recorded Loom videos or Slack updates. No meeting fatigue, visible to all timezones.</p>
            </div>
          </div>
          <div class="flex gap-6 items-start">
            <div class="w-12 h-12 bg-payflo-purple/10 rounded-xl flex items-center justify-center flex-shrink-0 border border-payflo-purple/20">
              <span class="font-black text-payflo-purple">2</span>
            </div>
            <div>
              <h4 class="text-lg font-bold text-white mb-2">Documentation-First</h4>
              <p class="text-gray-400 text-sm">Every feature includes documentation, architecture decisions, and API specs before coding.</p>
            </div>
          </div>
          <div class="flex gap-6 items-start">
            <div class="w-12 h-12 bg-payflo-purple/10 rounded-xl flex items-center justify-center flex-shrink-0 border border-payflo-purple/20">
              <span class="font-black text-payflo-purple">3</span>
            </div>
            <div>
              <h4 class="text-lg font-bold text-white mb-2">Weekly Video Demos</h4>
              <p class="text-gray-400 text-sm">Recorded demos at the end of each sprint. You watch when convenient, leave comments.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-24 bg-white/5">
      <div class="container-custom max-w-4xl mx-auto">
        <h2 class="text-4xl font-black text-center mb-16">Remote <span class="gradient-text">FAQ</span></h2>
        <div class="space-y-6">
          <div class="p-8 glass-card border-white/10">
            <h4 class="text-lg font-bold mb-3 text-white">How do you manage remote Laravel developers?</h4>
            <p class="text-gray-400">We use async workflows with daily standups via Slack/Discord, Jira/Trello for task tracking, and weekly video demos. All code is reviewed, tested, and documented regardless of timezone.</p>
          </div>
          <div class="p-8 glass-card border-white/10">
            <h4 class="text-lg font-bold mb-3 text-white">Which timezone is best for remote hiring?</h4>
            <p class="text-gray-400">For US companies: Latin America (same-day overlap). For UK/Western Europe: Eastern Europe (4-6h overlap). For APAC: Southeast Asia (same-day overlap). We match talent to your timezone.</p>
          </div>
          <div class="p-8 glass-card border-white/10">
            <h4 class="text-lg font-bold mb-3 text-white">How much do remote Laravel developers cost?</h4>
            <p class="text-gray-400">Remote hiring ranges from $25/hr (Latin America/Eastern Europe) to $100/hr (US/UK). Dedicated full-time remote developers cost $3,000-$8,000/month depending on location and seniority.</p>
          </div>
        </div>
      </div>
    </section>

    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

    <!-- Internal Links -->
    <section class="py-16 border-t border-white/5">
      <div class="container-custom">
        <div class="flex flex-wrap justify-center gap-6 text-sm">
          <a href="/" class="text-payflo-purple hover:underline font-bold">Laravel Development Company →</a>
          <a href="/hire-laravel-developer/" class="text-payflo-purple hover:underline font-bold">All Hiring Models →</a>
          <a href="/laravel-developers-romania/" class="text-payflo-purple hover:underline font-bold">Romania Team →</a>
          <a href="/nearshore-laravel-development/" class="text-payflo-purple hover:underline font-bold">Nearshore →</a>
        </div>
      </div>
    </section>

    <CTASection />
  </main>
</Layout>

<style>
  .btn { @apply inline-flex items-center justify-center font-black transition-all duration-300 rounded-2xl; }
  .btn-primary { @apply bg-gradient-to-r from-payflo-purple to-payflo-pink text-white shadow-xl shadow-purple-600/30 hover:shadow-purple-600/50 hover:-translate-y-1; }
  .glass-card { @apply bg-white/5 backdrop-blur-xl border border-white/10 rounded-3xl shadow-2xl; }
  .gradient-text { @apply bg-clip-text text-transparent bg-gradient-to-r from-payflo-purple to-payflo-pink; }
</style>
