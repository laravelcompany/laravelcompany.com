---
import Layout from '../../layouts/Layout.astro';
import { FAQ_QUESTIONS } from '../../data/faq-questions';

export function getStaticPaths() {
  return FAQ_QUESTIONS.map((q) => ({
    params: { slug: q.slug },
    props: { question: q },
  }));
}

export const prerender = true;

const { question } = Astro.props;
const { slug } = Astro.params;

const siteUrl = "https://laravelcompany.com";
const pageUrl = `${siteUrl}/faq/${slug}/`;
const pageTitle = `${question.question} | Laravel Company`;
const pageDescription = `Find the answer to "${question.question}" and learn more about Laravel development, PHP, and modern web technologies at Laravel Company.`;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": question.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": question.answer || "This page will be updated with a detailed answer soon."
      }
    }
  ]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": question.question, "item": pageUrl }
  ]
};
---

<Layout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <div class="max-w-3xl mx-auto px-4 py-16">
    <nav aria-label="Breadcrumb" class="mb-8 text-sm text-gray-400">
      <ol class="list-none p-0 flex flex-wrap items-center gap-1">
        <li>
          <a href="/" class="hover:text-payflo-purple transition-colors">Home</a>
        </li>
        <li aria-hidden="true" class="mx-1">/</li>
        <li class="text-white" aria-current="page">{question.question}</li>
      </ol>
    </nav>

    <h1 class="text-3xl md:text-4xl font-bold text-white mb-6">{question.question}</h1>

    <div class="prose prose-invert max-w-none">
      <p class="text-lg text-gray-400">
        {question.answer || "This page will be updated with a detailed answer soon."}
      </p>
    </div>

    <hr class="my-12 border-gray-800" />

    <div class="text-center">
      <p class="text-gray-400 mb-4">Looking for Laravel development services?</p>
      <a
        href="/"
        class="inline-block bg-payflo-purple hover:bg-purple-600 text-white font-semibold px-6 py-3 rounded-lg transition-colors"
      >
        Laravel Development Company
      </a>
    </div>
  </div>
</Layout>
