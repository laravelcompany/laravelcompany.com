									<div class="text-center text-white/90">
										<Icon name="ph:envelope-simple-duotone" class="w-20 h-20 mx-auto mb-4 opacity-80" />
										<span class="text-xl font-bold">Laravel Mail</span>
									</div>
								</div>
							</div>
						</div>
						<div class="lg:col-span-7">
							<div class="flex items-center gap-3 mb-4">
								<div class="h-10 w-10 rounded-xl bg-gradient-to-br from-violet-600 to-violet-800 flex items-center justify-center">
