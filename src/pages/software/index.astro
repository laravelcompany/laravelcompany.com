								</div>
							</div>
							
							<div class="flex flex-wrap items-center gap-4">
								<a href="/software/laravel-ui/" class="btn btn-primary inline-flex items-center gap-2">
									Learn More
									<Icon name="ph:arrow-right" class="w-5 h-5" />
								</a>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- Leads Captain -->
			<div class="animate-on-scroll delay-400 mb-16 group">
				<div class="glass-card p-8 md:p-10 hover:border-emerald-500/30 transition-all duration-500">
					<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
						<div class="lg:col-span-5">
							<div class="relative">
								<div class="absolute inset-0 bg-gradient-to-br from-emerald-600 to-emerald-800 rounded-2xl blur-xl opacity-30 group-hover:opacity-50 transition-opacity"></div>
								<div class="relative h-64 bg-gradient-to-br from-emerald-600 to-emerald-800 rounded-2xl flex items-center justify-center">
									<div class="text-center text-white/90">
										<Icon name="ph:flag-banner-duotone" class="w-20 h-20 mx-auto mb-4 opacity-80" />
										<span class="text-xl font-bold">Leads Captain</span>
									</div>
								</div>
							</div>
						</div>
