---
import Layout from "../../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
---

<Layout
	title="Developer Tools & Business Solutions | Laravel Software"
	description="Self-hosted Laravel software products for developers and businesses. Laravel Mail, SEO toolkit, GPT AI platform, and more. Full control, no SaaS lock-in."
>
	<!-- SoftwareApplication Collection Schema -->
	<script type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@type": "ItemList",
			"name": "Laravel Software Products",
			"description": "Self-hosted Laravel software platforms for developers and businesses. Buy-to-own solutions with full control and no SaaS lock-in.",
			"url": "https://laravelcompany.com/software",
			"numberOfItems": 6,
			"itemListOrder": "https://schema.org/ItemListOrderDescending",
			"itemListElement": [
				{
					"@type": "ListItem",
					"position": 1,
					"item": {
						"@type": "SoftwareApplication",
						"name": "Laravel Mail",
						"url": "https://laravelcompany.com/software/laravel-mail",
						"applicationCategory": "BusinessApplication"
					}
				},
				{
					"@type": "ListItem",
					"position": 2,
					"item": {
						"@type": "SoftwareApplication",
						"name": "Laravel SEO",
						"url": "https://laravelcompany.com/software/laravel-seo",
						"applicationCategory": "BusinessApplication"
					}
				},
				{
					"@type": "ListItem",
					"position": 3,
					"item": {
						"@type": "SoftwareApplication",
						"name": "Laravel GPT",
						"url": "https://laravelcompany.com/software/laravel-gpt",
						"applicationCategory": "BusinessApplication"
					}
				},
				{
					"@type": "ListItem",
					"position": 4,
					"item": {
						"@type": "SoftwareApplication",
						"name": "Laravel UI",
						"url": "https://laravelcompany.com/software/laravel-ui",
						"applicationCategory": "DeveloperApplication"
					}
				},
				{
					"@type": "ListItem",
					"position": 5,
					"item": {
						"@type": "SoftwareApplication",
						"name": "Leads Captain",
						"url": "https://laravelcompany.com/software/leads-captain",
						"applicationCategory": "BusinessApplication"
					}
				},
				{
					"@type": "ListItem",
					"position": 6,
					"item": {
						"@type": "SoftwareApplication",
						"name": "Laravel Social",
						"url": "https://laravelcompany.com/software/laravel-social",
						"applicationCategory": "BusinessApplication"
					}
				}
			]
		}
	</script>
	<!-- Breadcrumb Schema -->
	<script type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@type": "BreadcrumbList",
			"itemListElement": [
				{
					"@type": "ListItem",
					"position": 1,
					"name": "Home",
					"item": "https://laravelcompany.com/"
				},
				{
					"@type": "ListItem",
					"position": 2,
					"name": "Software",
					"item": "https://laravelcompany.com/software"
				}
			]
		}
	</script>
	<!-- CTA Event Tracking -->
	<script is:inline>
		document.addEventListener('astro:page-load', function() {
			const ctaButtons = document.querySelectorAll('a[href*="/contact"], a[href*="/software/laravel-"], a[href*="laravelmail.com"], a[href*="laravelseo.com"], a[href*="laravelgpt.com"], a[href*="laravelsocial.com"]');
			
			ctaButtons.forEach(function(button) {
				button.addEventListener('click', function(e) {
					let ctaType = 'general_cta';
					const href = this.getAttribute('href');
					
					if (href.includes('laravel-mail') || href.includes('laravelmail.com')) {
						ctaType = 'laravel_mail_cta';
					} else if (href.includes('laravel-seo') || href.includes('laravelseo.com')) {
						ctaType = 'laravel_seo_cta';
					} else if (href.includes('laravel-gpt') || href.includes('laravelgpt.com')) {
						ctaType = 'laravel_gpt_cta';
					} else if (href.includes('laravel-social') || href.includes('laravelsocial.com')) {
						ctaType = 'laravel_social_cta';
					} else if (href.includes('/contact')) {
						ctaType = 'contact_cta';
					}
					
					if (typeof gtag !== 'undefined') {
						gtag('event', 'software_click', {
							software: ctaType,
							location: 'software_page'
						});
					}
					
				});
			});
		});
	</script>

	<!-- Hero Section -->
	<section class="pt-32 pb-20 relative overflow-hidden">
		<div class="absolute top-20 left-1/4 w-[500px] h-[500px] bg-payflo-purple/20 blur-[150px] rounded-full -z-10"></div>
		<div class="absolute bottom-20 right-1/4 w-[400px] h-[400px] bg-payflo-pink/15 blur-[120px] rounded-full -z-10"></div>
		<div class="absolute top-40 right-1/3 w-[300px] h-[300px] bg-payflo-blue/10 blur-[100px] rounded-full -z-10"></div>
		
		<div class="container-custom relative">
			<nav class="flex justify-center items-center gap-2 text-sm text-white/50 mb-8 animate-on-scroll">
				<a href="/" class="hover:text-white transition-colors">Home</a>
				<span>/</span>
				<span class="text-white">Software</span>
			</nav>
			<div class="text-center max-w-4xl mx-auto">
				<div class="animate-on-scroll inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/5 border border-white/10 backdrop-blur-sm mb-8">
					<Icon name="ph:package-duotone" class="w-5 h-5 text-payflo-purple" />
					<span class="text-sm font-semibold text-white/80">Premium Laravel Solutions</span>
				</div>
				
				<h1 class="animate-on-scroll delay-1 text-4xl md:text-5xl lg:text-6xl font-black text-white leading-tight mb-6">
					Powerful <span class="gradient-text">Software</span> for Modern Businesses
				</h1>
				
				<p class="animate-on-scroll delay-2 text-xl md:text-2xl text-white/70 leading-relaxed font-medium max-w-3xl mx-auto mb-10">
					Self-hosted Laravel packages that give you complete control. No subscriptions, no SaaS lock-in. 
					One-time purchase, lifetime access.
				</p>
				
				<div class="animate-on-scroll delay-3 flex flex-wrap justify-center gap-8 text-sm text-white/60 font-bold uppercase tracking-widest">
					<span class="flex items-center gap-2">
						<Icon name="ph:check-circle-duotone" class="w-5 h-5 text-emerald-400" />
						One-Time Purchase
					</span>
					<span class="flex items-center gap-2">
						<Icon name="ph:check-circle-duotone" class="w-5 h-5 text-emerald-400" />
						Lifetime Updates
					</span>
					<span class="flex items-center gap-2">
						<Icon name="ph:check-circle-duotone" class="w-5 h-5 text-emerald-400" />
						Priority Support
					</span>
				</div>
			</div>
		</div>
	</section>

	<!-- Software Products Grid -->
	<section class="pb-32 relative overflow-hidden">
		<div class="container-custom">
			<!-- Laravel Mail -->
			<div class="animate-on-scroll delay-0 mb-16 group">
				<div class="glass-card p-8 md:p-10 hover:border-payflo-purple/30 transition-all duration-500">
					<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
