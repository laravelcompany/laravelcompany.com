							</div>
						</div>
						<div class="lg:col-span-7 lg:order-1">
							<div class="flex items-center gap-3 mb-4">
								<div class="h-10 w-10 rounded-xl bg-gradient-to-br from-blue-600 to-blue-800 flex items-center justify-center">
