---
import Layout from "../../layouts/Layout.astro";
import Logo from "../../assets/logos/leads-captain.png";
import { Image } from "astro:assets";
---

<Layout title="Leads Captain - Professional Leads Management Solution">
    <main>
        <!-- Hero Section -->
        <section class="pt-20 pb-16 md:pt-28 md:pb-24 overflow-hidden">
            <div class="container-custom">
                <div
                    class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center"
                >
                    <div>
                        <h1
                            class="animate-on-scroll delay-0 text-4xl md:text-5xl lg:text-6xl font-bold leading-tight"
                        >
                            Master Your Pipeline with <br /><span
                                class="gradient-text">Leads Captain</span
                            >
                        </h1>
                        <p
                            class="animate-on-scroll delay-1 mt-6 text-xl text-gray-400 max-w-lg"
                        >
                            A powerful, <b>self-hosted</b> leads management solution
                            designed for high-growth teams. Capture, track, and convert
                            leads with automated workflows and intelligent scoring.
                        </p>
                        <div class="animate-on-scroll delay-2 mt-8 flex gap-4">
                            <a href="/contact" class="btn btn-primary"
                                >Get Started</a
                            >
                            <a href="#features" class="btn btn-secondary"
                                >Explore Features</a
                            >
                        </div>
                    </div>
                    <div class="animate-on-scroll delay-3">
                        <div class="relative">
                            <div
                                class="absolute -inset-0.5 bg-gradient-to-r from-cyan-500 to-blue-500 rounded-xl blur opacity-30"
                            >
                            </div>
                            <div
                                class="relative bg-white/10 rounded-xl shadow-xl overflow-hidden p-8"
                            >
                                <Image
                                    src={Logo}
                                    alt="Leads Captain Logo"
                                    class="w-full h-auto mb-6 rounded-lg shadow-inner"
                                />
                                <div class="space-y-6">
                                    <div class="flex items-center gap-4">
                                        <div
                                            class="w-12 h-12 bg-cyan-900/20 rounded-lg flex items-center justify-center"
                                        >
                                            <svg
                                                class="w-6 h-6 text-cyan-400"
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                xmlns="http://www.w3.org/2000/svg"
                                            >
                                                <path
                                                    d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"
                                                    stroke="currentColor"
                                                    stroke-width="2"
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                ></path>
                                                <circle
                                                    cx="9"
                                                    cy="7"
                                                    r="4"
                                                    stroke="currentColor"
                                                    stroke-width="2"
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                ></circle>
                                                <path
                                                    d="M23 21v-2a4 4 0 00-3-3.87m-4-12a4 4 0 010 7.75"
                                                    stroke="currentColor"
                                                    stroke-width="2"
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                ></path>
                                            </svg>
                                        </div>
                                        <div>
                                            <h3
                                                class="font-semibold text-white"
                                            >
                                                Lead Tracking
                                            </h3>
                                            <p class="text-gray-400">
                                                Consolidated view of all your
                                                prospects
                                            </p>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-4">
                                        <div
                                            class="w-12 h-12 bg-blue-900/20 rounded-lg flex items-center justify-center"
                                        >
                                            <svg
                                                class="w-6 h-6 text-blue-400"
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                xmlns="http://www.w3.org/2000/svg"
                                            >
                                                <path
                                                    d="M13 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V9z"
                                                    stroke="currentColor"
                                                    stroke-width="2"
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                ></path>
                                                <polyline
                                                    points="13 2 13 9 20 9"
                                                    stroke="currentColor"
                                                    stroke-width="2"
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                ></polyline>
                                            </svg>
                                        </div>
                                        <div>
                                            <h3
                                                class="font-semibold text-white"
                                            >
                                                Automated Follow-ups
                                            </h3>
                                            <p class="text-gray-400">
                                                Never miss a lead with smart
                                                triggers
                                            </p>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-4">
                                        <div
                                            class="w-12 h-12 bg-cyan-900/20 rounded-lg flex items-center justify-center"
                                        >
                                            <svg
                                                class="w-6 h-6 text-cyan-400"
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                xmlns="http://www.w3.org/2000/svg"
                                            >
                                                <path
                                                    d="M21.21 15.89A10 10 0 118 2.83"
                                                    stroke="currentColor"
                                                    stroke-width="2"
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                ></path>
                                                <path
                                                    d="M22 12A10 10 0 0012 2v10z"
                                                    stroke="currentColor"
                                                    stroke-width="2"
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                ></path>
                                            </svg>
                                        </div>
                                        <div>
                                            <h3
                                                class="font-semibold text-white"
                                            >
                                                Advanced Analytics
                                            </h3>
                                            <p class="text-gray-400">
                                                Real-time conversion data and
                                                ROI
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Features Section -->
        <section id="features" class="section bg-white/5">
            <div class="container-custom">
                <h2
                    class="animate-on-scroll delay-0 text-3xl md:text-4xl font-bold text-center mb-12"
                >
                    Why Choose <span class="gradient-text">Leads Captain</span>?
                </h2>

                <div class="space-y-8">
                    <div class="animate-on-scroll delay-1 feature-card">
                        <h3 class="text-xl font-semibold mb-3">
                            Unified Lead Capture
                        </h3>
                        <p class="text-gray-400">
                            Connect all your lead sources — from website forms
                            and social media to cold outreach and advertising.
                            Leads Captain centralizes everything in one
                            intuitive dashboard, giving your sales team a single
                            source of truth.
                        </p>
                    </div>

                    <div class="animate-on-scroll delay-2 feature-card">
                        <h3 class="text-xl font-semibold mb-3">
                            Intelligent Lead Scoring
                        </h3>
                        <p class="text-gray-400">
                            Automatically qualify and rank leads based on their
                            interactions, demographic data, and custom criteria.
                            Focus your team's energy where it matters most: on
                            the highest-potential prospects.
                        </p>
                    </div>

                    <div class="animate-on-scroll delay-3 feature-card">
                        <h3 class="text-xl font-semibold mb-3">
                            Customizable Sales Pipelines
                        </h3>
                        <p class="text-gray-400">
                            Design your sales process to match how you actually
                            work. Create multiple pipelines, drag-and-drop leads
                            between stages, and visualize your entire sales
                            funnel with clarity.
                        </p>
                    </div>

                    <div class="animate-on-scroll delay-4 feature-card">
                        <h3 class="text-xl font-semibold mb-3">
                            Seamless CRM & API Integrations
                        </h3>
                        <p class="text-gray-400">
                            Sync data effortlessly with your existing tools.
                            Whether it's Salesforce, HubSpot, or a custom
                            internal system, Leads Captain plays well with
                            others via a robust API and native integrations.
                        </p>
                    </div>

                    <div class="animate-on-scroll delay-5 feature-card">
                        <h3 class="text-xl font-semibold mb-3">
                            Data Privacy & Sovereignty
                        </h3>
                        <p class="text-gray-400">
                            As a self-hosted solution, you keep 100% control
                            over your sensitive prospect data. Comply with GDPR,
                            CCPA, and other regulations without relying on
                            third-party cloud providers.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Under the Hood Section -->
        <section class="section bg-white/10">
            <div class="container-custom">
                <h2
                    class="animate-on-scroll delay-0 text-3xl md:text-4xl font-bold text-center mb-16"
                >
                    Built for <span class="gradient-text">Performance</span>
                </h2>

                <div
                    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
                >
                    <div
                        class="animate-on-scroll delay-1 feature-card hover:shadow-xl transition-shadow duration-300"
                    >
                        <h3 class="text-lg font-semibold mb-2">
                            Self-Hosted Control
                        </h3>
                        <p class="text-gray-400">
                            Deploy on your own infrastructure for maximum
                            security, speed, and data ownership.
                        </p>
                    </div>

                    <div
                        class="animate-on-scroll delay-2 feature-card hover:shadow-xl transition-shadow duration-300"
                    >
                        <h3 class="text-lg font-semibold mb-2">
                            Automation Engine
                        </h3>
                        <p class="text-gray-400">
                            Powerful event-based triggers that automate
                            follow-ups, assignments, and status updates.
                        </p>
                    </div>

                    <div
                        class="animate-on-scroll delay-3 feature-card hover:shadow-xl transition-shadow duration-300"
                    >
                        <h3 class="text-lg font-semibold mb-2">
                            Scalable Architecture
                        </h3>
                        <p class="text-gray-400">
                            Handles thousands of incoming leads per day without
                            breaking a sweat, built on a robust Laravel
                            foundation.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Call to Action -->
        <section class="py-20 bg-gradient-to-r from-blue-900/40 to-cyan-900/40">
            <div class="container-custom text-center">
                <h2 class="text-3xl md:text-5xl font-bold mb-8">
                    Ready to Take Command?
                </h2>
                <p class="text-xl text-gray-300 max-w-2xl mx-auto mb-10">
                    Join the high-performing teams using Leads Captain to
                    streamline their sales and accelerate growth.
                </p>
                <a href="/contact" class="btn btn-primary btn-lg"
                    >Schedule a Demo</a
                >
            </div>
        </section>
    </main>
</Layout>
