---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Laravel SEO Platform | Automated SEO & Rank Tracking for Laravel">
	<main>
		<!-- Hero Section -->
		<section class="pt-20 pb-16 md:pt-28 md:pb-24 overflow-hidden">
			<div class="container-custom">
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
					<div>
						<h1 class="animate-on-scroll delay-0 text-4xl md:text-5xl lg:text-6xl font-bold leading-tight">
							Optimize Your Entire SEO Workflow with <span class="gradient-text">Laravel SEO</span>
						</h1>
						<p class="animate-on-scroll delay-1 mt-6 text-xl text-gray-600 max-w-lg">
							A fully **self-hosted**, Laravel-native SEO automation & monitoring platform. Track rankings, audit your site, monitor backlinks, analyze competitors, and optimize metadata — all directly inside Laravel.
						</p>
						<div class="animate-on-scroll delay-2 mt-8">
							<a href="#features" class="btn btn-primary">Explore Features</a>
						</div>
					</div>

					<div class="animate-on-scroll delay-3">
						<div class="relative">
							<div class="absolute -inset-0.5 bg-gradient-to-r from-indigo-500 to-blue-500 rounded-xl blur opacity-30"></div>
							<div class="relative bg-white rounded-xl shadow-xl overflow-hidden p-8">
								<img src="https://laravelseo.com/logo.svg" title="Laravel SEO Logo" />
								<div class="space-y-6">

									<div class="flex items-center gap-4">
										<div class="w-12 h-12 bg-indigo-100 rounded-lg flex items-center justify-center">
											<svg class="w-6 h-6 text-indigo-600" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3 12h18M12 3v18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
										</div>
										<div>
											<h3 class="font-semibold text-gray-900">Rank Tracking</h3>
											<p class="text-gray-600">Daily keyword ranking updates, SERP snapshots, competitors, and volatility alerts.</p>
										</div>
									</div>

									<div class="flex items-center gap-4">
										<div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center">
											<svg class="w-6 h-6 text-blue-600" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/><path d="M12 7v5l3 3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
										</div>
										<div>
											<h3 class="font-semibold text-gray-900">SEO Audits</h3>
											<p class="text-gray-600">Crawling, technical health checks, Core Web Vitals, metadata scoring and more.</p>
										</div>
									</div>

									<div class="flex items-center gap-4">
										<div class="w-12 h-12 bg-indigo-100 rounded-lg flex items-center justify-center">
											<svg class="w-6 h-6 text-indigo-600" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 4h16v16H4z" stroke="currentColor" stroke-width="2"/><path d="M4 9h16M9 4v16" stroke="currentColor" stroke-width="2"/></svg>
										</div>
										<div>
											<h3 class="font-semibold text-gray-900">On-Page Optimization</h3>
											<p class="text-gray-600">Titles, descriptions, schema, keyword scoring, and automatic suggestions.</p>
										</div>
									</div>

								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Features Section -->
		<section id="features" class="section bg-gray-50">
			<div class="container-custom">
				<h2 class="animate-on-scroll delay-0 text-3xl md:text-4xl font-bold text-center mb-12">
					Why Choose <span class="gradient-text">Laravel SEO</span>?
				</h2>

				<div class="space-y-8">
					<div class="animate-on-scroll delay-1 feature-card">
						<h3 class="text-xl font-semibold mb-3">Rank Tracking System</h3>
						<p class="text-gray-600">Track keyword positions daily across multiple search engines, countries, and devices. Compare ranking history and monitor competitors in real-time.</p>
					</div>

					<div class="animate-on-scroll delay-2 feature-card">
						<h3 class="text-xl font-semibold mb-3">Complete Site Audit Engine</h3>
						<p class="text-gray-600">Identify technical issues including speed, indexability, metadata, sitemaps, structured data, 404 checks, and content duplication.</p>
					</div>

					<div class="animate-on-scroll delay-3 feature-card">
						<h3 class="text-xl font-semibold mb-3">Keyword & SERP Intelligence</h3>
						<p class="text-gray-600">Keyword clustering, intent analysis, SERP snapshots, and volatility alerts — with full historical tracking.</p>
					</div>

					<div class="animate-on-scroll delay-4 feature-card">
						<h3 class="text-xl font-semibold mb-3">On‑Page Optimization Tools</h3>
						<p class="text-gray-600">Edit titles, descriptions, schema markup, indexing rules, and more directly inside Laravel with full API access.</p>
					</div>

					<div class="animate-on-scroll delay-5 feature-card">
						<h3 class="text-xl font-semibold mb-3">Backlink Monitoring</h3>
						<p class="text-gray-600">Track backlinks, domain authority metrics, link health, and competitive backlink gaps.</p>
					</div>

					<div class="animate-on-scroll delay-6 feature-card">
						<h3 class="text-xl font-semibold mb-3">Laravel‑Native Developer Tools</h3>
						<p class="text-gray-600">Blade helpers, APIs, Artisan commands, webhooks, and SEO automation triggers built specifically for Laravel devs.</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Tech Section -->
		<section class="section bg-white">
			<div class="container-custom">
				<h2 class="animate-on-scroll delay-0 text-3xl md:text-4xl font-bold text-center mb-16">
					Under The Hood: <span class="gradient-text">Technology & Architecture</span>
				</h2>

				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
					<div class="animate-on-scroll delay-1 feature-card hover:shadow-xl transition-shadow duration-300">
						<h3 class="text-lg font-semibold mb-2">Self-Hosted Laravel Platform</h3>
						<p class="text-gray-600">Run your full SEO suite on your own servers with complete privacy.</p>
					</div>

					<div class="animate-on-scroll delay-2 feature-card hover:shadow-xl transition-shadow duration-300">
						<h3 class="text-lg font-semibold mb-2">Crawling & Audit Engine</h3>
						<p class="text-gray-600">Fast, distributed crawler built on Laravel queues & workers.</p>
					</div>

					<div class="animate-on-scroll delay-3 feature-card hover:shadow-xl transition-shadow duration-300">
						<h

						<div class="animate-on-scroll delay-4 feature-card hover:shadow-xl transition-shadow duration-300">
							<h3 class="text-lg font-semibold mb-2">SERP Intelligence API</h3>
							<p class="text-gray-600">Live data ingestion for SERP features, competitors, rich results and keyword intent grouping.</p>
						</div>

						<div class="animate-on-scroll delay-5 feature-card hover:shadow-xl transition-shadow duration-300">
							<h3 class="text-lg font-semibold mb-2">Queue-Driven Automation</h3>
							<p class="text-gray-600">Background jobs for audits, keyword refreshes, backlink scans, content scoring and reporting.</p>
						</div>

						<div class="animate-on-scroll delay-6 feature-card hover:shadow-xl transition-shadow duration-300">
							<h3 class="text-lg font-semibold mb-2">Integrations</h3>
							<p class="text-gray-600">Built-in connectors for Search Console, Analytics, Sitemap parsing and popular SEO APIs.</p>
						</div>
					</div>
				</div>
		</section>

		<!-- CTA SECTION -->
		<section class="py-24 bg-gradient-to-br from-indigo-600 to-blue-600 text-white">
			<div class="container-custom text-center">
				<h2 class="text-4xl md:text-5xl font-bold mb-6 animate-on-scroll delay-0">Boost Your Rankings With Laravel SEO</h2>
				<p class="text-xl mb-10 max-w-2xl mx-auto animate-on-scroll delay-1">
					Start automating audits, tracking keywords, optimizing on-page content, and monitoring your entire SEO ecosystem — all inside Laravel.
				</p>

				<a href="/docs" class="btn btn-white animate-on-scroll delay-2">Get Started</a>
			</div>
		</section>

		<!-- FAQ SECTION -->
		<section class="section bg-gray-50">
			<div class="container-custom">
				<h2 class="text-3xl md:text-4xl font-bold text-center mb-16">Frequently Asked Questions</h2>

				<div class="space-y-8 max-w-3xl mx-auto">
					<div class="faq-item p-6 bg-white rounded-xl shadow">
						<h3 class="font-semibold text-lg mb-2">Is Laravel SEO self-hosted?</h3>
						<p class="text-gray-600">Yes — all ranking data, crawls, audits and metadata are stored on your own server for full privacy.</p>
					</div>

					<div class="faq-item p-6 bg-white rounded-xl shadow">
						<h3 class="font-semibold text-lg mb-2">Does it support multi-domain tracking?</h3>
						<p class="text-gray-600">Absolutely. Add unlimited domains, keywords, competitors and audit schedules.</p>
					</div>

					<div class="faq-item p-6 bg-white rounded-xl shadow">
						<h3 class="font-semibold text-lg mb-2">How often does rank tracking update?</h3>
						<p class="text-gray-600">You choose: hourly, daily or custom intervals through Laravel schedules.</p>
					</div>

					<div class="faq-item p-6 bg-white rounded-xl shadow">
						<h3 class="font-semibold text-lg mb-2">Can I extend the platform?</h3>
						<p class="text-gray-600">Yes. Laravel SEO is built with services, pipelines and clear interfaces for easy extension.</p>
					</div>
				</div>
			</div>
		</section>

	</main>
</Layout>