---
import Layout from "../../layouts/Layout.astro";
import seoLogo from "../../assets/logos/laravel-seo.svg";
import { Image } from "astro:assets";
---

<Layout title="Laravel SEO - Professional SEO Reports and Tools">
	<!-- SoftwareApplication Schema -->
	<script type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@type": "SoftwareApplication",
			"name": "Laravel SEO",
			"applicationCategory": "BusinessApplication",
			"operatingSystem": "Web",
			"url": "https://laravelseo.com",
			"description": "Professional SEO toolkit for Laravel applications. Automated sitemap generation, meta tag management, schema markup, and SEO performance analytics.",
			"creator": {
				"@type": "Organization",
				"name": "Laravel Company",
				"url": "https://laravelcompany.com"
			},
			"license": "https://creativecommons.org/licenses/by/4.0/",
			"offers": {
				"@type": "Offer",
				"price": "79",
				"priceCurrency": "GBP"
			},
			"featureList": [
				"Automated sitemap generation",
				"Dynamic meta tag management",
				"Schema.org structured data",
				"SEO performance analytics",
				"Keyword tracking",
				"Technical SEO audits"
			]
		}
	</script>
	<main>
		<!-- Hero Section -->
		<section class="pt-20 pb-16 md:pt-28 md:pb-24 overflow-hidden">
			<div class="container-custom">
				<nav class="flex justify-center items-center gap-2 text-sm text-white/50 mb-8 animate-on-scroll">
					<a href="/" class="hover:text-white transition-colors">Home</a>
					<span>/</span>
					<a href="/software/" class="hover:text-white transition-colors">Software</a>
					<span>/</span>
					<span class="text-white">Laravel SEO</span>
				</nav>
				<div
					class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center"
				>
					<div>
						<h1
							class="animate-on-scroll delay-0 text-4xl md:text-5xl lg:text-6xl font-bold leading-tight"
						>
							Professional SEO Reports and Tools
						</h1>
						<p
							class="animate-on-scroll delay-1 mt-6 text-xl text-gray-400 max-w-lg"
						>
							Identify the most critical technical SEO issues and
							take action to improve the health and performance of
							your website.
						</p>
						<div class="animate-on-scroll delay-2 mt-8 flex gap-4">
							<a
								href="https://laravelseo.com"
								class="btn btn-primary"
								target="_blank">Get Started</a
							>
							<a href="/contact/" class="btn btn-secondary"
								>Request a Quote</a
							>
						</div>
					</div>

					<div class="animate-on-scroll delay-3">
						<Image
							src={seoLogo}
							alt="Laravel SEO Dashboard"
							class="w-full rounded-xl shadow-xl"
						/>
					</div>
				</div>
			</div>
		</section>

		<!-- Key Features Section -->
		<section class="section bg-white/5">
			<div class="container-custom">
				<div class="grid grid-cols-1 md:grid-cols-3 gap-12">
					<div class="animate-on-scroll delay-1">
						<h3 class="text-xl font-semibold mb-3">
							Ranking Improvement
						</h3>
						<p class="text-gray-400">
							Reports that help you improve your presence on major
							search engines.
						</p>
					</div>

					<div class="animate-on-scroll delay-2">
						<h3 class="text-xl font-semibold mb-3">
							Complete Solution
						</h3>
						<p class="text-gray-400">
							Comprehensive platform to easily manage your SEO
							reports, projects and tools.
						</p>
					</div>

					<div class="animate-on-scroll delay-3">
						<h3 class="text-xl font-semibold mb-3">
							Advanced Reports
						</h3>
						<p class="text-gray-400">
							Detailed reports that enable you to take actions on
							issues that actually matter.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Reports Overview -->
		<section class="section bg-white/10">
			<div class="container-custom">
				<h2 class="text-3xl md:text-4xl font-bold text-center mb-16">
					Advanced Reporting Features
				</h2>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
					<div class="feature-card">
						<h3 class="text-lg font-semibold mb-3">SEO Analysis</h3>
						<p class="text-gray-400">
							Get an in-depth analysis on the most important tags
							and the content of your webpage.
						</p>
					</div>

					<div class="feature-card">
						<h3 class="text-lg font-semibold mb-3">Performance</h3>
						<p class="text-gray-400">
							Improve the performance of your webpages with key
							metrics and suggestions.
						</p>
					</div>

					<div class="feature-card">
						<h3 class="text-lg font-semibold mb-3">Security</h3>
						<p class="text-gray-400">
							Obtain privacy and security information to keep your
							webpage's health in good standing.
						</p>
					</div>
				</div>

				<div class="bg-white/5 p-8 rounded-xl">
					<h3 class="text-xl font-semibold mb-6">
						Report Components
					</h3>
					<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
						<div>
							<p class="font-semibold text-white mb-2">
								Title Tag
							</p>
							<p class="text-gray-400">
								The title tag is perfect.
							</p>
						</div>
						<div>
							<p class="font-semibold text-white mb-2">
								Meta Description
							</p>
							<p class="text-gray-400">
								The meta description tag is missing or empty.
							</p>
						</div>
						<div>
							<p class="font-semibold text-white mb-2">
								Load Time
							</p>
							<p class="text-gray-400">
								The webpage loaded in 0.02 seconds.
							</p>
						</div>
						<div>
							<p class="font-semibold text-white mb-2">
								Structured Data
							</p>
							<p class="text-gray-400">
								There are no structured data tags on the
								webpage.
							</p>
						</div>
						<div>
							<p class="font-semibold text-white mb-2">
								JavaScript Defer
							</p>
							<p class="text-gray-400">
								There are 10 javascript resources without the
								defer attribute.
							</p>
						</div>
						<div>
							<p class="font-semibold text-white mb-2">
								Content Length
							</p>
							<p class="text-gray-400">
								The webpage has 2,995 words.
							</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Tools Section -->
		<section class="section bg-white/5">
			<div class="container-custom text-center">
				<h2 class="text-3xl md:text-4xl font-bold mb-6">
					Over 30 Web Tools & Utilities
				</h2>
				<p class="text-gray-400 mb-12 max-w-2xl mx-auto">
					Website status checker, SSL checker, DNS lookup, WHOIS
					lookup, IP lookup, domain audits, Google Lighthouse audits,
					and more.
				</p>
				<div class="grid grid-cols-2 md:grid-cols-4 gap-4">
					<div class="bg-white/10 p-4 rounded-lg shadow">
						Website Status
					</div>
					<div class="bg-white/10 p-4 rounded-lg shadow">
						SSL Checker
					</div>
					<div class="bg-white/10 p-4 rounded-lg shadow">
						DNS Lookup
					</div>
					<div class="bg-white/10 p-4 rounded-lg shadow">
						WHOIS Lookup
					</div>
					<div class="bg-white/10 p-4 rounded-lg shadow">
						IP Lookup
					</div>
					<div class="bg-white/10 p-4 rounded-lg shadow">
						Redirect Checker
					</div>
					<div class="bg-white/10 p-4 rounded-lg shadow">
						IDN Converter
					</div>
					<div class="bg-white/10 p-4 rounded-lg shadow">
						Google Lighthouse
					</div>
					<div class="bg-white/10 p-4 rounded-lg shadow">
						Black SEO Analyzer
					</div>
					<div class="bg-white/10 p-4 rounded-lg shadow">
						And More...
					</div>
				</div>
			</div>
		</section>

		<!-- Black SEO Analyzer Section -->
		<section class="section bg-white/10">
			<div class="container-custom">
				<div class="max-w-4xl mx-auto">
					<h2 class="text-3xl md:text-4xl font-bold text-center mb-6">
						Black SEO Analyzer Integration
					</h2>
					<p class="text-center text-gray-400 mb-4">
						A professional command-line tool designed for websites
						that need to be found in both search results and AI
						answers.
					</p>
					<p class="text-center text-gray-400 mb-12">
						When your site's structure and metadata are optimized
						correctly, you'll appear in both search results and AI
						conversations—without corporate buzzwords, just
						actionable data.
					</p>

					<div
						class="bg-indigo-900/20 p-8 rounded-xl border-2 border-indigo-500/30 mb-12"
					>
						<h3
							class="text-2xl font-bold text-center mb-6 text-white"
						>
							True Ownership, Not Subscription
						</h3>
						<p class="text-center text-gray-400 mb-8">
							Unlike subscription-based tools that stop working
							when you stop paying, Black SEO Analyzer offers
							genuine software ownership with a legally-binding
							source code access guarantee if discontinued.
						</p>
						<div
							class="grid grid-cols-1 md:grid-cols-3 gap-4 text-center text-gray-300"
						>
							<div>✓ Lifetime software ownership</div>
							<div>✓ All future updates</div>
							<div>✓ Source code escrow guarantee</div>
						</div>
					</div>

					<div class="space-y-6 mb-12">
						<h3 class="text-2xl font-bold mb-6">
							Comprehensive Feature Set
						</h3>

						<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
							<div class="feature-card">
								<h4 class="text-lg font-semibold mb-3">
									Content Analysis
								</h4>
								<p class="text-gray-400">
									Word count, keyword density, readability
									scores, duplicate detection, heading
									structure, semantic HTML analysis
								</p>
							</div>

							<div class="feature-card">
								<h4 class="text-lg font-semibold mb-3">
									Metadata & OG Tags
								</h4>
								<p class="text-gray-400">
									Title tags, meta descriptions, OpenGraph
									data, Twitter Cards, canonical URLs, robots
									meta validation
								</p>
							</div>

							<div class="feature-card">
								<h4 class="text-lg font-semibold mb-3">
									Link Analysis
								</h4>
								<p class="text-gray-400">
									Internal/external links, anchor text
									analysis, broken link detection, redirect
									checks, link attributes validation
								</p>
							</div>

							<div class="feature-card">
								<h4 class="text-lg font-semibold mb-3">
									Web Vitals & Performance
								</h4>
								<p class="text-gray-400">
									LCP, FID/INP, CLS, FCP, TTI analysis.
									Resource loading, script analysis, caching
									headers, compression checks
								</p>
							</div>

							<div class="feature-card">
								<h4 class="text-lg font-semibold mb-3">
									Security Analysis
								</h4>
								<p class="text-gray-400">
									HTTPS validation, mixed content detection,
									CSP headers, form security, SSL certificate
									checks, SRI validation
								</p>
							</div>

							<div class="feature-card">
								<h4 class="text-lg font-semibold mb-3">
									Schema & Structured Data
								</h4>
								<p class="text-gray-400">
									JSON-LD, Microdata, RDFa extraction and
									validation, schema property verification,
									deprecated property detection
								</p>
							</div>

							<div class="feature-card">
								<h4 class="text-lg font-semibold mb-3">
									Mobile-Friendliness
								</h4>
								<p class="text-gray-400">
									Viewport analysis, responsive images, touch
									target sizing, font size validation, media
									query coverage
								</p>
							</div>

							<div class="feature-card">
								<h4 class="text-lg font-semibold mb-3">
									JavaScript & SPA Support
								</h4>
								<p class="text-gray-400">
									Full headless browser rendering for SPAs,
									async script analysis, event handler
									inspection, third-party script detection
								</p>
							</div>

							<div class="feature-card">
								<h4 class="text-lg font-semibold mb-3">
									CSS Analysis
								</h4>
								<p class="text-gray-400">
									External/inline styles, media queries, CSS
									complexity, duplicate rule detection,
									accessibility checks
								</p>
							</div>

							<div class="feature-card">
								<h4 class="text-lg font-semibold mb-3">
									Internationalization (i18n)
								</h4>
								<p class="text-gray-400">
									Language declarations, hreflang
									implementation, character encoding, text
									direction, locale-specific checks
								</p>
							</div>

							<div class="feature-card">
								<h4 class="text-lg font-semibold mb-3">
									AI-Powered Analysis
								</h4>
								<p class="text-gray-400">
									Integration with OpenAI, Anthropic Claude,
									DeepSeek, Google Gemini for advanced
									recommendations and content optimization
								</p>
							</div>

							<div class="feature-card">
								<h4 class="text-lg font-semibold mb-3">
									Multiple Output Formats
								</h4>
								<p class="text-gray-400">
									JSON, JSONL, XML, CSV, HTML reports,
									individual JSON files per page, templated
									HTML folder output
								</p>
							</div>
						</div>
					</div>

					<div class="bg-white/5 p-8 rounded-xl mb-12">
						<h3 class="text-2xl font-bold mb-8">
							Command-Line Integration
						</h3>
						<p class="text-gray-400 mb-6">
							Powerful CLI options for complete automation and
							Laravel integration:
						</p>
						<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
							<div class="space-y-2">
								<p class="font-semibold text-white">
									Crawling Options
								</p>
								<ul class="text-gray-400 text-sm space-y-1">
									<li>
										✓ Configurable concurrent requests
										(default: 20)
									</li>
									<li>✓ Rate limiting controls</li>
									<li>✓ Sitemap parsing</li>
									<li>✓ SPA detection and rendering</li>
									<li>✓ Max page limits</li>
									<li>✓ Custom user-agent strings</li>
								</ul>
							</div>
							<div class="space-y-2">
								<p class="font-semibold text-white">
									Advanced Features
								</p>
								<ul class="text-gray-400 text-sm space-y-1">
									<li>✓ External link disable option</li>
									<li>✓ Robots.txt respect</li>
									<li>✓ Custom HTML templates</li>
									<li>✓ Detailed logging system</li>
									<li>✓ Custom LLM prompts</li>
									<li>✓ Multi-language support</li>
								</ul>
							</div>
						</div>
					</div>

					<div
						class="bg-indigo-600 text-white p-8 rounded-xl text-center"
					>
						<h3 class="text-2xl font-bold mb-4">
							Perfect for Laravel Developers
						</h3>
						<p class="mb-6">
							Automate SEO audits in your CI/CD pipeline, monitor
							site health continuously, and integrate
							comprehensive analysis directly into your Laravel
							development workflow.
						</p>
						<a
							href="https://www.blackseoanalyzer.com/"
							class="inline-block bg-white/10 text-indigo-400 px-8 py-3 rounded-lg font-semibold hover:bg-white/20 transition-colors"
							>Visit Black SEO Analyzer</a
						>
					</div>
				</div>
			</div>
		</section>

		<!-- Laravel Suite Section -->
		<section class="section bg-white/10">
			<div class="container-custom">
				<div class="max-w-4xl mx-auto text-center mb-16">
					<h2 class="text-3xl md:text-4xl font-bold mb-6">
						Fully Automated SEO Suite
					</h2>
					<p class="text-xl text-gray-400 mb-8">
						Supercharge Your Laravel SEO With Real-Time Lighthouse
						Monitoring
					</p>
					<p class="text-gray-400 mb-10">
						Take control of your site's search visibility with a
						fully automated optimisation suite built specifically
						for Laravel. Track, tune, and improve your SEO
						performance instantly — no guesswork, no external
						dashboards.
					</p>
					<div class="flex gap-4 justify-center">
						<a href="/contact/" class="btn btn-primary"
							>Request a Quote</a
						>
					</div>
				</div>
			</div>
		</section>

		<!-- Everything You Need Section -->
		<section class="section bg-white/5">
			<div class="container-custom">
				<h2 class="text-3xl md:text-4xl font-bold text-center mb-6">
					Everything You Need to Optimize Your Application
				</h2>
				<p class="text-center text-gray-400 mb-16 max-w-2xl mx-auto">
					LaravelSeo gives you everything you need to optimise your
					application at scale. All the tools — none of the hassle.
				</p>

				<div
					class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"
				>
					<div class="feature-card">
						<h3 class="text-lg font-semibold mb-3">
							Real-time Lighthouse Scoring
						</h3>
						<p class="text-gray-400">
							Fully automated and integrated directly into your
							Laravel workflow.
						</p>
					</div>

					<div class="feature-card">
						<h3 class="text-lg font-semibold mb-3">
							Automatic Meta Management
						</h3>
						<p class="text-gray-400">
							Fully automated and integrated directly into your
							Laravel workflow.
						</p>
					</div>

					<div class="feature-card">
						<h3 class="text-lg font-semibold mb-3">
							Social Preview Automation
						</h3>
						<p class="text-gray-400">
							Fully automated and integrated directly into your
							Laravel workflow.
						</p>
					</div>

					<div class="feature-card">
						<h3 class="text-lg font-semibold mb-3">
							JSON-LD & Schema.org
						</h3>
						<p class="text-gray-400">
							Fully automated and integrated directly into your
							Laravel workflow.
						</p>
					</div>

					<div class="feature-card">
						<h3 class="text-lg font-semibold mb-3">
							Route-level SEO Rules
						</h3>
						<p class="text-gray-400">
							Fully automated and integrated directly into your
							Laravel workflow.
						</p>
					</div>

					<div class="feature-card">
						<h3 class="text-lg font-semibold mb-3">
							Seamless Integration
						</h3>
						<p class="text-gray-400">
							Fully automated and integrated directly into your
							Laravel workflow.
						</p>
					</div>
				</div>

				<div class="text-center mt-12">
				</div>
			</div>
		</section>

		<!-- How It Works Section -->
		<section class="section bg-white/10">
			<div class="container-custom">
				<h2 class="text-3xl md:text-4xl font-bold text-center mb-6">
					How It Works
				</h2>
				<p class="text-center text-gray-400 mb-16 max-w-2xl mx-auto">
					Straightforward setup, zero friction. Get running in
					minutes.
				</p>

				<div
					class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-4xl mx-auto"
				>
					<div class="text-center">
						<div
							class="w-12 h-12 bg-indigo-600 text-white rounded-full flex items-center justify-center font-bold text-xl mx-auto mb-4"
						>
							1
						</div>
						<h3 class="text-lg font-semibold mb-2">
							Install the Package
						</h3>
						<p class="text-gray-400">
							Install the package with Composer. Straightforward
							setup, zero friction.
						</p>
					</div>

					<div class="text-center">
						<div
							class="w-12 h-12 bg-indigo-600 text-white rounded-full flex items-center justify-center font-bold text-xl mx-auto mb-4"
						>
							2
						</div>
						<h3 class="text-lg font-semibold mb-2">
							Configure Your Rules
						</h3>
						<p class="text-gray-400">
							Use the UI or config files — whichever suits your
							workflow.
						</p>
					</div>

					<div class="text-center">
						<div
							class="w-12 h-12 bg-indigo-600 text-white rounded-full flex items-center justify-center font-bold text-xl mx-auto mb-4"
						>
							3
						</div>
						<h3 class="text-lg font-semibold mb-2">
							Monitor SEO in Real Time
						</h3>
						<p class="text-gray-400">
							Every edit triggers a fresh Lighthouse audit. You
							see the impact instantly.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Why Google Lighthouse Section -->
		<section class="section bg-white/5">
			<div class="container-custom max-w-3xl mx-auto text-center">
				<div class="mb-8">
					<span
						class="inline-block text-5xl font-bold text-indigo-600 mb-4"
						>100</span
					>
					<p class="text-gray-400">Perfect SEO Score</p>
