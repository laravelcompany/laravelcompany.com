---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Laravel UI | Premium React Components for Laravel">
    <main>
        <!-- Hero Section -->
        <section class="pt-20 pb-16 md:pt-28 md:pb-24 overflow-hidden">
            <div class="container-custom">
                <div
                    class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center"
                >
                    <div>
                        <h1
                            class="animate-on-scroll delay-0 text-4xl md:text-5xl lg:text-6xl font-bold leading-tight"
                        >
                            Premium React Components for <span
                                class="gradient-text">Laravel UI</span
                            >
                        </h1>
                        <p
                            class="animate-on-scroll delay-1 mt-6 text-xl text-gray-400 max-w-lg"
                        >
                            Inspired by Flowbite Premium, our component library
                            is designed specifically for Laravel, built for
                            modern conversion-driven web applications.
                        </p>
                        <div class="animate-on-scroll delay-2 mt-8 flex gap-4">
                            <a href="/contact" class="btn btn-primary"
                                >Get Started</a
                            >
                            <a href="#marketing-ui" class="btn btn-secondary"
                                >Explore Components</a
                            >
                        </div>
                    </div>
                    <div class="animate-on-scroll delay-3">
                        <div class="relative">
                            <div
                                class="absolute -inset-0.5 bg-gradient-to-r from-blue-500 to-cyan-500 rounded-xl blur opacity-30"
                            >
                            </div>
                            <div
                                class="relative bg-white/10 rounded-xl shadow-xl overflow-hidden p-8"
                            >
                                <div class="space-y-6">
                                    <div class="flex items-center gap-4">
                                        <div
                                            class="w-12 h-12 bg-blue-900/20 rounded-lg flex items-center justify-center"
                                        >
                                            <svg
                                                class="w-6 h-6 text-blue-500"
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                xmlns="http://www.w3.org/2000/svg"
                                            >
                                                <path
                                                    d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"
                                                    stroke="currentColor"
                                                    stroke-width="2"
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                ></path>
                                            </svg>
                                        </div>
                                        <div>
                                            <h3
                                                class="font-semibold text-white"
                                            >
                                                Modular Design
                                            </h3>
                                            <p class="text-gray-400">
                                                Fully customizable React
                                                components
                                            </p>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-4">
                                        <div
                                            class="w-12 h-12 bg-cyan-900/20 rounded-lg flex items-center justify-center"
                                        >
                                            <svg
                                                class="w-6 h-6 text-cyan-400"
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                xmlns="http://www.w3.org/2000/svg"
                                            >
                                                <path
                                                    d="M13 10V3L4 14h7v7l9-11h-7z"
                                                    stroke="currentColor"
                                                    stroke-width="2"
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                ></path>
                                            </svg>
                                        </div>
                                        <div>
                                            <h3
                                                class="font-semibold text-white"
                                            >
                                                High Performance
                                            </h3>
                                            <p class="text-gray-400">
                                                Optimized for speed and
                                                conversion
                                            </p>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-4">
                                        <div
                                            class="w-12 h-12 bg-blue-900/20 rounded-lg flex items-center justify-center"
                                        >
                                            <svg
                                                class="w-6 h-6 text-blue-500"
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                xmlns="http://www.w3.org/2000/svg"
                                            >
                                                <path
                                                    d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                                                    stroke="currentColor"
                                                    stroke-width="2"
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                ></path>
                                            </svg>
                                        </div>
                                        <div>
                                            <h3
                                                class="font-semibold text-white"
                                            >
                                                Laravel Native
                                            </h3>
                                            <p class="text-gray-400">
                                                Seamless integration with
                                                Laravel apps
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Marketing UI Section -->
        <section id="marketing-ui" class="section bg-white/5">
            <div class="container-custom">
                <div class="max-w-3xl mx-auto text-center mb-16">
                    <h2
                        class="animate-on-scroll delay-0 text-3xl md:text-4xl font-bold mb-6"
                    >
                        Marketing <span class="gradient-text">UI</span>
                    </h2>
                    <p class="text-gray-400 text-lg">
                        Landing pages, feature sections, newsletters, and
                        conversion-focused components for your marketing site.
                    </p>
                </div>

                <div
                    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"
                >
                    <div class="animate-on-scroll delay-1 feature-card">
                        <h3 class="text-xl font-semibold mb-3">
                            Landing Pages
                        </h3>
                        <p class="text-gray-400">
                            High-converting landing page templates designed to
                            showcase your product and drive sign-ups.
                        </p>
                    </div>

                    <div class="animate-on-scroll delay-2 feature-card">
                        <h3 class="text-xl font-semibold mb-3">
                            Feature Sections
                        </h3>
                        <p class="text-gray-400">
                            Beautifully crafted feature grids and highlights to
                            explain your value proposition clearly.
                        </p>
                    </div>

                    <div class="animate-on-scroll delay-3 feature-card">
                        <h3 class="text-xl font-semibold mb-3">Newsletters</h3>
                        <p class="text-gray-400">
                            Engagement-focused newsletter signup forms and
                            sections to grow your audience.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Application UI Section -->
        <section id="application-ui" class="section bg-white/10">
            <div class="container-custom">
                <div class="max-w-3xl mx-auto text-center mb-16">
                    <h2
                        class="animate-on-scroll delay-0 text-3xl md:text-4xl font-bold mb-6"
                    >
                        Application <span class="gradient-text">UI</span>
                    </h2>
                    <p class="text-gray-400 text-lg">
                        Dashboards, CRUD interfaces, forms, and complex layouts
                        for building powerful web applications.
                    </p>
                </div>

                <div
                    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"
                >
                    <div class="animate-on-scroll delay-1 feature-card">
                        <h3 class="text-xl font-semibold mb-3">Dashboards</h3>
                        <p class="text-gray-400">
                            Comprehensive dashboard layouts with sidebar
                            navigation, search, and user profiles.
                        </p>
                    </div>

                    <div class="animate-on-scroll delay-2 feature-card">
                        <h3 class="text-xl font-semibold mb-3">
                            CRUD Interfaces
                        </h3>
                        <p class="text-gray-400">
                            Standardized table views, filters, and action menus
                            for managing your application data.
                        </p>
                    </div>

                    <div class="animate-on-scroll delay-3 feature-card">
                        <h3 class="text-xl font-semibold mb-3">
                            Forms & Layouts
                        </h3>
                        <p class="text-gray-400">
                            Complex multi-step forms and grid-based layouts to
                            handle any user input requirement.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Tech Section -->
        <section class="section">
            <div class="container-custom">
                <h2
                    class="animate-on-scroll delay-0 text-3xl md:text-4xl font-bold text-center mb-16"
                >
                    Built for <span class="gradient-text"
                        >Modern Development</span
                    >
                </h2>

                <div
                    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6"
                >
                    <div
                        class="animate-on-scroll delay-1 feature-card hover:shadow-xl transition-shadow duration-300"
                    >
                        <h3 class="text-lg font-semibold mb-2">React 18+</h3>
                        <p class="text-gray-400">
                            Leveraging the latest React features for optimal
                            performance and developer experience.
                        </p>
                    </div>

                    <div
                        class="animate-on-scroll delay-2 feature-card hover:shadow-xl transition-shadow duration-300"
                    >
                        <h3 class="text-lg font-semibold mb-2">Tailwind CSS</h3>
                        <p class="text-gray-400">
                            Utility-first styling for maximum flexibility and
                            rapid customization.
                        </p>
                    </div>

                    <div
                        class="animate-on-scroll delay-3 feature-card hover:shadow-xl transition-shadow duration-300"
                    >
                        <h3 class="text-lg font-semibold mb-2">
                            Framer Motion
                        </h3>
                        <p class="text-gray-400">
                            Smooth animations and transitions to make your
                            application feel alive.
                        </p>
                    </div>

                    <div
                        class="animate-on-scroll delay-4 feature-card hover:shadow-xl transition-shadow duration-300"
                    >
                        <h3 class="text-lg font-semibold mb-2">TypeScript</h3>
                        <p class="text-gray-400">
                            Full type safety for a more robust and maintainable
                            codebase.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Final CTA -->
        <section
            class="section bg-gradient-to-r from-blue-600 to-cyan-600 text-white"
        >
            <div class="container-custom text-center py-12">
                <h2 class="text-3xl md:text-5xl font-bold mb-6">
                    Ready to build faster?
                </h2>
                <p class="text-xl mb-8 max-w-2xl mx-auto opacity-90">
                    Start using Laravel UI today and transform your development
                    workflow with premium components.
                </p>
                <div class="flex justify-center gap-4">
                    <a
                        href="/contact"
                        class="bg-white text-blue-600 px-8 py-4 rounded-xl font-bold hover:bg-gray-100 transition-colors"
                    >
                        Contact Sales
                    </a>
                </div>
            </div>
        </section>
    </main>
</Layout>
