---
import Layout from "../../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
---

<Layout title="Laravel Social - AI-Powered Social Media Automation">
    <main>
        <!-- Hero Section -->
        <section class="pt-20 pb-16 md:pt-28 md:pb-24 overflow-hidden relative">
            <div class="absolute top-0 left-0 w-full h-full overflow-hidden -z-10">
                <div class="absolute top-20 left-1/4 w-[500px] h-[500px] bg-orange-500/20 blur-[150px] rounded-full"></div>
                <div class="absolute bottom-20 right-1/4 w-[400px] h-[400px] bg-orange-600/15 blur-[120px] rounded-full"></div>
            </div>
            <div class="container-custom">
                <div class="max-w-4xl mx-auto text-center">
                    <div class="animate-on-scroll inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/5 border border-white/10 backdrop-blur-sm mb-8">
                        <Icon name="ph:sparkle-duotone" class="w-5 h-5 text-orange-400" />
                        <span class="text-sm font-semibold text-white/80">v2.0.0 Now Live with AI Features</span>
                    </div>
                    
                    <h1 class="animate-on-scroll delay-1 text-4xl md:text-5xl lg:text-6xl font-black text-white leading-tight mb-6">
                        Dominate Socials with <br /><span class="gradient-text">AI Automation</span>
                    </h1>
                    
                    <p class="animate-on-scroll delay-2 text-xl text-white/70 leading-relaxed font-medium max-w-3xl mx-auto mb-10">
                        Laravel Social is a next-gen social media platform. Schedule posts, generate AI content, and grow your brand across all channels from one power-packed dashboard.
                    </p>
                    
                    <div class="animate-on-scroll delay-3 flex flex-wrap justify-center gap-4">
                        <a href="/contact/" class="btn btn-primary !px-8 !py-4 text-lg inline-flex items-center gap-2">
                            <Icon name="ph:rocket-launch-duotone" class="w-5 h-5" />
                            Get Early Access
                        </a>
                        <a href="#features" class="btn btn-secondary !px-8 !py-4 text-lg inline-flex items-center gap-2">
                            Explore Features
                            <Icon name="ph:arrow-down" class="w-5 h-5" />
                        </a>
                    </div>
                    
                    <div class="animate-on-scroll delay-4 mt-12 flex items-center justify-center gap-4">
                        <div class="flex -space-x-3">
                            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-violet-500 to-purple-600 border-2 border-gray-900"></div>
                            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-pink-500 to-rose-600 border-2 border-gray-900"></div>
                            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-blue-500 to-cyan-600 border-2 border-gray-900"></div>
                            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-emerald-500 to-teal-600 border-2 border-gray-900"></div>
                        </div>
                        <span class="text-white/80 font-semibold">Trusted by 5,000+ businesses worldwide</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- Dashboard Preview Section -->
        <section class="pb-24 overflow-hidden">
            <div class="container-custom">
                <div class="animate-on-scroll relative max-w-5xl mx-auto">
                    <div class="absolute -inset-0.5 bg-gradient-to-r from-orange-500 to-orange-600 rounded-2xl blur opacity-30"></div>
                    <div class="relative glass-card rounded-2xl p-6 md:p-10">
                        <div class="flex items-center gap-3 mb-6">
                            <div class="flex gap-1.5">
                                <div class="w-3 h-3 rounded-full bg-red-500"></div>
                                <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
                                <div class="w-3 h-3 rounded-full bg-green-500"></div>
                            </div>
                            <span class="text-white/50 text-sm font-medium ml-2">Laravel Social Dashboard</span>
                        </div>
                        
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                            <div class="md:col-span-2 bg-gradient-to-br from-orange-900/30 to-orange-800/20 rounded-xl p-6 border border-orange-500/20">
                                <div class="flex items-center justify-between mb-6">
                                    <h3 class="text-lg font-bold text-white">AI Post Generation</h3>
                                    <span class="px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-400 text-sm font-medium">Ready for Approval</span>
                                </div>
                                <div class="space-y-4">
                                    <div class="bg-white/5 rounded-lg p-4 border border-white/10">
                                        <div class="flex items-start gap-3">
                                            <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-orange-500 to-orange-600 flex items-center justify-center flex-shrink-0">
                                                <Icon name="ph:robot-duotone" class="w-5 h-5 text-white" />
                                            </div>
                                            <div>
                                                <p class="text-white/80 text-sm leading-relaxed">
                                                    Excited to announce our new product launch! 🚀 Building the future of social media automation with AI-powered tools that help brands grow smarter.
                                                </p>
                                                <div class="flex items-center gap-4 mt-3">
                                                    <span class="text-xs text-orange-400 font-medium">Facebook</span>
                                                    <span class="text-xs text-pink-400 font-medium">Instagram</span>
                                                    <span class="text-xs text-blue-400 font-medium">Twitter</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-3 text-sm text-white/60">
                                        <Icon name="ph:clock-duotone" class="w-4 h-4" />
                                        <span>Scheduled for 9:00 AM tomorrow</span>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="space-y-6">
                                <div class="bg-gradient-to-br from-orange-900/30 to-orange-800/20 rounded-xl p-6 border border-orange-500/20">
                                    <h3 class="text-lg font-bold text-white mb-4">Schedule Status</h3>
                                    <div class="space-y-4">
                                        <div class="flex items-center justify-between">
                                            <span class="text-white/70 text-sm">Posts Scheduled</span>
                                            <span class="text-white font-bold">24</span>
                                        </div>
                                        <div class="flex items-center justify-between">
                                            <span class="text-white/70 text-sm">AI Generated Today</span>
                                            <span class="text-orange-400 font-bold">12</span>
                                        </div>
                                        <div class="flex items-center justify-between">
                                            <span class="text-white/70 text-sm">Platforms</span>
                                            <span class="text-white font-bold">5</span>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="bg-gradient-to-br from-emerald-900/30 to-emerald-800/20 rounded-xl p-6 border border-emerald-500/20">
                                    <div class="flex items-center gap-2 mb-2">
                                        <Icon name="ph:check-circle-duotone" class="w-5 h-5 text-emerald-400" />
                                        <span class="text-emerald-400 font-bold">Campaign Posted Successfully!</span>
                                    </div>
                                    <p class="text-white/60 text-sm">Your weekly newsletter is now live across all platforms.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Features Section -->
        <section id="features" class="pb-24 relative overflow-hidden">
            <div class="container-custom">
                <div class="text-center max-w-3xl mx-auto mb-16">
                    <h2 class="animate-on-scroll text-3xl md:text-4xl font-black text-white mb-6">
                        Unlock Your <span class="gradient-text">Social Potential</span>
                    </h2>
                    <p class="animate-on-scroll delay-1 text-lg text-white/70">
                        Powerful features designed to help you automate, optimize, and scale your social media presence with zero effort.
                    </p>
                </div>
                
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    <div class="animate-on-scroll delay-0 glass-card p-8 hover:border-orange-500/30">
                        <div class="h-14 w-14 rounded-2xl bg-gradient-to-br from-orange-500 to-orange-600 flex items-center justify-center mb-6">
                            <Icon name="ph:robot-duotone" class="w-7 h-7 text-white" />
                        </div>
                        <h3 class="text-xl font-bold text-white mb-3">AI Post Generation</h3>
                        <p class="text-white/60 mb-6">Generate engaging social media posts automatically using advanced AI technology tailored to your brand voice.</p>
                        <a href="#demo" class="text-orange-400 font-semibold hover:text-orange-300 inline-flex items-center gap-2 transition-colors">
                            Explore Demo
                            <Icon name="ph:arrow-right" class="w-4 h-4" />
                        </a>
                    </div>
                    
                    <div class="animate-on-scroll delay-100 glass-card p-8 hover:border-orange-500/30">
                        <div class="h-14 w-14 rounded-2xl bg-gradient-to-br from-purple-500 to-purple-600 flex items-center justify-center mb-6">
                            <Icon name="ph:image-square-duotone" class="w-7 h-7 text-white" />
                        </div>
                        <h3 class="text-xl font-bold text-white mb-3">AI Image Generation</h3>
                        <p class="text-white/60 mb-6">Create stunning visuals for your posts with integrated AI-powered image generation tools.</p>
                        <a href="#demo" class="text-orange-400 font-semibold hover:text-orange-300 inline-flex items-center gap-2 transition-colors">
                            Explore Demo
                            <Icon name="ph:arrow-right" class="w-4 h-4" />
                        </a>
                    </div>
                    
                    <div class="animate-on-scroll delay-200 glass-card p-8 hover:border-orange-500/30">
                        <div class="h-14 w-14 rounded-2xl bg-gradient-to-br from-pink-500 to-pink-600 flex items-center justify-center mb-6">
                            <Icon name="ph:share-fat-duotone" class="w-7 h-7 text-white" />
                        </div>
                        <h3 class="text-xl font-bold text-white mb-3">Multi-Platform Support</h3>
                        <p class="text-white/60 mb-6">Schedule posts across Facebook, Instagram, Twitter, TikTok, and LinkedIn from a single dashboard.</p>
                        <a href="#demo" class="text-orange-400 font-semibold hover:text-orange-300 inline-flex items-center gap-2 transition-colors">
                            Explore Demo
                            <Icon name="ph:arrow-right" class="w-4 h-4" />
                        </a>
                    </div>
                    
                    <div class="animate-on-scroll delay-300 glass-card p-8 hover:border-orange-500/30">
                        <div class="h-14 w-14 rounded-2xl bg-gradient-to-br from-blue-500 to-blue-600 flex items-center justify-center mb-6">
                            <Icon name="ph:calendar-dots-duotone" class="w-7 h-7 text-white" />
                        </div>
                        <h3 class="text-xl font-bold text-white mb-3">Content Calendar</h3>
                        <p class="text-white/60 mb-6">Plan and organize your content schedule with an intuitive, drag-and-drop calendar interface.</p>
                        <a href="#demo" class="text-orange-400 font-semibold hover:text-orange-300 inline-flex items-center gap-2 transition-colors">
                            Explore Demo
                            <Icon name="ph:arrow-right" class="w-4 h-4" />
                        </a>
                    </div>
                    
                    <div class="animate-on-scroll delay-400 glass-card p-8 hover:border-orange-500/30">
                        <div class="h-14 w-14 rounded-2xl bg-gradient-to-br from-emerald-500 to-emerald-600 flex items-center justify-center mb-6">
                            <Icon name="ph:chart-line-up-duotone" class="w-7 h-7 text-white" />
                        </div>
                        <h3 class="text-xl font-bold text-white mb-3">Analytics Dashboard</h3>
                        <p class="text-white/60 mb-6">Track performance metrics and analyze engagement across all platforms with clear data visualizations.</p>
                        <a href="#demo" class="text-orange-400 font-semibold hover:text-orange-300 inline-flex items-center gap-2 transition-colors">
                            Explore Demo
                            <Icon name="ph:arrow-right" class="w-4 h-4" />
                        </a>
                    </div>
                    
                    <div class="animate-on-scroll delay-500 glass-card p-8 hover:border-orange-500/30">
                        <div class="h-14 w-14 rounded-2xl bg-gradient-to-br from-cyan-500 to-cyan-600 flex items-center justify-center mb-6">
                            <Icon name="ph:shield-check-duotone" class="w-7 h-7 text-white" />
                        </div>
                        <h3 class="text-xl font-bold text-white mb-3">Secure Authentication</h3>
                        <p class="text-white/60 mb-6">Enterprise-grade security with OAuth support for safe, authorized social media platform connections.</p>
                        <a href="#demo" class="text-orange-400 font-semibold hover:text-orange-300 inline-flex items-center gap-2 transition-colors">
                            Explore Demo
                            <Icon name="ph:arrow-right" class="w-4 h-4" />
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- Admin & User Features Section -->
        <section class="pb-24 relative overflow-hidden">
            <div class="container-custom">
                <div class="text-center max-w-3xl mx-auto mb-16">
                    <h2 class="animate-on-scroll text-3xl md:text-4xl font-black text-white mb-6">
                        Powerful <span class="gradient-text">Admin & User Features</span>
                    </h2>
                    <p class="animate-on-scroll delay-1 text-lg text-white/70">
                        A complete solution for both administrators and end-users to manage social media automation at scale.
                    </p>
                </div>
                
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                    <div class="animate-on-scroll delay-0 glass-card p-8 hover:border-orange-500/30">
                        <div class="flex items-center gap-3 mb-8">
                            <div class="h-12 w-12 rounded-xl bg-gradient-to-br from-orange-500 to-orange-600 flex items-center justify-center">
                                <Icon name="ph:shield-star-duotone" class="w-6 h-6 text-white" />
                            </div>
                            <h3 class="text-2xl font-bold text-white">Admin Features</h3>
                        </div>
                        
                        <div class="space-y-6">
                            <div class="flex items-start gap-4">
                                <div class="h-10 w-10 rounded-lg bg-orange-500/20 flex items-center justify-center flex-shrink-0 mt-0.5">
                                    <Icon name="ph:users-three-duotone" class="w-5 h-5 text-orange-400" />
                                </div>
                                <div>
                                    <span class="text-white font-semibold block">User Management</span>
                                    <span class="text-white/50 text-sm">Create and manage user accounts with role-based access control.</span>
                                </div>
                            </div>
                            
                            <div class="flex items-start gap-4">
                                <div class="h-10 w-10 rounded-lg bg-orange-500/20 flex items-center justify-center flex-shrink-0 mt-0.5">
                                    <Icon name="ph:gear-six-duotone" class="w-5 h-5 text-orange-400" />
                                </div>
                                <div>
                                    <span class="text-white font-semibold block">Platform Settings</span>
                                    <span class="text-white/50 text-sm">Configure social media platform APIs and OAuth integrations.</span>
                                </div>
                            </div>
                            
                            <div class="flex items-start gap-4">
                                <div class="h-10 w-10 rounded-lg bg-orange-500/20 flex items-center justify-center flex-shrink-0 mt-0.5">
                                    <Icon name="ph:sliders-horizontal-duotone" class="w-5 h-5 text-orange-400" />
                                </div>
                                <div>
                                    <span class="text-white font-semibold block">System Settings</span>
                                    <span class="text-white/50 text-sm">Manage email notifications, payments, and system backups.</span>
                                </div>
                            </div>
                            
                            <div class="flex items-start gap-4">
                                <div class="h-10 w-10 rounded-lg bg-orange-500/20 flex items-center justify-center flex-shrink-0 mt-0.5">
                                    <Icon name="ph:chart-bar-duotone" class="w-5 h-5 text-orange-400" />
                                </div>
                                <div>
                                    <span class="text-white font-semibold block">Analytics & Reports</span>
                                    <span class="text-white/50 text-sm">Global dashboard for revenue, subscriptions, and user statistics.</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="animate-on-scroll delay-100 glass-card p-8 hover:border-purple-500/30">
                        <div class="flex items-center gap-3 mb-8">
                            <div class="h-12 w-12 rounded-xl bg-gradient-to-br from-purple-500 to-purple-600 flex items-center justify-center">
                                <Icon name="ph:user-circle-duotone" class="w-6 h-6 text-white" />
                            </div>
                            <h3 class="text-2xl font-bold text-white">User Features</h3>
                        </div>
                        
                        <div class="space-y-6">
                            <div class="flex items-start gap-4">
                                <div class="h-10 w-10 rounded-lg bg-purple-500/20 flex items-center justify-center flex-shrink-0 mt-0.5">
                                    <Icon name="ph:calendar-check-duotone" class="w-5 h-5 text-purple-400" />
                                </div>
                                <div>
                                    <span class="text-white font-semibold block">Post Scheduling</span>
                                    <span class="text-white/50 text-sm">Plan and automate your social media presence with bulk scheduling.</span>
                                </div>
                            </div>
                            
                            <div class="flex items-start gap-4">
                                <div class="h-10 w-10 rounded-lg bg-purple-500/20 flex items-center justify-center flex-shrink-0 mt-0.5">
                                    <Icon name="ph:magic-wand-duotone" class="w-5 h-5 text-purple-400" />
                                </div>
                                <div>
                                    <span class="text-white font-semibold block">AI Content Tools</span>
                                    <span class="text-white/50 text-sm">Generate high-quality posts and images using advanced AI models.</span>
                                </div>
                            </div>
                            
                            <div class="flex items-start gap-4">
                                <div class="h-10 w-10 rounded-lg bg-purple-500/20 flex items-center justify-center flex-shrink-0 mt-0.5">
                                    <Icon name="ph:image-duotone" class="w-5 h-5 text-purple-400" />
                                </div>
                                <div>
                                    <span class="text-white font-semibold block">Media Library</span>
                                    <span class="text-white/50 text-sm">Centralized storage and management for all your social media assets.</span>
                                </div>
                            </div>
                            
                            <div class="flex items-start gap-4">
                                <div class="h-10 w-10 rounded-lg bg-purple-500/20 flex items-center justify-center flex-shrink-0 mt-0.5">
                                    <Icon name="ph:users-duotone" class="w-5 h-5 text-purple-400" />
                                </div>
                                <div>
                                    <span class="text-white font-semibold block">Team Collaboration</span>
                                    <span class="text-white/50 text-sm">Invite team members and manage seamless approval workflows.</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Platforms Section -->
        <section class="pb-24 relative overflow-hidden">
            <div class="container-custom">
                <div class="text-center max-w-3xl mx-auto mb-16">
                    <h2 class="animate-on-scroll text-3xl md:text-4xl font-black text-white mb-6">
                        Post to All Your <span class="gradient-text">Favorite Platforms</span>
                    </h2>
                    <p class="animate-on-scroll delay-1 text-lg text-white/70">
                        Native integrations with the world's most popular social networks. One dashboard, infinite reach.
                    </p>
                </div>
                
                <div class="animate-on-scroll delay-200 flex flex-wrap justify-center gap-8 md:gap-12">
                    <div class="glass-card p-6 hover:border-blue-500/30 transition-all hover:-translate-y-1">
                        <Icon name="ph:facebook-logo-duotone" class="w-12 h-12 text-blue-500 mb-2" />
                        <span class="text-white font-semibold block text-center">Facebook</span>
                    </div>
                    <div class="glass-card p-6 hover:border-pink-500/30 transition-all hover:-translate-y-1">
                        <Icon name="ph:instagram-logo-duotone" class="w-12 h-12 text-pink-500 mb-2" />
                        <span class="text-white font-semibold block text-center">Instagram</span>
                    </div>
                    <div class="glass-card p-6 hover:border-sky-500/30 transition-all hover:-translate-y-1">
                        <Icon name="ph:x-logo-duotone" class="w-12 h-12 text-sky-500 mb-2" />
                        <span class="text-white font-semibold block text-center">Twitter (X)</span>
                    </div>
                    <div class="glass-card p-6 hover:border-rose-500/30 transition-all hover:-translate-y-1">
                        <Icon name="ph:tiktok-logo-duotone" class="w-12 h-12 text-rose-500 mb-2" />
                        <span class="text-white font-semibold block text-center">TikTok</span>
                    </div>
                    <div class="glass-card p-6 hover:border-blue-600/30 transition-all hover:-translate-y-1">
                        <Icon name="ph:linkedin-logo-duotone" class="w-12 h-12 text-blue-600 mb-2" />
                        <span class="text-white font-semibold block text-center">LinkedIn</span>
                    </div>
                    <div class="glass-card p-6 hover:border-red-500/30 transition-all hover:-translate-y-1">
                        <Icon name="ph:pinterest-logo-duotone" class="w-12 h-12 text-red-500 mb-2" />
                        <span class="text-white font-semibold block text-center">Pinterest</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- Built On Laravel Section -->
        <section class="pb-24 relative overflow-hidden">
            <div class="container-custom">
                <div class="glass-card p-10 md:p-16 text-center">
                    <div class="max-w-3xl mx-auto">
                        <h2 class="animate-on-scroll text-3xl md:text-4xl font-black text-white mb-6">
                            Built on <span class="gradient-text">Laravel 12</span>
                        </h2>
                        <p class="animate-on-scroll delay-1 text-lg text-white/70 mb-10">
                            We use the latest stable version of Laravel to ensure maximum performance, security, and developer joy. Scale your agency with confidence on a rock-solid foundation.
                        </p>
                        
                        <div class="animate-on-scroll delay-2 flex flex-wrap justify-center gap-6 mb-12">
                            <div class="px-6 py-3 rounded-full bg-orange-500/20 border border-orange-500/30 text-orange-400 font-semibold">
                                Laravel 12
                            </div>
                            <div class="px-6 py-3 rounded-full bg-blue-500/20 border border-blue-500/30 text-blue-400 font-semibold">
                                Bootstrap 5
                            </div>
                            <div class="px-6 py-3 rounded-full bg-yellow-500/20 border border-yellow-500/30 text-yellow-400 font-semibold">
                                jQuery
                            </div>
                        </div>
                        
                        <div class="animate-on-scroll delay-300 glass-card p-6 text-left max-w-xl mx-auto">
                            <div class="space-y-4 font-mono text-sm">
                                <div>
                                    <span class="text-white/40">// Initialize your agency</span>
                                </div>
                                <div>
                                    <span class="text-purple-400">composer</span> <span class="text-white">require</span> <span class="text-orange-400">laravel-social/core</span>
                                </div>
                                <div class="h-2"></div>
                                <div>
                                    <span class="text-white/40">// Configure AI Engines</span>
                                </div>
                                <div>
                                    <span class="text-purple-400">AI</span><span class="text-white">::</span><span class="text-blue-400">engine</span><span class="text-white">(</span><span class="text-orange-400">'gpt-4'</span><span class="text-white">);</span>
                                </div>
                                <div>
                                    <span class="text-purple-400">AI</span><span class="text-white">::</span><span class="text-blue-400">engine</span><span class="text-white">(</span><span class="text-orange-400">'dalle-3'</span><span class="text-white">);</span>
                                </div>
                                <div class="h-2"></div>
                                <div>
                                    <span class="text-white/40">// Start dominating</span>
                                </div>
                                <div>
                                    <span class="text-purple-400">php</span> <span class="text-white">artisan</span> <span class="text-orange-400">social:automate</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- What You Get Section -->
        <section class="pb-24 relative overflow-hidden">
            <div class="container-custom">
                <div class="text-center max-w-3xl mx-auto mb-16">
                    <h2 class="animate-on-scroll text-3xl md:text-4xl font-black text-white mb-6">
                        What You Will <span class="gradient-text">Get</span>
                    </h2>
                    <p class="animate-on-scroll delay-1 text-lg text-white/70">
