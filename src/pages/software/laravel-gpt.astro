---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Laravel GPT — Multi-Agent AI Platform | Laravel GPT">
	<main>
		<!-- Hero Section -->
		<section class="pt-20 pb-16 md:pt-28 md:pb-24 overflow-hidden">
			<div class="container-custom">
				<div
					class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center"
				>
					<div>
						<h1
							class="animate-on-scroll delay-0 text-4xl md:text-5xl lg:text-6xl font-bold leading-tight"
						>
							Build & Manage Multiple AI Agents with <span
								class="gradient-text">Laravel GPT</span
							>
						</h1>
						<p
							class="animate-on-scroll delay-1 mt-6 text-xl text-gray-400 max-w-lg"
						>
							An open-source, self-hosted **Laravel-native**
							platform to create, orchestrate and embed multiple
							AI agents — including interactive 3D chat avatars —
							directly into your Laravel apps and websites.
						</p>
						<div class="animate-on-scroll delay-2 mt-8 flex gap-4">
							<a
								href="https://laravelgpt.com"
								class="btn btn-primary"
								target="_blank">Get Started</a
							>
							<a href="#features" class="btn btn-secondary"
								>Explore Features</a
							>
						</div>
					</div>
					<div class="animate-on-scroll delay-3">
						<div class="relative">
							<div
								class="absolute -inset-0.5 bg-gradient-to-r from-indigo-500 to-purple-500 rounded-xl blur opacity-30"
							>
							</div>
							<div
								class="relative bg-white/10 rounded-xl shadow-xl overflow-hidden p-8"
							>
								<!--<img src="/assets/laravel-gpt-logo.svg" alt="Laravel GPT logo" class="mb-6 w-36" />-->
								<div class="space-y-6">
									<div class="flex items-center gap-4">
										<div
											class="w-12 h-12 bg-indigo-900/20 rounded-lg flex items-center justify-center"
										>
											<!-- Icon: Multi-Agent -->
											<svg
												class="w-6 h-6 text-indigo-600"
												viewBox="0 0 24 24"
												fill="none"
												xmlns="http://www.w3.org/2000/svg"
											>
												<path
													d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zM4 20c0-2.21 3.58-4 8-4s8 1.79 8 4v1H4v-1z"
													stroke="currentColor"
													stroke-width="1.5"
													stroke-linecap="round"
													stroke-linejoin="round"
												></path>
											</svg>
										</div>
										<div>
											<h3
												class="font-semibold text-white"
											>
												Multi-Agent Management
											</h3>
											<p class="text-gray-400">
												Create, version, and orchestrate
												agent fleets — chat, assistant,
												specialist, and tools — from one
												dashboard.
											</p>
										</div>
									</div>
									<div class="flex items-center gap-4">
										<div
											class="w-12 h-12 bg-purple-900/20 rounded-lg flex items-center justify-center"
										>
											<!-- Icon: 3D Agent -->
											<svg
												class="w-6 h-6 text-purple-600"
												viewBox="0 0 24 24"
												fill="none"
												xmlns="http://www.w3.org/2000/svg"
											>
												<path
													d="M12 2v6"
													stroke="currentColor"
													stroke-width="1.5"
													stroke-linecap="round"
													stroke-linejoin="round"
												></path>
												<path
													d="M4 22a8 8 0 0116 0"
													stroke="currentColor"
													stroke-width="1.5"
													stroke-linecap="round"
													stroke-linejoin="round"
												></path>
											</svg>
										</div>
										<div>
											<h3
												class="font-semibold text-white"
											>
												3D Chat Avatars
											</h3>
											<p class="text-gray-400">
												Embeddable WebGL-based 3D
												avatars with voice and lip-sync
												for immersive customer
												interactions.
											</p>
										</div>
									</div>
									<div class="flex items-center gap-4">
										<div
											class="w-12 h-12 bg-indigo-900/20 rounded-lg flex items-center justify-center"
										>
											<!-- Icon: Integrations -->
											<svg
												class="w-6 h-6 text-indigo-600"
												viewBox="0 0 24 24"
												fill="none"
												xmlns="http://www.w3.org/2000/svg"
											>
												<path
													d="M3 12h18"
													stroke="currentColor"
													stroke-width="1.5"
													stroke-linecap="round"
													stroke-linejoin="round"
												></path>
												<path
													d="M12 3v18"
													stroke="currentColor"
													stroke-width="1.5"
													stroke-linecap="round"
													stroke-linejoin="round"
												></path>
											</svg>
										</div>
										<div>
											<h3
												class="font-semibold text-white"
											>
												Deep Integrations
											</h3>
											<p class="text-gray-400">
												Native Laravel SDK, Blade
												components, Artisan CLI and REST
												API for full control.
											</p>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Features / Benefits Section -->
		<section id="features" class="section bg-white/5">
			<div class="container-custom">
				<h2
					class="animate-on-scroll delay-0 text-3xl md:text-4xl font-bold text-center mb-12"
				>
					Why Choose <span class="gradient-text">Laravel GPT</span>?
				</h2>

				<div class="space-y-8">
					<div class="animate-on-scroll delay-1 feature-card">
						<h3 class="text-xl font-semibold mb-3">
							Agent Orchestration Studio
						</h3>
						<p class="text-gray-400">
							Design complex multi-agent workflows visually. Chain
							agents, route messages, call external tools, and run
							scheduled or event-driven pipelines — all in
							Laravel-native UI.
						</p>
					</div>

					<div class="animate-on-scroll delay-2 feature-card">
						<h3 class="text-xl font-semibold mb-3">
							Embeddable 3D Chat Widgets
						</h3>
						<p class="text-gray-400">
							Drop-in WebGL avatars with a tiny JS client.
							Supports text, voice, video, and contextual memory.
							Use our simple snippet to embed:
						</p>
					</div>

					<div class="animate-on-scroll delay-3 feature-card">
						<h3 class="text-xl font-semibold mb-3">
							Marketplace & Agent Blueprints
						</h3>
						<p class="text-gray-400">
							Ship agents quickly using pre-built blueprints:
							customer support, hiring assistant, code helper,
							analytics bot, and more. Customize behaviors with
							policies, tools, and prompts.
						</p>
					</div>

					<div class="animate-on-scroll delay-4 feature-card">
						<h3 class="text-xl font-semibold mb-3">
							Security, Privacy & Compliance
						</h3>
						<p class="text-gray-400">
							Self-hosted deployment keeps data on your
							infrastructure. Role-based access, encrypted
							storage, audit logs, and GDPR-ready data controls.
						</p>
					</div>

					<div class="animate-on-scroll delay-5 feature-card">
						<h3 class="text-xl font-semibold mb-3">
							Developer-Friendly
						</h3>
						<p class="text-gray-400">
							Laravel-first SDK, Blade & Vue components, and
							Artisan commands to scaffold agents, run local
							simulators, and deploy to staging/production.
						</p>
					</div>

					<div class="animate-on-scroll delay-6 feature-card">
						<h3 class="text-xl font-semibold mb-3">
							Observability & Analytics
						</h3>
						<p class="text-gray-400">
							Monitor agent conversations, latency, token usage,
							and user satisfaction. Built-in A/B testing for
							prompts and agent behaviors.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Tech Section -->
		<section class="section bg-white/10">
			<div class="container-custom">
				<h2
					class="animate-on-scroll delay-0 text-3xl md:text-4xl font-bold text-center mb-16"
				>
					Under The Hood: <span class="gradient-text"
						>Technology & Architecture</span
					>
				</h2>

				<div
					class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
				>
					<div
						class="animate-on-scroll delay-1 feature-card hover:shadow-xl transition-shadow duration-300"
					>
						<h3 class="text-lg font-semibold mb-2">
							Self-Hosted Laravel Core
						</h3>
						<p class="text-gray-400">
							Run the agent management server on your
							infrastructure, with optional managed gateway for
							updates and model connectors.
						</p>
					</div>

					<div
						class="animate-on-scroll delay-2 feature-card hover:shadow-xl transition-shadow duration-300"
					>
						<h3 class="text-lg font-semibold mb-2">
							Pluggable Model Connectors
						</h3>
						<p class="text-gray-400">
							Connect to local LLMs, private model endpoints, or
							commercial APIs. Swap providers without changing
							agent logic.
						</p>
					</div>

					<div
						class="animate-on-scroll delay-3 feature-card hover:shadow-xl transition-shadow duration-300"
					>
						<h3 class="text-lg font-semibold mb-2">
							Realtime Message Bus
						</h3>
						<p class="text-gray-400">
							WebSocket / WebRTC channels for low-latency chat and
							voice streams to 3D avatars and web clients.
						</p>
					</div>

					<div
						class="animate-on-scroll delay-4 feature-card hover:shadow-xl transition-shadow duration-300"
					>
						<h3 class="text-lg font-semibold mb-2">
							Policies & Tooling
						</h3>
						<p class="text-gray-400">
							Agent policies, tool interfaces (databases, search,
							calculators), and secure tool sandboxes for safe
							actions.
						</p>
					</div>

					<div
						class="animate-on-scroll delay-5 feature-card hover:shadow-xl transition-shadow duration-300"
					>
						<h3 class="text-lg font-semibold mb-2">
							Edge-Ready Widgets
						</h3>
						<p class="text-gray-400">
							Tiny JS bundle for embedding 3D avatars and chat UIs
							that run on the edge with graceful degradation for
							low-power devices.
						</p>
					</div>

					<div
						class="animate-on-scroll delay-6 feature-card hover:shadow-xl transition-shadow duration-300"
					>
						<h3 class="text-lg font-semibold mb-2">
							Versioned Agents & Git Sync
						</h3>
						<p class="text-gray-400">
							Sync agent definitions, prompts, and blueprints to
							Git for code review, branching and CI-based
							promotion workflows.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Example Embed / Live Preview -->
		<section class="section bg-white/5">
			<div class="container-custom">
				<h2
					class="animate-on-scroll delay-0 text-3xl md:text-4xl font-bold text-center mb-8"
				>
					Live Embed Example
				</h2>
				<div
					class="mx-auto max-w-3xl p-6 bg-white/10 rounded-xl shadow"
				>
					<p class="text-gray-400 mb-4">
						This is a static preview of an embeddable 3D chat agent.
						In a real install the following component connects to
						your Laravel GPT backend.
					</p>
					<!-- Placeholder 3D avatar container -->
					<div
						class="w-full h-64 rounded-lg bg-gradient-to-br from-white/5 to-white/10 border border-white/10 flex items-center justify-center"
					>
						<div class="text-center text-gray-400">
							<p class="mb-2">[3D Avatar Preview]</p>
							<pre
								class="text-sm bg-white/5 p-2 rounded">&lt;laravel-gpt-agent agent="welcome-bot" /&gt;</pre>
						</div>
					</div>
					<p class="mt-4 text-sm text-gray-400">Embed snippet:</p>
					<pre
						class="mt-2 p-3 bg-white/5 rounded text-sm overflow-auto"><code>&lt;script src="https://cdn.yourdomain.com/laravel-gpt/widget.js"&gt;&lt;/script&gt;
&lt;laravel-gpt-agent agent="welcome-bot" channel="websocket" /&gt;</code></pre>
				</div>
			</div>
		</section>

		<!-- CTA Section -->
		<section class="section bg-gradient-to-r from-red-600 to-orange-600">
			<div class="container-custom text-center">
				<h2
					class="animate-on-scroll delay-0 text-3xl md:text-4xl font-bold text-white mb-8"
				>
					Ready to Run Your Own AI Agent Fleet?
				</h2>
				<p
					class="animate-on-scroll delay-1 text-xl text-white/90 mb-10 max-w-2xl mx-auto"
				>
					Get started with our open-source, self-hosted <strong
						>Laravel GPT</strong
					> platform — full control, multi-agent orchestration, and embeddable
					3D chat experiences.
				</p>
				<div
					class="animate-on-scroll delay-2 flex flex-col sm:flex-row gap-4 justify-center"
				>
					<a
						href="https://laravelgpt.com"
						class="btn bg-white/10 text-white hover:bg-white/20"
						target="_blank">View Docs</a
					>
					<a
						href="/contact"
						class="btn border-2 border-white text-white hover:bg-white/10 hover:text-indigo-600"
						>Talk to Sales</a
					>
				</div>
			</div>
		</section>
	</main>
</Layout>
