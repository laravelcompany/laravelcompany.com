---
import Layout from "../../layouts/Layout.astro";
import Logo from "../../assets/logos/laravel-mail.svg";
import { Image } from "astro:assets";
---

<Layout title="Laravel Mail - Self-Hosted Email Marketing Software">
	<!-- SoftwareApplication Schema -->
	<script type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@type": "SoftwareApplication",
			"name": "Laravel Mail",
			"applicationCategory": "BusinessApplication",
			"operatingSystem": "Web",
			"url": "https://laravelmail.com",
			"description": "Self-hosted email marketing and automation platform for Laravel. Send campaigns, manage subscribers, and track performance with powerful analytics.",
			"creator": {
				"@type": "Organization",
				"name": "Laravel Company",
				"url": "https://laravelcompany.com"
			},
			"offers": {
				"@type": "Offer",
				"price": "99",
				"priceCurrency": "GBP"
			},
			"featureList": [
				"Campaign management",
				"Subscriber segmentation",
				"Automated drip campaigns",
				"Drag-and-drop email builder",
				"API integrations",
				"Analytics and tracking"
			]
		}
	</script>
	<main>
		<!-- Hero Section -->
		<section class="pt-20 pb-16 md:pt-28 md:pb-24 overflow-hidden">
			<div class="container-custom">
				<div
					class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center"
				>
					<div>
						<h1
							class="animate-on-scroll delay-0 text-4xl md:text-5xl lg:text-6xl font-bold leading-tight"
						>
							Email Marketing Sooftware <br /><span
								class="gradient-text">Laravel Mail</span
							>
						</h1>
						<p
							class="animate-on-scroll delay-1 mt-6 text-xl text-gray-400 max-w-lg"
						>
							A fully <b>self hosted</b>, email marketing software
							with automation. <br />
							Build powerful workflows with drag-and-drop, send transactional
							and marketing emails, and keep full control over your
							data.
						</p>
						<div class="animate-on-scroll delay-2 mt-8 flex gap-4">
							<a
								href="https://laravelmail.com/"
								class="btn btn-primary"
								target="_blank">Get Started</a
							>
							<a href="#features" class="btn btn-secondary"
								>Explore Features</a
							>
						</div>
					</div>
					<div class="animate-on-scroll delay-3">
						<div class="relative">
							<div
								class="absolute -inset-0.5 bg-gradient-to-r from-red-500 to-orange-500 rounded-xl blur opacity-30"
							>
							</div>
							<div
								class="relative bg-white/10 rounded-xl shadow-xl overflow-hidden p-8"
							>
								<Image src={Logo} alt="logo laravel mail" />
								<div class="space-y-6">
									<div class="flex items-center gap-4">
										<div
											class="w-12 h-12 bg-red-900/20 rounded-lg flex items-center justify-center"
										>
											<!-- Icon for Marketing / Campaigns -->
											<svg
												class="w-6 h-6 text-red-600"
												viewBox="0 0 24 24"
												fill="none"
												xmlns="http://www.w3.org/2000/svg"
											>
												<path
													d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"
													stroke="currentColor"
													stroke-width="2"
													stroke-linecap="round"
													stroke-linejoin="round"
												></path>
											</svg>
										</div>
										<div>
											<h3
												class="font-semibold text-white"
											>
												Marketing Automation
											</h3>
											<p class="text-gray-400">
												Visual workflow builder + drip
												campaigns
											</p>
										</div>
									</div>
									<div class="flex items-center gap-4">
										<div
											class="w-12 h-12 bg-orange-900/20 rounded-lg flex items-center justify-center"
										>
											<!-- Icon for Transactional Emails -->
											<svg
												class="w-6 h-6 text-orange-400"
												viewBox="0 0 24 24"
												fill="none"
												xmlns="http://www.w3.org/2000/svg"
											>
												<path
													d="M13 10V3L4 14h7v7l9-11h-7z"
													stroke="currentColor"
													stroke-width="2"
													stroke-linecap="round"
													stroke-linejoin="round"
												></path>
											</svg>
										</div>
										<div>
											<h3
												class="font-semibold text-white"
											>
												Transactional Emails
											</h3>
											<p class="text-gray-400">
												Send custom system emails via
												Laravel Mail API
											</p>
										</div>
									</div>
									<div class="flex items-center gap-4">
										<div
											class="w-12 h-12 bg-red-900/20 rounded-lg flex items-center justify-center"
										>
											<!-- Icon for Analytics / Deliverability -->
											<svg
												class="w-6 h-6 text-red-600"
												viewBox="0 0 24 24"
												fill="none"
												xmlns="http://www.w3.org/2000/svg"
											>
												<path
													d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"
													stroke="currentColor"
													stroke-width="2"
													stroke-linecap="round"
													stroke-linejoin="round"
												></path>
												<polyline
													points="7.5,4.21 12,6.81 16.5,4.21"
													stroke="currentColor"
													stroke-width="2"
													stroke-linecap="round"
													stroke-linejoin="round"
												></polyline>
												<polyline
													points="7.5,19.79 7.5,14.6 3,12"
													stroke="currentColor"
													stroke-width="2"
													stroke-linecap="round"
													stroke-linejoin="round"
												></polyline>
												<polyline
													points="21,12 16.5,14.6 16.5,19.79"
													stroke="currentColor"
													stroke-width="2"
													stroke-linecap="round"
													stroke-linejoin="round"
												></polyline>
												<polyline
													points="12,22.81 12,17"
													stroke="currentColor"
													stroke-width="2"
													stroke-linecap="round"
													stroke-linejoin="round"
												></polyline>
												<line
													x1="12"
													y1="6.81"
													x2="12"
													y2="12"
													stroke="currentColor"
													stroke-width="2"
													stroke-linecap="round"
													stroke-linejoin="round"
												></line>
											</svg>
										</div>
										<div>
											<h3
												class="font-semibold text-white"
											>
												Deliverability & Analytics
											</h3>
											<p class="text-gray-400">
												Real-time tracking, IP
												reputation, A/B testing
											</p>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Features / Benefits Section -->
		<section id="features" class="section bg-white/5">
			<div class="container-custom">
				<h2
					class="animate-on-scroll delay-0 text-3xl md:text-4xl font-bold text-center mb-12"
				>
					Why Choose <span class="gradient-text">Laravel Mail</span>?
				</h2>

				<div class="space-y-8">
					<div class="animate-on-scroll delay-1 feature-card">
						<h3 class="text-xl font-semibold mb-3">
							Visual Automation & Workflow Builder
						</h3>
						<p class="text-gray-400">
							Design advanced customer journeys using our
							intuitive drag-and-drop builder. Trigger emails
							based on Laravel events (like registration or
							purchase), set delays, conditional logic, and
							multi-step automations — all without writing
							boilerplate code.
						</p>
					</div>

					<div class="animate-on-scroll delay-2 feature-card">
						<h3 class="text-xl font-semibold mb-3">
							Full Laravel Native Integration
						</h3>
						<p class="text-gray-400">
							Seamlessly plug Laravel Mail into your Laravel apps.
							Use Blade templates, Artisan commands, and Laravel’s
							Mail facade natively — no need for complicated API
							workarounds.
						</p>
					</div>

					<div class="animate-on-scroll delay-3 feature-card">
						<h3 class="text-xl font-semibold mb-3">
							2000+ Responsive Email Templates
						</h3>
						<p class="text-gray-400">
							Build pixel-perfect emails with hundreds of
							mobile-friendly, responsive designs. Choose from
							drag-and-drop editor, code editor, or Blade-based
							templates — all highly customizable. :
						</p>
					</div>

					<div class="animate-on-scroll delay-4 feature-card">
						<h3 class="text-xl font-semibold mb-3">
							Advanced Analytics & Deliverability
						</h3>
						<p class="text-gray-400">
							Track open rates, click rates, and more. Run split
							tests to optimize campaigns. Plus, monitor your IP
							reputation, warm-up settings, and set up SPF, DKIM,
							DMARC to maximize email deliverability.
						</p>
					</div>

					<div class="animate-on-scroll delay-5 feature-card">
						<h3 class="text-xl font-semibold mb-3">
							Email Intelligence & Validation
						</h3>
						<p class="text-gray-400">
							Protect your sender reputation with email
							validation, identity matching, and risk scoring.
							Reduce bounce rates and enhance email quality with
							Forensic Email Intelligence™ powered by Laravel
							Mail. :
						</p>
					</div>

					<div class="animate-on-scroll delay-6 feature-card">
						<h3 class="text-xl font-semibold mb-3">
							Version-Controlled Email Development
						</h3>
						<p class="text-gray-400">
							Manage your Blade email templates in Git. Use
							staging workflows, branch-based previews, and CI/CD
							to deploy with confidence — with full version
							control and rollback when needed.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Workflow / Tech Section -->
		<section class="section bg-white/10">
			<div class="container-custom">
				<h2
					class="animate-on-scroll delay-0 text-3xl md:text-4xl font-bold text-center mb-16"
				>
					Under The Hood: <span class="gradient-text"
						>Technology & Architecture</span
					>
				</h2>

				<div
					class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
				>
					<div
						class="animate-on-scroll delay-1 feature-card hover:shadow-xl transition-shadow duration-300"
					>
						<h3 class="text-lg font-semibold mb-2">
							Self-Hosted Laravel Platform
						</h3>
						<p class="text-gray-400">
							Run the entire marketing stack on your own
							infrastructure, keeping full control of your data
							and costs.
						</p>
					</div>

					<div
						class="animate-on-scroll delay-2 feature-card hover:shadow-xl transition-shadow duration-300"
					>
						<h3 class="text-lg font-semibold mb-2">
							Workflow Engine
						</h3>
						<p class="text-gray-400">
							Triggers, tasks, and data buses let you build
							complex automation using model events, button
							clicks, or custom logic.
						</p>
					</div>

					<div
						class="animate-on-scroll delay-3 feature-card hover:shadow-xl transition-shadow duration-300"
					>
						<h3 class="text-lg font-semibold mb-2">
							Multi-SMTP & Mail Transport
						</h3>
						<p class="text-gray-400">
							Use multiple SMTP servers, verify them in parallel,
							and use high-throughput sending.
						</p>
					</div>

					<div
						class="animate-on-scroll delay-4 feature-card hover:shadow-xl transition-shadow duration-300"
					>
						<h3 class="text-lg font-semibold mb-2">
							Secure Analytics
						</h3>
						<p class="text-gray-400">
							Analytics are fully GDPR compliant, encrypted, and
							optional so you own your subscriber data.
						</p>
					</div>

					<div
						class="animate-on-scroll delay-5 feature-card hover:shadow-xl transition-shadow duration-300"
					>
						<h3 class="text-lg font-semibold mb-2">
							A/B Testing / Split Testing
						</h3>
						<p class="text-gray-400">
							Experiment with campaign variants to identify what
							resonates best with your audience, optimizing
							performance.
						</p>
					</div>

					<div
						class="animate-on-scroll delay-6 feature-card hover:shadow-xl transition-shadow duration-300"
					>
						<h3 class="text-lg font-semibold mb-2">
							GDPR-Compliant Workflows
						</h3>
						<p class="text-gray-400">
							Built-in unsubscribe and consent tools, encrypted
							tracking, and data control empower you to stay fully
							compliant.
						</p>
					</div>
				</div>
			</div>
		</section>
		<!-- Intent Matcher Section - Prevents SERP Demotion -->
		<section class="bg-blue-900/20 border-b border-blue-900/30 py-8">
			<div class="container-custom">
				<div class="max-w-4xl mx-auto">
					<h2 class="text-2xl font-bold text-white mb-4">
						When to Choose Laravel Mail Over SaaS Alternatives
					</h2>
					<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
						<div
							class="bg-white/10 p-4 rounded-lg border border-blue-500/30"
						>
							<h3 class="font-semibold text-white mb-2">
								✓ Perfect For:
							</h3>
							<ul class="text-gray-300 space-y-1 text-sm">
								<li>
									• Sending 100K+ emails/month without
									escalating SaaS costs
								</li>
								<li>
									• GDPR/data sovereignty requiring
									self-hosted infrastructure
								</li>
								<li>
									• Teams already using Laravel wanting native
									integration
								</li>
								<li>
									• Git-based email template versioning and
									CI/CD workflows
								</li>
								<li>
									• Advanced automation exceeding
									Mailchimp/SendGrid capabilities
								</li>
							</ul>
						</div>
						<div
							class="bg-white/10 p-4 rounded-lg border border-blue-500/30"
						>
							<h3 class="font-semibold text-white mb-2">
								Cost Comparison:
							</h3>
							<p class="text-gray-300 text-sm mb-2">
								<strong>Mailchimp (100K contacts):</strong> $350-500/month
							</p>
							<p class="text-gray-300 text-sm mb-2">
								<strong>SendGrid (1M emails):</strong> $89-249/month
							</p>
							<p class="text-red-600 font-semibold text-sm">
								Laravel Mail: One-time license + hosting costs
								(~$50-100/month for VPS)
							</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Email Deliverability Deep Dive Section -->
		<section class="section bg-white/5">
			<div class="container-custom">
				<h2
					class="animate-on-scroll delay-0 text-3xl md:text-4xl font-bold text-center mb-12"
				>
					Email Deliverability Engineering
				</h2>

				<div class="max-w-5xl mx-auto">
					<div class="animate-on-scroll delay-1 mb-8">
						<h3 class="text-2xl font-bold mb-4">
							Why Self-Hosted Improves Deliverability
						</h3>
						<p class="text-gray-300 mb-4">
							Shared IP reputation on SaaS platforms means one bad
							sender affects everyone. When you share IPs with
							thousands of other senders on Mailchimp or
							SendGrid's shared infrastructure, your
							deliverability is tied to their behavior. With
							Laravel Mail, you control your sending
							infrastructure and reputation completely.
						</p>

						<div
							class="bg-white/10 p-6 rounded-lg border-2 border-blue-500/30 mb-6"
						>
							<h4 class="font-semibold text-lg mb-3">
								Deliverability Comparison:
							</h4>
							<div class="space-y-3">
								<div
									class="flex justify-between items-center pb-2 border-b"
								>
									<span class="text-gray-300 font-medium"
										>Shared IP (SaaS platforms)</span
									>
									<span class="text-orange-400 font-semibold"
										>82-87% inbox rate</span
									>
								</div>
								<div
									class="flex justify-between items-center pb-2 border-b"
								>
									<span class="text-gray-300 font-medium"
										>Dedicated IP (premium SaaS)</span
									>
									<span class="text-blue-400 font-semibold"
										>88-92% inbox rate</span
									>
								</div>
								<div
									class="flex justify-between items-center pb-2"
								>
									<span class="text-gray-300 font-medium"
										>Self-hosted with proper setup</span
									>
									<span class="text-green-400 font-bold"
										>93-97% inbox rate</span
									>
								</div>
							</div>
						</div>
					</div>

					<div class="animate-on-scroll delay-2 space-y-6">
						<h3 class="text-2xl font-bold mb-4">
							Built-in Deliverability Tools
						</h3>

						<div
							class="bg-white/10 p-6 rounded-lg border-l-4 border-red-500"
						>
							<h4 class="font-semibold text-lg mb-3 text-red-400">
								IP Warm-up Scheduler
							</h4>
							<p class="text-gray-300 mb-3">
								When you start sending from a new IP address,
								ISPs don't trust you yet. Our automated warm-up
								scheduler gradually increases sending volume
								over 4-6 weeks, building reputation with Gmail,
								Outlook, Yahoo, and other major providers.
							</p>
							<div class="bg-white/5 p-4 rounded">
								<p
									class="text-sm text-gray-300 font-semibold mb-2"
								>
									Warm-up Schedule Example:
								</p>
								<ul class="text-sm text-gray-400 space-y-1">
									<li>
										Day 1-3: 50-200 emails/day
										(high-engagement recipients)
									</li>
									<li>Day 4-7: 500-1,000 emails/day</li>
									<li>Week 2: 2,000-5,000 emails/day</li>
									<li>Week 3: 10,000-20,000 emails/day</li>
									<li>
										Week 4-6: Gradually scale to full volume
									</li>
								</ul>
							</div>
						</div>

						<div
							class="bg-white/10 p-6 rounded-lg border-l-4 border-blue-500"
						>
							<h4
								class="font-semibold text-lg mb-3 text-blue-400"
							>
								SPF, DKIM, DMARC Validator
							</h4>
							<p class="text-gray-300 mb-3">
								Email authentication is critical for
								deliverability. Laravel Mail continuously
								monitors your DNS records and provides real-time
								validation with fix recommendations.
							</p>
							<div class="grid md:grid-cols-3 gap-4 text-sm">
								<div class="bg-blue-900/20 p-3 rounded">
									<p class="font-semibold text-blue-300 mb-1">
										SPF (Sender Policy Framework)
									</p>
									<p class="text-gray-300">
										Validates that your server is authorized
										to send email for your domain
									</p>
								</div>
								<div class="bg-blue-900/20 p-3 rounded">
									<p class="font-semibold text-blue-300 mb-1">
										DKIM (DomainKeys)
									</p>
									<p class="text-gray-300">
										Cryptographically signs emails to prove
										they haven't been tampered with
									</p>
								</div>
								<div class="bg-blue-900/20 p-3 rounded">
									<p class="font-semibold text-blue-300 mb-1">
										DMARC (Policy)
									</p>
									<p class="text-gray-300">
										Tells ISPs what to do if SPF/DKIM checks
										fail (quarantine or reject)
									</p>
								</div>
							</div>
						</div>

						<div
							class="bg-white/10 p-6 rounded-lg border-l-4 border-green-500"
						>
							<h4
								class="font-semibold text-lg mb-3 text-green-400"
							>
								Bounce Classification & List Hygiene
							</h4>
							<p class="text-gray-300 mb-3">
								Laravel Mail automatically processes bounce
								notifications and categorizes them as hard
								bounces (permanent failures) or soft bounces
								(temporary issues). Hard bounces are immediately
								suppressed to protect your sender reputation.
							</p>
							<div class="bg-white/5 p-4 rounded">
								<p
									class="text-sm font-semibold text-gray-300 mb-2"
								>
									Automatic Actions:
								</p>
								<ul class="text-sm text-gray-400 space-y-1">
									<li>
										• Hard bounce: Immediate suppression,
										marked as invalid
									</li>
									<li>
										• Soft bounce (3+ attempts): Temporary
										suppression for 7 days
									</li>
									<li>
										• Spam complaints: Immediate unsubscribe
										+ global suppression
									</li>
									<li>
										• Inactive subscribers (90+ days no
										opens): Engagement re-activation
										campaign or suppression
									</li>
								</ul>
							</div>
						</div>

						<div
							class="bg-white/10 p-6 rounded-lg border-l-4 border-purple-500"
						>
							<h4
								class="font-semibold text-lg mb-3 text-purple-400"
							>
								Feedback Loop Integration
							</h4>
							<p class="text-gray-300 mb-3">
								Major ISPs (Gmail, Outlook, Yahoo, AOL) provide
								feedback loops that report when recipients mark
								your emails as spam. Laravel Mail automatically
								processes these reports and suppresses
								complaining addresses.
							</p>
							<p class="text-gray-400 text-sm italic">
								This is critical because spam complaint rates
								above 0.1% can trigger domain-wide reputation
								penalties.
							</p>
						</div>

						<div
							class="bg-white/10 p-6 rounded-lg border-l-4 border-orange-500"
						>
							<h4
								class="font-semibold text-lg mb-3 text-orange-400"
							>
								Engagement-Based Sending
							</h4>
							<p class="text-gray-300 mb-3">
								Laravel Mail tracks subscriber engagement
								velocity and automatically adjusts sending
								behavior. Highly engaged subscribers get
								priority, while inactive subscribers are
								throttled or suppressed to maintain high
								engagement rates—which ISPs reward with better
								inbox placement.
							</p>
							<div class="bg-orange-900/20 p-4 rounded">
								<p
