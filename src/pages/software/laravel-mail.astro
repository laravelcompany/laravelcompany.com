
---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Laravel Marketing Automation | Laravel Mail Platform">
	<main>
		<!-- Hero Section -->
		<section class="pt-20 pb-16 md:pt-28 md:pb-24 overflow-hidden">
			<div class="container-custom">
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
					<div>
						<h1 class="animate-on-scroll delay-0 text-4xl md:text-5xl lg:text-6xl font-bold leading-tight">
							Scale Your Email Marketing with <span class="gradient-text">Laravel Mail</span>
						</h1>
						<p class="animate-on-scroll delay-1 mt-6 text-xl text-gray-600 max-w-lg">
							A fully **self-hosted**, Laravel-native email marketing and automation platform. Build powerful workflows with drag-and-drop, send transactional and marketing emails, and keep full control over your data.
						</p>
						<div class="animate-on-scroll delay-2 mt-8">
							<a href="#features" class="btn btn-primary">Explore Features</a>
						</div>
					</div>
					<div class="animate-on-scroll delay-3">
						<div class="relative">
							<div class="absolute -inset-0.5 bg-gradient-to-r from-red-500 to-orange-500 rounded-xl blur opacity-30"></div>
							<div class="relative bg-white rounded-xl shadow-xl overflow-hidden p-8">
								<img src="https://laravelmail.com/logo.svg" title="logo laravel mail" />
								<div class="space-y-6">
									<div class="flex items-center gap-4">
										<div class="w-12 h-12 bg-red-100 rounded-lg flex items-center justify-center">
											<!-- Icon for Marketing / Campaigns -->
											<svg class="w-6 h-6 text-red-600" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
												<path d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
											</svg>
										</div>
										<div>
											<h3 class="font-semibold text-gray-900">Marketing Automation</h3>
											<p class="text-gray-600">Visual workflow builder + drip campaigns</p>
										</div>
									</div>
									<div class="flex items-center gap-4">
										<div class="w-12 h-12 bg-orange-100 rounded-lg flex items-center justify-center">
											<!-- Icon for Transactional Emails -->
											<svg class="w-6 h-6 text-orange-600" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
												<path d="M13 10V3L4 14h7v7l9-11h-7z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
											</svg>
										</div>
										<div>
											<h3 class="font-semibold text-gray-900">Transactional Emails</h3>
											<p class="text-gray-600">Send custom system emails via Laravel Mail API</p>
										</div>
									</div>
									<div class="flex items-center gap-4">
										<div class="w-12 h-12 bg-red-100 rounded-lg flex items-center justify-center">
											<!-- Icon for Analytics / Deliverability -->
											<svg class="w-6 h-6 text-red-600" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
												<path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
												<polyline points="7.5,4.21 12,6.81 16.5,4.21" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
												<polyline points="7.5,19.79 7.5,14.6 3,12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
												<polyline points="21,12 16.5,14.6 16.5,19.79" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
												<polyline points="12,22.81 12,17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
												<line x1="12" y1="6.81" x2="12" y2="12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
											</svg>
										</div>
										<div>
											<h3 class="font-semibold text-gray-900">Deliverability & Analytics</h3>
											<p class="text-gray-600">Real-time tracking, IP reputation, A/B testing</p>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Features / Benefits Section -->
		<section id="features" class="section bg-gray-50">
			<div class="container-custom">
				<h2 class="animate-on-scroll delay-0 text-3xl md:text-4xl font-bold text-center mb-12">
					Why Choose <span class="gradient-text">Laravel Mail</span>?
				</h2>

				<div class="space-y-8">
					<div class="animate-on-scroll delay-1 feature-card">
						<h3 class="text-xl font-semibold mb-3">Visual Automation & Workflow Builder</h3>
						<p class="text-gray-600">
							Design advanced customer journeys using our intuitive drag-and-drop builder. Trigger emails based on
							Laravel events (like registration or purchase), set delays, conditional logic, and multi-step automations —
							all without writing boilerplate code.
						</p>
					</div>

					<div class="animate-on-scroll delay-2 feature-card">
						<h3 class="text-xl font-semibold mb-3">Full Laravel Native Integration</h3>
						<p class="text-gray-600">
							Seamlessly plug Laravel Mail into your Laravel apps. Use Blade templates, Artisan commands,
							and Laravel’s Mail facade natively — no need for complicated API workarounds.
						</p>
					</div>

					<div class="animate-on-scroll delay-3 feature-card">
						<h3 class="text-xl font-semibold mb-3">2000+ Responsive Email Templates</h3>
						<p class="text-gray-600">
							Build pixel-perfect emails with hundreds of mobile-friendly, responsive designs. Choose from drag-and-drop
							editor, code editor, or Blade-based templates — all highly customizable. :
						</p>
					</div>

					<div class="animate-on-scroll delay-4 feature-card">
						<h3 class="text-xl font-semibold mb-3">Advanced Analytics & Deliverability</h3>
						<p class="text-gray-600">
							Track open rates, click rates, and more. Run split tests to optimize campaigns. Plus, monitor your IP reputation,
							warm-up settings, and set up SPF, DKIM, DMARC to maximize email deliverability.
						</p>
					</div>

					<div class="animate-on-scroll delay-5 feature-card">
						<h3 class="text-xl font-semibold mb-3">Email Intelligence & Validation</h3>
						<p class="text-gray-600">
							Protect your sender reputation with email validation, identity matching, and risk scoring. Reduce bounce rates and
							enhance email quality with Forensic Email Intelligence™ powered by Laravel Mail. :
						</p>
					</div>

					<div class="animate-on-scroll delay-6 feature-card">
						<h3 class="text-xl font-semibold mb-3">Version-Controlled Email Development</h3>
						<p class="text-gray-600">
							Manage your Blade email templates in Git. Use staging workflows, branch-based previews, and CI/CD to deploy
							with confidence — with full version control and rollback when needed.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Workflow / Tech Section -->
		<section class="section bg-white">
			<div class="container-custom">
				<h2 class="animate-on-scroll delay-0 text-3xl md:text-4xl font-bold text-center mb-16">
					Under The Hood: <span class="gradient-text">Technology & Architecture</span>
				</h2>

				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
					<div class="animate-on-scroll delay-1 feature-card hover:shadow-xl transition-shadow duration-300">
						<h3 class="text-lg font-semibold mb-2">Self-Hosted Laravel Platform</h3>
						<p class="text-gray-600">
							Run the entire marketing stack on your own infrastructure, keeping full control of your data and costs.
						</p>
					</div>

					<div class="animate-on-scroll delay-2 feature-card hover:shadow-xl transition-shadow duration-300">
						<h3 class="text-lg font-semibold mb-2">Workflow Engine</h3>
						<p class="text-gray-600">
							Triggers, tasks, and data buses let you build complex automation using model events, button clicks, or custom logic.
						</p>
					</div>

					<div class="animate-on-scroll delay-3 feature-card hover:shadow-xl transition-shadow duration-300">
						<h3 class="text-lg font-semibold mb-2">Multi-SMTP & Mail Transport</h3>
						<p class="text-gray-600">
							Use multiple SMTP servers, verify them in parallel, and use high-throughput sending.
						</p>
					</div>

					<div class="animate-on-scroll delay-4 feature-card hover:shadow-xl transition-shadow duration-300">
						<h3 class="text-lg font-semibold mb-2">Secure Analytics</h3>
						<p class="text-gray-600">
							Analytics are fully GDPR compliant, encrypted, and optional so you own your subscriber data.
						</p>
					</div>

					<div class="animate-on-scroll delay-5 feature-card hover:shadow-xl transition-shadow duration-300">
						<h3 class="text-lg font-semibold mb-2">A/B Testing / Split Testing</h3>
						<p class="text-gray-600">
							Experiment with campaign variants to identify what resonates best with your audience, optimizing performance.
						</p>
					</div>

					<div class="animate-on-scroll delay-6 feature-card hover:shadow-xl transition-shadow duration-300">
						<h3 class="text-lg font-semibold mb-2">GDPR-Compliant Workflows</h3>
						<p class="text-gray-600">
							Built-in unsubscribe and consent tools, encrypted tracking, and data control empower you to stay fully compliant.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- CTA Section -->
		<section class="section bg-gradient-to-r from-red-600 to-orange-600">
			<div class="container-custom text-center">
				<h2 class="animate-on-scroll delay-0 text-3xl md:text-4xl font-bold text-white mb-8">Ready to Try Laravel Mail?</h2>
				<p class="animate-on-scroll delay-1 text-xl text-white/90 mb-10 max-w-2xl mx-auto">
					Get started with our **open source, self-hosted Laravel Mail platform**. Full control, unlimited automations, and no monthly SaaS lock-in.
				</p>
				<div class="animate-on-scroll delay-2 flex flex-col sm:flex-row gap-4 justify-center">
					<a href="https://laravelmail.com/" class="btn bg-white text-red-600 hover:bg-white/90">Try It Free</a>
					<a href="/contact" class="btn border-2 border-white text-white hover:bg-white hover:text-red-600">Talk to Sales</a>
				</div>
			</div>
		</section>
	</main>
</Layout>
