---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Laravel Mail - Self-Hosted Email Marketing Software">
	<!-- SoftwareApplication Schema -->
	<script type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@type": "SoftwareApplication",
			"name": "Laravel Mail",
			"applicationCategory": "BusinessApplication",
			"operatingSystem": "Web",
			"url": "https://laravelmail.com",
			"description": "Self-hosted email marketing and automation platform for Laravel. Send campaigns, manage subscribers, and track performance with powerful analytics.",
			"creator": {
				"@type": "Organization",
				"name": "Laravel Company",
				"url": "https://laravelcompany.com"
			},
			"license": "https://creativecommons.org/licenses/by/4.0/",
			"offers": {
				"@type": "Offer",
				"price": "99",
				"priceCurrency": "GBP"
			},
			"featureList": [
				"Campaign management",
				"Subscriber segmentation",
				"Automated drip campaigns",
				"Drag-and-drop email builder",
				"API integrations",
				"Analytics and tracking"
			]
		}
	</script>
	<main>
		<!-- Hero Section -->
		<section class="hero-bg relative overflow-hidden" style="min-height:100vh;" itemscope itemtype="https://schema.org/WebPageElement">
			<div id="hero-three" style="position:absolute;inset:0;z-index:0;"></div>
			<div class="hero-content max-w-7xl mx-auto px-8 flex items-center lg:flex-row flex-col" style="position:relative;z-index:1;min-height:100vh; padding-top:100px; padding-bottom:80px;">
				<div class="w-full lg:w-1/2 flex flex-col justify-center" style="max-width:540px;">
					<nav class="flex items-center gap-2 text-xs text-white/50 mb-6 animate-on-scroll" style="justify-content:flex-start;">
						<a href="/" class="hover:text-white transition-colors">Home</a>
						<span>/</span>
						<a href="/software/" class="hover:text-white transition-colors">Software</a>
						<span>/</span>
						<span class="text-white">Laravel Mail</span>
					</nav>
					<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-primary/10 border border-brand-primary/20 text-brand-primary text-xs font-bold uppercase tracking-widest mb-6">
						<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
						Product Hunt #1 of the Day
					</div>
					<h1 class="text-white text-4xl md:text-5xl lg:text-6xl font-black leading-tight mb-6" itemprop="headline"> Laravel Mail — Email Marketing Built for Laravel Developers </h1>
					<p class="text-xl text-gray-200 leading-relaxed max-w-lg mb-8" itemprop="description"> Send emails with Laravel Mail using SMTP, queues, and notifications. Complete email marketing automation with B2B leads and AI agents. </p>
					<div class="flex flex-wrap items-center gap-4 mb-8">
						<a href="https://laravelmail.com/" class="btn btn-primary w-full sm:w-auto text-center touch-padding" aria-label="Get started with Laravel Mail" target="_blank"> Install Now <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg> </a>
						<a href="/install" class="btn border-2 border-white/30 text-white hover:bg-white/10 w-full sm:w-auto text-center">Explore Features</a>
					</div>
					<div class="flex flex-wrap items-center gap-6 mb-8">
						<span class="flex items-center gap-2 text-sm text-gray-400"> <span class="w-4 h-4 rounded-full bg-green-500 flex items-center justify-center flex-shrink-0"><svg width="8" height="8" viewBox="0 0 8 8" fill="none"><path d="M1 4l2 2 4-4" stroke="#fff" stroke-width="1.5" stroke-linecap="round"></path></svg></span> 4,600+ users </span>
						<span class="flex items-center gap-2 text-sm text-gray-400"> <span class="w-4 h-4 rounded-full bg-green-500 flex items-center justify-center flex-shrink-0"><svg width="8" height="8" viewBox="0 0 8 8" fill="none"><path d="M1 4l2 2 4-4" stroke="#fff" stroke-width="1.5" stroke-linecap="round"></path></svg></span> No credit card </span>
						<span class="flex items-center gap-2 text-sm text-gray-400"> <span class="w-4 h-4 rounded-full bg-green-500 flex items-center justify-center flex-shrink-0"><svg width="8" height="8" viewBox="0 0 8 8" fill="none"><path d="M1 4l2 2 4-4" stroke="#fff" stroke-width="1.5" stroke-linecap="round"></path></svg></span> Cancel anytime </span>
					</div>
					<div class="code-block">
						<span class="cmd"> <span style="color:#a78bfa">docker-compose</span> <span style="color:#e2e8f0"> up</span> </span>
						<button class="copy-btn" onclick="copyCmd(this)" title="Copy" aria-label="Copy command"> <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="5" y="5" width="8" height="9" rx="1.5" stroke="currentColor" stroke-width="1.5"></rect><path d="M3 11V3.5A1.5 1.5 0 014.5 2H11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg> </button>
					</div>
				</div>
				<div class="w-full lg:w-1/2 flex items-center justify-center lg:pl-8">
					<div class="hero-dash w-full" style="padding:20px 0;">
						<div style="position:relative; height:100%; display:flex; align-items:center;">
							<div class="dash-mockup float-anim w-full" style="max-width:600px;">
						<div class="flex items-center justify-between px-5 py-3" style="background:rgba(255,255,255,0.04); border-bottom:1px solid rgba(255,255,255,0.07);">
							<div class="flex items-center gap-2 text-sm font-semibold">
								<div class="w-[22px] h-[22px] rounded-md bg-brand-primary flex items-center justify-center"> <svg width="12" height="12" viewBox="0 0 12 12" fill="white"><path d="M1 3l5 3 5-3M1 3v6l5 3 5-3V3" stroke="white" stroke-width="1" fill="none" stroke-linecap="round" stroke-linejoin="round"></path></svg> </div>
								Laravel Mail <span class="text-[9px] bg-brand-primary px-1.5 py-0.5 rounded font-medium text-white">ALPHA</span>
							</div>
							<div class="flex items-center gap-4">
								<svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="7" cy="7" r="5" stroke="rgba(255,255,255,0.4)" stroke-width="1.5"></circle><path d="M11 11l3 3" stroke="rgba(255,255,255,0.4)" stroke-width="1.5" stroke-linecap="round"></path></svg>
								<svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M8 1a5 5 0 015 5c0 3-1 4.5-1 4.5H4S3 9 3 6a5 5 0 015-5zM6.5 13.5a1.5 1.5 0 003 0" stroke="rgba(255,255,255,0.4)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
								<span class="text-xs" style="color:rgba(255,255,255,0.5);">Laravel User ∨</span>
							</div>
						</div>
						<div class="flex">
							<div class="w-[120px] p-4 flex-shrink-0" style="border-right:1px solid rgba(255,255,255,0.06);">
								<div class="flex flex-col gap-0.5">
									<div class="flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs bg-brand-primary/20 text-brand-primary"> <svg width="12" height="12" fill="none" viewBox="0 0 12 12" stroke="currentColor" stroke-width="1"><rect x="1" y="1" width="4" height="4" rx="1"></rect><rect x="7" y="1" width="4" height="4" rx="1"></rect><rect x="1" y="7" width="4" height="4" rx="1"></rect><rect x="7" y="7" width="4" height="4" rx="1"></rect></svg> Dashboard </div>
									<div class="flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs text-gray-400"> <svg width="12" height="12" fill="none" viewBox="0 0 12 12" stroke="currentColor" stroke-width="1"><path d="M1 4l5-3 5 3v5l-5 3-5-3V4z"></path></svg> Campaigns </div>
									<div class="flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs text-gray-400"> <svg width="12" height="12" fill="none" viewBox="0 0 12 12" stroke="currentColor" stroke-width="1"><circle cx="6" cy="5" r="3"></circle><path d="M1 11c0-2.2 2.2-4 5-4s5 1.8 5 4"></path></svg> Subscribers </div>
									<div class="flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs text-gray-400"> <svg width="12" height="12" fill="none" viewBox="0 0 12 12" stroke="currentColor" stroke-width="1"><path d="M6 1v5l3 2"></path></svg> Automations </div>
									<div class="flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs text-gray-400"> <svg width="12" height="12" fill="none" viewBox="0 0 12 12" stroke="currentColor" stroke-width="1"><rect x="1" y="2" width="10" height="8" rx="1"></rect><path d="M4 5h4M4 7h2"></path></svg> Templates </div>
									<div class="flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs text-gray-400"> <svg width="12" height="12" fill="none" viewBox="0 0 12 12" stroke="currentColor" stroke-width="1"><path d="M2 9V4l4 4 4-4v5"></path></svg> Reports </div>
									<div class="flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs text-gray-400"> <svg width="12" height="12" fill="none" viewBox="0 0 12 12" stroke="currentColor" stroke-width="1"><circle cx="6" cy="6" r="2"></circle><path d="M6 1v1M6 10v1M1 6h1M10 6h1"></path></svg> Settings </div>
								</div>
							</div>
							<div class="flex-1 p-4 overflow-hidden">
								<p class="text-sm font-semibold mb-3 text-white">Dashboard</p>
								<div class="grid grid-cols-4 gap-2 mb-3.5">
									<div style="background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.07); border-radius:10px; padding:8px;"> <div class="text-[10px] text-gray-400 mb-0.5">Total Subscribers</div> <div class="text-lg font-bold text-white">12,458</div> <div class="text-[10px] text-green-400 mt-0.5">▲ 12.5%</div> </div>
									<div style="background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.07); border-radius:10px; padding:8px;"> <div class="text-[10px] text-gray-400 mb-0.5">Emails Sent</div> <div class="text-lg font-bold text-white">189,456</div> <div class="text-[10px] text-green-400 mt-0.5">▲ 8.7%</div> </div>
									<div style="background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.07); border-radius:10px; padding:8px;"> <div class="text-[10px] text-gray-400 mb-0.5">Open Rate</div> <div class="text-lg font-bold text-white">42.1%</div> <div class="text-[10px] text-green-400 mt-0.5">▲ 5.3%</div> </div>
									<div style="background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.07); border-radius:10px; padding:8px;"> <div class="text-[10px] text-gray-400 mb-0.5">Click Rate</div> <div class="text-lg font-bold text-white">8.7%</div> <div class="text-[10px] text-green-400 mt-0.5">▲ 2.1%</div> </div>
								</div>
								<div class="grid grid-cols-[1fr_180px] gap-2.5">
									<div style="background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.07); border-radius:10px; padding:10px;">
										<p class="text-xs font-semibold text-white mb-2">Campaign Performance</p>
										<svg viewBox="0 0 240 80" style="width:100%; height:70px;"> <defs> <linearGradient id="areaGrad" x1="0" y1="0" x2="0" y2="1"> <stop offset="0%" stop-color="#7c3aed" stop-opacity="0.4"></stop> <stop offset="100%" stop-color="#7c3aed" stop-opacity="0"></stop> </linearGradient> </defs> <path d="M0 70 C30 70, 40 50, 60 45 S100 30, 130 25 S190 20, 240 15" fill="none" stroke="#7c3aed" stroke-width="2"></path> <path d="M0 70 C30 70, 40 50, 60 45 S100 30, 130 25 S190 20, 240 15 L240 80 L0 80z" fill="url(#areaGrad)"></path> <circle cx="130" cy="25" r="3" fill="#a78bfa"></circle> <text x="120" y="18" font-size="8" fill="#a78bfa" text-anchor="middle">2,456</text> <text x="0" y="79" font-size="7" fill="rgba(255,255,255,0.3)">May 10</text> <text x="60" y="79" font-size="7" fill="rgba(255,255,255,0.3)">May 15</text> <text x="120" y="79" font-size="7" fill="rgba(255,255,255,0.3)">May 20</text> <text x="180" y="79" font-size="7" fill="rgba(255,255,255,0.3)">May 25</text> </svg>
									</div>
									<div style="background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.07); border-radius:10px; padding:10px;">
										<p class="text-xs font-semibold text-white mb-2">Top Campaigns</p>
										<div class="flex flex-col gap-2">
											<div class="flex items-center justify-between"> <div class="flex items-center gap-1.5"> <div class="w-4 h-4 rounded bg-brand-primary flex items-center justify-center"><svg width="8" height="8" fill="white" viewBox="0 0 8 8"><path d="M1 2l3 2 3-2M1 2v3l3 2 3-2V2"></path></svg></div> <span class="text-[10px] text-gray-400">Product Launch</span> </div> <span class="text-[10px] font-semibold text-white">9,124</span> </div>
											<div class="flex items-center justify-between"> <div class="flex items-center gap-1.5"> <div class="w-4 h-4 rounded bg-blue-600"></div> <span class="text-[10px] text-gray-400">Newsletter May</span> </div> <span class="text-[10px] font-semibold text-white">6,253</span> </div>
											<div class="flex items-center justify-between"> <div class="flex items-center gap-1.5"> <div class="w-4 h-4 rounded bg-emerald-700"></div> <span class="text-[10px] text-gray-400">Re-engagement</span> </div> <span class="text-[10px] font-semibold text-white">4,982</span> </div>
											<a href="#" class="text-[10px] text-brand-primary text-center block mt-1 no-underline">View all</a>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
				<div class="orb" style="width:60px; height:60px; top:15%; right:0; animation: float 5s ease-in-out infinite;"> <svg width="26" height="26" viewBox="0 0 26 26" fill="none"><path d="M2 7l11 7 11-7M2 7v12l11 7 11-7V7" stroke="#7c3aed" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg> </div>
				<div class="orb" style="width:56px; height:56px; bottom:20%; right:12px; animation: float 7s ease-in-out infinite 0.5s;"> <svg width="22" height="22" viewBox="0 0 22 22" fill="none"><circle cx="11" cy="8" r="4" stroke="#c084fc" stroke-width="1.5"></circle><path d="M3 19c0-3.3 3.6-6 8-6s8 2.7 8 6" stroke="#c084fc" stroke-width="1.5" stroke-linecap="round"></path><circle cx="18" cy="9" r="2.5" fill="#22d3ee" opacity="0.8"></circle><circle cx="4" cy="9" r="2.5" fill="#22d3ee" opacity="0.8"></circle></svg> </div>
				<div class="orb" style="width:50px; height:50px; top:55%; left:-10px; animation: float 6s ease-in-out infinite 1s;"> <svg width="22" height="22" viewBox="0 0 22 22" fill="none"><rect x="3" y="5" width="6" height="8" rx="1" stroke="#22d3ee" stroke-width="1.5"></rect><path d="M13 8h6M13 12h4" stroke="#22d3ee" stroke-width="1.5" stroke-linecap="round"></path></svg> </div>
				<div class="orb" style="width:54px; height:54px; bottom:35%; left:-20px; animation: float 5.5s ease-in-out infinite 0.8s;"> <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><rect x="4" y="4" width="7" height="7" rx="1.5" fill="#7c3aed" opacity="0.7"></rect><rect x="13" y="4" width="7" height="7" rx="1.5" fill="#7c3aed" opacity="0.5"></rect><rect x="4" y="13" width="7" height="7" rx="1.5" fill="#7c3aed" opacity="0.5"></rect><rect x="13" y="13" width="7" height="7" rx="1.5" fill="#7c3aed"></rect></svg> </div>
			</div>
			<div class="glow-line" style="bottom:0; left:0; right:0;"></div>
		</section>

		<!-- Features / Benefits Section -->
		<section id="features" class="section bg-white/5">
			<div class="container-custom">
				<h2
					class="animate-on-scroll delay-0 text-3xl md:text-4xl font-bold text-center mb-12"
				>
					Why Choose <span class="gradient-text">Laravel Mail</span>?
				</h2>

				<div class="space-y-8">
					<div class="animate-on-scroll delay-1 feature-card">
						<h3 class="text-xl font-semibold mb-3">
							Visual Automation & Workflow Builder
						</h3>
						<p class="text-gray-400">
							Design advanced customer journeys using our
							intuitive drag-and-drop builder. Trigger emails
							based on Laravel events (like registration or
							purchase), set delays, conditional logic, and
							multi-step automations — all without writing
							boilerplate code.
						</p>
					</div>

					<div class="animate-on-scroll delay-2 feature-card">
						<h3 class="text-xl font-semibold mb-3">
							Full Laravel Native Integration
						</h3>
						<p class="text-gray-400">
							Seamlessly plug Laravel Mail into your Laravel apps.
							Use Blade templates, Artisan commands, and Laravel’s
							Mail facade natively — no need for complicated API
							workarounds.
						</p>
					</div>

					<div class="animate-on-scroll delay-3 feature-card">
						<h3 class="text-xl font-semibold mb-3">
							2000+ Responsive Email Templates
						</h3>
						<p class="text-gray-400">
							Build pixel-perfect emails with hundreds of
							mobile-friendly, responsive designs. Choose from
							drag-and-drop editor, code editor, or Blade-based
							templates — all highly customizable. :
						</p>
					</div>

					<div class="animate-on-scroll delay-4 feature-card">
						<h3 class="text-xl font-semibold mb-3">
							Advanced Analytics & Deliverability
						</h3>
						<p class="text-gray-400">
							Track open rates, click rates, and more. Run split
							tests to optimize campaigns. Plus, monitor your IP
							reputation, warm-up settings, and set up SPF, DKIM,
							DMARC to maximize email deliverability.
						</p>
					</div>

					<div class="animate-on-scroll delay-5 feature-card">
						<h3 class="text-xl font-semibold mb-3">
							Email Intelligence & Validation
						</h3>
						<p class="text-gray-400">
							Protect your sender reputation with email
							validation, identity matching, and risk scoring.
							Reduce bounce rates and enhance email quality with
							Forensic Email Intelligence™ powered by Laravel
							Mail. :
						</p>
					</div>

					<div class="animate-on-scroll delay-6 feature-card">
						<h3 class="text-xl font-semibold mb-3">
							Version-Controlled Email Development
						</h3>
						<p class="text-gray-400">
							Manage your Blade email templates in Git. Use
							staging workflows, branch-based previews, and CI/CD
							to deploy with confidence — with full version
							control and rollback when needed.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Workflow / Tech Section -->
		<section class="section bg-white/10">
			<div class="container-custom">
				<h2
					class="animate-on-scroll delay-0 text-3xl md:text-4xl font-bold text-center mb-16"
				>
					Under The Hood: <span class="gradient-text"
						>Technology & Architecture</span
					>
				</h2>

				<div
					class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
				>
					<div
						class="animate-on-scroll delay-1 feature-card hover:shadow-xl transition-shadow duration-300"
					>
						<h3 class="text-lg font-semibold mb-2">
							Self-Hosted Laravel Platform
						</h3>
						<p class="text-gray-400">
							Run the entire marketing stack on your own
							infrastructure, keeping full control of your data
							and costs.
						</p>
					</div>

					<div
						class="animate-on-scroll delay-2 feature-card hover:shadow-xl transition-shadow duration-300"
					>
						<h3 class="text-lg font-semibold mb-2">
							Workflow Engine
						</h3>
						<p class="text-gray-400">
							Triggers, tasks, and data buses let you build
							complex automation using model events, button
							clicks, or custom logic.
						</p>
					</div>

					<div
						class="animate-on-scroll delay-3 feature-card hover:shadow-xl transition-shadow duration-300"
					>
						<h3 class="text-lg font-semibold mb-2">
							Multi-SMTP & Mail Transport
						</h3>
						<p class="text-gray-400">
							Use multiple SMTP servers, verify them in parallel,
							and use high-throughput sending.
						</p>
					</div>

					<div
						class="animate-on-scroll delay-4 feature-card hover:shadow-xl transition-shadow duration-300"
					>
						<h3 class="text-lg font-semibold mb-2">
							Secure Analytics
						</h3>
						<p class="text-gray-400">
							Analytics are fully GDPR compliant, encrypted, and
							optional so you own your subscriber data.
						</p>
					</div>

					<div
						class="animate-on-scroll delay-5 feature-card hover:shadow-xl transition-shadow duration-300"
					>
						<h3 class="text-lg font-semibold mb-2">
							A/B Testing / Split Testing
						</h3>
						<p class="text-gray-400">
							Experiment with campaign variants to identify what
							resonates best with your audience, optimizing
							performance.
						</p>
					</div>

					<div
						class="animate-on-scroll delay-6 feature-card hover:shadow-xl transition-shadow duration-300"
					>
						<h3 class="text-lg font-semibold mb-2">
							GDPR-Compliant Workflows
						</h3>
						<p class="text-gray-400">
							Built-in unsubscribe and consent tools, encrypted
							tracking, and data control empower you to stay fully
							compliant.
						</p>
					</div>
				</div>
			</div>
		</section>
		<!-- Intent Matcher Section - Prevents SERP Demotion -->
		<section class="bg-blue-900/20 border-b border-blue-900/30 py-8">
			<div class="container-custom">
				<div class="max-w-4xl mx-auto">
