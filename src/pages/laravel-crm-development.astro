---
import Layout from "../layouts/Layout.astro";
import CTASection from "../components/CTASection.astro";
import { Icon } from "astro-icon/components";

const features = [
  {
    title: "Sales Pipeline",
    desc: "Kanban boards, deal stages, probability tracking, and automated pipeline movements.",
    icon: "ph:funnel-duotone"
  },
  {
    title: "Custom Fields & Entities",
    desc: "Unlimited custom fields, custom objects, relationships, and dynamic forms.",
    icon: "ph:columns-duotone"
  },
  {
    title: "Reporting & Analytics",
    desc: "Sales forecasts, conversion rates, activity reports, and custom dashboard widgets.",
    icon: "ph:chart-bar-duotone"
  },
  {
    title: "Email & Calendar Sync",
    desc: "Gmail/Outlook integration, email tracking, templates, and calendar scheduling.",
    icon: "ph:envelope-simple-duotone"
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      "name": "How much does custom CRM development cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Custom CRM systems cost $20,000-$50,000. Basic CRMs with contact management start at $15,000. Enterprise CRMs with complex workflows reach $50,000-$100,000+."
      }
    },
    {
      "@type": "Question",
      "name": "Do you integrate with existing CRM systems?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. We integrate with Salesforce, HubSpot, Pipedrive, and Zoho via APIs. We can also migrate data from legacy CRMs to your new Laravel CRM."
      }
    },
    {
      "@type": "Question",
      "name": "Can you build industry-specific CRM?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Absolutely. We build CRMs for real estate, healthcare, finance, logistics, and manufacturing with industry-specific fields, workflows, and compliance requirements."
      }
    },
    {
      "@type": "Question",
      "name": "Do you provide CRM migration services?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. We migrate data from Salesforce, HubSpot, Pipedrive, Excel, and custom CRMs to Laravel with data mapping, deduplication, and validation."
      }
    }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Laravel CRM Development",
  "provider": {
    "@type": "Organization",
    "name": "Laravel Company",
    "url": "https://laravelcompany.com"
  },
  "description": "Custom CRM development with Laravel. Sales pipeline, custom fields, reporting, email sync. $20K-$100K.",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "CRM Services",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Custom CRM" }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "CRM Migration" }}
    ]
  }
};
---

<Layout
  title="Laravel CRM Development Services | Custom Sales & Pipeline"
  description="Custom CRM development with Laravel. Sales pipeline, custom fields, reporting, email/calendar sync. $20K-$100K. Get a free quote."
>
  <main id="main-content">
    <!-- Hero -->
    <section class="pt-24 pb-20 md:pt-32 md:pb-28 overflow-hidden relative bg-payflo-dark">
      <div class="absolute inset-0 opacity-10 -z-10">
        <div class="absolute top-0 left-0 w-full h-full bg-[radial-gradient(circle_at_50%_120%,rgba(120,119,198,0.3),rgba(255,255,255,0))]"></div>
      </div>
      <div class="container-custom relative">
        <nav class="flex justify-center items-center gap-2 text-sm text-white/50 mb-8 animate-on-scroll">
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <span>/</span>
          <a href="/laravel-services/" class="hover:text-white transition-colors">Services</a>
          <span>/</span>
          <span class="text-white">CRM Development</span>
        </nav>
        <div class="max-w-4xl mx-auto text-center">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-payflo-purple/10 border border-payflo-purple/20 mb-8 animate-on-scroll">
            <Icon name="ph:user-gear-duotone" class="w-5 h-5 text-payflo-purple" />
            <span class="text-sm font-bold uppercase tracking-widest text-white/70">CRM Specialists</span>
          </div>
          <h1 class="animate-on-scroll delay-1 text-5xl md:text-7xl lg:text-8xl font-black leading-tight tracking-tight text-white">
            Laravel <span class="gradient-text">CRM Development</span>
          </h1>
          <p class="animate-on-scroll delay-2 mt-8 text-xl md:text-2xl text-white/70 leading-relaxed font-medium">
            Custom sales pipeline, custom fields, reporting, and email/calendar sync. Starting at $20,000.
          </p>
          <div class="animate-on-scroll delay-3 mt-12 flex flex-wrap justify-center gap-6">
            <a href="/contact/" class="btn btn-primary px-10 py-5 text-lg shadow-2xl">Build Custom CRM</a>
            <a href="/laravel-mvp-development/" class="btn glass-card border-white/20 px-10 py-5 text-lg hover:bg-white/10 transition-all font-bold">MVP Package</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Core Features -->
    <section class="py-24">
      <div class="container-custom">
        <div class="text-center max-w-3xl mx-auto mb-20 animate-on-scroll">
          <h2 class="text-4xl md:text-5xl font-black mb-6">CRM <span class="gradient-text">Core Features</span></h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
          {features.map((f, i) => (
            <div class="animate-on-scroll delay-{i} glass-card p-10 border-white/10 group hover:border-payflo-purple/50 transition-colors">
              <Icon name={f.icon} class="w-12 h-12 text-payflo-purple mb-6 group-hover:scale-110 transition-transform" />
              <h3 class="text-2xl font-black mb-4 text-white">{f.title}</h3>
              <p class="text-gray-400 text-sm leading-relaxed">{f.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Integrations -->
    <section class="py-24 bg-white/5">
      <div class="container-custom max-w-4xl mx-auto">
        <h2 class="text-4xl font-black text-center mb-16">CRM <span class="gradient-text">Integrations</span></h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10 text-center">
            <h4 class="text-lg font-bold text-white mb-2">Salesforce</h4>
            <p class="text-gray-400 text-xs">API integration, data sync</p>
          </div>
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10 text-center">
            <h4 class="text-lg font-bold text-white mb-2">HubSpot</h4>
            <p class="text-gray-400 text-xs">Contacts, deals, workflows</p>
          </div>
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10 text-center">
            <h4 class="text-lg font-bold text-white mb-2">Gmail/Outlook</h4>
            <p class="text-gray-400 text-xs">Email tracking, templates</p>
          </div>
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10 text-center">
            <h4 class="text-lg font-bold text-white mb-2">Twilio</h4>
            <p class="text-gray-400 text-xs">SMS, voice, WhatsApp</p>
          </div>
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10 text-center">
            <h4 class="text-lg font-bold text-white mb-2">QuickBooks</h4>
            <p class="text-gray-400 text-xs">Invoicing, accounting</p>
          </div>
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10 text-center">
            <h4 class="text-lg font-bold text-white mb-2">Slack</h4>
            <p class="text-gray-400 text-xs">Notifications, deal alerts</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Cost Estimate -->
    <section class="py-24">
      <div class="container-custom max-w-4xl mx-auto">
        <h2 class="text-4xl font-black text-center mb-16">Cost <span class="gradient-text">Estimate</span></h2>
        <div class="glass-card p-10 border-white/10">
          <div class="space-y-4">
            <div class="flex justify-between pb-4 border-b border-white/5">
              <span class="text-white/70">Basic CRM (6-10 weeks)</span>
              <span class="text-payflo-purple font-bold">$20K-$35K</span>
            </div>
            <div class="flex justify-between pb-4 border-b border-white/5">
              <span class="text-white/70">Advanced CRM (10-16 weeks)</span>
              <span class="text-payflo-purple font-bold">$35K-$50K</span>
            </div>
            <div class="flex justify-between">
              <span class="text-white/70">Enterprise + ERP (16-24 weeks)</span>
              <span class="text-payflo-pink font-bold">$50K-$100K</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-24 bg-white/5">
      <div class="container-custom max-w-4xl mx-auto">
        <h2 class="text-4xl font-black text-center mb-16">CRM <span class="gradient-text">FAQ</span></h2>
        <div class="space-y-6">
          <div class="p-8 glass-card border-white/10">
            <h4 class="text-lg font-bold mb-3 text-white">How much does custom CRM development cost?</h4>
            <p class="text-gray-400">Custom CRM systems cost $20,000-$50,000. Basic CRMs with contact management start at $15,000. Enterprise CRMs with complex workflows reach $50,000-$100,000+.</p>
          </div>
          <div class="p-8 glass-card border-white/10">
            <h4 class="text-lg font-bold mb-3 text-white">Do you integrate with existing CRM systems?</h4>
            <p class="text-gray-400">Yes. We integrate with Salesforce, HubSpot, Pipedrive, and Zoho via APIs. We can also migrate data from legacy CRMs to your new Laravel CRM.</p>
          </div>
          <div class="p-8 glass-card border-white/10">
            <h4 class="text-lg font-bold mb-3 text-white">Can you build industry-specific CRM?</h4>
            <p class="text-gray-400">Absolutely. We build CRMs for real estate, healthcare, finance, logistics, and manufacturing with industry-specific fields, workflows, and compliance requirements.</p>
          </div>
        </div>
      </div>
    </section>

    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

    <!-- Internal Links -->
    <section class="py-16 border-t border-white/5">
      <div class="container-custom">
        <div class="flex flex-wrap justify-center gap-6 text-sm">
          <a href="/hire-laravel-developer/" class="text-payflo-purple hover:underline font-bold">Hire CRM Developer →</a>
          <a href="/laravel-api-development/" class="text-payflo-purple hover:underline font-bold">API Development →</a>
          <a href="/laravel-mvp-development/" class="text-payflo-purple hover:underline font-bold">MVP Package →</a>
        </div>
      </div>
    </section>

    <CTASection />
  </main>
</Layout>

<style>
  .btn { @apply inline-flex items-center justify-center font-black transition-all duration-300 rounded-2xl; }
  .btn-primary { @apply bg-gradient-to-r from-payflo-purple to-payflo-pink text-white shadow-xl shadow-purple-600/30 hover:shadow-purple-600/50 hover:-translate-y-1; }
  .glass-card { @apply bg-white/5 backdrop-blur-xl border border-white/10 rounded-3xl shadow-2xl; }
  .gradient-text { @apply bg-clip-text text-transparent bg-gradient-to-r from-payflo-purple to-payflo-pink; }
</style>
