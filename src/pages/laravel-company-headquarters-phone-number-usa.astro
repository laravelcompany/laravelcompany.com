---
import Layout from "../layouts/Layout.astro";
import CTASection from "../components/CTASection.astro";
import { Icon } from "astro-icon/components";

const pageTitle = "Laravel Company Headquarters Phone Number USA | Free Laravel Support";
const pageDescription = "Looking for the laravel.com headquarters phone number in the USA? Skip the search and call us instead. We offer free expert support for all your Laravel issues — no contracts, no commitments.";
---

<Layout title={pageTitle} description={pageDescription}>
  <main id="main-content">
    <!-- Hero -->
    <section class="pt-24 pb-20 md:pt-32 md:pb-28 overflow-hidden relative bg-payflo-dark">
      <div class="absolute inset-0 opacity-10 -z-10">
        <div class="absolute top-0 left-0 w-full h-full bg-[radial-gradient(circle_at_50%_120%,rgba(120,119,198,0.3),rgba(255,255,255,0))]"></div>
      </div>
      <div class="container-custom relative">
        <nav class="flex justify-center items-center gap-2 text-sm text-white/50 mb-8 animate-on-scroll">
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <span>/</span>
          <span class="text-white">Laravel Company Phone Number USA</span>
        </nav>
        <div class="max-w-4xl mx-auto text-center">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-payflo-purple/10 border border-payflo-purple/20 mb-8 animate-on-scroll">
            <Icon name="ph:phone-duotone" class="w-5 h-5 text-payflo-purple" />
            <span class="text-sm font-bold uppercase tracking-widest text-white/70">Free Laravel Support</span>
          </div>
          <h1 class="text-5xl md:text-7xl lg:text-8xl font-black leading-tight tracking-tight text-white">
            Laravel Company <span class="gradient-text">Phone Number USA</span>
          </h1>
          <p class="animate-on-scroll delay-2 mt-8 text-xl md:text-2xl text-white/70 leading-relaxed font-medium">
            Looking for the <strong>laravel.com headquarters phone number in the USA</strong>? Don't waste time searching. Reach out to us instead — we provide <strong class="text-payflo-purple">free expert support</strong> for all your Laravel questions, issues, and projects.
          </p>
          <div class="animate-on-scroll delay-3 mt-12 flex flex-wrap justify-center gap-6">
            <a href="/contact/" class="btn btn-primary px-10 py-5 text-lg shadow-2xl">Call Us for Free Support</a>
            <a href="/" class="btn glass-card border-white/20 px-10 py-5 text-lg hover:bg-white/10 transition-all font-bold">Explore Our Services</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Why Call Us Instead -->
    <section class="py-24">
      <div class="container-custom max-w-4xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-16 animate-on-scroll">
          <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-payflo-purple/20 border border-payflo-purple/30 text-payflo-purple text-sm font-bold uppercase tracking-widest mb-6">
            <Icon name="ph:phone-call-duotone" class="h-5 w-5" />
            Skip the Search
          </span>
          <h2 class="text-4xl md:text-5xl font-black mb-6">Why Call Us Instead of <span class="gradient-text">laravel.com Headquarters?</span></h2>
          <p class="text-gray-400 text-lg">Searching for the <strong>laravel.com headquarters phone number in the USA</strong> usually leads to dead ends. Laravel is open source — there is no central office to call. But that does not mean you cannot get expert help over the phone.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="animate-on-scroll glass-card p-8 border-white/10 group hover:border-payflo-purple/50 transition-colors text-center">
            <div class="w-16 h-16 rounded-full bg-payflo-purple/20 flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform">
              <Icon name="ph:headphones-duotone" class="w-8 h-8 text-payflo-purple" />
            </div>
            <h3 class="text-xl font-black mb-3 text-white">Free Expert Support</h3>
            <p class="text-gray-400 text-sm leading-relaxed">Unlike calling a <strong>laravel.com headquarters phone number</strong> (which does not exist), we actually answer. Get free guidance from senior Laravel developers who have built enterprise-scale applications.</p>
          </div>
          <div class="animate-on-scroll delay-1 glass-card p-8 border-white/10 group hover:border-payflo-purple/50 transition-colors text-center">
            <div class="w-16 h-16 rounded-full bg-payflo-purple/20 flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform">
              <Icon name="ph:chat-teardrop-duotone" class="w-8 h-8 text-payflo-purple" />
            </div>
            <h3 class="text-xl font-black mb-3 text-white">Real Humans, No Bots</h3>
            <p class="text-gray-400 text-sm leading-relaxed">When you look up <strong>laravel.com headquarters phone number USA</strong>, you deserve to talk to a real person. We are a US-friendly Laravel development company with a team ready to help — no automated menus, no endless holds.</p>
          </div>
          <div class="animate-on-scroll delay-2 glass-card p-8 border-white/10 group hover:border-payflo-purple/50 transition-colors text-center">
            <div class="w-16 h-16 rounded-full bg-payflo-purple/20 flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform">
              <Icon name="ph:currency-dollar-duotone" class="w-8 h-8 text-payflo-purple" />
            </div>
            <h3 class="text-xl font-black mb-3 text-white">No Cost, No Commitment</h3>
            <p class="text-gray-400 text-sm leading-relaxed">Our free support is exactly that — free. Whether you are stuck on a bug, need architecture advice, or want to discuss a project, there is no charge and no obligation. No <strong>laravel.com headquarters phone number</strong> can offer that.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Free Support Offer -->
    <section class="py-24 bg-white/5">
      <div class="container-custom max-w-4xl mx-auto">
        <div class="animate-on-scroll glass-card p-12 border-payflo-purple/30 text-center relative overflow-hidden">
          <div class="absolute inset-0 bg-gradient-to-br from-payflo-purple/5 to-transparent"></div>
          <div class="relative">
            <Icon name="ph:hand-heart-duotone" class="w-16 h-16 text-payflo-purple mx-auto mb-6" />
            <h2 class="text-3xl md:text-4xl font-black mb-6 text-white">Get Free Laravel Support <span class="gradient-text">Right Now</span></h2>
            <p class="text-gray-300 text-lg leading-relaxed max-w-3xl mx-auto mb-8">
              Stop searching for a <strong>laravel.com headquarters phone number in the USA</strong> that does not exist. We are a dedicated team of Laravel experts who offer free, no-obligation support to anyone building with Laravel. Whether you are debugging an issue, planning an architecture, or just have a question — we are here to help. Our developers have years of experience with Laravel, Livewire, Alpine.js, Tailwind, and the entire Laravel ecosystem. One conversation with us is worth more than hours of searching for the right phone number.
            </p>
            <div class="flex flex-col sm:flex-row justify-center gap-6">
              <a href="/contact/" class="btn btn-primary px-12 py-5 text-xl">Get Free Support Now</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Why People Search for laravel.com Phone Number -->
    <section class="py-24">
      <div class="container-custom max-w-4xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-16 animate-on-scroll">
          <h2 class="text-4xl md:text-5xl font-black mb-6">What You Actually Get When You Call <span class="gradient-text">Us Instead</span></h2>
          <p class="text-gray-400 text-lg">Many developers and business owners search for the <strong>laravel.com headquarters phone number in the USA</strong> because they need help. Here is what happens when you reach out to us instead.</p>
        </div>
        <div class="space-y-8 max-w-3xl mx-auto">
          <div class="animate-on-scroll glass-card p-8 border-white/10 flex flex-col md:flex-row gap-6 items-start">
            <div class="w-16 h-16 rounded-2xl bg-payflo-purple/20 flex items-center justify-center flex-shrink-0">
              <Icon name="ph:bug-duotone" class="w-8 h-8 text-payflo-purple" />
            </div>
            <div>
              <h3 class="text-2xl font-black mb-3 text-white">Immediate Debugging Help</h3>
              <p class="text-gray-400 leading-relaxed">Stuck on a Laravel bug? Instead of hunting for a <strong>laravel.com headquarters phone number in the USA</strong>, describe your issue to us and we will help you diagnose and fix it. Our team has deep experience with Laravel internals, Eloquent optimization, queue management, caching strategies, and common pitfalls. Most issues are resolved in a single conversation.</p>
            </div>
          </div>
          <div class="animate-on-scroll delay-1 glass-card p-8 border-white/10 flex flex-col md:flex-row gap-6 items-start">
            <div class="w-16 h-16 rounded-2xl bg-payflo-purple/20 flex items-center justify-center flex-shrink-0">
              <Icon name="ph:compass-duotone" class="w-8 h-8 text-payflo-purple" />
            </div>
            <div>
              <h3 class="text-2xl font-black mb-3 text-white">Architecture & Planning Advice</h3>
              <p class="text-gray-400 leading-relaxed">Planning a new Laravel project or scaling an existing one? We offer free architecture reviews and technology recommendations. Whether you need advice on multi-tenancy, microservices, API design, or deployment strategies, our senior developers share what we have learned from hundreds of production Laravel applications. Why search for a <strong>laravel.com headquarters phone number USA</strong> when you can talk to architects who build Laravel systems daily?</p>
            </div>
          </div>
          <div class="animate-on-scroll delay-2 glass-card p-8 border-white/10 flex flex-col md:flex-row gap-6 items-start">
            <div class="w-16 h-16 rounded-2xl bg-payflo-purple/20 flex items-center justify-center flex-shrink-0">
              <Icon name="ph:rocket-duotone" class="w-8 h-8 text-payflo-purple" />
            </div>
            <div>
              <h3 class="text-2xl font-black mb-3 text-white">Project Discussion & Estimates</h3>
              <p class="text-gray-400 leading-relaxed">If you need a Laravel development partner, we can discuss your project scope, timeline, and budget. We have built SaaS platforms, e-commerce systems, enterprise applications, and APIs for clients across the USA and worldwide. Unlike calling a <strong>laravel.com headquarters phone number</strong>, talking to us means getting straight answers from people who actually build Laravel software professionally.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-24 bg-white/5">
      <div class="container-custom max-w-4xl mx-auto">
        <h2 class="text-4xl font-black text-center mb-16">Frequently Asked <span class="gradient-text">Questions</span></h2>
        <div class="space-y-6">
          <div class="p-8 glass-card border-white/10">
            <h4 class="text-lg font-bold mb-3 text-white">Is there a laravel.com headquarters phone number in the USA?</h4>
            <p class="text-gray-400">No. Laravel is an open-source framework maintained by Taylor Otwell and the Laravel core team. There is no <strong>laravel.com headquarters phone number in the USA</strong> you can call for support. However, we at Laravel Company offer free expert support — call us instead and speak to real Laravel developers.</p>
          </div>
          <div class="p-8 glass-card border-white/10">
            <h4 class="text-lg font-bold mb-3 text-white">Can I really get free Laravel support over the phone?</h4>
            <p class="text-gray-400">Yes. We provide free, no-obligation Laravel support to developers and businesses. Whether you have a quick question or a complex issue, our team is happy to help over the phone or via email. There is no catch — we believe in building relationships by being useful.</p>
          </div>
          <div class="p-8 glass-card border-white/10">
            <h4 class="text-lg font-bold mb-3 text-white">Who is Laravel Company and are you affiliated with laravel.com?</h4>
            <p class="text-gray-400">Laravel Company is an independent <a href="/" class="text-payflo-purple hover:underline font-bold">Laravel development company</a> staffed by senior Laravel developers and contributors to the Laravel ecosystem. We are not affiliated with or endorsed by laravel.com or Taylor Otwell. We are a separate entity that specializes in Laravel development and offers free community support.</p>
          </div>
          <div class="p-8 glass-card border-white/10">
            <h4 class="text-lg font-bold mb-3 text-white">What kind of Laravel issues can you help with?</h4>
            <p class="text-gray-400">We can help with virtually any Laravel-related issue: debugging errors, optimizing database queries, configuring queues and jobs, setting up caching, designing database schemas, API development, authentication and authorization, deployment and DevOps, package recommendations, and architecture planning. If it is Laravel, we can help.</p>
          </div>
          <div class="p-8 glass-card border-white/10">
            <h4 class="text-lg font-bold mb-3 text-white">Do you have a Laravel company phone number in the USA I can call?</h4>
            <p class="text-gray-400">Yes — while there is no <strong>laravel.com headquarters phone number in the USA</strong>, Laravel Company is available for calls. <a href="/contact/" class="text-payflo-purple hover:underline font-bold">Contact us</a> and we will set up a call with a senior Laravel developer at your convenience. We serve clients across the USA and work in US time zones.</p>
          </div>
          <div class="p-8 glass-card border-white/10">
            <h4 class="text-lg font-bold mb-3 text-white">Is there a cost for the support calls?</h4>
            <p class="text-gray-400">No. Initial support calls are completely free. We do not ask for credit cards, contracts, or commitments. If your needs grow beyond a quick consultation, we can discuss paid development services — but there is never any pressure.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="py-24">
      <div class="container-custom max-w-4xl mx-auto text-center">
        <div class="animate-on-scroll">
          <Icon name="ph:phone-duotone" class="w-16 h-16 text-payflo-purple mx-auto mb-6" />
          <h2 class="text-4xl md:text-5xl font-black mb-6 text-white">Stop Searching. <span class="gradient-text">Start Building.</span></h2>
          <p class="text-gray-300 text-xl leading-relaxed max-w-3xl mx-auto mb-10">
            There is no <strong>laravel.com headquarters phone number in the USA</strong> — but there is us. We are ready to help with free Laravel support, expert advice, and professional development services when you need them.
          </p>
          <a href="/contact/" class="btn btn-primary px-12 py-5 text-xl">Reach Out for Free Support</a>
        </div>
      </div>
    </section>

    <!-- Internal Links -->
    <section class="py-16 border-t border-white/5">
      <div class="container-custom">
        <div class="flex flex-wrap justify-center gap-6 text-sm mb-8">
          <a href="/" class="text-payflo-purple hover:underline font-bold">Laravel Development Company →</a>
          <a href="/laravel-development-services/" class="text-payflo-purple hover:underline font-bold">Laravel Development Services →</a>
          <a href="/laravel-consulting/" class="text-payflo-purple hover:underline font-bold">Laravel Consulting →</a>
          <a href="/hire-laravel-developer/" class="text-payflo-purple hover:underline font-bold">Hire Laravel Developer →</a>
          <a href="/contact/" class="text-payflo-purple hover:underline font-bold">Contact Us →</a>
        </div>
      </div>
    </section>

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Is there a laravel.com headquarters phone number in the USA?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "No. Laravel is an open-source framework with no central office phone number. Laravel Company offers free expert support as an alternative."
            }
          },
          {
            "@type": "Question",
            "name": "Can I get free Laravel support over the phone?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes. Laravel Company offers free, no-obligation Laravel support over phone and email for developers and businesses."
            }
          },
          {
            "@type": "Question",
            "name": "Who is Laravel Company and are you affiliated with laravel.com?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Laravel Company is an independent Laravel development company staffed by senior Laravel developers. We are not affiliated with laravel.com or Taylor Otwell."
            }
          },
          {
            "@type": "Question",
            "name": "Do you have a Laravel company phone number in the USA?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes. Laravel Company is available for calls. Contact us to speak with a senior Laravel developer at your convenience."
            }
          }
        ]
      }
    </script>

    <CTASection />
  </main>
</Layout>

<style>
  .btn { @apply inline-flex items-center justify-center font-black transition-all duration-300 rounded-2xl; }
  .btn-primary { @apply bg-gradient-to-r from-payflo-purple to-payflo-pink text-white shadow-xl shadow-purple-600/30 hover:shadow-purple-600/50 hover:-translate-y-1; }
  .glass-card { @apply bg-white/5 backdrop-blur-xl border border-white/10 rounded-3xl shadow-2xl; }
  .gradient-text { @apply bg-clip-text text-transparent bg-gradient-to-r from-payflo-purple to-payflo-pink; }
</style>
