---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import type { CollectionEntry } from "astro:content";

export const getStaticPaths = (async ({ paginate }) => {
  const allPrompts = await getCollection("prompts");
  const sortedPrompts = allPrompts.sort((a, b) => {
    const dateA = new Date(a.data.date || 0);
    const dateB = new Date(b.data.date || 0);
    return dateB.getTime() - dateA.getTime();
  });
  return paginate(sortedPrompts, { pageSize: 24 });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<CollectionEntry<"prompts">>;
}

const { page } = Astro.props;
const sortedPrompts = page.data;

function toExcerpt(improvedPrompt: string): string {
  return improvedPrompt
    .replace(/```[\s\S]*?```/g, " ")
    .replace(/[#*>`]/g, "")
    .replace(/\s+/g, " ")
    .trim()
    .slice(0, 220);
}

function getPageNumbers(current: number, last: number): (number | "...")[] {
  if (last <= 7) return Array.from({ length: last }, (_, i) => i + 1);

  const pages: (number | "...")[] = [1];
  const delta = 1;
  const rangeStart = Math.max(2, current - delta);
  const rangeEnd = Math.min(last - 1, current + delta);

  if (rangeStart > 2) pages.push("...");
  for (let i = rangeStart; i <= rangeEnd; i++) pages.push(i);
  if (rangeEnd < last - 1) pages.push("...");

  pages.push(last);
  return pages;
}

const pageNumbers = getPageNumbers(page.currentPage, page.lastPage);
---

<Layout
  title={page.currentPage === 1 ? "Prompts | Laravel Company" : `Prompts - Page ${page.currentPage} | Laravel Company`}
  description="A library of community-contributed AI prompts for development, writing, productivity, and more. Each prompt credits its source."
>
  <main class="py-20 px-6 sm:px-8 lg:px-12 max-w-7xl mx-auto">
    <nav class="flex justify-center items-center gap-2 text-sm text-white/50 mb-8 animate-on-scroll">
      <a href="/" class="hover:text-white transition-colors">Home</a>
      <span>/</span>
      <span class="text-white">Prompts</span>
      {page.currentPage > 1 && <><span>/</span><span class="text-white">Page {page.currentPage}</span></>}
    </nav>

    <div class="max-w-5xl mx-auto">
      <h1 class="text-4xl font-bold mb-4 text-center animate-on-scroll">Prompts</h1>
      <p class="text-xl text-white/70 mb-8 text-center animate-on-scroll max-w-2xl mx-auto">
        Browse {page.total.toLocaleString("en-GB")} community-contributed prompts. Search the full text, title or contributor.
      </p>

      <div class="max-w-xl mx-auto mb-12 animate-on-scroll">
        <div class="relative">
          <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-white/40 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
          <input
            id="prompt-search"
            type="search"
            placeholder="Try Laravel testing, a role, or a contributor..."
            aria-label="Search prompts"
            autocomplete="off"
            class="w-full pl-12 pr-4 py-3 rounded-xl bg-white/10 border border-white/10 text-white placeholder-white/40 focus:outline-none focus:border-payflo-purple focus:ring-1 focus:ring-payflo-purple transition-colors"
          />
        </div>
        <div class="flex flex-wrap items-center gap-3 mt-4 text-sm">
          <label for="prompt-type" class="sr-only">Prompt type</label>
          <select id="prompt-type" class="rounded-lg bg-slate-900 border border-white/20 px-3 py-2 text-white">
            <option value="">All types</option><option>TEXT</option><option>STRUCTURED</option><option>IMAGE</option>
          </select>
          <label class="flex items-center gap-2 text-white/70"><input id="prompt-devs" type="checkbox" class="accent-violet-500" /> For developers</label>
          <button id="prompt-clear" type="button" class="ml-auto text-white/70 underline hover:text-white">Clear filters</button>
        </div>
        <p id="prompt-search-status" role="status" aria-live="polite" class="text-sm text-white/70 mt-3 text-center hidden"></p>
      </div>

      <div id="prompt-search-results" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 hidden"></div>

      <div class="text-center"><button id="prompt-more" type="button" class="hidden mt-8 mb-8 px-5 py-3 rounded-xl bg-payflo-purple text-white">Show more results</button></div>

      <div id="prompt-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {sortedPrompts.map((prompt, index) => (
          <a
            href={`/prompts/${prompt.id}/`}
            class="group glass-card overflow-hidden animate-on-scroll hover:border-payflo-purple/50 transition-all duration-300"
            style={`animation-delay: ${index * 0.05}s`}
          >
            <div class="p-6">
              <div class="flex flex-wrap gap-2 mb-3">
                {prompt.data.type && (
                  <span class="text-xs px-2.5 py-1 rounded-full bg-payflo-purple/20 text-payflo-purple font-medium">
                    {prompt.data.type}
                  </span>
                )}
                {prompt.data.forDevs && (
                  <span class="text-xs px-2.5 py-1 rounded-full bg-payflo-blue/20 text-payflo-blue font-medium">
                    For developers
                  </span>
                )}
              </div>
              <h2 class="text-lg font-semibold text-white mb-2 group-hover:text-payflo-purple transition-colors">
                {prompt.data.act}
              </h2>
              <p class="text-sm text-white/60 mb-4 line-clamp-2">
                {toExcerpt(prompt.data.improvedPrompt)}
              </p>
              <div class="flex items-center gap-3 text-xs text-white/40">
                {prompt.data.date && <span class="whitespace-nowrap">{prompt.data.date}</span>}
                {prompt.data.date && prompt.data.contributor && <span class="w-1 h-1 shrink-0 rounded-full bg-white/20"></span>}
                {prompt.data.contributor && <span>by {prompt.data.contributor}</span>}
              </div>
            </div>
          </a>
        ))}
      </div>

      {page.lastPage > 1 && (
        <nav id="prompt-pagination" class="flex justify-center items-center gap-2 mt-12 animate-on-scroll" aria-label="Prompts pagination">
          {page.currentPage > 1 && (
            <a
              href={page.currentPage === 2 ? "/prompts/" : `/prompts/${page.currentPage - 1}/`}
              class="px-4 py-2 rounded-lg bg-white/10 text-white hover:bg-white/20 transition-colors text-sm"
            >
              <span class="flex items-center gap-1">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M10 12L6 8l4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                Previous
              </span>
            </a>
          )}

          <div class="flex items-center gap-1">
            {pageNumbers.map((p) => (
              p === "..." ? (
                <span class="w-9 h-9 flex items-center justify-center text-sm text-white/40 select-none">...</span>
              ) : p === page.currentPage ? (
                <span class="w-9 h-9 rounded-lg bg-payflo-purple text-white flex items-center justify-center text-sm font-semibold">{p}</span>
              ) : (
                <a
                  href={p === 1 ? "/prompts/" : `/prompts/${p}/`}
                  class="w-9 h-9 rounded-lg bg-white/10 text-white/70 hover:bg-white/20 hover:text-white transition-colors flex items-center justify-center text-sm"
                >{p}</a>
              )
            ))}
          </div>

          {page.currentPage < page.lastPage && (
            <a
              href={`/prompts/${page.currentPage + 1}/`}
              class="px-4 py-2 rounded-lg bg-white/10 text-white hover:bg-white/20 transition-colors text-sm"
            >
              <span class="flex items-center gap-1">
                Next
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </a>
          )}
        </nav>
      )}
    </div>
  </main>
</Layout>

<script>
  import PromptWorker from '../../search/prompts.worker.js?worker';
  const input = document.getElementById('prompt-search') as HTMLInputElement;
  const type = document.getElementById('prompt-type') as HTMLSelectElement;
  const devs = document.getElementById('prompt-devs') as HTMLInputElement;
  const results = document.getElementById('prompt-search-results')!;
  const status = document.getElementById('prompt-search-status')!;
  const grid = document.getElementById('prompt-grid')!;
  const pagination = document.getElementById('prompt-pagination');
  const more = document.getElementById('prompt-more')!;
  let worker: Worker | undefined;
  let requestId = 0;
  let matches: any[] = [];
  let visible = 24;
  let timer: ReturnType<typeof setTimeout>;
  const escape = (s: string) => String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]!));
  function render() {
    results.innerHTML = matches.slice(0, visible).map(p => `
      <a href="/prompts/${encodeURIComponent(p.slug)}/" class="group glass-card p-6 hover:border-payflo-purple/50 transition-colors">
        <div class="text-xs text-violet-300 mb-3">${escape(p.type)}${p.forDevs ? ' · For developers' : ''}</div>
        <h2 class="text-lg font-semibold mb-2 group-hover:text-payflo-purple">${escape(p.act)}</h2>
        <p class="text-sm text-white/60 line-clamp-2 mb-4">${escape(p.excerpt)}</p>
        ${p.contributor ? `<p class="text-xs text-white/40">by ${escape(p.contributor)}</p>` : ''}
      </a>`).join('');
    status.textContent = matches.length ? `Showing ${Math.min(visible, matches.length)} of ${matches.length.toLocaleString('en-GB')} matching prompts` : 'No prompts match. Try fewer words or clear the filters.';
    more.classList.toggle('hidden', visible >= matches.length);
  }
  function search() {
    const id = ++requestId;
    const query = input.value.trim();
    const params = new URLSearchParams();
    if (query) params.set('q', query);
    if (type.value) params.set('type', type.value);
    if (devs.checked) params.set('devs', '1');
    history.replaceState(null, '', location.pathname + (params.size ? '?' + params : ''));
    const active = !!(query || type.value || devs.checked);
    grid.classList.toggle('hidden', active);
    pagination?.classList.toggle('hidden', active);
    results.classList.toggle('hidden', !active);
    status.classList.toggle('hidden', !active);
    more.classList.add('hidden');
    if (!active) return;
    results.innerHTML = '';
    status.textContent = 'Searching the full prompt library...';
    if (!worker) {
      worker = new PromptWorker();
      worker.onmessage = ({data}) => {
        if (data.id !== requestId) return;
        if (data.error) { status.textContent = 'Search could not load. Please try again. You can still browse the pages below.'; grid.classList.remove('hidden'); pagination?.classList.remove('hidden'); return; }
        matches = data.matches;
        visible = 24;
        render();
      };
      worker.onerror = () => { status.textContent = 'Search could not load. Refresh to try again.'; grid.classList.remove('hidden'); pagination?.classList.remove('hidden'); };
    }
    worker.postMessage({ id, query, type: type.value, devs: devs.checked });
  }
  input.addEventListener('input', () => { clearTimeout(timer); timer = setTimeout(search, 200); });
  type.addEventListener('change', search);
  devs.addEventListener('change', search);
  document.getElementById('prompt-clear')!.addEventListener('click', () => { clearTimeout(timer); input.value = ''; type.value = ''; devs.checked = false; search(); input.focus(); });
  more.addEventListener('click', () => { visible += 24; render(); });
  const params = new URLSearchParams(location.search);
  input.value = params.get('q') || '';
  type.value = params.get('type') || '';
  devs.checked = params.get('devs') === '1';
  if (input.value || type.value || devs.checked) search();
</script>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
