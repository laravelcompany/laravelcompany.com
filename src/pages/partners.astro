---
import Layout from "../layouts/Layout.astro";
import PartnersSection from "../components/Partners.astro";
---

<Layout
  title="Partners & Certifications | Laravel Company"
  description="Our partnerships and certifications with leading industry organizations including AppFutura, CII, CLUTCH, CMO, ISO, NASSCOM, and TIE."
>
  <section class="py-20 bg-payflo-darker">
    <div class="container-custom">
      <div class="text-center max-w-4xl mx-auto mb-16">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-black text-white leading-tight">
          Our Partners &
          <span class="gradient-text bg-gradient-to-r from-emerald-400 via-blue-400 to-violet-400 bg-clip-text text-transparent">
            Certifications
          </span>
        </h1>
        <p class="mt-6 text-xl text-gray-300 max-w-2xl mx-auto">
          We're proud to be affiliated with leading industry organizations and certification bodies that validate our expertise and commitment to quality.
        </p>
      </div>
      <PartnersSection />
    </div>
  </section>
</Layout>