---
import ClientReviews from "../components/ClientReviews.astro";
import { reviewsAggregate, reviewsSchemaJSON } from "../data/reviews";
import Layout from "../layouts/Layout.astro";
import CTASection from "../components/CTASection.astro";
import WhitePaperSection from "../components/WhitePaperSection.astro";
import { Icon } from "astro-icon/components";

const painPoints = [
  {
    title: "Scaling Rapidly",
    desc: "When your business takes off, your software needs to keep pace. We build Laravel applications designed for growth — from database architecture to caching layers and auto-scaling infrastructure — so your platform performs under pressure.",
    icon: "ph:trend-up-duotone"
  },
  {
    title: "Modernising Legacy Systems",
    desc: "Outdated PHP systems slow you down. We migrate legacy applications to modern Laravel frameworks, improving performance, security, and maintainability without disrupting your operations or losing data.",
    icon: "ph:arrows-clockwise-duotone"
  },
  {
    title: "Rescuing Stalled Projects",
    desc: "Stuck with a project that's off track? We step in to audit, restructure, and deliver. Our team has rescued dozens of stalled Laravel builds, getting them back on budget and on schedule.",
    icon: "ph:wrench-duotone"
  },
  {
    title: "Building from Scratch",
    desc: "Starting fresh? We design and build bespoke Laravel web applications from the ground up — clean architecture, intuitive UX, and a product that aligns perfectly with your business goals.",
    icon: "ph:rocket-duotone"
  }
];

const services = [
  {
    title: "Laravel Development",
    desc: "Laravel powers everything we build. As official Laravel partners, we have mastered the framework inside-out — from elegant APIs to complex enterprise applications. Our certified Laravel development experts regularly contribute to core Laravel features and packages, ensuring we are always at the forefront of the framework's evolution.",
    icon: "ph:code-duotone",
    bullets: ["Custom Laravel application development", "API development and integration", "Enterprise-grade solutions", "Legacy application upgrades", "Laravel maintenance and support"],
    link: "/laravel-services/"
  },
  {
    title: "Vue.js Frontend Development",
    desc: "When projects need sophisticated front-end applications — SPAs, complex dashboards, progressive web apps — we build them with Vue's flexibility and performance. Paired with Laravel, we create seamless, dynamic user experiences that keep users engaged.",
    icon: "ph:layout-duotone",
    bullets: ["Single Page Applications (SPAs)", "Complex dashboards and admin panels", "Progressive Web Apps (PWAs)", "Interactive user interfaces", "Vue + Laravel integration"],
    link: "/laravel-services/"
  },
  {
    title: "User Experience Design",
    desc: "Our UI expertise ensures your Laravel application is not just powerful under the hood — it is intuitive, elegant, and does exactly what your users need. We leverage inclusive user research to produce front-end experiences that are accessible, enjoyable, and WCAG compliant.",
    icon: "ph:compass-duotone",
    bullets: ["User research and testing", "Interface design", "Accessibility (WCAG compliance)", "Mobile-first responsive design", "User journey mapping"],
    link: "/laravel-services/"
  }
];

const testimonials = [
  {
    quote: "Jump24 has been instrumental in the success of themarket.co.uk. As our core development partner, the team helped us to create the UK's most sophisticated and successful Classic Car Auction platform.",
    author: "Mark Livesy",
    role: "Head of UK, The Market"
  },
  {
    quote: "The Seafarers Happiness Index is an essential tool for giving seafarers a voice. The team took the time to understand the challenges seafarers face accessing the survey at sea and worked with us to design a mobile-first, reliable, and accessible solution.",
    author: "Steven",
    role: "Seafarers Happiness Index"
  },
  {
    quote: "As a Laravel agency, they have delivered outstanding digital transformation for global brands including Worcester Bosch, Cadbury, Cancer Research UK, and Cabot Financial.",
    author: "Industry Reference",
    role: "Enterprise Client Portfolio"
  }
];

const journalLinks = [
  { title: "Why Laravel is the Best Choice for Enterprise Applications", link: "/laravel-development-company/", icon: "ph:buildings-duotone" },
  { title: "How to Scale Laravel Projects and Applications", link: "/laravel-development-cost/", icon: "ph:chart-line-up-duotone" },
  { title: "Modernising Legacy Systems with Laravel", link: "/laravel-services/", icon: "ph:arrows-clockwise-duotone" },
  { title: "Our Approach to Laravel Security", link: "/laravel-security-audit/", icon: "ph:shield-check-duotone" },
  { title: "Scaling Your Development Team", link: "/hire-laravel-developer/", icon: "ph:users-three-duotone" },
  { title: "Laravel Performance Optimization Guide", link: "/laravel-performance-optimization/", icon: "ph:lightning-duotone" }
];

const deepDiveServices = [
  {
    title: "Laravel Application Development",
    desc: "Laravel's incredible scalability, flexibility and functionality make it one of the best web frameworks for building complex platforms. First, we work to understand your business, service design and user requirements, then design the architecture and infrastructure to deliver them. We identify which of Laravel's seamless integrations like Stripe (payments), Algolia (search), and automated deployment tools will ensure your Laravel web apps can perform immediately, and grow with your business.",
    icon: "ph:code-duotone",
    bullets: ["Custom architecture design", "Payment gateway integration (Stripe, PayPal)", "Search integration (Algolia, Meilisearch)", "Automated deployment pipelines", "Scalable infrastructure"],
    link: "/laravel-services/"
  },
  {
    title: "Laravel Maintenance & Support",
    desc: "Whether it is a new application built by our team, or a Laravel rescue project, we build in strong test automation, making ongoing maintenance and support simple. We support clients with Agile delivery, seamlessly introducing new features to existing applications. When it comes to refactoring your code, our Laravel specialists can guide you through the upgrade for Laravel, PHP and any other code necessary.",
    icon: "ph:wrench-duotone",
    bullets: ["Test automation and CI/CD", "Agile delivery for new features", "Code refactoring and modernisation", "Laravel and PHP version upgrades", "Ongoing monitoring and optimisation"],
    link: "/laravel-services/"
  },
  {
    title: "Cloud Hosting & Infrastructure",
    desc: "We provide cloud hosting for Laravel applications using platforms such as Amazon Web Services (AWS), Google Cloud Platform (GCP) and Microsoft Azure. No matter the platform of choice, we can build a solution that scales with the business and traffic demands. We also optimise the continuous integration delivery pipeline for all our clients' projects, as part of our DevOps services.",
    icon: "ph:cloud-arrow-up-duotone",
    bullets: ["AWS, GCP, and Azure hosting", "Auto-scaling infrastructure", "CI/CD pipeline optimisation", "Docker containerisation", "24/7 monitoring and alerting"],
    link: "/laravel-services/"
  },
  {
    title: "CRM & ERP Integration",
    desc: "Whether you need a customer relationship management (CRM) or enterprise resource planning (ERP) system integration, we can help. Our decade-plus of Laravel CRM integration experience helps us understand exactly how the Laravel application needs to support your business operations. We have delivered projects that synchronise users and push opportunities to Salesforce, Microsoft Dynamics, and HubSpot, and integrated with payment gateways such as Sagepay, Stripe and Worldpay.",
    icon: "ph:plugs-connected-duotone",
    bullets: ["Salesforce, HubSpot, Dynamics integration", "Payment gateways (Stripe, Worldpay, Sagepay)", "User synchronisation and data flows", "Custom API connectors", "Real-time data orchestration"],
    link: "/laravel-services/"
  }
];

const faqs = [
  {
    question: "What types of web applications can be built with Laravel?",
    answer: "Laravel is versatile enough to build everything from simple websites to complex enterprise applications, including e-commerce platforms, content management systems, booking systems, CRM systems, membership platforms, data dashboards, and API backends. Its robust architecture makes it suitable for applications of any scale."
  },
  {
    question: "Why choose a Laravel agency instead of using an off-the-shelf system?",
    answer: "Off-the-shelf systems limit your flexibility and scalability. A Laravel agency builds custom solutions tailored to your specific business needs, workflows, and user requirements. This means you get exactly what you need, can scale as you grow, and are not constrained by someone else's limitations."
  },
  {
    question: "How secure and scalable is Laravel for long-term applications?",
    answer: "Laravel is highly secure and scalable. It includes built-in security features like CSRF protection, encryption, authentication, and authorization. For scalability, Laravel supports caching, queue systems, and can handle high-traffic applications when properly architected. Major companies including Apple, OpenAI, and Pfizer use Laravel."
  },
  {
    question: "Can Laravel integrate with external APIs and other systems?",
    answer: "Yes, Laravel excels at API integration. We regularly integrate with payment gateways (Stripe, Worldpay), CRM systems (Salesforce, HubSpot), search services (Algolia), and many other third-party services. Laravel's HTTP client and API resources make integration seamless."
  },
  {
    question: "Do you build front ends in React or Vue for Laravel applications?",
    answer: "We primarily use Vue.js for frontend development, though we can work with React as well. The decoupled approach allows us to create seamless, dynamic user experiences while keeping the core application secure and scalable. This ensures optimal performance and user experience."
  },
  {
    question: "Is Laravel a good choice for MVPs and enterprise-level projects?",
    answer: "Absolutely. Laravel's rapid prototyping capabilities make it ideal for MVPs, while its scalability and robustness make it perfect for enterprise-level projects. You can start with an MVP and grow into a full enterprise solution without needing to rebuild from scratch."
  },
  {
    question: "Do you take on existing Laravel projects for maintenance or further development?",
    answer: "Yes, we frequently take on existing Laravel projects for maintenance, upgrades, and further development. We can audit your current application, identify areas for improvement, and provide ongoing support to keep your application secure and performing optimally."
  },
  {
    question: "Can you audit our current Laravel application and recommend improvements?",
    answer: "Yes, we offer comprehensive Laravel application audits. We review code quality, security, performance, scalability, and architecture. We provide detailed recommendations for improvements, upgrades, and optimisation."
  },
  {
    question: "Can you support our Laravel app long-term even if you did not build it?",
    answer: "Absolutely. We support many Laravel applications that we did not originally build. Our team can quickly understand your existing codebase, identify issues, and provide ongoing maintenance, support, and enhancement services."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer
    }
  }))
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Laravel Development Agency",
  "provider": {
    "@type": "Organization",
    "name": "Laravel Company",
    "url": "https://laravelcompany.com",
    "aggregateRating": reviewsAggregate,
    "review": reviewsSchemaJSON
  },
  "description": "UK-based Laravel development agency offering custom web applications, API development, SaaS platforms, CRM portals, and enterprise solutions. Laravel Partners since 2015.",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Laravel Development Services",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Laravel Application Development" }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Vue.js Frontend Development" }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "User Experience Design" }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Laravel Maintenance & Support" }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Cloud Hosting & Infrastructure" }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "CRM & ERP Integration" }}
    ]
  }
};
---

<Layout
  title="Laravel Development Agency UK | Custom Web Applications & APIs"
  description="UK-based Laravel development agency. Custom web applications, APIs, SaaS platforms, CRM portals & enterprise solutions. Laravel Partners since 2015. Get a free consultation."
>
  <main id="main-content">
    <!-- Hero -->
    <section class="pt-24 pb-20 md:pt-32 md:pb-28 overflow-hidden relative bg-payflo-dark">
      <div class="absolute inset-0 opacity-10 -z-10">
        <div class="absolute top-0 left-0 w-full h-full bg-[radial-gradient(circle_at_50%_120%,rgba(120,119,198,0.3),rgba(255,255,255,0))]"></div>
      </div>
      <div class="container-custom relative">
        <nav class="flex justify-center items-center gap-2 text-sm text-white/50 mb-8 animate-on-scroll">
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <span>/</span>
          <a href="/laravel-services/" class="hover:text-white transition-colors">Services</a>
          <span>/</span>
          <span class="text-white">Laravel Development Agency</span>
        </nav>
        <div class="max-w-4xl mx-auto text-center">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-payflo-purple/10 border border-payflo-purple/20 mb-8 animate-on-scroll">
            <Icon name="ph:buildings-duotone" class="w-5 h-5 text-payflo-purple" />
            <span class="text-sm font-bold uppercase tracking-widest text-white/70">Laravel Agency</span>
          </div>
          <h1 class="text-5xl md:text-7xl lg:text-8xl font-black leading-tight tracking-tight text-white">
            Laravel in Your <span class="gradient-text">Language</span>
          </h1>
          <p class="animate-on-scroll delay-2 mt-4 text-2xl md:text-3xl text-white/80 leading-relaxed font-black">
            We make the sophisticated simple, crafting elegant and efficient code, setting you free to focus on growing your business.
          </p>
          <p class="animate-on-scroll delay-2 mt-6 text-xl text-white/60 leading-relaxed font-medium max-w-3xl mx-auto">
            Whether you are scaling rapidly, modernising a legacy system, rescuing a stalled project, or building from scratch — we will get you unstuck and moving forward.
          </p>
          <div class="animate-on-scroll delay-3 mt-10 flex flex-wrap justify-center gap-4 text-sm font-bold uppercase tracking-widest text-white/50">
            <span class="flex items-center gap-2"><Icon name="ph:handshake-duotone" class="w-5 h-5 text-payflo-purple" /> Laravel Partners Since 2015</span>
            <span class="flex items-center gap-2"><Icon name="ph:trophy-duotone" class="w-5 h-5 text-payflo-pink" /> 500+ Projects Delivered</span>
            <span class="flex items-center gap-2"><Icon name="ph:star-duotone" class="w-5 h-5 text-payflo-purple" /> 4.9/5 Client Rating</span>
          </div>
          <div class="animate-on-scroll delay-3 mt-12 flex flex-wrap justify-center gap-6">
            <a href="/contact/" class="btn btn-primary px-10 py-5 text-lg shadow-2xl">Ready to Start? Let's Talk</a>
            <a href="/about-us/" class="btn glass-card border-white/20 px-10 py-5 text-lg hover:bg-white/10 transition-all font-bold">View Our Work</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Problem / Solution -->
    <section class="py-24 bg-white/5">
      <div class="container-custom">
        <div class="text-center max-w-3xl mx-auto mb-20 animate-on-scroll">
          <h2 class="text-4xl md:text-5xl font-black mb-6">Trusted by Ambitious Businesses <span class="gradient-text">Across the UK and Beyond</span></h2>
          <p class="text-gray-400 text-lg">From early-stage start-ups to multi-million pound exits, from teams scaling to 100,000+ users to organisations attracting major investors — we deliver Laravel solutions that drive real growth.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
          {painPoints.map((p, i) => (
            <div class={`animate-on-scroll delay-${i} glass-card p-8 border-white/10 group hover:border-payflo-purple/50 transition-colors`}>
              <Icon name={p.icon} class="w-10 h-10 text-payflo-purple mb-5 group-hover:scale-110 transition-transform" />
              <h3 class="text-xl font-black mb-3 text-white">{p.title}</h3>
              <p class="text-gray-400 text-sm leading-relaxed">{p.desc}</p>
            </div>
          ))}
        </div>
        <div class="animate-on-scroll mt-16 flex flex-wrap justify-center gap-8 text-center">
          <div class="px-6">
            <p class="text-3xl font-black text-white mb-1">Start-ups</p>
            <p class="text-gray-400 text-sm">to multi-million pound exits</p>
          </div>
          <div class="w-px bg-white/10 hidden md:block"></div>
          <div class="px-6">
            <p class="text-3xl font-black text-white mb-1">100,000+</p>
            <p class="text-gray-400 text-sm">users scaling with our platforms</p>
          </div>
          <div class="w-px bg-white/10 hidden md:block"></div>
          <div class="px-6">
            <p class="text-3xl font-black text-white mb-1">Major Investors</p>
            <p class="text-gray-400 text-sm">attracted by our client platforms</p>
          </div>
        </div>
        <div class="animate-on-scroll mt-12 flex flex-wrap justify-center gap-6 text-sm">
          <a href="/about-us/" class="text-payflo-purple hover:underline font-bold">See our story →</a>
          <a href="/laravel-services/" class="text-payflo-purple hover:underline font-bold">Explore services →</a>
        </div>
      </div>
    </section>

    <!-- Services Overview -->
    <section class="py-24">
      <div class="container-custom">
        <div class="text-center max-w-3xl mx-auto mb-20 animate-on-scroll">
          <h2 class="text-4xl md:text-5xl font-black mb-6">What We <span class="gradient-text">Do</span></h2>
          <p class="text-gray-400 text-lg">We combine deep Laravel expertise with modern frontend frameworks and user-centred design to deliver applications that are powerful, beautiful, and built to last.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {services.map((s, i) => (
            <div class={`animate-on-scroll delay-${i} glass-card p-8 border-white/10 group hover:border-payflo-purple/50 transition-colors flex flex-col`}>
              <Icon name={s.icon} class="w-12 h-12 text-payflo-purple mb-6 group-hover:scale-110 transition-transform" />
              <h3 class="text-xl font-black mb-3 text-white">{s.title}</h3>
              <p class="text-gray-400 text-sm leading-relaxed mb-6 flex-1">{s.desc}</p>
              <ul class="space-y-2 mb-6">
                {s.bullets.map(b => (
                  <li class="flex items-center gap-2 text-sm text-white/60">
                    <Icon name="ph:check-circle-fill" class="w-4 h-4 text-payflo-purple flex-shrink-0" /> {b}
                  </li>
                ))}
              </ul>
              <a href={s.link} class="text-payflo-purple hover:underline font-bold text-sm mt-auto">Learn more →</a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Our Advantage -->
    <section class="py-24 bg-white/5">
      <div class="container-custom">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
          <div class="animate-on-scroll">
            <h2 class="text-4xl font-black mb-8">Never Outsourced. Never Offshored. <span class="gradient-text">Always Exceptional.</span></h2>
            <p class="text-gray-400 text-lg leading-relaxed mb-6">
              We believe in clarity over complexity. That means straightforward communication, no jargon, and making sure you are with us at every turn. We work efficiently and effectively — never outsourced, never offshored, always exceptional.
            </p>
            <p class="text-gray-400 text-lg leading-relaxed">
              Your project becomes our priority, with a flexible approach shaped to your needs. From initial discovery through to long-term optimisation, we act as a trusted Laravel development partner, not just a supplier.
            </p>
          </div>
          <div class="animate-on-scroll delay-2">
            <div class="glass-card p-10 border-white/10">
              <div class="space-y-6">
                <div class="flex gap-4">
                  <Icon name="ph:handshake-duotone" class="w-8 h-8 text-payflo-purple flex-shrink-0 mt-1" />
                  <div>
                    <h4 class="text-lg font-bold text-white mb-1">Laravel Partner Since 2015</h4>
                    <p class="text-gray-400 text-sm">Official recognition of our expertise, commitment, and contribution to the Laravel ecosystem.</p>
                  </div>
                </div>
                <div class="flex gap-4">
                  <Icon name="ph:shield-check-duotone" class="w-8 h-8 text-payflo-pink flex-shrink-0 mt-1" />
                  <div>
                    <h4 class="text-lg font-bold text-white mb-1">ISO 27001 Accredited</h4>
                    <p class="text-gray-400 text-sm">Enterprise-grade information security management across every project we deliver.</p>
                  </div>
                </div>
                <div class="flex gap-4">
                  <Icon name="ph:certificate-duotone" class="w-8 h-8 text-payflo-purple flex-shrink-0 mt-1" />
                  <div>
                    <h4 class="text-lg font-bold text-white mb-1">Laravel Certified Company</h4>
                    <p class="text-gray-400 text-sm">Every developer on our team holds Laravel certification with proven hands-on experience.</p>
                  </div>
                </div>
                <div class="flex gap-4">
                  <Icon name="ph:seal-check-duotone" class="w-8 h-8 text-payflo-pink flex-shrink-0 mt-1" />
                  <div>
                    <h4 class="text-lg font-bold text-white mb-1">Multiple ISO-Accredited Processes</h4>
                    <p class="text-gray-400 text-sm">Quality management, environmental, and security processes independently verified.</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- AI-Enhanced Development -->
    <section class="py-24">
      <div class="container-custom max-w-4xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 items-center">
          <div class="lg:col-span-2 animate-on-scroll">
            <div class="glass-card p-8 border-white/10 text-center">
              <Icon name="ph:brain-duotone" class="w-16 h-16 text-payflo-purple mx-auto mb-4" />
              <p class="text-sm font-bold uppercase tracking-widest text-white/50">AI-Enhanced</p>
              <p class="text-xl font-black text-white mt-1">Laravel Development</p>
            </div>
          </div>
          <div class="lg:col-span-3 animate-on-scroll delay-1">
            <h2 class="text-3xl font-black mb-6">Smarter Development with <span class="gradient-text">AI Tools</span></h2>
            <p class="text-gray-400 leading-relaxed mb-4">
              We use AI tools to enhance how we design, build, and maintain Laravel applications — never to replace the thinking, experience, or accountability of our team. AI helps us move faster, spot issues earlier, and focus more time on solving the right problems.
            </p>
            <p class="text-gray-400 leading-relaxed mb-6">
              Every decision, line of code, and architectural choice is still made and owned by our UK-based developers. The result: faster delivery, higher quality, and better value for your investment.
            </p>
            <a href="/about-us/" class="text-payflo-purple hover:underline font-bold text-sm">Our approach →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Client Testimonials -->
    <section class="py-24 bg-white/5">
      <div class="container-custom">
        <div class="text-center max-w-3xl mx-auto mb-16 animate-on-scroll">
          <h2 class="text-4xl md:text-5xl font-black mb-6">What Our <span class="gradient-text">Clients Say</span></h2>
          <p class="text-gray-400 text-lg">Trusted by businesses that demand quality software and measurable results.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
          {testimonials.map((t, i) => (
            <div class={`animate-on-scroll delay-${i} glass-card p-8 border-white/10 group hover:border-payflo-purple/50 transition-colors relative`}>
              <Icon name="ph:quotes-duotone" class="w-10 h-10 text-payflo-purple/30 mb-4" />
              <p class="text-white/80 text-sm leading-relaxed italic mb-6">{t.quote}</p>
              <div class="border-t border-white/10 pt-4">
                <p class="font-black text-white text-sm">{t.author}</p>
                <p class="text-white/50 text-xs uppercase tracking-wider">{t.role}</p>
              </div>
            </div>
          ))}
        </div>
        <div class="animate-on-scroll mt-12 text-center">
          <a href="/about-us/" class="text-payflo-purple hover:underline font-bold text-sm">View all client stories →</a>
        </div>
      </div>
    </section>

    <!-- Journal / Insights -->
    <section class="py-24">
      <div class="container-custom">
        <div class="text-center max-w-3xl mx-auto mb-16 animate-on-scroll">
          <h2 class="text-4xl md:text-5xl font-black mb-6">Insights & <span class="gradient-text">Thinking</span></h2>
          <p class="text-gray-400 text-lg">Practical knowledge from over a decade of Laravel development across multiple sectors and markets.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
          {journalLinks.map((j, i) => (
            <a href={j.link} class={`animate-on-scroll delay-${i} glass-card p-6 border-white/10 group hover:border-payflo-purple/50 transition-colors`}>
              <Icon name={j.icon} class="w-8 h-8 text-payflo-purple mb-4 group-hover:scale-110 transition-transform" />
              <h3 class="text-base font-black text-white group-hover:text-payflo-purple transition-colors leading-snug">{j.title}</h3>
            </a>
          ))}
        </div>
        <div class="animate-on-scroll mt-10 text-center">
          <a href="/about-us/" class="text-payflo-purple hover:underline font-bold text-sm">Read more insights →</a>
        </div>
      </div>
    </section>

    <!-- Core Services Deep-Dive -->
    <section class="py-24 bg-white/5">
      <div class="container-custom max-w-5xl mx-auto">
