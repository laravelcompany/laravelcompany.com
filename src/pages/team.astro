---
import Layout from "../layouts/Layout.astro";

const teamMembers = [
  {
    name: "Bogdanboti",
    github: "Bogdanboti",
    avatar: "https://avatars.githubusercontent.com/u/90279111?s=96&v=4",
  },
  {
    name: "Stefan Bogdan",
    github: "izdrail",
    avatar: "https://avatars.githubusercontent.com/u/2276408?s=96&v=4",
  },
  {
    name: "Jon Basildon",
    github: "jonbasildon",
    avatar: "https://avatars.githubusercontent.com/u/145971646?s=96&v=4",
  },
  {
    name: "andreim",
    github: "marmureanuweb",
    avatar: "https://avatars.githubusercontent.com/u/13685130?s=96&v=4",
  },
  {
    name: "Marian P",
    github: "popiciulo",
    avatar: "https://avatars.githubusercontent.com/u/8106610?s=96&v=4",
  },
  {
    name: "Syed Hammad Ahmed",
    github: "shammadahmed",
    avatar: "https://avatars.githubusercontent.com/u/8712631?s=96&v=4",
  },
];
---

<Layout
  title="Our Team | Laravel Company"
  description="Meet the talented team behind Laravel Company - experts in software development, geolocation, and 3D maps solutions."
>
  <section class="pt-20 pb-16 md:pt-28 md:pb-24">
    <div class="container-custom">
      <div class="text-center max-w-4xl mx-auto animate-on-scroll">
        <span class="inline-block px-4 py-1 bg-payflo-purple/20 rounded-full text-sm font-medium text-payflo-purple mb-6">
          Our People
        </span>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight">
          Meet the <span class="gradient-text">Team</span>
        </h1>
        <p class="mt-6 text-xl text-white/70">
          The talented individuals behind Laravel Company. We're a team of passionate 
          developers and innovators specializing in geolocation technology and 3D maps solutions.
        </p>
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="container-custom">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {
          teamMembers.map((member, index) => (
            <div 
              class="glass-card animate-on-scroll p-6 text-center group"
              style={`animation-delay: ${index * 0.1}s`}
            >
              <div class="relative inline-block mb-6">
                <img
                  src={member.avatar}
                  alt={`${member.name} avatar`}
                  class="w-24 h-24 rounded-full mx-auto border-4 border-payflo-purple/30 group-hover:border-payflo-purple transition-colors duration-300"
                  onerror={`this.src='https://ui-avatars.com/api/?name=${encodeURIComponent(member.name)}&background=7c3aed&color=fff'`}
                />
                <div class="absolute inset-0 rounded-full ring-2 ring-offset-2 ring-offset-transparent ring-payflo-purple/0 group-hover:ring-payflo-purple/50 transition-all duration-300" />
              </div>
              <h3 class="text-xl font-semibold text-white mb-2">
                {member.name}
              </h3>
              <a
                href={`https://github.com/${member.github}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-white/60 hover:text-white transition-colors duration-200"
                aria-label={`View ${member.name}'s GitHub profile`}
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
                </svg>
                <span>@{member.github}</span>
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-20 bg-payflo-darker/30">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto text-center animate-on-scroll">
        <h2 class="text-3xl md:text-4xl font-bold">Join Our Growing Team</h2>
        <p class="mt-4 text-xl text-white/70">
          We're always looking for talented individuals to join our team. 
          Check out our open positions and become part of the Laravel Company family.
        </p>
        <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/jobs/" class="btn btn-primary">
            View Open Positions
          </a>
          <a href="/esop/" class="btn btn-secondary">
            Learn About ESOP
          </a>
        </div>
      </div>
    </div>
  </section>

  <section
    class="py-20 bg-gradient-to-r from-payflo-purple to-payflo-blue text-white relative overflow-hidden"
  >
    <div class="absolute inset-0 bg-[url('/grid-pattern.svg')] opacity-10"></div>
    <div class="container-custom relative">
      <div class="max-w-3xl mx-auto text-center animate-on-scroll">
        <h2 class="text-3xl md:text-4xl font-bold">Connect With Us</h2>
        <p class="mt-6 text-xl opacity-90">
          Follow us on GitHub to see our latest projects and contributions to the open source community.
        </p>
        <div class="mt-10 flex justify-center gap-6">
          <a
            href="https://github.com/laravelcompany"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 px-6 py-3 bg-white/10 hover:bg-white/20 rounded-xl transition-colors duration-300"
            aria-label="Follow us on GitHub"
          >
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
            </svg>
            <span class="font-semibold">@laravelcompany</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
