---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";

interface TeamMember {
  name: string;
  role: string;
  skills: string[];
  github: string;
  avatar: string;
}

const teamMembers: TeamMember[] = [
  {
    name: "Bogdan Boti",
    role: "Full-Stack Developer",
    skills: ["Laravel", "Vue.js", "MySQL"],
    github: "Bogdanboti",
    avatar: "https://avatars.githubusercontent.com/u/90279111?s=96&v=4",
  },
  {
    name: "Stefan Bogdan",
    role: "Senior Full-Stack Developer",
    skills: ["Laravel", "React", "DevOps"],
    github: "izdrail",
    avatar: "https://avatars.githubusercontent.com/u/2276408?s=96&v=4",
  },
  {
    name: "Jon Basildon",
    role: "Full-Stack Developer",
    skills: ["Laravel", "Tailwind", "Livewire"],
    github: "jonbasildon",
    avatar: "https://avatars.githubusercontent.com/u/145971646?s=96&v=4",
  },
  {
    name: "Andrei M",
    role: "Full-Stack Developer",
    skills: ["Laravel", "Vue.js", "API Design"],
    github: "marmureanuweb",
    avatar: "https://avatars.githubusercontent.com/u/13685130?s=96&v=4",
  },
  {
    name: "Marian P",
    role: "Senior Developer",
    skills: ["Laravel", "React", "PostgreSQL"],
    github: "popiciulo",
    avatar: "https://avatars.githubusercontent.com/u/8106610?s=96&v=4",
  },
  {
    name: "Syed Hammad Ahmed",
    role: "Full-Stack Developer",
    skills: ["Laravel", "React", "AWS"],
    github: "shammadahmed",
    avatar: "https://avatars.githubusercontent.com/u/8712631?s=96&v=4",
  },
];
---

<Layout
  title="Our Team | Laravel Company"
  description="Meet the talented team behind Laravel Company — expert Laravel developers, engineers, and open source contributors building world-class web applications."
>
  <!-- ===== HERO + CONSTELLATION ===== -->
  <section class="relative min-h-screen overflow-hidden bg-[#05080f]">
    <!-- Three.js Canvas -->
    <div id="constellation-canvas" class="absolute inset-0 z-0"></div>

    <!-- Gradient overlays -->
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-[#05080f] z-[1] pointer-events-none"></div>
    <div class="absolute top-0 left-1/4 w-[600px] h-[600px] bg-payflo-purple/5 blur-[150px] rounded-full -z-10 pointer-events-none"></div>
    <div class="absolute bottom-0 right-1/4 w-[500px] h-[500px] bg-payflo-blue/5 blur-[120px] rounded-full -z-10 pointer-events-none"></div>

    <div class="relative z-10 pt-20 md:pt-28">
      <div class="container-custom">
        <nav class="flex justify-center items-center gap-2 text-sm text-white/40 mb-8 animate-on-scroll">
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <span>/</span>
          <span class="text-white/80">Our Team</span>
        </nav>

        <div class="text-center max-w-4xl mx-auto animate-on-scroll">
          <span class="inline-block px-4 py-1.5 rounded-full text-sm font-bold uppercase tracking-widest text-payflo-purple bg-payflo-purple/10 border border-payflo-purple/20 mb-6">
            Our People
          </span>
          <h1 class="text-5xl md:text-6xl lg:text-7xl font-black leading-tight text-white">
            Meet the <span class="gradient-text">Constellation</span>
          </h1>
          <p class="mt-6 text-lg md:text-xl text-white/60 leading-relaxed max-w-2xl mx-auto">
            A team of passionate Laravel developers, open source contributors, and problem solvers building the future of web applications.
          </p>
        </div>
      </div>

      <!-- Constellation -->
      <div class="mt-10 md:mt-16" id="team-constellation">
        <div class="max-w-6xl mx-auto px-4">
          <div class="constellation-container relative" id="constellation-container">
            <!-- SVG lines -->
            <svg
              id="constellation-svg"
              class="absolute inset-0 w-full h-full z-[1] pointer-events-none hidden md:block"
              style="position:absolute;top:0;left:0;width:100%;height:100%;"
            ></svg>

            <!-- Center Orb -->
            <div
              id="center-orb"
              class="hidden md:flex absolute z-[2] flex-col items-center justify-center"
              style="top:50%;left:50%;transform:translate(-50%,-50%);"
            >
              <div class="w-20 h-20 rounded-full bg-gradient-to-br from-payflo-purple via-payflo-pink to-payflo-blue p-[3px] shadow-2xl shadow-payflo-purple/40 animate-pulse-glow">
                <div class="w-full h-full rounded-full bg-[#05080f] flex items-center justify-center">
                  <svg class="w-10 h-10 text-white" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M0 0h24v24H0z" fill="none"/>
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/>
                  </svg>
                </div>
              </div>
              <span class="mt-3 text-xs font-bold text-white/40 uppercase tracking-widest">Laravel Company</span>
            </div>

            <!-- Team Cards Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8 relative z-[3] md:pt-0">
              {
                teamMembers.map((member, index) => {
                  const animationDelay = `${index * 0.15}s`;
                  return (
                    <div
                      class="team-card group animate-on-scroll"
                      style={`animation-delay: ${animationDelay}`}
                      data-index={index}
                    >
                      <div class="glass-card p-6 md:p-7 text-center border-white/[0.06] hover:border-payflo-purple/30 bg-white/[0.03] hover:bg-white/[0.06] backdrop-blur-xl relative overflow-hidden">
                        {/* Hover glow */}
                        <div class="absolute -top-20 -right-20 w-40 h-40 bg-payflo-purple/5 blur-[60px] rounded-full group-hover:bg-payflo-purple/10 transition-all duration-700"></div>

                        {/* Avatar with conic gradient ring */}
                        <div class="relative inline-block mb-5">
                          <div class="w-24 h-24 rounded-full p-[3px] bg-gradient-to-br from-payflo-purple via-payflo-pink to-payflo-blue animate-spin-slow group-hover:from-payflo-blue group-hover:via-payflo-purple group-hover:to-payflo-pink transition-all duration-700">
                            <div class="w-full h-full rounded-full overflow-hidden bg-[#05080f]">
                              <img
                                src={member.avatar}
                                alt={`${member.name}`}
                                class="w-full h-full object-cover"
                                onerror={`this.src='https://ui-avatars.com/api/?name=${encodeURIComponent(member.name)}&background=7c3aed&color=fff&size=96'`}
                                loading="lazy"
                              />
                            </div>
                          </div>
                          {/* Online dot */}
                          <div class="absolute -bottom-1 -right-1 w-5 h-5 rounded-full bg-emerald-500 border-[3px] border-[#05080f] shadow-lg shadow-emerald-500/30">
                            <div class="absolute inset-0 rounded-full bg-emerald-500 animate-ping opacity-30"></div>
                          </div>
                        </div>

                        {/* Name & Role */}
                        <h3 class="text-xl font-bold text-white mb-1">{member.name}</h3>
                        <p class="text-sm text-payflo-purple/80 font-medium mb-4">{member.role}</p>

                        {/* Skills */}
                        <div class="flex flex-wrap justify-center gap-2 mb-5">
                          {member.skills.map((skill) => (
                            <span class="px-3 py-1 text-[11px] font-bold uppercase tracking-wider rounded-full bg-white/[0.06] text-white/50 border border-white/[0.06] group-hover:border-payflo-purple/20 group-hover:text-white/70 transition-all duration-300">
                              {skill}
                            </span>
                          ))}
                        </div>

                        {/* Social links */}
                        <div class="flex justify-center gap-3 pt-3 border-t border-white/[0.06]">
                          <a
                            href={`https://github.com/${member.github}`}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="w-9 h-9 rounded-lg bg-white/[0.04] hover:bg-white/10 flex items-center justify-center text-white/40 hover:text-white transition-all duration-200 group/btn"
                            aria-label={`${member.name}'s GitHub`}
                          >
                            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/></svg>
                          </a>
                          <a
                            href={`https://github.com/${member.github}`}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="flex items-center gap-1.5 px-3 h-9 rounded-lg bg-white/[0.04] hover:bg-white/10 text-[11px] font-bold text-white/40 hover:text-white uppercase tracking-wider transition-all duration-200"
                            aria-label={`View ${member.name}'s GitHub profile`}
                          >
                            <span>GitHub</span>
                            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                          </a>
                        </div>
                      </div>
                    </div>
                  );
                })
              }
            </div>
          </div>
        </div>
      </div>

      <!-- Scroll indicator -->
      <div class="flex justify-center mt-16 md:mt-20 pb-10 animate-on-scroll">
        <div class="flex flex-col items-center gap-2 text-white/20">
          <span class="text-[10px] font-bold uppercase tracking-widest">Scroll to explore</span>
          <div class="w-5 h-8 rounded-full border border-white/20 flex justify-center pt-1.5">
            <div class="w-1 h-2 rounded-full bg-white/40 animate-bounce"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== STATS ===== -->
  <section class="py-20 md:py-28 relative overflow-hidden bg-[#05080f]">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-gradient-to-r from-payflo-purple/3 via-transparent to-payflo-blue/3 blur-[100px] rounded-full pointer-events-none"></div>
    <div class="container-custom relative">
      <div class="text-center max-w-3xl mx-auto mb-16 animate-on-scroll">
        <h2 class="text-3xl md:text-5xl font-black text-white leading-tight">
          By the <span class="gradient-text">Numbers</span>
        </h2>
        <p class="mt-4 text-white/50 text-lg">The reach and impact of our work across the Laravel ecosystem.</p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
        {[
          { value: "18+", label: "Developers", icon: "ph:users-three-duotone" },
          { value: "250+", label: "Projects Delivered", icon: "ph:rocket-launch-duotone" },
          { value: "10M+", label: "Package Downloads", icon: "ph:download-duotone" },
          { value: "8+", label: "Years in Business", icon: "ph:calendar-check-duotone" },
        ].map((stat, i) => (
          <div
            class="animate-on-scroll glass-card p-6 md:p-8 text-center border-white/[0.06] hover:border-payflo-purple/20 bg-white/[0.03] group"
            style={`animation-delay: ${i * 0.1}s`}
          >
            <Icon name={stat.icon} class="w-8 h-8 mx-auto mb-4 text-payflo-purple/60 group-hover:text-payflo-purple transition-colors" />
            <div class="text-3xl md:text-4xl font-black text-white mb-1">{stat.value}</div>
            <div class="text-sm text-white/40 font-medium">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== BOTTOM 3-COLUMN SECTION ===== -->
  <section class="py-20 md:py-28 relative overflow-hidden bg-gradient-to-b from-[#05080f] via-payflo-dark to-payflo-dark">
    <div class="container-custom">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-10">
        <!-- Why Companies Choose Us -->
        <div class="animate-on-scroll">
          <div class="glass-card p-8 border-white/[0.06] bg-white/[0.02] h-full">
            <div class="w-12 h-12 rounded-xl bg-payflo-purple/10 border border-payflo-purple/20 flex items-center justify-center mb-6">
              <Icon name="ph:star-duotone" class="w-6 h-6 text-payflo-purple" />
            </div>
            <h3 class="text-xl font-bold text-white mb-4">Why Companies Choose Us</h3>
            <ul class="space-y-3">
              {[
                "Deep Laravel expertise — core contributors to the ecosystem",
                "Proven track record with 250+ successful project deliveries",
                "Open source first — we give back to the community",
                "Transparent communication and agile development process",
                "End-to-end service from strategy through deployment and maintenance",
              ].map((item) => (
                <li class="flex items-start gap-3 text-sm text-white/60">
                  <svg class="w-4 h-4 mt-0.5 shrink-0 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Tech Stack -->
        <div class="animate-on-scroll" style="animation-delay:0.1s">
          <div class="glass-card p-8 border-white/[0.06] bg-white/[0.02] h-full">
            <div class="w-12 h-12 rounded-xl bg-payflo-blue/10 border border-payflo-blue/20 flex items-center justify-center mb-6">
              <Icon name="ph:code-duotone" class="w-6 h-6 text-payflo-blue" />
            </div>
            <h3 class="text-xl font-bold text-white mb-4">Our Tech Stack</h3>
            <div class="flex flex-wrap gap-2">
              {["Laravel", "PHP", "Vue.js", "React", "Tailwind", "Livewire", "Alpine.js", "MySQL", "PostgreSQL", "Redis", "AWS", "Vapor", "Docker", "GitHub Actions", "Three.js"].map((tech) => (
                <span class="px-3 py-1.5 text-xs font-bold uppercase tracking-wider rounded-lg bg-white/[0.04] text-white/50 border border-white/[0.06] hover:border-payflo-purple/30 hover:text-white/80 hover:bg-white/[0.06] transition-all duration-200 cursor-default">
                  {tech}
                </span>
              ))}
            </div>
          </div>
        </div>

        <!-- Open Source Impact -->
        <div class="animate-on-scroll" style="animation-delay:0.2s">
          <div class="glass-card p-8 border-white/[0.06] bg-white/[0.02] h-full">
            <div class="w-12 h-12 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center mb-6">
              <Icon name="ph:github-logo-duotone" class="w-6 h-6 text-emerald-400" />
            </div>
            <h3 class="text-xl font-bold text-white mb-4">Open Source Impact</h3>
            <ul class="space-y-4">
              {[
                { pkg: "Laravel SEO", desc: "Powerful search engine optimization for Laravel apps", downloads: "2.5M+" },
                { pkg: "Laravel Mail", desc: "Beautiful transactional email package", downloads: "1.8M+" },
                { pkg: "Laravel GPT", desc: "AI integration toolkit for Laravel", downloads: "1.2M+" },
              ].map((pkg) => (
                <li class="flex items-start gap-3 p-3 rounded-xl bg-white/[0.03] hover:bg-white/[0.06] transition-colors">
                  <div class="w-8 h-8 rounded-lg bg-payflo-purple/10 border border-payflo-purple/20 flex items-center justify-center shrink-0 mt-0.5">
                    <Icon name="ph:puzzle-piece-duotone" class="w-4 h-4 text-payflo-purple" />
                  </div>
                  <div class="min-w-0">
                    <div class="flex items-center gap-2 mb-0.5">
                      <span class="text-sm font-bold text-white">{pkg.pkg}</span>
                      <span class="text-[10px] font-bold text-emerald-500/70 bg-emerald-500/10 px-1.5 py-0.5 rounded">{pkg.downloads} downloads</span>
                    </div>
                    <p class="text-xs text-white/40">{pkg.desc}</p>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== CTA ===== -->
  <section class="py-20 md:py-28 relative overflow-hidden bg-payflo-darker">
    <div class="absolute top-0 left-1/4 w-96 h-96 bg-payflo-purple/10 blur-[120px] rounded-full pointer-events-none"></div>
    <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-payflo-blue/10 blur-[120px] rounded-full pointer-events-none"></div>
    <div class="container-custom relative">
      <div class="max-w-3xl mx-auto text-center animate-on-scroll">
        <h2 class="text-3xl md:text-5xl font-black text-white leading-tight">
          Ready to Build Something <span class="gradient-text">Great</span>?
        </h2>
        <p class="mt-6 text-lg text-white/60 leading-relaxed">
          Let's discuss your next project. Our team is ready to help you turn your vision into a powerful, scalable web application.
        </p>
        <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/contact/" class="btn btn-primary text-base">
            Start Your Project
          </a>
          <a href="/jobs/" class="btn btn-secondary text-base">
            Join Our Team
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
import * as THREE from 'three';

const canvasEl = document.getElementById('constellation-canvas');
if (!canvasEl) throw new Error('Missing constellation canvas');

const W = window.innerWidth;
const H = window.innerHeight;

const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
renderer.setSize(W, H);
canvasEl.appendChild(renderer.domElement);

const scene = new THREE.Scene();
const camera = new THREE.PerspectiveCamera(60, W / H, 0.1, 200);
camera.position.z = 60;

// ── Stars ──
const STAR_COUNT = 400;
const starGeo = new THREE.BufferGeometry();
const starPos = new Float32Array(STAR_COUNT * 3);
const starSizes = new Float32Array(STAR_COUNT);
const starSpeeds = new Float32Array(STAR_COUNT);

for (let i = 0; i < STAR_COUNT; i++) {
  starPos[i*3] = (Math.random() - 0.5) * 200;
  starPos[i*3+1] = (Math.random() - 0.5) * 120;
  starPos[i*3+2] = (Math.random() - 0.5) * 80 - 20;
  starSizes[i] = 0.5 + Math.random() * 1.5;
  starSpeeds[i] = 0.0003 + Math.random() * 0.001;
}
starGeo.setAttribute('position', new THREE.BufferAttribute(starPos, 3));
starGeo.setAttribute('size', new THREE.BufferAttribute(starSizes, 1));

const starMat = new THREE.PointsMaterial({
  color: 0x7c3aed,
  size: 0.25,
  transparent: true,
  opacity: 0.6,
  blending: THREE.AdditiveBlending,
  depthWrite: false,
});
const stars = new THREE.Points(starGeo, starMat);
scene.add(stars);

// ── Constellation connections ──
const EDGE_COUNT = 60;
const connGeo = new THREE.BufferGeometry();
const connPositions = new Float32Array(EDGE_COUNT * 2 * 3);
const connOpacities = new Float32Array(EDGE_COUNT);

for (let i = 0; i < EDGE_COUNT; i++) {
  const i1 = Math.floor(Math.random() * STAR_COUNT);
  const i2 = Math.floor(Math.random() * STAR_COUNT);
  connPositions[i*6] = starPos[i1*3];
  connPositions[i*6+1] = starPos[i1*3+1];
  connPositions[i*6+2] = starPos[i1*3+2];
  connPositions[i*6+3] = starPos[i2*3];
  connPositions[i*6+4] = starPos[i2*3+1];
  connPositions[i*6+5] = starPos[i2*3+2];
  connOpacities[i] = 0.1 + Math.random() * 0.3;
}
connGeo.setAttribute('position', new THREE.BufferAttribute(connPositions, 3));

const connMat = new THREE.LineBasicMaterial({
  color: 0x7c3aed,
  transparent: true,
  opacity: 0.15,
});
const connections = new THREE.LineSegments(connGeo, connMat);
scene.add(connections);

// ── Glowing orbs ──
const orbGroup = new THREE.Group();
scene.add(orbGroup);

const orbColors = [0x7c3aed, 0xec4899, 0x3b82f6];
orbColors.forEach((color, i) => {
  const geo = new THREE.SphereGeometry(0.6 + i * 0.15, 16, 16);
  const mat = new THREE.MeshBasicMaterial({
    color,
    transparent: true,
    opacity: 0.3 - i * 0.08,
  });
  const mesh = new THREE.Mesh(geo, mat);
  const angle = (i / orbColors.length) * Math.PI * 2;
  mesh.position.set(Math.cos(angle) * 6, Math.sin(angle) * 4, -5 + i * 3);
  orbGroup.add(mesh);

  // Glow halo
  const haloGeo = new THREE.SphereGeometry((0.6 + i * 0.15) * 2.5, 16, 16);
  const haloMat = new THREE.MeshBasicMaterial({
    color,
    transparent: true,
    opacity: 0.06,
  });
  const halo = new THREE.Mesh(haloGeo, haloMat);
  halo.position.copy(mesh.position);
  orbGroup.add(halo);
});

// ── Mouse tracking ──
let mouseX = 0;
let mouseY = 0;
let targetRotX = 0;
let targetRotY = 0;

document.addEventListener('mousemove', (e) => {
  mouseX = (e.clientX / window.innerWidth) * 2 - 1;
  mouseY = (e.clientY / window.innerHeight) * 2 - 1;
});

// ── Animate ──
let time = 0;
function animate() {
  requestAnimationFrame(animate);
  time += 0.005;

  // Smooth mouse following
  targetRotX += (mouseY * 0.05 - targetRotX) * 0.02;
  targetRotY += (mouseX * 0.05 - targetRotY) * 0.02;

  stars.rotation.x = targetRotX * 0.3;
  stars.rotation.y = targetRotY * 0.3;
  connections.rotation.x = targetRotX * 0.3;
  connections.rotation.y = targetRotY * 0.3;

  // Drift stars
  const pos = starGeo.attributes.position.array;
  for (let i = 0; i < STAR_COUNT; i++) {
    pos[i*3+1] += starSpeeds[i];
    if (pos[i*3+1] > 60) pos[i*3+1] = -60;
  }
  starGeo.attributes.position.needsUpdate = true;

  // Orbit orbs
  orbGroup.children.forEach((child, i) => {
    if (i % 2 === 0) {
      child.position.y += Math.sin(time * 0.5 + i) * 0.003;
    }
  });
  orbGroup.rotation.y = time * 0.08;
  orbGroup.rotation.x = Math.sin(time * 0.1) * 0.05;

  // Pulse star sizes
  const sizes = starGeo.attributes.size.array;
  for (let i = 0; i < STAR_COUNT; i++) {
    sizes[i] = (0.5 + Math.sin(time * 2 + i * 0.5) * 0.3) * (1 + starSizes[i] * 0.5);
  }
  starGeo.attributes.size.needsUpdate = true;

  renderer.render(scene, camera);
}
animate();

// ── Resize ──
window.addEventListener('resize', () => {
  const nW = window.innerWidth;
  const nH = window.innerHeight;
  renderer.setSize(nW, nH);
  camera.aspect = nW / nH;
  camera.updateProjectionMatrix();
});

// ── SVG Constellation Lines ──
function drawConstellationLines() {
  const svg = document.getElementById('constellation-svg');
  const container = document.getElementById('constellation-container');
  const cards = container?.querySelectorAll('.team-card');
  const centerOrb = document.getElementById('center-orb');
  if (!svg || !container || !cards || !centerOrb) return;

  // Only on desktop
  if (window.innerWidth < 768) {
    svg.innerHTML = '';
    return;
  }

  const lines = [];
  const centerRect = centerOrb.getBoundingClientRect();
  const containerRect = container.getBoundingClientRect();
  const cx = centerRect.left - containerRect.left + centerRect.width / 2;
  const cy = centerRect.top - containerRect.top + centerRect.height / 2;

  cards.forEach((card, i) => {
    const cardRect = card.getBoundingClientRect();
    const x = cardRect.left - containerRect.left + cardRect.width / 2;
    const y = cardRect.top - containerRect.top + cardRect.height / 2;

    lines.push(
      `<line x1="${cx}" y1="${cy}" x2="${x}" y2="${y}"
        stroke="url(#lineGrad${i})" stroke-width="1.5" stroke-dasharray="6 4"
        class="constellation-line" style="--delay:${i * 0.2}s" />`
    );
  });

  const defs = cards.map((_, i) => {
    const hue1 = 270 + i * 12;
    const hue2 = 330 + i * 8;
    return `<linearGradient id="lineGrad${i}" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="hsla(${hue1}, 80%, 60%, 0.4)" />
      <stop offset="100%" stop-color="hsla(${hue2}, 80%, 70%, 0.15)" />
    </linearGradient>`;
  }).join('');

  svg.innerHTML = `<defs>${defs}</defs>${lines.join('')}`;
}

// Draw on load and resize
window.addEventListener('load', () => setTimeout(drawConstellationLines, 300));
window.addEventListener('resize', drawConstellationLines);
// Astro page transition support
document.addEventListener('astro:page-load', () => setTimeout(drawConstellationLines, 300));
</script>

