<script>
import * as THREE from "three";

/* =====================================================================
   TEAM DATA (for constellation positioning)
===================================================================== */
const teamData = [
  { left: 9, top: 34 },
  { left: 33, top: 16 },
  { left: 65, top: 16 },
  { left: 90, top: 34 },
  { left: 22, top: 66 },
  { left: 77, top: 66 },
];

/* =====================================================================
   CONSTELLATION: DRAG + SVG LINES (desktop only)
===================================================================== */
const constellation = document.getElementById("constellation");
const svg = document.getElementById("lines-svg");
const coreEl = document.getElementById("core");

if (constellation && svg && coreEl && window.innerWidth > 1100) {
  const dragEls = Array.from(constellation.querySelectorAll<HTMLElement>(".card-drag"));

  // Drag state
  const dragState = dragEls.map(() => ({ dx: 0, dy: 0 }));

  dragEls.forEach((el, i) => {
    let startX = 0,
      startY = 0,
      origX = 0,
      origY = 0,
      dragging = false;

    el.addEventListener("pointerdown", (e: PointerEvent) => {
      dragging = true;
      el.classList.add("dragging");
      el.setPointerCapture(e.pointerId);
      startX = e.clientX;
      startY = e.clientY;
      origX = dragState[i].dx;
      origY = dragState[i].dy;
    });

    el.addEventListener("pointermove", (e: PointerEvent) => {
      if (!dragging) return;
      dragState[i].dx = origX + (e.clientX - startX);
      dragState[i].dy = origY + (e.clientY - startY);
      el.style.transform = `translate(-50%,-50%) translate(${dragState[i].dx}px, ${dragState[i].dy}px)`;
    });

    const end = (e: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      el.classList.remove("dragging");
      try { el.releasePointerCapture(e.pointerId); } catch (_) {}
    };
    el.addEventListener("pointerup", end);
    el.addEventListener("pointercancel", end);
  });

  // Draw lines
  function drawLines() {
    const rect = constellation!.getBoundingClientRect();
    const coreRect = coreEl!.getBoundingClientRect();
    const cx = coreRect.left + coreRect.width / 2 - rect.left;
    const cy = coreRect.top + coreRect.height / 2 - rect.top;

    svg!.querySelectorAll(".link-path, .link-dot").forEach((n) => n.remove());

    dragEls.forEach((el, i) => {
      const r = el.getBoundingClientRect();
      const x = r.left + r.width / 2 - rect.left;
      const y = r.top + r.height / 2 - rect.top;
      const mx = (cx + x) / 2;
      const my = (cy + y) / 2 - 40;

      const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
      path.setAttribute("d", `M ${cx} ${cy} Q ${mx} ${my} ${x} ${y}`);
      path.setAttribute("class", "link-path");
      svg!.appendChild(path);

      const dot = document.createElementNS("http://www.w3.org/2000/svg", "circle");
      dot.setAttribute("cx", String(x));
      dot.setAttribute("cy", String(y));
      dot.setAttribute("r", "3");
      dot.setAttribute("class", "link-dot");
      svg!.appendChild(dot);
    });

    requestAnimationFrame(drawLines);
  }
  requestAnimationFrame(drawLines);
}

/* =====================================================================
   THREE.JS BACKGROUND — starfield + wireframe cubes + icosahedron
===================================================================== */
(function () {
  const canvas = document.getElementById("bg-canvas") as HTMLCanvasElement;
  if (!canvas) return;

  const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.setSize(window.innerWidth, window.innerHeight);

  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(
    60,
    window.innerWidth / window.innerHeight,
    0.1,
    1000
  );
  camera.position.z = 60;

  // Purple particle field
  const particleCount = 700;
  const positions = new Float32Array(particleCount * 3);
  for (let i = 0; i < particleCount; i++) {
    positions[i * 3] = (Math.random() - 0.5) * 260;
    positions[i * 3 + 1] = (Math.random() - 0.5) * 200;
    positions[i * 3 + 2] = (Math.random() - 0.5) * 200 - 40;
  }
  const pGeo = new THREE.BufferGeometry();
  pGeo.setAttribute("position", new THREE.BufferAttribute(positions, 3));
  const pMat = new THREE.PointsMaterial({
    color: 0xa855f7,
    size: 0.9,
    transparent: true,
    opacity: 0.55,
  });
  const points = new THREE.Points(pGeo, pMat);
  scene.add(points);

  // Pink particle field
  const positions2 = new Float32Array(300 * 3);
  for (let i = 0; i < 300; i++) {
    positions2[i * 3] = (Math.random() - 0.5) * 220;
    positions2[i * 3 + 1] = (Math.random() - 0.5) * 160;
    positions2[i * 3 + 2] = (Math.random() - 0.5) * 160 - 20;
  }
  const pGeo2 = new THREE.BufferGeometry();
  pGeo2.setAttribute("position", new THREE.BufferAttribute(positions2, 3));
  const pMat2 = new THREE.PointsMaterial({
    color: 0xec4899,
    size: 1.1,
    transparent: true,
    opacity: 0.45,
  });
  const points2 = new THREE.Points(pGeo2, pMat2);
  scene.add(points2);

  // Mouse-follow physics
  const basePos1 = positions.slice();
  const basePos2 = positions2.slice();
  const vel1 = new Float32Array(positions.length);
  const vel2 = new Float32Array(positions2.length);

  const raycaster = new THREE.Raycaster();
  const mouseNDC = new THREE.Vector2(0, 0);
  const mousePlane = new THREE.Plane(new THREE.Vector3(0, 0, 1), 40);
  const mouseWorld = new THREE.Vector3();
  let hasMouse = false;

  const INFLUENCE_RADIUS = 55;
  const ATTRACT_STRENGTH = 0.9;
  const SPRING_K = 0.018;
  const DAMPING = 0.9;

  function applyMouseForces(
    posArr: Float32Array,
    baseArr: Float32Array,
    velArr: Float32Array,
    group: THREE.Points
  ) {
    if (!hasMouse) return;
    const localMouse = group.worldToLocal(mouseWorld.clone());
    for (let i = 0; i < posArr.length; i += 3) {
      const dx = localMouse.x - posArr[i];
      const dy = localMouse.y - posArr[i + 1];
      const dz = localMouse.z - posArr[i + 2];
      const dist = Math.sqrt(dx * dx + dy * dy + dz * dz) || 0.001;

      if (dist < INFLUENCE_RADIUS) {
        const force = (1 - dist / INFLUENCE_RADIUS) * ATTRACT_STRENGTH;
        velArr[i] += (dx / dist) * force;
        velArr[i + 1] += (dy / dist) * force;
        velArr[i + 2] += (dz / dist) * force;
      }

      velArr[i] += (baseArr[i] - posArr[i]) * SPRING_K;
      velArr[i + 1] += (baseArr[i + 1] - posArr[i + 1]) * SPRING_K;
      velArr[i + 2] += (baseArr[i + 2] - posArr[i + 2]) * SPRING_K;

      velArr[i] *= DAMPING;
      velArr[i + 1] *= DAMPING;
      velArr[i + 2] *= DAMPING;

      posArr[i] += velArr[i];
      posArr[i + 1] += velArr[i + 1];
      posArr[i + 2] += velArr[i + 2];
    }
  }

  // Floating wireframe cubes
  const cubes: THREE.LineSegments[] = [];
  const cubeColors = [0xa855f7, 0xec4899, 0x8b5cf6, 0xff2d20];
  for (let i = 0; i < 10; i++) {
    const size = 2 + Math.random() * 3.5;
    const geo = new THREE.BoxGeometry(size, size, size);
    const edges = new THREE.EdgesGeometry(geo);
    const mat = new THREE.LineBasicMaterial({
      color: cubeColors[i % cubeColors.length],
      transparent: true,
      opacity: 0.55,
    });
    const cube = new THREE.LineSegments(edges, mat);
    cube.position.set(
      (Math.random() - 0.5) * 90,
      (Math.random() - 0.5) * 70,
      (Math.random() - 0.5) * 50 - 10
    );
    cube.userData = {
      speed: 0.2 + Math.random() * 0.4,
      rotSpeed: (Math.random() - 0.5) * 0.01,
      floatPhase: Math.random() * Math.PI * 2,
      baseY: cube.position.y,
    };
    scene.add(cube);
    cubes.push(cube);
  }

  // Central wireframe icosahedron
  const icoGeo = new THREE.IcosahedronGeometry(9, 0);
  const icoEdges = new THREE.EdgesGeometry(icoGeo);
  const icoMat = new THREE.LineBasicMaterial({
    color: 0xff2d20,
    transparent: true,
    opacity: 0.5,
  });
  const ico = new THREE.LineSegments(icoEdges, icoMat);
  ico.position.set(0, -2, -25);
  scene.add(ico);

  scene.add(new THREE.AmbientLight(0xffffff, 0.4));

  let mouseX = 0;
  let mouseY = 0;
  let targetX = 0;
  let targetY = 0;

  window.addEventListener("mousemove", (e) => {
    mouseX = e.clientX / window.innerWidth - 0.5;
    mouseY = e.clientY / window.innerHeight - 0.5;
    mouseNDC.x = (e.clientX / window.innerWidth) * 2 - 1;
    mouseNDC.y = -(e.clientY / window.innerHeight) * 2 + 1;
    hasMouse = true;
  });
  window.addEventListener("mouseleave", () => {
    hasMouse = false;
  });
  window.addEventListener(
    "touchmove",
    (e) => {
      if (!e.touches.length) return;
      const touch = e.touches[0];
      mouseX = touch.clientX / window.innerWidth - 0.5;
      mouseY = touch.clientY / window.innerHeight - 0.5;
      mouseNDC.x = (touch.clientX / window.innerWidth) * 2 - 1;
      mouseNDC.y = -(touch.clientY / window.innerHeight) * 2 + 1;
      hasMouse = true;
    },
    { passive: true }
  );
  window.addEventListener("touchend", () => {
    hasMouse = false;
  });

  window.addEventListener("resize", () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
  });

  const clock = new THREE.Clock();
  function animate() {
    const t = clock.getElapsedTime();

    if (hasMouse) {
      raycaster.setFromCamera(mouseNDC, camera);
      raycaster.ray.intersectPlane(mousePlane, mouseWorld);
    }

    points.rotation.y = t * 0.02;
    points.rotation.x = t * 0.008;
    points2.rotation.y = -t * 0.015;

    applyMouseForces(positions, basePos1, vel1, points);
    applyMouseForces(positions2, basePos2, vel2, points2);
    pGeo.attributes.position.needsUpdate = true;
    pGeo2.attributes.position.needsUpdate = true;

    cubes.forEach((cube) => {
      cube.rotation.x += cube.userData.rotSpeed;
      cube.rotation.y += cube.userData.rotSpeed * 1.4;
      cube.position.y =
        cube.userData.baseY +
        Math.sin(t * cube.userData.speed + cube.userData.floatPhase) * 3;
    });

    ico.rotation.y = t * 0.15;
    ico.rotation.x = t * 0.08;
    const s = 1 + Math.sin(t * 0.6) * 0.04;
    ico.scale.set(s, s, s);

    targetX += (mouseX - targetX) * 0.03;
    targetY += (mouseY - targetY) * 0.03;
    camera.position.x = targetX * 8;
    camera.position.y = -targetY * 6;
    camera.lookAt(0, 0, 0);

    renderer.render(scene, camera);
    requestAnimationFrame(animate);
  }
  animate();
})();
</script>

