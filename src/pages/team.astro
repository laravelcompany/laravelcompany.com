---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";

interface TeamMember {
  name: string;
  role: string;
  desc: string;
  skills: string[];
  github: string;
  avatar: string;
  initials: string;
  left: number;
  top: number;
  color1: string;
  color2: string;
}

const teamMembers: TeamMember[] = [
  {
    name: "Bogdan Boti",
    role: "Marketing",
    desc: "Laravel Community Member",
    skills: ["Laravel", "SEO", "AI"],
    github: "Bogdanboti",
    avatar: "https://avatars.githubusercontent.com/u/90279111?s=96&v=4",
    initials: "BB",
    left: 9,
    top: 34,
    color1: "#f97316",
    color2: "#facc15",
  },
  {
    name: "Stefan Bogdan",
    role: "Founder",
    desc: "Laravel Core Team Contributor",
    skills: ["Laravel", "Vue", "AI"],
    github: "izdrail",
    avatar: "https://avatars.githubusercontent.com/u/2276408?s=96&v=4",
    initials: "SB",
    left: 33,
    top: 16,
    color1: "#f472b6",
    color2: "#fb923c",
  },
  {
    name: "Jon Basildon",
    role: "Developer",
    desc: "Backend & API Specialist",
    skills: ["PHP", "Laravel", "AWS"],
    github: "jonbasildon",
    avatar: "https://avatars.githubusercontent.com/u/145971646?s=96&v=4",
    initials: "JB",
    left: 65,
    top: 16,
    color1: "#38bdf8",
    color2: "#818cf8",
  },
  {
    name: "Andrei M",
    role: "Marketing",
    desc: "Laravel Community Member",
    skills: ["Content", "SEO", "Growth"],
    github: "marmureanuweb",
    avatar: "https://avatars.githubusercontent.com/u/13685130?s=96&v=4",
    initials: "AM",
    left: 90,
    top: 34,
    color1: "#34d399",
    color2: "#0ea5e9",
  },
  {
    name: "Marian P",
    role: "Developer",
    desc: "Full Stack Developer",
    skills: ["Laravel", "Livewire", "Vue"],
    github: "popiciulo",
    avatar: "https://avatars.githubusercontent.com/u/8106610?s=96&v=4",
    initials: "MP",
    left: 22,
    top: 66,
    color1: "#a78bfa",
    color2: "#818cf8",
  },
  {
    name: "Syed Hammad Ahmed",
    role: "Developer",
    desc: "Backend & DevOps Engineer",
    skills: ["Laravel", "Docker", "AWS"],
    github: "shammadahmed",
    avatar: "https://avatars.githubusercontent.com/u/8712631?s=96&v=4",
    initials: "SH",
    left: 77,
    top: 66,
    color1: "#fb7185",
    color2: "#f59e0b",
  },
];
---

<Layout
  title="Our Team | Laravel Company"
  description="Meet the talented team behind Laravel Company — expert Laravel developers, engineers, and open source contributors building world-class web applications."
>
  <!-- Three.js Background Canvas -->
  <canvas id="bg-canvas"></canvas>

  <!-- Film Grain Overlay -->
  <div class="grain-overlay"></div>

  <div class="relative z-10">
    <!-- ==================== HERO ==================== -->
    <section class="pt-24 md:pt-32 pb-4">
      <div class="container-custom">
        <div class="flex flex-col lg:flex-row justify-between items-start gap-8 lg:gap-12">
          <!-- Left: Text -->
          <div class="max-w-2xl animate-on-scroll">
            <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-widest bg-gradient-to-r from-payflo-purple/20 to-payflo-pink/20 border border-payflo-purple/30 text-purple-200 mb-6">
              <Icon name="ph:users-three" class="w-4 h-4" />
              Our Team
            </span>
            <h1
              class="text-5xl md:text-6xl lg:text-[52px] font-extrabold leading-[1.05] text-white"
              style="font-family:'Sora',sans-serif;"
            >
              Meet Our <span class="gradient-text">Team</span>
            </h1>
            <p class="mt-5 text-base md:text-lg text-purple-200/60 leading-relaxed max-w-xl">
              The talented individuals behind Laravel Company. We're a team of passionate
              developers building modern software solutions with Laravel — drag a card to see who moves.
            </p>
          </div>

          <!-- Right: Stat Cards -->
          <div class="grid grid-cols-2 gap-3 w-full lg:w-auto lg:min-w-[520px] animate-on-scroll" style="animation-delay:0.15s;">
            {[
              { icon: "ph:users-three", num: "18+", label: "Developers" },
              { icon: "ph:cube", num: "250+", label: "Projects" },
              { icon: "ph:download-simple", num: "10M+", label: "Downloads" },
              { icon: "ph:star", num: "8+", label: "Years" },
            ].map((stat) => (
              <div class="stat-card glass-card !p-3.5 !rounded-2xl flex items-center gap-3 border-white/[0.08] bg-white/[0.04] hover:border-payflo-pink/40 hover:bg-white/[0.07] transition-all duration-300 group cursor-default">
                <div class="w-[42px] h-[42px] rounded-xl flex items-center justify-center bg-gradient-to-br from-payflo-purple/30 to-payflo-pink/30 border border-white/10">
                  <Icon name={stat.icon} class="w-4 h-4 text-purple-200" />
                </div>
                <div>
                  <div class="text-lg font-bold text-white leading-none" style="font-family:'Sora',sans-serif;">{stat.num}</div>
                  <div class="text-xs text-purple-200/50 mt-1">{stat.label}</div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== CONSTELLATION (Desktop) ==================== -->
    <div id="constellation" class="relative w-full h-[900px] mt-8 hidden lg:block">
      <!-- SVG Lines -->
      <svg id="lines-svg" class="absolute inset-0 w-full h-full overflow-visible pointer-events-none">
        <defs>
          <linearGradient id="lineGrad" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#a855f7" />
            <stop offset="100%" stop-color="#ec4899" />
          </linearGradient>
        </defs>
      </svg>

      <!-- Central Laravel Core -->
      <div class="core" id="core">
        <div class="core-ring"></div>
        <div class="core-ring core-ring-r2"></div>
        <div class="core-glow"></div>
        <div class="core-gem">
          <svg width="70" height="80" viewBox="0 0 70 80" fill="none">
            <path d="M35 2 L66 20 L66 60 L35 78 L4 60 L4 20 Z" stroke="#ff2d20" stroke-width="2" fill="rgba(255,45,32,0.07)" />
            <path d="M35 2 L35 78 M4 20 L66 60 M66 20 L4 60" stroke="#ff2d20" stroke-width="1.2" opacity="0.6" />
          </svg>
        </div>
      </div>

      <!-- Team Cards (Desktop Constellation) -->
      {
        teamMembers.map((member, i) => (
          <div class="card-anchor" style={`left:${member.left}%;top:${member.top}%`}>
            <div
              class="card-float"
              style={`animation:${5 + (i % 3)}s ease-in-out infinite;animation-delay:${i * 0.4}s;`}
            >
              <div class="card-drag" data-index={i}>
                <div class="drag-hint">
                  <Icon name="ph:arrows-out-cardinal" class="w-3 h-3" /> drag me
                </div>
                <div class="member-card">
                  <div class="w-2.5 h-2.5 rounded-full bg-emerald-400 shadow-[0_0_8px_#34d399] absolute top-3.5 right-3.5" />
                  <div class="flex gap-3.5 items-start">
                    <div class="w-[70px] h-[70px] rounded-full p-[2px] bg-gradient-to-br from-violet-500 via-pink-500 to-violet-500 flex-shrink-0">
                      <div
                        class="w-full h-full rounded-full flex items-center justify-center font-bold text-white text-lg"
                        style={`background:linear-gradient(135deg,${member.color1},${member.color2});font-family:'Sora',sans-serif;`}
                      >
                        {member.initials}
                      </div>
                    </div>
                    <div class="min-w-0">
                      <div class="font-bold text-[16.5px] text-white">{member.name}</div>
                      <div class="text-[12.5px] font-bold text-payflo-pink">{member.role}</div>
                      <div class="text-[12.5px] text-purple-200/50 leading-snug mt-0.5">{member.desc}</div>
                    </div>
                  </div>
                  <div class="flex gap-1.5 mt-3.5 flex-wrap">
                    {member.skills.map((skill) => (
                      <span class="text-[11px] px-2.5 py-1 rounded-lg bg-white/[0.05] border border-white/[0.09] text-purple-200/50">
                        {skill}
                      </span>
                    ))}
                  </div>
                  <div class="flex gap-2 mt-3.5">
                    <a
                      href={`https://github.com/${member.github}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="w-[30px] h-[30px] rounded-lg flex items-center justify-center bg-white/[0.05] border border-white/[0.08] text-purple-200/40 hover:text-white hover:bg-gradient-to-br hover:from-payflo-purple hover:to-payflo-pink transition-all duration-200 hover:-translate-y-0.5"
                      aria-label={`${member.name}'s GitHub`}
                    >
                      <Icon name="ph:github-logo" class="w-3.5 h-3.5" />
                    </a>
                    <a
                      href={`https://github.com/${member.github}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="w-[30px] h-[30px] rounded-lg flex items-center justify-center bg-white/[0.05] border border-white/[0.08] text-purple-200/40 hover:text-white hover:bg-gradient-to-br hover:from-payflo-purple hover:to-payflo-pink transition-all duration-200 hover:-translate-y-0.5"
                      aria-label={`${member.name}'s LinkedIn`}
                    >
                      <Icon name="ph:linkedin-logo" class="w-3.5 h-3.5" />
                    </a>
                    <a
                      href={`https://github.com/${member.github}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="w-[30px] h-[30px] rounded-lg flex items-center justify-center bg-white/[0.05] border border-white/[0.08] text-purple-200/40 hover:text-white hover:bg-gradient-to-br hover:from-payflo-purple hover:to-payflo-pink transition-all duration-200 hover:-translate-y-0.5"
                      aria-label={`${member.name}'s Twitter`}
                    >
                      <Icon name="ph:x-logo" class="w-3.5 h-3.5" />
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        ))
      }

      <!-- Quote Pill -->
      <div class="quote-pill">
        <Icon name="ph:users-three" class="w-4 h-4 text-payflo-pink" />
        A team united by code, driven by purpose.
      </div>
    </div>

    <!-- ==================== MOBILE CARDS ==================== -->
    <div class="mobile-cards grid grid-cols-1 sm:grid-cols-2 gap-5 px-4 max-w-5xl mx-auto mt-8 lg:hidden">
      {
        teamMembers.map((member) => (
          <div class="member-card !relative">
            <div class="w-2.5 h-2.5 rounded-full bg-emerald-400 shadow-[0_0_8px_#34d399] absolute top-3.5 right-3.5" />
            <div class="flex gap-3.5 items-start">
              <div class="w-[70px] h-[70px] rounded-full p-[2px] bg-gradient-to-br from-violet-500 via-pink-500 to-violet-500 flex-shrink-0">
                <div
                  class="w-full h-full rounded-full flex items-center justify-center font-bold text-white text-lg"
                  style={`background:linear-gradient(135deg,${member.color1},${member.color2});font-family:'Sora',sans-serif;`}
                >
                  {member.initials}
                </div>
              </div>
              <div class="min-w-0">
                <div class="font-bold text-[16.5px] text-white">{member.name}</div>
                <div class="text-[12.5px] font-bold text-payflo-pink">{member.role}</div>
                <div class="text-[12.5px] text-purple-200/50 leading-snug mt-0.5">{member.desc}</div>
              </div>
            </div>
            <div class="flex gap-1.5 mt-3.5 flex-wrap">
              {member.skills.map((skill) => (
                <span class="text-[11px] px-2.5 py-1 rounded-lg bg-white/[0.05] border border-white/[0.09] text-purple-200/50">
                  {skill}
                </span>
              ))}
            </div>
            <div class="flex gap-2 mt-3.5">
              <a
                href={`https://github.com/${member.github}`}
                target="_blank"
                rel="noopener noreferrer"
                class="w-[30px] h-[30px] rounded-lg flex items-center justify-center bg-white/[0.05] border border-white/[0.08] text-purple-200/40 hover:text-white hover:bg-gradient-to-br hover:from-payflo-purple hover:to-payflo-pink transition-all duration-200"
                aria-label={`${member.name}'s GitHub`}
              >
                <Icon name="ph:github-logo" class="w-3.5 h-3.5" />
              </a>
              <a
                href={`https://github.com/${member.github}`}
                target="_blank"
                rel="noopener noreferrer"
                class="w-[30px] h-[30px] rounded-lg flex items-center justify-center bg-white/[0.05] border border-white/[0.08] text-purple-200/40 hover:text-white hover:bg-gradient-to-br hover:from-payflo-purple hover:to-payflo-pink transition-all duration-200"
                aria-label={`${member.name}'s LinkedIn`}
              >
                <Icon name="ph:linkedin-logo" class="w-3.5 h-3.5" />
              </a>
              <a
                href={`https://github.com/${member.github}`}
                target="_blank"
                rel="noopener noreferrer"
                class="w-[30px] h-[30px] rounded-lg flex items-center justify-center bg-white/[0.05] border border-white/[0.08] text-purple-200/40 hover:text-white hover:bg-gradient-to-br hover:from-payflo-purple hover:to-payflo-pink transition-all duration-200"
                aria-label={`${member.name}'s Twitter`}
              >
                <Icon name="ph:x-logo" class="w-3.5 h-3.5" />
              </a>
            </div>
          </div>
        ))
      }
    </div>

    <!-- ==================== BOTTOM 3-COLUMN SECTION ==================== -->
    <section class="py-20 md:py-28 relative overflow-hidden">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-gradient-to-r from-payflo-purple/3 via-transparent to-payflo-blue/3 blur-[100px] rounded-full pointer-events-none"></div>
      <div class="container-custom relative">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-10">
          <!-- Why Companies Choose Us -->
          <div class="animate-on-scroll">
            <div class="glass-card p-8 border-white/[0.06] bg-white/[0.02] h-full">
              <div class="w-12 h-12 rounded-xl bg-payflo-purple/10 border border-payflo-purple/20 flex items-center justify-center mb-6">
                <Icon name="ph:star-duotone" class="w-6 h-6 text-payflo-purple" />
              </div>
              <h3
                class="text-xl font-bold text-white mb-5"
                style="font-family:'Sora',sans-serif;"
              >
                Why Companies Choose Us
              </h3>
              <ul class="space-y-3">
                {[
                  { icon: "ph:git-branch", title: "Laravel Core", sub: "Contributors" },
                  { icon: "ph:git-fork", title: "Open Source", sub: "Creators" },
                  { icon: "ph:magic-wand", title: "AI & Innovation", sub: "Focused" },
                  { icon: "ph:lightning", title: "Performance", sub: "Experts" },
                  { icon: "ph:stack-simple", title: "Clean & Scalable", sub: "Architecture" },
                  { icon: "ph:cloud", title: "DevOps & Cloud", sub: "Specialists" },
                ].map((item) => (
                  <li class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-lg flex items-center justify-center bg-gradient-to-br from-payflo-purple/25 to-payflo-pink/20 border border-white/10 flex-shrink-0">
                      <Icon name={item.icon} class="w-4 h-4 text-purple-200/80" />
                    </div>
                    <div>
                      <div class="text-sm font-semibold text-white">{item.title}</div>
                      <div class="text-xs text-purple-200/50">{item.sub}</div>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Tech Stack -->
          <div class="animate-on-scroll" style="animation-delay:0.1s;">
            <div class="glass-card p-8 border-white/[0.06] bg-white/[0.02] h-full">
              <div class="w-12 h-12 rounded-xl bg-payflo-blue/10 border border-payflo-blue/20 flex items-center justify-center mb-6">
                <Icon name="ph:code-duotone" class="w-6 h-6 text-payflo-blue" />
              </div>
              <h3
                class="text-xl font-bold text-white mb-5"
                style="font-family:'Sora',sans-serif;"
              >
                Our Top Tech Stack
              </h3>
              <div class="grid grid-cols-2 gap-2.5">
                {[
                  { name: "Laravel", color: "#ff2d20", icon: "ph:fire" },
                  { name: "Livewire", color: "#ff9500", icon: "ph:lightning" },
                  { name: "Vue.js", color: "#42b883", icon: "ph:paint-brush" },
                  { name: "PHP", color: "#8993be", icon: "ph:code" },
                  { name: "Tailwind", color: "#38bdf8", icon: "ph:wind" },
                  { name: "Docker", color: "#2496ed", icon: "ph:shipping-container" },
                  { name: "MySQL", color: "#c9b6ff", icon: "ph:database" },
                  { name: "AWS", color: "#ff9900", icon: "ph:cloud" },
                ].map((tech) => (
                  <div class="flex items-center gap-2 px-3 py-2.5 rounded-xl bg-white/[0.04] border border-white/[0.08] hover:-translate-y-0.5 hover:border-payflo-pink/40 hover:bg-white/[0.07] transition-all duration-200 cursor-default">
                    <Icon name={tech.icon} class="w-3.5 h-3.5" style={`color:${tech.color};`} />
                    <span class="text-[13.5px] font-semibold text-purple-200/70">{tech.name}</span>
                  </div>
                ))}
              </div>
              <div class="text-center text-xs text-purple-200/30 mt-4">+ Many More</div>
            </div>
          </div>

          <!-- Open Source Impact -->
          <div class="animate-on-scroll" style="animation-delay:0.2s;">
            <div class="glass-card p-8 border-white/[0.06] bg-white/[0.02] h-full">
              <div class="w-12 h-12 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center mb-6">
                <Icon name="ph:github-logo-duotone" class="w-6 h-6 text-emerald-400" />
              </div>
              <h3
                class="text-xl font-bold text-white mb-5"
                style="font-family:'Sora',sans-serif;"
              >
                Open Source Impact
              </h3>
              <ul class="space-y-3">
                {[
                  { label: "Laravel Packages", value: "25+", icon: "ph:squares-four" },
                  { label: "GitHub Repositories", value: "120+", icon: "ph:git-fork" },
                  { label: "Stars Received", value: "5.2K+", icon: "ph:star" },
                  { label: "Community Members", value: "15K+", icon: "ph:users-three" },
                ].map((stat) => (
                  <li class="flex items-center justify-between py-2.5 border-b border-white/[0.06] last:border-b-0">
                    <span class="flex items-center gap-2.5 text-sm text-purple-200/50">
                      <Icon name={stat.icon} class="w-4 h-4" />
                      {stat.label}
                    </span>
                    <span class="font-bold text-payflo-pink" style="font-family:'Sora',sans-serif;">{stat.value}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== SPECIALISTS INTRO ==================== -->
    <section class="py-20 md:py-28 relative overflow-hidden">
      <div class="absolute top-0 right-1/4 w-[500px] h-[500px] bg-payflo-purple/5 blur-[150px] rounded-full pointer-events-none"></div>
      <div class="container-custom relative">
        <div class="flex flex-col lg:flex-row gap-12 lg:gap-16 items-start">
          <!-- Left: Text -->
          <div class="flex-1 max-w-2xl animate-on-scroll">
            <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-widest bg-gradient-to-r from-payflo-purple/20 to-payflo-pink/20 border border-payflo-purple/30 text-purple-200 mb-6">
              <Icon name="ph:target" class="w-4 h-4" />
              Who We Are
            </span>
            <h2
              class="text-3xl md:text-4xl lg:text-5xl font-extrabold leading-tight text-white mb-6"
              style="font-family:'Sora',sans-serif;"
            >
              Specialists Who Know
              <span class="gradient-text">Laravel Inside Out</span>
            </h2>
            <div class="space-y-4 text-base text-purple-200/60 leading-relaxed">
              <p>
                We're not your do-it-all digital agency, but a partner focused on building web
                applications with a solid foundation that can grow alongside your needs. By asking
                the right questions first, we make thoughtful architecture decisions, and ship
                clean code your team can maintain and extend long after launch.
              </p>
              <p>
                Over time, we have created a collection of open source building blocks that
                allow us to focus all our time and effort on making your project unique, rather
                than on the scaffolding. And with our experience in building with AI, we can
                ship faster, iterate more quickly, and develop more prototypes that can validate
                your ideas.
              </p>
            </div>
            <a
              href="/contact/"
              class="inline-flex items-center gap-2 mt-8 px-6 py-3 rounded-xl bg-payflo-purple text-white font-bold text-sm shadow-lg shadow-payflo-purple/25 hover:shadow-payflo-purple/40 hover:scale-105 active:scale-95 transition-all duration-300"
            >
              <Icon name="ph:paper-plane-tilt" class="w-4 h-4" />
              Brief us your project
            </a>
          </div>

          <!-- Right: Feature Card -->
          <div class="w-full lg:w-[400px] flex-shrink-0 animate-on-scroll" style="animation-delay:0.15s;">
            <div class="glass-card p-8 border-white/[0.06] bg-white/[0.02]">
              <div class="space-y-4">
                {[
                  { icon: "ph:git-branch", title: "Laravel Core", sub: "Contributors to the ecosystem" },
                  { icon: "ph:git-fork", title: "Open Source", sub: "Creators of reusable packages" },
                  { icon: "ph:magic-wand", title: "AI & Innovation", sub: "Focused on shipping faster" },
                  { icon: "ph:lightning", title: "Performance", sub: "Experts in optimization" },
                  { icon: "ph:stack-simple", title: "Clean Architecture", sub: "Scalable & maintainable code" },
                  { icon: "ph:cloud", title: "DevOps & Cloud", sub: "Deployment & infrastructure" },
                ].map((item) => (
                  <div class="flex items-start gap-4 p-3 rounded-xl hover:bg-white/[0.03] transition-colors">
                    <div class="w-10 h-10 rounded-xl flex items-center justify-center bg-gradient-to-br from-payflo-purple/25 to-payflo-pink/20 border border-white/10 flex-shrink-0">
                      <Icon name={item.icon} class="w-5 h-5 text-purple-200/80" />
                    </div>
                    <div>
                      <div class="text-sm font-bold text-white">{item.title}</div>
                      <div class="text-xs text-purple-200/50 mt-0.5">{item.sub}</div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== PROCESS ==================== -->
    <section class="py-20 md:py-28 relative overflow-hidden">
