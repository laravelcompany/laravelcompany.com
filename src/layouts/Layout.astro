---
import { ViewTransitions } from "astro:transitions";
import { getImage } from "astro:assets";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Laravel Company develops open-source Laravel tools for UI, Mail, SEO, GPT and Leads Management — no lock-in, no fluff, just solid engineering.",
} = Astro.props;

// Preload critical assets
const faviconImg = await getImage({
  src: "/favicon.png",
  width: 32,
  height: 32,
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="ce8-JHMeCvdT_PeZOS0E4Gpd5KcLqXu4hdDxoS991i0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Canonical URL -->
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />

    <!-- Robots -->
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Laravel Company" />

    <ViewTransitions />

    <!-- Preload critical resources -->
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap"
      rel="stylesheet"
    />

    <!-- Structured data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Laravel Company",
        "url": "https://laravelcompany.com",
        "logo": "https://laravelcompany.com/logo.svg",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "7 High Street",
          "addressLocality": "Basildon",
          "addressRegion": "Essex",
          "postalCode": "SS14 1AB",
          "addressCountry": "GB"
        },
        "contactPoint": {
          "@type": "ContactPoint",
          "telephone": "+44-1234-567890",
          "contactType": "customer service",
          "areaServed": "GB",
          "availableLanguage": "English"
        },
        "sameAs": [
          "https://twitter.com/laravelcompany",
          "https://github.com/laravelcompany",
          "https://linkedin.com/company/laravelcompany"
        ]
      }
    </script>

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={new URL("/logo.svg", Astro.site)} />
    <meta property="og:site_name" content="Laravel Development Company" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@laravelcompany" />
    <meta name="twitter:creator" content="@laravelcompany" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL("/logo.svg", Astro.site)} />
  </head>
  <body
    class="min-h-screen flex flex-col bg-payflo-dark text-white selection:bg-payflo-purple/30"
  >
    <a
      title="Laravel development company"
      href="#main-content"
      class="skip-link sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-1/2 focus:-translate-x-1/2 focus:z-50 focus:bg-payflo-purple focus:text-white focus:px-6 focus:py-3 focus:rounded-lg shadow-xl shadow-payflo-purple/20"
      >laravel development company</a
    >
    <Header />
    <main id="main-content" class="flex-grow">
      <slot />
    </main>
    <Footer />

    <!-- Intersection Observer for animations on scroll -->
    <script is:inline defer>
      document.addEventListener("astro:page-load", () => {
        const animatedElements =
          document.querySelectorAll(".animate-on-scroll");

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("animated");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1 },
        );

        animatedElements.forEach((element) => {
          observer.observe(element);
        });
      });
    </script>
  </body>
</html>
